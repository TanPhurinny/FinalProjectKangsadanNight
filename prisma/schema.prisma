datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// กำหนดสิทธิ์ตามขอบเขตงานของคุณ
enum Role {
  ADMIN      // ผู้ดูแลตลาด
  SELLER     // ผู้ขาย (Merchant)
  CUSTOMER   // ลูกค้า
  STAFF      // พนักงานตลาด
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
}

model Slot {
  id          Int      @id @default(autoincrement())
  slotNumber  String   @unique
  zone        String
  price       Float
  isAvailable Boolean  @default(true)
  merchant    String?
  createdAt   DateTime @default(now()) // เพิ่มบรรทัดนี้หากยังไม่มี
}