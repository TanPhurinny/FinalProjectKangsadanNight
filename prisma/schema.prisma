generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int                 @id @default(autoincrement())
  username      String              @unique
  password      String
  name          String
  role          Role                @default(CUSTOMER)
  createdAt     DateTime            @default(now())
  birthDate     DateTime?
  phoneNumber   String?
  email         String?             @unique
  avatarUrl     String?
  announcements Announcement[]
  bookings      Booking[]
  requests      MaintenanceReport[] @relation("MaintenanceReportReporter")
  shop          ShopDetail?
  sellerProfile Seller?
  sellerApplications SellerApplication[]
  passwordResetTokens PasswordResetToken[]
  taxInvoiceProfiles TaxInvoiceProfile[]
  taxInvoiceRequests TaxInvoiceRequest[]
  communityPosts CommunityPost[]
  communityLikes CommunityLike[]
  communityComments CommunityComment[]
  recordedElectricExcess StallElectricExcessRecord[]
  recordedInspectionChecks StallInspectionCheckRecord[]
  recordedIssues StallIssueRecord[]
  recordedCleanlinessInspections StallCleanlinessInspection[]
  assignedRepairReports MaintenanceReport[] @relation("MaintenanceReportAssignedTo")
  dailyInspectionSubmissions DailyInspectionSubmission[]
  // Blacklist จากคะแนนตรวจตลาด — อยู่บน User (ไม่ใช่ Seller model ที่ไม่มีที่ไหนในระบบสร้างข้อมูลจริงเลย)
  isBlacklisted   Boolean   @default(false)
  blacklistedAt   DateTime?
  blacklistReason String?   @db.Text
  blacklistedById Int?
  blacklistedBy   User?     @relation("UserBlacklistedBy", fields: [blacklistedById], references: [id], onDelete: SetNull)
  blacklistedUsers User[]   @relation("UserBlacklistedBy")

  @@index([blacklistedById], map: "User_blacklistedById_fkey")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "PasswordResetToken_userId_fkey")
}

model CommunityPost {
  id        Int      @id @default(autoincrement())
  userId    Int
  category  String
  content   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  images    CommunityPostImage[]
  likes     CommunityLike[]
  comments  CommunityComment[]

  @@index([userId], map: "CommunityPost_userId_fkey")
  @@index([createdAt], map: "CommunityPost_createdAt_idx")
}

model CommunityPostImage {
  id       Int    @id @default(autoincrement())
  postId   Int
  imageUrl String

  post     CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId], map: "CommunityPostImage_postId_fkey")
}

model CommunityComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId], map: "CommunityComment_postId_fkey")
  @@index([userId], map: "CommunityComment_userId_fkey")
}

model CommunityLike {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId], map: "CommunityLike_postId_fkey")
  @@index([userId], map: "CommunityLike_userId_fkey")
}

model SellerApplication {
  id                Int       @id @default(autoincrement())
  userId            Int
  shopName          String
  productType       String?
  productSubtype    String?
  productSubtypeOther String? // "อื่นๆ (ระบุ)" พิมพ์เอง — เก็บไว้เฉยๆ ไม่เอาเข้ากฎเว้นระยะล็อก (ดู utils/productSubtypes.js)
  productDetail     String?   @db.Text
  sellerName        String?
  idCardNumber      String?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  phoneNumber       String?
  houseNumber       String?
  subdistrict       String?
  district          String?
  province          String?
  shopCoverImage    String?
  termsAcceptedAt   DateTime?
  status            Status    @default(PENDING)
  rejectReason      String?   @db.Text
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "SellerApplication_userId_fkey")
}

model ShopDetail {
  id            Int     @id @default(autoincrement())
  shopName      String?
  productType   String?
  productSubtype String? // ประเภทสินค้าเฉพาะ (เช่น "ลูกชิ้นทอด") ใช้เทียบระยะห่างล็อกตอนแอดมินจัดล็อก ดู utils/stallSpacing.js
  productSubtypeOther String? // "อื่นๆ (ระบุ)" พิมพ์เอง — ไม่เอาเข้ากฎเว้นระยะล็อก
  productDetail String? @db.Text
  productImage  String? // รูปหลัก/รูปย่อของสินค้า อ้างอิงรูปแรกใน productImages เสมอ (ใช้แสดงในหน้าอื่นที่ยังอ้างอิงรูปเดียว เช่น ผังตลาด/คอมมูนิตี้)
  shopSummary   String? @db.Text
  shopCoverImage String?
  sellerTier    String?
  shopZoneLabel String?
  shopTags      String? @db.Text
  isVerified    Boolean @default(false)
  userId        Int     @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productImages ShopProductImage[]
}

model ShopProductImage {
  id           Int        @id @default(autoincrement())
  shopDetailId Int
  imageUrl     String
  createdAt    DateTime   @default(now())
  shopDetail   ShopDetail @relation(fields: [shopDetailId], references: [id], onDelete: Cascade)

  @@index([shopDetailId], map: "ShopProductImage_shopDetailId_fkey")
}

model BookingRequest {
  id           Int      @id @default(autoincrement())
  productName  String
  description  String   @db.Text
  sellerName   String
  phone        String
  zone         String
  assignedStallCode String?
  productImage String?
  sellerId     Int?
  status       Status   @default(PENDING)
  createdAt    DateTime @default(now())
  // เวลาที่แอดมินจัดล็อกให้ (ตั้งสถานะเป็น IN_PROGRESS) — ใช้คำนวณกำหนดชำระเงินภายใน 6 ชม.
  // (ดู getPaymentDeadlineHours ใน utils/bookingRound.js) รีเซ็ตใหม่ทุกครั้งที่จัดล็อกซ้ำ
  lockAssignedAt DateTime?
  paymentConfirmedAt DateTime?
  paymentSlipImage   String?
  slipVerified       Boolean?
  slipVerifyReason   String?  @db.Text
  slipVerifiedAmount Float?
  confirmedByName    String?
  seller       Seller?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  taxInvoiceRequestItems TaxInvoiceRequestItem[]

  @@index([sellerId], map: "BookingRequest_sellerId_fkey")
}

model BookingRound {
  id             Int      @id @default(autoincrement())
  roundNumber    Int      @unique
  cycleStartDate DateTime
  cycleEndDate   DateTime
  reminderDate   DateTime?
  openAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([cycleStartDate], map: "BookingRound_cycleStartDate_idx")
}

model Slot {
  id          Int       @id @default(autoincrement())
  slotNumber  String    @unique
  zone        String
  price       Float
  isAvailable Boolean   @default(true)
  bookings    Booking[]
}

model Booking {
  id        Int      @id @default(autoincrement())
  slotId    Int
  userId    Int
  sellerId  Int?
  status    Status   @default(PENDING)
  createdAt DateTime @default(now())
  zoneCode  String?
  selectedZoneLabel String?
  stallCount Int      @default(1)
  rentalStartDate DateTime?
  rentalEndDate DateTime?
  rentalDays Int      @default(1)
  dailyStallPrice Float @default(0)
  lightEnabled Boolean @default(false)
  lightUnitPrice Float @default(15)
  smallApplianceCount Int @default(0)
  largeApplianceCount Int @default(0)
  smallAppliancePrice Float @default(20)
  largeAppliancePrice Float @default(40)
  applianceTotal Float @default(0)
  lightTotal Float @default(0)
  rentTotal Float @default(0)
  grandTotal Float @default(0)
  storeDetailSnapshot String? @db.Text
  totalBasePrice Float @default(0)
  totalExtraPrice Float @default(0)
  totalElectricPrice Float @default(0)
  slot      Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller    Seller?  @relation("SellerBookings", fields: [sellerId], references: [id], onDelete: SetNull)
  items     BookingItem[]
  electricDevices BookingElectricDevice[]

  @@index([slotId], map: "Booking_slotId_fkey")
  @@index([userId], map: "Booking_userId_fkey")
  @@index([sellerId], map: "Booking_sellerId_fkey")
}

model MaintenanceReport {
  id           Int      @id @default(autoincrement())
  location     String
  category     String
  description  String   @db.Text
  image        String? // เส้นทางรูปภาพ
  status       Status   @default(PENDING)
  rejectReason String?  @db.Text // เหตุผลที่แอดมิน/สตาฟกดปฏิเสธคำร้อง
  userId       Int
  // assignedToId/updatedAt: มีคอลัมน์นี้อยู่แล้วบน DB กลาง (ทีมอื่นเพิ่มไว้) ผสานเข้า schema ให้ตรงกัน
  assignedToId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  user         User     @relation("MaintenanceReportReporter", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo   User?    @relation("MaintenanceReportAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  images       MaintenanceReportImage[]

  @@index([userId], map: "MaintenanceReport_userId_fkey")
  @@index([assignedToId], map: "MaintenanceReport_assignedToId_fkey")
}

// รูปแนบหลายรูปต่อ 1 รายงานแจ้งซ่อม — คอลัมน์ image เดิมบน MaintenanceReport ยังคงไว้เพื่อแสดงผล
// รายงานเก่าที่มีแค่รูปเดียว รายงานใหม่ใช้ตารางนี้แทน (ไม่เติมค่า image เดิมอีกต่อไป)
model MaintenanceReportImage {
  id                  Int               @id @default(autoincrement())
  maintenanceReportId Int
  imageUrl            String
  createdAt           DateTime          @default(now())
  maintenanceReport   MaintenanceReport @relation(fields: [maintenanceReportId], references: [id], onDelete: Cascade)

  @@index([maintenanceReportId], map: "MaintenanceReportImage_maintenanceReportId_fkey")
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  content     String   @db.Text
  category    String   @default("ทั่วไป")
  targetRole  Role     @default(CUSTOMER)
  authorId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  image       String?
  targetRoles Json?
  isImportant Boolean  @default(false)
  author      User     @relation(fields: [authorId], references: [id])

  @@index([authorId], map: "Announcement_authorId_fkey")
}

model Zone {
  id               Int                  @id @default(autoincrement())
  code             String               @unique
  name             String
  description      String?              @db.Text
  productCategory  Zone_productCategory
  size             String
  displayOrder     Int                  @default(0)
  defaultStallWidth Int                 @default(2)
  defaultStallHeight Int                @default(2)
  bookingStartDate DateTime?
  bookingEndDate   DateTime?
  electricityFee   Float                @default(15)
  rows             ZoneRow[]
  zoneProductTypes ZoneProductType[]
}

model ZoneRow {
  id      Int     @id @default(autoincrement())
  rowCode String
  label   String?
  price   Float
  size    String
  displayOrder Int @default(0)
  stallStartNumber Int?
  stallEndNumber Int?
  zoneId  Int
  zone    Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  stalls  Stall[]

  @@unique([zoneId, rowCode])
  @@index([zoneId], map: "ZoneRow_zoneId_fkey")
}

model Stall {
  id                   Int       @id @default(autoincrement())
  stallCode            String    @unique
  rowId                Int
  isAvailable          Boolean   @default(true)
  status               StallInventoryStatus @default(AVAILABLE)
  width                Int       @default(2)
  height               Int       @default(2)
  basePrice            Float     @default(0)
  extraPrice           Float     @default(0)
  displayOrder         Int       @default(0)
  bookingStartDate     DateTime?
  bookingEndDate       DateTime?
  extraElectricityCost Float     @default(0)
  electricFeePerDay    Float     @default(15)
  row                  ZoneRow   @relation(fields: [rowId], references: [id], onDelete: Cascade)
  bookingItems         BookingItem[]
  priceRules           StallPriceRule[]
  electricExcessRecords StallElectricExcessRecord[]
  inspectionCheckRecords StallInspectionCheckRecord[]
  issueRecords         StallIssueRecord[]
  cleanlinessInspections StallCleanlinessInspection[]

  @@index([rowId], map: "Stall_rowId_fkey")
}

// พบเครื่องใช้ไฟฟ้าเกินตอนตรวจตลาดหน้างาน (แยกจาก Booking.smallApplianceCount/largeApplianceCount
// ซึ่งเป็นจำนวนที่แจ้งไว้ตอนจองและคิดราคาไปแล้ว) เก็บราคาต่อหน่วย ณ ตอนบันทึกไว้ด้วยกันราคากลาง
// เปลี่ยนในอนาคตแล้วกระทบข้อมูลย้อนหลัง
model StallElectricExcessRecord {
  id             Int      @id @default(autoincrement())
  stallId        Int
  stallCode      String
  smallCount     Int      @default(0)
  largeCount     Int      @default(0)
  smallUnitPrice Float    @default(20)
  largeUnitPrice Float    @default(40)
  subtotal       Float    @default(0)
  note           String?  @db.Text
  recordedById   Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stall          Stall    @relation(fields: [stallId], references: [id], onDelete: Cascade)
  recordedBy     User     @relation(fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([stallId], map: "StallElectricExcessRecord_stallId_fkey")
  @@index([recordedById], map: "StallElectricExcessRecord_recordedById_fkey")
}

// สถานะ "ตรวจสอบแล้ว" ตอนเดินตรวจตลาด เก็บเป็น event log เหมือน StallElectricExcessRecord
// (เร็คอร์ดล่าสุดต่อ stallId คือสถานะปัจจุบัน) เพื่อเก็บประวัติการติ๊ก/เอาออกไว้ด้วย ไม่เขียนทับ record เดิมที่มีอยู่แล้ว
model StallInspectionCheckRecord {
  id           Int      @id @default(autoincrement())
  stallId      Int
  stallCode    String
  isInspected  Boolean  @default(false)
  recordedById Int
  createdAt    DateTime @default(now())

  stall        Stall    @relation(fields: [stallId], references: [id], onDelete: Cascade)
  recordedBy   User     @relation(fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([stallId], map: "StallInspectionCheckRecord_stallId_fkey")
  @@index([recordedById], map: "StallInspectionCheckRecord_recordedById_fkey")
}

// การ "ส่งงาน" ตรวจตลาดรายวัน แยกตามพนักงานแต่ละคน — เป็นแค่หลักฐาน/สรุปยอด ณ เวลาที่ส่ง
// ไม่ใช่ hard lock (StallInspectionCheckRecord ยังแก้ไขได้ตามหน้าต่าง 24 ชม. ปกติ แม้ส่งงานไปแล้ว)
model DailyInspectionSubmission {
  id             Int      @id @default(autoincrement())
  submissionDate DateTime
  submittedById  Int
  inspectedCount Int
  totalCount     Int
  createdAt      DateTime @default(now())

  submittedBy    User     @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  @@unique([submissionDate, submittedById])
  @@index([submittedById], map: "DailyInspectionSubmission_submittedById_fkey")
}

// หัวข้อปัญหาที่พบตอนตรวจตลาด (ไม่มาขาย/ปล่อยเช่าช่วง/ไปเปิดท้ายหรือขายอื่น/ขายไม่ตรง + หมายเหตุปัญหาอื่นๆ)
// เก็บเป็น event log เหมือน StallInspectionCheckRecord (เร็คอร์ดล่าสุดต่อ stallId คือค่าปัจจุบัน)
// บันทึกทุก field พร้อมกันทุกครั้งที่มีการแก้ไข (ไม่แยกเป็นรายฟิลด์) เพื่อให้เร็คอร์ดล่าสุดสมบูรณ์เสมอ
model StallIssueRecord {
  id             Int      @id @default(autoincrement())
  stallId        Int
  stallCode      String
  noShow         Boolean  @default(false)
  sublease       Boolean  @default(false)
  otherMarket    Boolean  @default(false)
  wrongSeller    Boolean  @default(false)
  otherIssueNote String?  @db.Text
  recordedById   Int
  createdAt      DateTime @default(now())

  stall          Stall    @relation(fields: [stallId], references: [id], onDelete: Cascade)
  recordedBy     User     @relation(fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([stallId], map: "StallIssueRecord_stallId_fkey")
  @@index([recordedById], map: "StallIssueRecord_recordedById_fkey")
}

// เช็คลิสต์ตรวจสอบคุณภาพร้านค้า (ความสะอาด/สุขอนามัย) — เฉพาะร้านค้าประเภทอาหาร
// itemResults เก็บผลราย 17 ข้อเป็น JSON เดียว (คีย์ = item id เช่น "1.1", ค่า = true/false)
// เพราะเช็คลิสต์เป็น config คงที่ในโค้ด (utils/cleanlinessChecklist.js) ไม่ต้อง query แยกรายข้อที่ไหนอีก
// event log แบบเดียวกับ StallIssueRecord — สร้างแถวใหม่ทุกครั้งที่บันทึก แถวล่าสุด = ค่าปัจจุบัน
model StallCleanlinessInspection {
  id            Int      @id @default(autoincrement())
  stallId       Int
  stallCode     String
  itemResults   Json
  overallPassed Boolean
  note          String?  @db.Text
  recordedById  Int
  createdAt     DateTime @default(now())

  stall         Stall    @relation(fields: [stallId], references: [id], onDelete: Cascade)
  recordedBy    User     @relation(fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([stallId], map: "StallCleanlinessInspection_stallId_fkey")
  @@index([recordedById], map: "StallCleanlinessInspection_recordedById_fkey")
}

model ProductType {
  id           Int             @id @default(autoincrement())
  code         ProductTypeCode @unique
  name         String
  displayOrder Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sellers      Seller[]
  zones        ZoneProductType[]
}

model Seller {
  id            Int              @id @default(autoincrement())
  userId        Int              @unique
  productTypeId Int?
  shopName      String?
  productDetail String?          @db.Text
  productImage  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productType   ProductType?     @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  bookings      Booking[]        @relation("SellerBookings")
  bookingRequests BookingRequest[]

  @@index([productTypeId], map: "Seller_productTypeId_fkey")
}

model ZoneProductType {
  id            Int         @id @default(autoincrement())
  zoneId        Int
  productTypeId Int
  zone          Zone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@unique([zoneId, productTypeId])
  @@index([zoneId], map: "ZoneProductType_zoneId_fkey")
  @@index([productTypeId], map: "ZoneProductType_productTypeId_fkey")
}

model ElectricDevice {
  id             Int      @id @default(autoincrement())
  deviceName     String
  defaultDailyFee Float   @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bookingItems   BookingElectricDevice[]

  @@unique([deviceName])
}

model BookingItem {
  id               Int      @id @default(autoincrement())
  bookingId        Int
  stallId          Int
  priceBasePerDay  Float    @default(0)
  priceExtraPerDay Float    @default(0)
  days             Int      @default(1)
  subtotal         Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  stall            Stall    @relation(fields: [stallId], references: [id], onDelete: Restrict)

  @@index([bookingId], map: "BookingItem_bookingId_fkey")
  @@index([stallId], map: "BookingItem_stallId_fkey")
}

model BookingElectricDevice {
  id         Int      @id @default(autoincrement())
  bookingId  Int
  deviceId   Int
  quantity   Int      @default(0)
  dailyFee   Float    @default(0)
  days       Int      @default(1)
  subtotal   Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  device     ElectricDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([bookingId], map: "BookingElectricDevice_bookingId_fkey")
  @@index([deviceId], map: "BookingElectricDevice_deviceId_fkey")
}

model StallPriceRule {
  id          Int               @id @default(autoincrement())
  stallId     Int
  ruleType    StallPriceRuleType
  extraAmount Float             @default(0)
  note        String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  stall       Stall             @relation(fields: [stallId], references: [id], onDelete: Cascade)

  @@index([stallId], map: "StallPriceRule_stallId_fkey")
}

model CommunityBanner {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// โปรไฟล์ผู้เสียภาษีสำหรับออกใบกำกับภาษี — แยกจากข้อมูลผู้จอง (User/SellerApplication) เพราะนามที่ขอ
// ออกใบกำกับภาษีมักเป็นคนละนามกับคนจอง (เช่น จองในนามตัวเอง ขอใบกำกับภาษีในนามบริษัท)
// 1 user มีได้หลายโปรไฟล์ เผื่อขอในนามบริษัทคนละอันในแต่ละครั้ง reuse ได้ไม่ต้องกรอกซ้ำ
model TaxInvoiceProfile {
  id           Int      @id @default(autoincrement())
  userId       Int
  taxpayerType TaxpayerType @default(COMPANY)
  taxpayerName String
  taxId        String
  branch       String?  // สำนักงานใหญ่ / สาขาเลขที่... (บังคับตามกฎหมายถ้าเป็นนิติบุคคล)
  address      String   @db.Text
  phoneNumber  String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests     TaxInvoiceRequest[]

  @@index([userId], map: "TaxInvoiceProfile_userId_fkey")
}

// คำขอใบกำกับภาษี 1 คำขอ = 1 เอกสาร รวมได้หลายใบเสนอราคา (BookingRequest) — ต่างจากใบเสนอราคาที่
// gen อัตโนมัติทันทีที่ยืนยันสลิป ใบกำกับภาษีต้องมีคนขอเข้ามาก่อน แอดมินเป็นคนกรอก/ยืนยันข้อมูลแล้วออกจริง
model TaxInvoiceRequest {
  id                  Int      @id @default(autoincrement())
  taxInvoiceProfileId Int
  requestedByUserId   Int
  status              TaxInvoiceStatus @default(PENDING)
  documentNumber      String?  @unique
  requestedAt         DateTime @default(now())
  issuedAt            DateTime?
  issuedByName        String?
  rejectReason        String?  @db.Text
  // ชี้ไปคำขอเดิมที่ถูกยกเลิกเมื่อออกใหม่แทน (แก้ข้อมูลผิดหลังออกไปแล้ว) — เก็บไว้ไล่ประวัติทั้งสายเพื่อตรวจสอบภาษีย้อนหลัง
  replacesRequestId   Int?     @unique
  createdAt           DateTime @default(now())

  taxInvoiceProfile   TaxInvoiceProfile @relation(fields: [taxInvoiceProfileId], references: [id], onDelete: Restrict)
  requestedBy         User     @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  replaces            TaxInvoiceRequest? @relation("TaxInvoiceReissue", fields: [replacesRequestId], references: [id], onDelete: SetNull)
  replacedBy          TaxInvoiceRequest? @relation("TaxInvoiceReissue")
  items               TaxInvoiceRequestItem[]

  @@index([taxInvoiceProfileId], map: "TaxInvoiceRequest_taxInvoiceProfileId_fkey")
  @@index([requestedByUserId], map: "TaxInvoiceRequest_requestedByUserId_fkey")
}

// ตัวเชื่อม many-to-many ระหว่างคำขอใบกำกับภาษีกับใบเสนอราคา (BookingRequest) ที่รวมอยู่ในคำขอนั้น
// ไม่เก็บยอดเงินซ้ำที่นี่ — คำนวณสดจาก BookingRequest/Booking ผ่าน buildQuotationData เสมอ (เหมือนใบเสนอราคา)
model TaxInvoiceRequestItem {
  id                  Int      @id @default(autoincrement())
  taxInvoiceRequestId Int
  bookingRequestId    Int
  taxInvoiceRequest   TaxInvoiceRequest @relation(fields: [taxInvoiceRequestId], references: [id], onDelete: Cascade)
  bookingRequest      BookingRequest    @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  @@unique([taxInvoiceRequestId, bookingRequestId])
  @@index([bookingRequestId], map: "TaxInvoiceRequestItem_bookingRequestId_fkey")
}

enum TaxpayerType {
  INDIVIDUAL
  COMPANY
}

enum TaxInvoiceStatus {
  PENDING
  ISSUED
  CANCELLED
}

enum Role {
  ADMIN
  STAFF
  SELLER
  CUSTOMER
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
  SUCCESS
}

enum Zone_productCategory {
  FASHION
  FOOD
  EVENT_BOOTH
}

enum ProductTypeCode {
  FASHION
  FOOD
  EVENT_BOOTH
}

// แจ้งเตือนในระบบที่แอดมินกด "แจ้งเตือนร้านค้า" ให้ผู้เช่าล็อกที่ใกล้หมดสัญญา (ควบคู่กับอีเมล) — ไม่ผูก FK
// การ์ดฝั่งผู้ขายแสดงเมื่อ bookingEndDate ตรงกับวันหมดสัญญาปัจจุบันของล็อกนั้น ต่อสัญญาแล้วการ์ดหายเอง
model StallRenewalNotice {
  id             Int      @id @default(autoincrement())
  stallCode      String
  userId         Int
  bookingEndDate DateTime
  createdAt      DateTime @default(now())

  @@index([userId])
}

enum StallPriceRuleType {
  PINK
  YELLOW
  BLUE
}

enum StallInventoryStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
}
