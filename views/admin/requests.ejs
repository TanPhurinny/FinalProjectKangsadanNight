<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Repair Requests | Kangsadan Night Market</title>
    
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/requests.css">

    <style>
        /* สไตล์เพิ่มเติมเพื่อให้เข้ากับหน้า Dashboard ที่คุณส่งมา */
        :root {
            --primary-color: #A73B24;
            --secondary-color: #1a1a2e;
        }
        
        /* ปรับแต่ง Badge สถานะ */
        .badge-status {
            padding: 7px 15px;
            border-radius: 10px;
            font-size: 0.85rem;
            font-weight: 500;
            display: inline-block;
        }
        .status-pending { background-color: rgba(241, 196, 15, 0.1); color: #d97706; border: 1px solid rgba(241, 196, 15, 0.2); }
        .status-in_progress { background-color: rgba(52, 152, 219, 0.1); color: #2563eb; border: 1px solid rgba(52, 152, 219, 0.2); }
        .status-success { background-color: rgba(46, 204, 113, 0.1); color: #059669; border: 1px solid rgba(46, 204, 113, 0.2); }
        
        .x-small { font-size: 0.75rem; }
        .category-pill {
            background: #f8f9fa;
            border: 1px solid #e2e8f0;
            padding: 4px 12px;
            border-radius: 8px;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="dashboard-container">
        
        <header class="d-flex justify-content-between align-items-end mb-5">
            <div>
                <h1 class="fw-bold mb-1">Repair Requests</h1>
                <p class="text-muted mb-0">ศูนย์จัดการคำร้องและติดตามสถานะการซ่อมบำรุง</p>
            </div>
            <div class="text-end">
                <% if (user.role === 'SELLER') { %>
                    <button class="btn btn-manage px-4" data-bs-toggle="modal" data-bs-target="#requestModal">
                        <i class="fas fa-plus me-2"></i>สร้างคำร้องใหม่
                    </button>
                <% } else { %>
                    <div class="badge bg-white text-dark shadow-sm p-2 px-3 rounded-pill border">
                        <i class="far fa-calendar-alt me-2 text-primary"></i>
                        <span id="live-date">กำลังโหลดวันที่...</span>
                    </div>
                <% } %>
            </div>
        </header>

        <div class="stat-grid mb-5">
            <div class="stat-card">
                <div class="icon-box" style="background: rgba(241, 196, 15, 0.1); color: var(--warning);">
                    <i class="fas fa-hourglass-half"></i>
                </div>
                <div>
                    <small class="text-muted d-block">รอรับเรื่อง</small>
                    <h3 class="fw-bold mb-0">
                        <%= (locals.requests) ? requests.filter(r => r.status === 'PENDING').length : 0 %> 
                        <small class="fs-6 fw-normal">รายการ</small>
                    </h3>
                </div>
            </div>

            <div class="stat-card">
                <div class="icon-box" style="background: rgba(52, 152, 219, 0.1); color: #3498db;">
                    <i class="fas fa-tools"></i>
                </div>
                <div>
                    <small class="text-muted d-block">กำลังดำเนินการ</small>
                    <h3 class="fw-bold mb-0">
                        <%= (locals.requests) ? requests.filter(r => r.status === 'IN_PROGRESS').length : 0 %> 
                        <small class="fs-6 fw-normal">รายการ</small>
                    </h3>
                </div>
            </div>

            <div class="stat-card">
                <div class="icon-box" style="background: rgba(46, 204, 113, 0.1); color: var(--success);">
                    <i class="fas fa-check-double"></i>
                </div>
                <div>
                    <small class="text-muted d-block">เสร็จสิ้นแล้ว</small>
                    <h3 class="fw-bold mb-0">
                        <%= (locals.requests) ? requests.filter(r => r.status === 'SUCCESS').length : 0 %> 
                        <small class="fs-6 fw-normal">รายการ</small>
                    </h3>
                </div>
            </div>
        </div>

        <div class="zone-section shadow-sm border-0">
            <div class="zone-header">
                <div class="d-flex align-items-center gap-3">
                    <i class="fas fa-clipboard-list fs-4"></i>
                    <div>
                        <h5 class="mb-0 fw-bold">รายการคำร้องทั้งหมด</h5>
                        <small class="opacity-75">ตารางสรุปปัญหาและสถานะการแก้ไข</small>
                    </div>
                </div>
            </div>
            <div class="zone-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="text-muted small">
                                <th class="ps-4 py-3">พื้นที่ / ผู้แจ้ง</th>
                                <th class="py-3">หมวดหมู่</th>
                                <th class="py-3">รายละเอียด</th>
                                <th class="py-3 text-center">สถานะปัจจุบัน</th>
                                <th class="py-3 text-end pe-4">การจัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (locals.requests && requests.length > 0) { %>
                                <% requests.forEach(function(req) { %>
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark"><%= req.location %></div>
                                            <div class="x-small text-muted">โดย: <%= req.user ? req.user.name : 'ไม่ระบุ' %></div>
                                        </td>
                                        <td>
                                            <span class="category-pill">
                                                <i class="fas fa-wrench me-1 text-primary small"></i> <%= req.category %>
                                            </span>
                                        </td>
                                        <td>
                                            <div class="small text-dark fw-medium text-wrap" style="max-width: 250px;"><%= req.description %></div>
                                            <div class="x-small text-muted mt-1">
                                                <i class="far fa-clock me-1"></i><%= new Date(req.createdAt).toLocaleString('th-TH') %>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge-status status-<%= req.status.toLowerCase() %>">
                                                <%= req.status === 'PENDING' ? 'รอรับเรื่อง' : req.status === 'IN_PROGRESS' ? 'กำลังดำเนินการ' : 'เสร็จสิ้น' %>
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <% if (user.role === 'ADMIN' || user.role === 'STAFF') { %>
                                                <div class="d-flex justify-content-end gap-2">
                                                    <% if (req.status === 'PENDING') { %>
                                                        <form action="/admin/requests/update-status" method="POST">
                                                            <input type="hidden" name="id" value="<%= req.id %>">
                                                            <input type="hidden" name="status" value="IN_PROGRESS">
                                                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3">รับเรื่อง</button>
                                                        </form>
                                                    <% } else if (req.status === 'IN_PROGRESS') { %>
                                                        <form action="/admin/requests/update-status" method="POST">
                                                            <input type="hidden" name="id" value="<%= req.id %>">
                                                            <input type="hidden" name="status" value="SUCCESS">
                                                            <button class="btn btn-sm btn-success rounded-pill px-3 text-white">ปิดงาน</button>
                                                        </form>
                                                    <% } else { %>
                                                        <span class="text-success small fw-bold"><i class="fas fa-check-circle me-1"></i>ปิดงานแล้ว</span>
                                                    <% } %>
                                                </div>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <i class="fas fa-inbox fa-3x text-light mb-3"></i>
                                        <p class="text-muted">ไม่พบข้อมูลคำร้องแจ้งซ่อมในขณะนี้</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        // แสดงวันที่ปัจจุบัน
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        const liveDate = document.getElementById('live-date');
        if (liveDate) liveDate.innerHTML = new Date().toLocaleDateString('th-TH', options);
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>