<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>การแจ้งคำร้อง (แจ้งซ่อม) | Kangsadan Night Market</title>
        <link rel="icon" type="image/png" href="/img/Logo.png">

        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css"
            rel="stylesheet">
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
            rel="stylesheet">
        <link
            href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
            rel="stylesheet">

        <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260711-5">
        <link rel="stylesheet" href="/stylesheets/admin/theme.css">
        <link rel="stylesheet" href="/stylesheets/admin/requests.css">
        <link rel="stylesheet" href="/stylesheets/responsive.css">
    </head>
    <body>
        <%- include('../partials/navbar') %>

        <header class="site-header">
            <a href="javascript:history.back()" class="btn-back"><i
                    class="fa-solid fa-arrow-left"></i></a>
            <h2 class="header-title">การแจ้งคำร้อง (แจ้งซ่อม)</h2>
            <div class="header-spacer"></div>
        </header>

        <div class="container requests-layout py-4">
            <%
            const bookingList = Array.isArray(requests) ? requests : [];
            const rStats = {
            pending: (typeof counts !== 'undefined' && counts) ? counts.pending : bookingList.filter(r => r.status === 'PENDING').length,
            inProgress: (typeof counts !== 'undefined' && counts) ? counts.inProgress : bookingList.filter(r => r.status === 'IN_PROGRESS').length,
            success: (typeof counts !== 'undefined' && counts) ? counts.success : bookingList.filter(r => r.status === 'SUCCESS').length,
            rejected: (typeof counts !== 'undefined' && counts) ? counts.rejected : bookingList.filter(r => r.status === 'REJECTED').length,
            total: (typeof counts !== 'undefined' && counts) ? counts.all : bookingList.length
            };
            %>

            <section class="requests-hero mb-4">
                <div></div>
                <div class="hero-meta">
                    <div class="meta-chip">
                        <i class="far fa-calendar-alt me-2"></i><span
                            id="live-date"></span>
                    </div>
                    <div class="meta-chip strong">ทั้งหมด <span
                            id="totalVisibleCount"><%= rStats.total %></span>
                        รายการ</div>
                </div>
            </section>

            <% if (success) { %>
            <div class="alert alert-success">
                <i
                    class="fas fa-circle-check me-2"></i>อัปเดตสถานะคำร้องเรียบร้อยแล้ว
            </div>
            <% } %>
            <% if (error) { %>
            <div class="alert alert-danger">
                <i
                    class="fas fa-triangle-exclamation me-2"></i>เกิดข้อผิดพลาดในการอัปเดตคำร้อง
            </div>
            <% } %>

            <section class="row g-3 mb-4">
                <div class="col-6 col-lg-3">
                    <div class="summary-card is-pending">
                        <div class="summary-icon"><i
                                class="fas fa-hourglass-half"></i></div>
                        <div class="summary-content">
                            <small>รอรับเรื่อง</small>
                            <h3><%= rStats.pending %></h3>
                            <p class="summary-note">คำร้องแจ้งซ่อมที่รอดำเนินการ</p>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="summary-card is-progressing">
                        <div class="summary-icon"><i
                                class="fas fa-screwdriver-wrench"></i></div>
                        <div class="summary-content">
                            <small>กำลังดำเนินการ</small>
                            <h3><%= rStats.inProgress %></h3>
                            <p class="summary-note">งานซ่อมที่กำลังดำเนินการอยู่</p>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="summary-card is-done">
                        <div class="summary-icon"><i
                                class="fas fa-circle-check"></i></div>
                        <div class="summary-content">
                            <small>ซ่อมเสร็จแล้ว</small>
                            <h3><%= rStats.success %></h3>
                            <p class="summary-note">งานซ่อมที่เสร็จสิ้นแล้ว</p>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="summary-card is-total">
                        <div class="summary-icon"><i
                                class="fas fa-layer-group"></i></div>
                        <div class="summary-content">
                            <small>คำร้องทั้งหมด</small>
                            <h3><%= rStats.total %></h3>
                            <p class="summary-note">ภาพรวมคำร้องแจ้งซ่อมทั้งหมด</p>
                        </div>
                    </div>
                </div>
            </section>

            <section class="controls-bar mb-3">
                <div class="controls-left">
                    <div class="input-group search-group">
                        <span class="input-group-text"><i
                                class="fas fa-search"></i></span>
                        <input type="text" id="searchInput" class="form-control"
                            placeholder="ค้นหาจากพื้นที่ ผู้แจ้ง หรือเบอร์โทร">
                    </div>
                </div>
                <div class="controls-right" role="group"
                    aria-label="ตัวกรองสถานะ">
                    <button class="status-filter active"
                        data-filter="ALL">ทั้งหมด</button>
                    <button class="status-filter"
                        data-filter="PENDING">รอรับเรื่อง</button>
                    <button class="status-filter"
                        data-filter="IN_PROGRESS">กำลังดำเนินการ</button>
                    <button class="status-filter"
                        data-filter="SUCCESS">ซ่อมเสร็จแล้ว</button>
                    <button class="status-filter"
                        data-filter="REJECTED">ปฏิเสธ</button>
                </div>
            </section>

            <section class="desktop-view d-none d-lg-block">
                <div class="card shadow-sm overflow-hidden">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">พื้นที่ / ปัญหา</th>
                                    <th>ผู้แจ้ง</th>
                                    <th>รายละเอียด</th>
                                    <th class="text-center">สถานะ</th>
                                    <th class="text-end pe-4">การจัดการ</th>
                                </tr>
                            </thead>
                            <tbody id="requestsTableBody">
                                <% if (bookingList.length > 0) {
                                %>
                                <% bookingList.forEach(function(req) { %>
                                <tr class="request-row"
                                    data-status="<%= req.status %>"
                                    data-search="<%= `${req.location} ${req.category} ${req.sellerName} ${req.phone}`.toLowerCase() %>">
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark"><%= req.location %></div>
                                        <div class="small text-muted"><%= req.category %></div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark"><%= req.sellerName %></div>
                                        <div class="small text-muted"><%= req.phone %></div>
                                    </td>
                                    <td>
                                        <div class="desc-wrap"><%= req.description %></div>
                                        <div class="small text-muted mt-1">
                                            <i class="far fa-clock me-1"></i><%=
                                            req.createdAtText
                                            %>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span
                                            class="badge <%= req.status === 'PENDING' ? 'bg-warning text-dark' : req.status === 'IN_PROGRESS' ? 'bg-info text-dark' : req.status === 'SUCCESS' ? 'bg-success' : req.status === 'REJECTED' ? 'bg-danger' : 'bg-secondary' %>">
                                            <%= req.statusLabel %>
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button"
                                            class="btn btn-outline-secondary btn-sm me-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#requestDetailModal"
                                            data-location="<%= req.location %>"
                                            data-requester="<%= req.sellerName %>"
                                            data-category="<%= req.category %>"
                                            data-description="<%= req.description %>"
                                            data-date="<%= req.createdAtText %>"
                                            data-status="<%= req.status %>"
                                            data-status-label="<%= req.statusLabel %>"
                                            data-image="<%= req.image || '' %>"
                                            title="ดูรายละเอียด">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <% if (user.role === 'ADMIN' ||
                                        user.role === 'STAFF') { %>
                                        <% if (req.status === 'PENDING') { %>
                                        <form
                                            action="/admin/requests/update-status"
                                            method="POST" class="d-inline">
                                            <input type="hidden" name="id"
                                                value="<%= req.id %>">
                                            <input type="hidden" name="status"
                                                value="IN_PROGRESS">
                                            <button
                                                class="btn btn-outline-primary btn-sm action-btn">รับเรื่อง</button>
                                        </form>
                                        <form
                                            action="/admin/requests/update-status"
                                            method="POST" class="d-inline">
                                            <input type="hidden" name="id"
                                                value="<%= req.id %>">
                                            <input type="hidden" name="status"
                                                value="REJECTED">
                                            <button
                                                class="btn btn-danger btn-sm action-btn">ปฏิเสธ</button>
                                        </form>
                                        <% } else if (req.status === 'IN_PROGRESS') { %>
                                        <form
                                            action="/admin/requests/update-status"
                                            method="POST" class="d-inline">
                                            <input type="hidden" name="id"
                                                value="<%= req.id %>">
                                            <input type="hidden" name="status"
                                                value="SUCCESS">
                                            <button
                                                class="btn btn-outline-success btn-sm action-btn">ซ่อมเสร็จแล้ว</button>
                                        </form>
                                        <form
                                            action="/admin/requests/update-status"
                                            method="POST" class="d-inline">
                                            <input type="hidden" name="id"
                                                value="<%= req.id %>">
                                            <input type="hidden" name="status"
                                                value="REJECTED">
                                            <button
                                                class="btn btn-danger btn-sm action-btn">ปฏิเสธ</button>
                                        </form>
                                        <% } else { %>
                                        <span
                                            class="badge bg-light text-dark border">ไม่มีการดำเนินการเพิ่มเติม</span>
                                        <% } %>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }); %>
                                <% } else { %>
                                <tr id="emptyTableRow">
                                    <td colspan="5"
                                        class="text-center py-5 text-muted">
                                        <i
                                            class="fas fa-inbox fa-3x opacity-25 d-block mb-3"></i>
                                        ไม่พบคำร้องแจ้งซ่อมในขณะนี้
                                    </td>
                                </tr>
                                <% } %>
                                <tr id="emptyFilteredTableRow" class="d-none">
                                    <td colspan="5"
                                        class="text-center py-5 text-muted">
                                        <i
                                            class="fas fa-filter fa-2x opacity-25 d-block mb-3"></i>
                                        ไม่พบคำร้องที่ตรงกับการค้นหา/ตัวกรอง
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="mobile-view d-lg-none" id="requestsCardList">
                <% if (bookingList.length > 0) { %>
                <% bookingList.forEach(function(req) { %>
                <article class="request-card"
                    data-status="<%= req.status %>"
                    data-search="<%= `${req.location} ${req.category} ${req.sellerName} ${req.phone}`.toLowerCase() %>">
                    <div class="request-card-head">
                        <div>
                            <h6 class="mb-1 fw-bold"><%= req.location %></h6>
                            <small class="text-muted"><%= req.category %></small>
                        </div>
                        <span
                            class="badge <%= req.status === 'PENDING' ? 'bg-warning text-dark' : req.status === 'IN_PROGRESS' ? 'bg-info text-dark' : req.status === 'SUCCESS' ? 'bg-success' : req.status === 'REJECTED' ? 'bg-danger' : 'bg-secondary' %>">
                            <%= req.statusLabel %>
                        </span>
                    </div>

                    <div class="mb-2">
                        <span class="badge bg-light text-dark border"><i
                                class="fas fa-user me-1"></i><%= req.sellerName
                            %></span>
                    </div>

                    <p class="small mb-2"><%= req.description %></p>
                    <p class="small mb-2">เบอร์โทร: <%= req.phone %></p>
                    <div class="small text-muted mb-3"><i
                            class="far fa-clock me-1"></i><%= req.createdAtText %></div>

                    <button type="button"
                        class="btn btn-outline-secondary btn-sm w-100 mb-2"
                        data-bs-toggle="modal"
                        data-bs-target="#requestDetailModal"
                        data-location="<%= req.location %>"
                        data-requester="<%= req.sellerName %>"
                        data-category="<%= req.category %>"
                        data-description="<%= req.description %>"
                        data-date="<%= req.createdAtText %>"
                        data-status="<%= req.status %>"
                        data-status-label="<%= req.statusLabel %>"
                        data-image="<%= req.image || '' %>">
                        <i class="fas fa-eye me-1"></i>ดูรายละเอียด
                    </button>

                    <% if (user.role === 'ADMIN' || user.role === 'STAFF') { %>
                    <div class="d-flex gap-2">
                        <% if (req.status === 'PENDING') { %>
                        <form action="/admin/requests/update-status"
                            method="POST" class="flex-grow-1">
                            <input type="hidden" name="id"
                                value="<%= req.id %>">
                            <input type="hidden" name="status"
                                value="IN_PROGRESS">
                            <button
                                class="btn btn-outline-primary w-100 action-btn">รับเรื่อง</button>
                        </form>
                        <form action="/admin/requests/update-status"
                            method="POST" class="flex-grow-1">
                            <input type="hidden" name="id"
                                value="<%= req.id %>">
                            <input type="hidden" name="status" value="REJECTED">
                            <button
                                class="btn btn-outline-danger w-100 action-btn">ปฏิเสธ</button>
                        </form>
                        <% } else if (req.status === 'IN_PROGRESS') { %>
                        <form action="/admin/requests/update-status"
                            method="POST" class="flex-grow-1">
                            <input type="hidden" name="id"
                                value="<%= req.id %>">
                            <input type="hidden" name="status" value="SUCCESS">
                            <button
                                class="btn btn-outline-success w-100 action-btn">ซ่อมเสร็จแล้ว</button>
                        </form>
                        <form action="/admin/requests/update-status"
                            method="POST" class="flex-grow-1">
                            <input type="hidden" name="id"
                                value="<%= req.id %>">
                            <input type="hidden" name="status" value="REJECTED">
                            <button
                                class="btn btn-outline-danger w-100 action-btn">ปฏิเสธ</button>
                        </form>
                        <% } else { %>
                        <span
                            class="badge bg-success-subtle text-success-emphasis border px-3 py-2">ดำเนินการแล้ว</span>
                        <% } %>
                    </div>
                    <% } %>
                </article>
                <% }); %>
                <% } else { %>
                <div id="emptyCardRow" class="text-center py-5 text-muted">
                    <i class="fas fa-inbox fa-3x opacity-25 d-block mb-3"></i>
                    ไม่พบคำร้องแจ้งซ่อมในขณะนี้
                </div>
                <% } %>
                <div id="emptyFilteredCardRow"
                    class="text-center py-5 text-muted d-none">
                    <i class="fas fa-filter fa-2x opacity-25 d-block mb-3"></i>
                    ไม่พบคำร้องที่ตรงกับการค้นหา/ตัวกรอง
                </div>
            </section>
        </div>

        <div class="modal fade" id="requestDetailModal" tabindex="-1"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border">
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold"><i
                                class="fas fa-screwdriver-wrench me-2"></i>รายละเอียดคำร้องแจ้งซ่อม</h5>
                        <button type="button" class="btn-close"
                            data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="detailImageWrap" class="text-center mb-3 d-none">
                            <img id="detailImage" src="" alt="รูปแจ้งซ่อม"
                                class="img-fluid"
                                style="max-height: 320px; cursor: zoom-in;"
                                title="คลิกเพื่อดูรูปขนาดเต็ม">
                        </div>
                        <div id="detailImageEmpty"
                            class="text-center text-muted mb-3 d-none">
                            <i
                                class="fas fa-image fa-3x opacity-25 d-block mb-2"></i>ไม่มีรูปภาพแนบ
                        </div>
                        <dl class="row mb-0">
                            <dt class="col-4 text-muted">พื้นที่</dt>
                            <dd class="col-8" id="detailLocation"></dd>
                            <dt class="col-4 text-muted">ผู้แจ้ง</dt>
                            <dd class="col-8" id="detailRequester"></dd>
                            <dt class="col-4 text-muted">หมวดหมู่</dt>
                            <dd class="col-8" id="detailCategory"></dd>
                            <dt class="col-4 text-muted">รายละเอียด</dt>
                            <dd class="col-8" id="detailDescription"
                                style="white-space: pre-wrap;"></dd>
                            <dt class="col-4 text-muted">วันที่แจ้ง</dt>
                            <dd class="col-8" id="detailDate"></dd>
                            <dt class="col-4 text-muted">สถานะ</dt>
                            <dd class="col-8"><span class="badge"
                                    id="detailStatusBadge"></span></dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <script
            src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
        <script src="/js/admin/requests.js"></script>
    </body>
</html>