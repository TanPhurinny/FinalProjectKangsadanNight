<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Market Intelligence | Dashboard</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/admin/dashboard.css">
      <link rel="stylesheet" href="/stylesheets/partials/navbar.css">
    <link rel="stylesheet" href="/stylesheets/admin/dashboard.css">
    <link rel="stylesheet" href="/stylesheets/admin/requests.css">

</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container-fluid py-4 px-md-5">
        <header class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h1 class="fw-bold mb-1">Market Overview</h1>
                <p class="text-muted">วิเคราะห์โครงสร้างและประสิทธิภาพการดำเนินงานตลาด</p>
            </div>
            <div id="live-date" class="text-muted small"></div>
        </header>

        <div class="row g-3 mb-5">
            <% 
                const dStats = locals.stats || { unpaidCount: 0, occupiedCount: 0, totalSlots: 0, pendingRepairs: 0 }; 
                const occupancyRate = dStats.totalSlots > 0 ? ((dStats.occupiedCount / dStats.totalSlots) * 100).toFixed(1) : 0;
            %>
            
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-3 h-100">
                    <div class="d-flex align-items-center">
                        <div class="rounded-3 p-3 me-3" style="background: rgba(46, 204, 113, 0.1); color: #2ecc71;">
                            <i class="fas fa-chart-pie fa-2x"></i>
                        </div>
                        <div>
                            <small class="text-muted">ประสิทธิภาพการเช่า</small>
                            <h3 class="fw-bold mb-0"><%= occupancyRate %>%</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-3 h-100">
                    <div class="d-flex align-items-center">
                        <div class="rounded-3 p-3 me-3" style="background: rgba(52, 152, 219, 0.1); color: #3498db;">
                            <i class="fas fa-users fa-2x"></i>
                        </div>
                        <div>
                            <small class="text-muted">ผู้เช่าปัจจุบัน</small>
                            <h3 class="fw-bold mb-0"><%= dStats.occupiedCount %> <small class="fs-6 fw-normal">/ <%= dStats.totalSlots %></small></h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-3 h-100">
                    <div class="d-flex align-items-center">
                        <div class="rounded-3 p-3 me-3" style="background: rgba(231, 76, 60, 0.1); color: #e74c3c;">
                            <i class="fas fa-tools fa-2x"></i>
                        </div>
                        <div>
                            <small class="text-muted">งานซ่อมค้าง</small>
                            <h3 class="fw-bold mb-0 text-danger"><%= dStats.pendingRepairs %></h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <h4 class="fw-bold mb-4">สถานะพื้นที่รายโซน</h4>
        <div class="row g-4 mb-5">
            <% if (locals.zones && zones.length > 0) { %>
                <% zones.forEach(zone => { %>
                <div class="col-xl-6">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                        <div class="p-4 text-white d-flex justify-content-between" style="background-color: <%= zone.color %>;">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fas <%= zone.icon %> fs-3"></i>
                                <div>
                                    <h5 class="mb-0 fw-bold"><%= zone.name %></h5>
                                    <small class="opacity-75"><%= zone.description %></small>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-4 text-center">
                            <div class="row">
                                <div class="col-4 border-end">
                                    <small class="text-muted">แผงว่าง</small>
                                    <div class="fs-4 fw-bold text-success"><%= zone.available %></div>
                                </div>
                                <div class="col-4 border-end">
                                    <small class="text-muted">ค้างชำระ</small>
                                    <div class="fs-4 fw-bold text-danger"><%= zone.unpaid %></div>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted">งานซ่อม</small>
                                    <div class="fs-4 fw-bold text-warning"><%= zone.repairs %></div>
                                </div>
                            </div>
                            <a href="/admin/slots?zone=<%= zone.slug %>" class="btn btn-dark w-100 mt-4 py-2">ดูรายละเอียดแผง</a>
                        </div>
                    </div>
                </div>
                <% }) %>
            <% } %>
        </div>
    </div>

    <script>
        document.getElementById('live-date').innerText = `อัปเดตเมื่อ: ${new Date().toLocaleString('th-TH')}`;
    </script>
</body>
</html>