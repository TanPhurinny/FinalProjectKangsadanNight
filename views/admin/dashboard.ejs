<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Market Intelligence | Dashboard</title>
        <link rel="icon" type="image/png" href="/img/Logo.png">
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css"
            rel="stylesheet">
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
            rel="stylesheet">
        <link
            href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap"
            rel="stylesheet">
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260711-5">
        <link rel="stylesheet" href="/stylesheets/admin/theme.css">
        <link rel="stylesheet" href="/stylesheets/admin/dashboard.css">
        <link rel="stylesheet" href="/stylesheets/responsive.css">
    </head>
    <body class="bg-light">
        <%- include('../partials/navbar') %>

        <div class="container dashboard-shell py-4">
            <%
            const dStats = locals.stats || { totalStalls: 0, bookedStalls: 0,
            availableStalls: 0, maintenanceStalls: 0, pendingRepairs: 0,
            totalRepairs: 0, pendingRequests: 0, totalAnnouncements: 0,
            sellerCount: 0 };
            const occupancyRate = dStats.totalStalls > 0 ?
            ((dStats.bookedStalls / dStats.totalStalls) * 100).toFixed(1) : 0;
            const zoneList = locals.zones || [];
            %>

            <section class="db-hero mb-4">
                <div class="hero-main">

                    <div>
                        <h1 class="hero-title mb-2">
                            <i class="fas fa-chart-line me-2"></i>Market
                            Intelligence Dashboard
                        </h1>
                        <p
                            class="hero-subtitle mb-0">ภาพรวมการบริหารตลาดแบบเรียลไทม์
                            พร้อมปุ่มทางลัดและการวิเคราะห์โซน</p>
                    </div>
                </div>
                <div class="hero-side">
                    <div id="live-date" class="hero-date"></div>
                    <div class="hero-actions">
                        <a href="/admin/announcements" class="hero-btn"><i
                                class="fas fa-bullhorn"></i> ประกาศ</a>
                        <a href="/admin/approvals" class="hero-btn"><i
                                class="fas fa-file-signature"></i> อนุมัติ</a>
                        <a href="/admin/requests" class="hero-btn"><i
                                class="fas fa-tools"></i> ซ่อมบำรุง</a>
                        <a href="/admin/users" class="hero-btn"><i
                                class="fas fa-users-cog"></i> ผู้ใช้</a>
                    </div>
                </div>
            </section>

            <section class="row g-3 mb-4" id="kpiSection">
                <div class="col-6 col-lg-3">
                    <article class="kpi-card c-primary">
                        <div class="kpi-icon"><i
                                class="fas fa-chart-pie"></i></div>
                        <div class="kpi-label">แผงที่ถูกจอง</div>
                        <h3 class="kpi-value count-up"
                            data-target="<%= dStats.bookedStalls %>"><%=
                            dStats.bookedStalls
                            %></h3>
                        <small class="kpi-meta">จากทั้งหมด <%= dStats.totalStalls
                            %> แผง</small>
                    </article>
                </div>
                <div class="col-6 col-lg-3">
                    <article class="kpi-card c-success">
                        <div class="kpi-icon"><i
                                class="fas fa-door-open"></i></div>
                        <div class="kpi-label">แผงว่าง</div>
                        <h3 class="kpi-value count-up"
                            data-target="<%= dStats.availableStalls %>"><%=
                            dStats.availableStalls %></h3>
                        <small class="kpi-meta">พร้อมให้จองทันที</small>
                    </article>
                </div>
                <div class="col-6 col-lg-3">
                    <article class="kpi-card c-warning">
                        <div class="kpi-icon"><i
                                class="fas fa-file-circle-check"></i></div>
                        <div class="kpi-label">คำขออนุมัติ</div>
                        <h3 class="kpi-value count-up"
                            data-target="<%= dStats.pendingRequests %>"><%=
                            dStats.pendingRequests %></h3>
                        <small class="kpi-meta">รายการรอตรวจสอบ</small>
                    </article>
                </div>
                <div class="col-6 col-lg-3">
                    <article class="kpi-card c-info">
                        <div class="kpi-icon"><i
                                class="fas fa-screwdriver-wrench"></i></div>
                        <div class="kpi-label">งานซ่อมค้าง</div>
                        <h3 class="kpi-value count-up"
                            data-target="<%= dStats.pendingRepairs %>"><%=
                            dStats.pendingRepairs %></h3>
                        <small class="kpi-meta">ต้องดำเนินการ</small>
                    </article>
                </div>
            </section>

            <section class="row g-3 mb-4">
                <div class="col-lg-8">
                    <div class="insight-card h-100">
                        <div
                            class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="mb-0 fw-bold"><i
                                    class="fas fa-wave-square me-2"></i>สรุปการใช้งานผังตลาด</h5>
                            <span
                                class="badge rounded-pill text-bg-light">อัปเดตอัตโนมัติ</span>
                        </div>
                        <div class="progress-track mt-3">
                            <div class="progress-head">
                                <span>สัดส่วนแผงที่ถูกจอง</span>
                                <strong><%= occupancyRate %>%</strong>
                            </div>
                            <div class="progress">
                                <div class="progress-bar" role="progressbar"
                                    style="--occupancy: <%= occupancyRate %>;"
                                    aria-valuenow="<%= occupancyRate %>"
                                    aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                        <div class="quick-stats-grid mt-3">
                            <div class="mini-stat">
                                <span>แผงต้องซ่อมบำรุง</span>
                                <strong class="count-up"
                                    data-target="<%= dStats.maintenanceStalls %>"><%=
                                    dStats.maintenanceStalls %></strong>
                            </div>
                            <div class="mini-stat">
                                <span>ประกาศทั้งหมด</span>
                                <strong class="count-up"
                                    data-target="<%= dStats.totalAnnouncements %>"><%=
                                    dStats.totalAnnouncements %></strong>
                            </div>
                            <div class="mini-stat">
                                <span>งานซ่อมทั้งหมด</span>
                                <strong class="count-up"
                                    data-target="<%= dStats.totalRepairs %>"><%=
                                    dStats.totalRepairs %></strong>
                            </div>
                            <div class="mini-stat">
                                <span>ผู้ขายทั้งหมด</span>
                                <strong class="count-up"
                                    data-target="<%= dStats.sellerCount %>"><%=
                                    dStats.sellerCount %></strong>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="insight-card h-100">
                        <h5 class="mb-3 fw-bold"><i
                                class="fas fa-bolt me-2"></i>ทางลัดการจัดการ</h5>
                        <div class="d-grid gap-2 quick-links">
                            <a href="/admin/slots" class="quick-link-item"><i
                                    class="fas fa-map"></i> จัดการผังแผง</a>
                            <a href="/admin/approvals"
                                class="quick-link-item"><i
                                    class="fas fa-stamp"></i>
                                ตรวจใบขออนุมัติ</a>
                            <a href="/admin/requests" class="quick-link-item"><i
                                    class="fas fa-clipboard-check"></i>
                                อัปเดตสถานะงานซ่อม</a>
                            <a href="/admin/announcements"
                                class="quick-link-item"><i
                                    class="fas fa-bullhorn"></i>
                                เผยแพร่ประกาศใหม่</a>
                        </div>
                    </div>
                </div>
            </section>

            <section class="zone-panel mb-3">
                <div class="zone-panel-head">
                    <h3 class="fw-bold mb-0"><i
                            class="fas fa-map-marked-alt me-2"></i>สถานะพื้นที่รายโซน</h3>
                    <div class="zone-tools">
                        <div class="input-group">
                            <span class="input-group-text"><i
                                    class="fas fa-search"></i></span>
                            <input type="text" id="zoneSearchInput"
                                class="form-control" placeholder="ค้นหาโซน">
                        </div>
                        <select id="zoneSortSelect" class="form-select">
                            <option value="name-asc">เรียงตามโซน A-Z</option>
                            <option
                                value="available-desc">แผงว่างมากสุด</option>
                            <option
                                value="maintenance-desc">ต้องซ่อมบำรุงมากสุด</option>
                        </select>
                    </div>
                </div>
            </section>

            <section class="row g-4 mb-5" id="zonesGrid">
                <% zoneList.forEach((zone, index) => { %>
                <div class="col-lg-6 zone-col"
                    data-zone-name="<%= zone.name.toLowerCase() %>"
                    data-available="<%= zone.available || 0 %>"
                    data-maintenance="<%= zone.maintenance || 0 %>">
                    <div
                        class="zone-card <%= index % 4 === 0 ? 'primary' : index % 4 === 1 ? 'success' : index % 4 === 2 ? 'warning' : 'info' %>">
                        <div class="zone-card-header">
                            <div class="zone-header-content">
                                <i class="fas <%= zone.icon %> zone-icon"></i>
                                <div>
                                    <h5 class="zone-title"><%= zone.name %></h5>
                                    <small class="zone-description"><%=
                                        zone.description %> · <%= zone.total || 0
                                        %> แผง</small>
                                </div>
                            </div>
                        </div>
                        <div class="zone-card-body">
                            <div class="zone-stats">
                                <div class="stat-item">
                                    <div class="stat-icon available"><i
                                            class="fas fa-check-circle"></i></div>
                                    <small class="stat-label">แผงว่าง</small>
                                    <h4 class="stat-value count-up"
                                        data-target="<%= zone.available || 0 %>"><%=
                                        zone.available || 0 %></h4>
                                </div>
                                <div class="stat-item">
                                    <div class="stat-icon unpaid"><i
                                            class="fas fa-tag"></i></div>
                                    <small class="stat-label">ถูกจองแล้ว</small>
                                    <h4 class="stat-value count-up"
                                        data-target="<%= zone.booked || 0 %>"><%=
                                        zone.booked || 0 %></h4>
                                </div>
                                <div class="stat-item">
                                    <div class="stat-icon repairs"><i
                                            class="fas fa-wrench"></i></div>
                                    <small class="stat-label">ต้องซ่อมบำรุง</small>
                                    <h4 class="stat-value count-up"
                                        data-target="<%= zone.maintenance || 0 %>"><%=
                                        zone.maintenance || 0 %></h4>
                                </div>
                            </div>
                            <a href="/admin/slots" class="zone-btn">
                                ดูผังแผงทั้งหมด <i
                                    class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <% }) %>

                <div id="emptyFilteredZone" class="col-12 d-none">
                    <div class="empty-state py-5">
                        <div class="empty-state-icon"><i
                                class="fas fa-filter"></i></div>
                        <h4 class="fw-bold mb-2">ไม่พบโซนที่ตรงกับเงื่อนไข</h4>
                        <p
                            class="text-muted mb-0">ลองเปลี่ยนคำค้นหาหรือรูปแบบการเรียงใหม่</p>
                    </div>
                </div>
            </section>
        </div>

        <script
            src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
        <script src="/js/admin/dashboard.js"></script>
    </body>
</html>
