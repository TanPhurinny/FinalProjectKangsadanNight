<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>สัญญาเช่า #<%= request.id %> — Admin</title>
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20261023-ios">
    <link rel="stylesheet" href="/stylesheets/admin/theme.css">
    <link rel="stylesheet" href="/stylesheets/rentalStatement.css?v=20261026b">
    <link rel="stylesheet" href="/stylesheets/documents.css?v=20261026b">
</head>
<body class="rs-body" style="background:#f3f5f5">
    <script src="/js/common/tabSession.js"></script>
    <%- include('../partials/navbar') %>
    <%
        const s = contract.seller;
        const t = contract.totals;
        const baht = (n) => Number(n || 0).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const dateKey = (d) => { const x = new Date(d); return x.getFullYear() + '-' + String(x.getMonth() + 1).padStart(2, '0') + '-' + String(x.getDate()).padStart(2, '0'); };
        const successMessages = { issued: 'อนุมัติแล้ว ออกเลขที่สัญญาและแจ้งร้านค้าแล้ว ร้านเปิด/พิมพ์สัญญาได้ทันที' };
        const errorMessages = {
            missing_reason: 'กรุณากรอกเหตุผลที่ไม่อนุมัติ',
            not_pending: 'คำขอนี้ถูกดำเนินการไปแล้ว',
            no_paid_rentals: 'ช่วงนี้ไม่มีการเช่าที่ชำระแล้ว อนุมัติไม่ได้ — กรุณาไม่อนุมัติพร้อมแจ้งเหตุผล',
            action_failed: 'ดำเนินการไม่สำเร็จ กรุณาลองใหม่'
        };
        const pill = { PENDING: 'rs-pill--pending', ISSUED: 'rs-pill--paid', CANCELLED: 'rs-pill--danger' };
        const missing = [];
        if (s.idCardNumber === '-') missing.push('เลขบัตรประชาชน');
        if (s.address === '-') missing.push('ที่อยู่');
        if (s.phone === '-') missing.push('เบอร์โทร');
    %>

    <main class="rs-page">
        <header class="rs-head">
            <div>
                <p class="rs-kicker"><a href="/admin/lease-contracts?tab=<%= request.status %>" style="color:inherit">คำขอสัญญาเช่า</a> / #<%= request.id %></p>
                <h1 class="rs-title"><%= s.shopName %> · <%= request.periodText %></h1>
                <p class="rs-lead">
                    <span class="rs-pill <%= pill[request.status] %>"><%= request.statusLabel %></span>
                    ส่งคำขอเมื่อ <%= request.createdAtText %><% if (request.issuedAtText) { %> · อนุมัติเมื่อ <%= request.issuedAtText %> โดย <%= request.issuedByName || '-' %><% } %>
                </p>
            </div>
        </header>

        <%- include('../partials/documentSwitch', { active: 'lease', base: '/admin', counts: { tax: typeof taxInvoiceTodo !== 'undefined' ? taxInvoiceTodo : 0, lease: typeof leaseContractTodo !== 'undefined' ? leaseContractTodo : 0 } }) %>

        <% if (success && successMessages[success]) { %><div class="rs-notice rs-notice--success" role="status"><%= successMessages[success] %></div><% } %>
        <% if (error) { %><div class="rs-notice rs-notice--danger" role="alert"><%= errorMessages[error] || 'เกิดข้อผิดพลาด' %></div><% } %>

        <div class="lc-review">
            <div>
                <div class="lc-toolbar">
                    <span class="rs-muted" style="font-size:13px"><%= contract.isDraft ? 'ร่างสัญญา — สร้างจากการจองที่ชำระแล้วในช่วงที่ร้านขอ (ณ ตอนนี้)' : 'สัญญาที่อนุมัติแล้ว — นับเฉพาะการจองที่ชำระก่อนเวลาอนุมัติ' %></span>
                    <button type="button" class="rs-btn rs-btn--sm" onclick="window.print()"><i class="fa-solid fa-print"></i> พิมพ์</button>
                </div>
                <%- include('../partials/leaseContractDocument', { contract }) %>
            </div>

            <aside class="lc-review__side" aria-label="ตรวจและอนุมัติ">
                <section>
                    <h2>ตรวจก่อนอนุมัติ</h2>
                    <ul class="lc-checks">
                        <li class="<%= contract.rows.length ? 'ok' : 'warn' %>"><i class="fa-solid <%= contract.rows.length ? 'fa-check' : 'fa-triangle-exclamation' %>"></i> การเช่าที่ชำระแล้ว <%= contract.rows.length %> รายการ · <%= contract.byStall.length %> ล็อก</li>
                        <li class="ok"><i class="fa-solid fa-check"></i> ยอดชำระรวม <%= baht(t.paid) %> บาท</li>
                        <li class="<%= missing.length ? 'warn' : 'ok' %>"><i class="fa-solid <%= missing.length ? 'fa-triangle-exclamation' : 'fa-check' %>"></i> <%= missing.length ? 'ข้อมูลผู้เช่าไม่ครบ: ' + missing.join(', ') : 'ข้อมูลผู้เช่าครบ' %></li>
                        <% if (t.outstanding) { %><li class="warn"><i class="fa-solid fa-triangle-exclamation"></i> มียอดค้างชำระในช่วงนี้ <%= baht(t.outstanding) %> บาท (ไม่ถูกนับในสัญญา)</li><% } %>
                    </ul>
                    <% if (request.note) { %><p class="rs-hint" style="margin-top:10px"><b>หมายเหตุจากร้าน:</b> <%= request.note %></p><% } %>
                    <p class="rs-hint" style="margin-top:10px"><a href="/admin/rental-statements/user/<%= s.id %>?from=<%= dateKey(request.periodStart) %>&to=<%= dateKey(request.periodEnd) %>">ดูรายงานการเช่าเต็มของร้านในช่วงนี้</a></p>
                </section>

                <% if (request.status === 'PENDING') { %>
                <section>
                    <h2>อนุมัติ</h2>
                    <form method="post" action="/admin/lease-contracts/<%= request.id %>/issue">
                        <label class="rs-field">ข้อความถึงร้าน (ไม่บังคับ)
                            <textarea name="adminNote" maxlength="500" rows="3" placeholder="เช่น นำสัญญาที่พิมพ์มาลงนามที่ออฟฟิศภายใน 7 วัน"></textarea>
                        </label>
                        <button type="submit" class="rs-btn rs-btn--primary" <%= contract.rows.length ? '' : 'disabled' %>><i class="fa-solid fa-check"></i> อนุมัติและออกเลขที่สัญญา</button>
                    </form>
                </section>
                <section>
                    <h2>ไม่อนุมัติ</h2>
                    <form method="post" action="/admin/lease-contracts/<%= request.id %>/cancel" onsubmit="return confirm('ยืนยันไม่อนุมัติคำขอสัญญาเช่านี้? ร้านจะได้รับแจ้งพร้อมเหตุผล')">
                        <label class="rs-field">เหตุผล (ร้านจะเห็นข้อความนี้)
                            <input type="text" name="reason" maxlength="500" required placeholder="เช่น ข้อมูลที่อยู่ไม่ครบ กรุณาอัปเดตก่อน">
                        </label>
                        <button type="submit" class="rs-btn rs-btn--danger"><i class="fa-solid fa-xmark"></i> ไม่อนุมัติ</button>
                    </form>
                </section>
                <% } else if (request.status === 'CANCELLED') { %>
                <section>
                    <h2>ไม่อนุมัติแล้ว</h2>
                    <p class="rs-hint">เหตุผล: <%= request.adminNote || '-' %></p>
                </section>
                <% } else { %>
                <section>
                    <h2>อนุมัติแล้ว</h2>
                    <p class="rs-hint">เลขที่ <b><%= request.documentNumber %></b><br>ร้านเปิดและพิมพ์สัญญาได้ที่หน้าขอสัญญาเช่าของร้าน<% if (request.adminNote) { %><br>ข้อความถึงร้าน: <%= request.adminNote %><% } %></p>
                </section>
                <% } %>
            </aside>
        </div>
    </main>
</body>
</html>
