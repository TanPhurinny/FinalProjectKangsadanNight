<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>จัดการประกาศ | Kangsadan Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin/announcements.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/approvals.css">
</head>
<body class="bg-light">
    <%- include('../partials/navbar') %>

    <div class="announcement-container container py-5">
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="sticky-form">
                    <div class="card create-card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-4 d-flex align-items-center">
                                <span class="icon-badge me-2"><i class="fas fa-plus"></i></span>
                                สร้างประกาศใหม่
                            </h5>
                            
                            <form action="/admin/announcements/create" method="POST" enctype="multipart/form-data">
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">หัวข้อประกาศ</label>
                                    <input type="text" name="title" class="form-control custom-input" placeholder="พิมพ์หัวข้อประกาศ..." required>
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">ประกาศถึงใคร?</label>
                                    <div class="role-selector d-flex gap-2">
                                        <input type="radio" class="btn-check" name="targetRole" value="CUSTOMER" id="roleCust" checked>
                                        <label class="btn btn-outline-info flex-grow-1" for="roleCust">ผู้ใช้ทั่วไป</label>

                                        <input type="radio" class="btn-check" name="targetRole" value="SELLER" id="roleSell">
                                        <label class="btn btn-outline-warning flex-grow-1" for="roleSell">พ่อค้า/แม่ค้า</label>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small">หมวดหมู่</label>
                                    <select name="category" class="form-select custom-input">
                                        <option value="ข่าวสาร">📢 ข่าวสาร</option>
                                        <option value="กฎระเบียบ">⚖️ กฎระเบียบ</option>
                                        <option value="โปรโมชั่น">🔥 โปรโมชั่น</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small">รูปภาพประกอบ</label>
                                    <input type="file" name="announcementImage" class="form-control" accept="image/*" id="imgInput">
                                    <div id="previewContainer" class="mt-2 d-none">
                                        <img id="imgPreview" src="#" alt="Preview" class="img-fluid rounded-3 shadow-sm border" style="max-height: 200px;">
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold small">เนื้อหาประกาศ</label>
                                    <textarea name="content" class="form-control custom-input" rows="4" placeholder="ระบุรายละเอียดประกาศ..." required></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-3 shadow">
                                    <i class="fas fa-bullhorn me-2"></i> เผยแพร่ทันที
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-2">
                        <ul class="nav nav-pills nav-fill" id="announcementTabs">
                            <li class="nav-item">
                                <button class="nav-link active" onclick="filterPosts('ALL')">ทั้งหมด</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link text-info" onclick="filterPosts('CUSTOMER')">ผู้ใช้ทั่วไป</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link text-warning" onclick="filterPosts('SELLER')">พ่อค้า/แม่ค้า</button>
                            </li>
                        </ul>
                    </div>
                </div>

                <div id="postsContainer">
                    <% posts.forEach(post => { %>
                        <div class="card post-card border-0 shadow-sm mb-4 announcement-item" data-role="<%= post.targetRole %>">
                            <% if (post.image) { %>
                                <img src="/uploads/announcements/<%= post.image %>" class="card-img-top post-img" alt="announcement">
                            <% } %>
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge category-badge"><%= post.category %></span>
                                    <span class="target-role <%= post.targetRole === 'SELLER' ? 'seller' : 'customer' %>">
                                        <%= post.targetRole === 'SELLER' ? 'สำหรับพ่อค้าแม่ค้า' : 'สำหรับผู้ใช้ทั่วไป' %>
                                    </span>
                                </div>
                                <h4 class="fw-bold text-dark mb-2"><%= post.title %></h4>
                                <p class="post-content text-muted small"><%= post.content %></p>
                                <hr class="my-3 opacity-25">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="author-info d-flex align-items-center">
                                        <div class="author-avatar me-2"><%= post.author.name.charAt(0) %></div>
                                        <span class="small text-muted"><%= post.author.name %></span>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <small class="text-muted"><%= new Date(post.createdAt).toLocaleDateString('th-TH') %></small>
                                        <a href="/admin/announcements/delete/<%= post.id %>" class="text-danger ms-2" onclick="return confirm('ลบประกาศนี้ใช่ไหม?')">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <div id="noData" class="text-center py-5 d-none">
                    <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                    <p class="text-muted">ไม่พบประวัติประกาศในหมวดนี้</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ระบบ Filter ประกาศ
        function filterPosts(role) {
            // ปรับสถานะ Active ของปุ่ม
            const buttons = document.querySelectorAll('#announcementTabs .nav-link');
            buttons.forEach(btn => btn.classList.remove('active', 'bg-primary', 'text-white'));
            event.target.classList.add('active', 'bg-primary', 'text-white');

            const items = document.querySelectorAll('.announcement-item');
            let hasData = false;

            items.forEach(item => {
                if (role === 'ALL' || item.getAttribute('data-role') === role) {
                    item.classList.remove('d-none');
                    hasData = true;
                } else {
                    item.classList.add('d-none');
                }
            });

            // จัดการข้อความ No Data
            document.getElementById('noData').classList.toggle('d-none', hasData);
        }

        // Preview รูปภาพ (คงเดิม)
        const imgInput = document.getElementById('imgInput');
        imgInput.onchange = evt => {
            const [file] = imgInput.files;
            if (file) {
                document.getElementById('imgPreview').src = URL.createObjectURL(file);
                document.getElementById('previewContainer').classList.remove('d-none');
            }
        }
    </script>
</body>
</html>