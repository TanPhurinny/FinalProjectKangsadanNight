<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>จัดการสิทธิ์ผู้ใช้งาน | Kangsadan Night Market</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/partials/navbar.css">
    <link rel="stylesheet" href="/stylesheets/admin/users.css">
    <style>
        body { font-family: 'Kanit', sans-serif; background-color: #f8f9fa; }
        .users-container { padding-top: 40px; padding-bottom: 60px; }
        .table-card { background: white; border-radius: 20px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.05); overflow: hidden; }
        .thead-custom { background-color: #f1f3f5; color: #495057; }
        .role-badge { padding: 6px 15px; border-radius: 50px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; }
        .bg-admin { background-color: #ffe8e8; color: #a73b24; }
        .bg-staff { background-color: #e3f2fd; color: #0d47a1; }
        .bg-seller { background-color: #e8f5e9; color: #2e7d32; }
        .bg-customer { background-color: #f8f9fa; color: #6c757d; border: 1px solid #dee2e6; }
        .btn-action { width: 38px; height: 38px; border-radius: 12px; border: none; transition: 0.3s; display: inline-flex; align-items: center; justify-content: center; }
        .btn-edit { background-color: #fff4e5; color: #ff922b; }
        .btn-edit:hover { background-color: #ff922b; color: white; }
        .btn-delete { background-color: #fff0f0; color: #fa5252; }
        .btn-delete:hover { background-color: #fa5252; color: white; }
        .search-box { border-radius: 15px; border: 1.5px solid #eee; padding: 12px 20px; transition: 0.3s; }
        .search-box:focus { border-color: #a73b24; box-shadow: none; background-color: white; }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="users-container">
        <div class="container">
            <% if (success) { %>
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
                    <i class="fas fa-check-circle me-2"></i> บันทึกการเปลี่ยนแปลงเรียบร้อยแล้ว
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <div class="d-flex justify-content-between align-items-center mb-5">
                <div>
                    <h2 class="fw-bold text-dark">จัดการสิทธิ์การใช้งาน</h2>
                    <p class="text-muted">ตรวจสอบและแก้ไขบทบาทของสมาชิกในตลาดกังสดาล</p>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-7">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0" style="border-radius: 15px 0 0 15px; border: 1.5px solid #eee;">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control search-box border-start-0" placeholder="ค้นหาด้วยชื่อ หรือ Username..." style="border-radius: 0 15px 15px 0;">
                    </div>
                </div>
                <div class="col-md-5">
                    <select id="roleFilter" class="form-select search-box shadow-sm">
                        <option value="ALL">แสดงทุกบทบาท</option>
                        <option value="ADMIN">ADMIN (ผู้ดูแลระบบ)</option>
                        <option value="STAFF">STAFF (พนักงานตลาด)</option>
                        <option value="SELLER">SELLER (ผู้เช่าแผง/ผู้ขาย)</option>
                        <option value="CUSTOMER">CUSTOMER (ลูกค้า)</option>
                    </select>
                </div>
            </div>

            <div class="table-card">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="userTable">
                        <thead class="thead-custom">
                            <tr class="small text-muted text-uppercase">
                                <th class="py-3 px-4">ชื่อ-นามสกุล</th>
                                <th class="py-3">ชื่อผู้ใช้</th>
                                <th class="py-3">บทบาท</th>
                                <th class="py-3 text-center">การจัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% allUsers.forEach(u => { %>
                                <tr class="user-row" data-name="<%= u.name.toLowerCase() %>" data-username="<%= u.username.toLowerCase() %>" data-role="<%= u.role %>">
                                    <td class="px-4 fw-bold text-dark"><%= u.name %></td>
                                    <td class="text-muted"><%= u.username %></td>
                                    <td>
                                        <% 
                                            let badgeClass = 'bg-customer';
                                            if (u.role === 'ADMIN') badgeClass = 'bg-admin';
                                            else if (u.role === 'STAFF') badgeClass = 'bg-staff';
                                            else if (u.role === 'SELLER') badgeClass = 'bg-seller';
                                        %>
                                        <span class="role-badge <%= badgeClass %>"><%= u.role %></span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn-action btn-edit me-1" title="เปลี่ยนสิทธิ์" onclick="openEditModal('<%= u.id %>', '<%= u.name %>', '<%= u.role %>')">
                                            <i class="fas fa-user-shield"></i>
                                        </button>
                                        <button class="btn-action btn-delete" title="ลบผู้ใช้" onclick="deleteUser('<%= u.id %>')">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editRoleModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 25px;">
                <div class="modal-header border-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold">แก้ไขสิทธิ์การใช้งาน</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/admin/users/update-role" method="POST">
                    <div class="modal-body p-4">
                        <input type="hidden" name="userId" id="modalUserId">
                        
                        <div class="p-3 mb-4 rounded-4 bg-light">
                            <small class="text-muted d-block mb-1">ชื่อผู้ใช้งาน</small>
                            <span class="fw-bold text-dark fs-5" id="modalUserName"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">เลือกบทบาทใหม่</label>
                            <select name="newRole" id="modalRoleSelect" class="form-select border-0 bg-light p-3 rounded-4">
                                <option value="ADMIN">ADMIN (ผู้ดูแลระบบ)</option>
                                <option value="STAFF">STAFF (พนักงานตลาด)</option>
                                <option value="SELLER">SELLER (ผู้เช่าแผง/ผู้ขาย)</option>
                                <option value="CUSTOMER">CUSTOMER (ลูกค้าทั่วไป)</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-4 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">ยกเลิก</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4" style="background: #A73B24; border:none;">บันทึกข้อมูล</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script>
        // ระบบค้นหาและกรอง Client-side
        const searchInput = document.getElementById('searchInput');
        const roleFilter = document.getElementById('roleFilter');
        const rows = document.querySelectorAll('.user-row');

        function filterTable() {
            const searchTerm = searchInput.value.toLowerCase();
            const filterRole = roleFilter.value;

            rows.forEach(row => {
                const name = row.getAttribute('data-name');
                const username = row.getAttribute('data-username');
                const role = row.getAttribute('data-role');
                const matchesSearch = name.includes(searchTerm) || username.includes(searchTerm);
                const matchesRole = (filterRole === 'ALL' || role === filterRole);
                row.style.display = (matchesSearch && matchesRole) ? '' : 'none';
            });
        }

        searchInput.addEventListener('input', filterTable);
        roleFilter.addEventListener('change', filterTable);

        // ฟังก์ชันเปิด Modal และส่งค่า ID
        function openEditModal(id, name, role) {
            document.getElementById('modalUserId').value = id;
            document.getElementById('modalUserName').innerText = name;
            document.getElementById('modalRoleSelect').value = role;
            new bootstrap.Modal(document.getElementById('editRoleModal')).show();
        }

        // ระบบยืนยันการลบ
        function deleteUser(id) {
            if (confirm('ยืนยันการลบผู้ใช้นี้ออกจากระบบ? ข้อมูลที่เกี่ยวข้องทั้งหมดจะหายไป')) {
                window.location.href = `/admin/users/delete/${id}`;
            }
        }
    </script>
</body>
</html>