<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>จัดการผู้ใช้งาน | Kangsadan Admin</title>
        <link rel="icon" type="image/png" href="/img/favicon.png">
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
            rel="stylesheet">
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap"
            rel="stylesheet">
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20261023-ios">
        <link rel="stylesheet" href="/stylesheets/admin/theme.css">
        <link rel="stylesheet" href="/stylesheets/admin/users.css?v=20261026">
    </head>
    <body class="um-body">
        <script src="/js/common/tabSession.js"></script>
        <%- include('../partials/navbar') %>

        <main class="um-page" id="umApp" data-me="<%= user ? user.id : '' %>">
            <header class="um-head">
                <div>
                    <p class="um-kicker">ระบบหลังบ้าน · สมาชิก</p>
                    <h1 class="um-title">จัดการผู้ใช้งาน</h1>
                    <p class="um-lead">ค้นหาสมาชิก ดูข้อมูลติดต่อ ร้านค้า และล็อกที่ถืออยู่ เปลี่ยนบทบาททีละคนหรือหลายคนพร้อมกัน
                        กดแถวใดก็ได้เพื่อเปิดแผงรายละเอียด</p>
                </div>
                <div class="um-head-actions">
                    <button type="button" class="um-btn um-btn--ghost" id="exportBtn">
                        <i class="fa-solid fa-file-arrow-down"></i> ส่งออก CSV
                    </button>
                </div>
            </header>

            <% if (error) { %>
            <div class="um-notice um-notice--danger" role="alert"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
            <% } %>

            <!-- ดัชนีบทบาท: ตัวเลขแต่ละช่องกดเพื่อกรองได้ (ทำหน้าที่เป็นแท็บ) -->
            <nav class="um-index" id="roleIndex" aria-label="กรองตามบทบาท"></nav>

            <section class="um-toolbar" aria-label="ค้นหาและตัวกรอง">
                <div class="um-search">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <input type="search" id="searchInput" autocomplete="off"
                        placeholder="ค้นหาชื่อ ชื่อผู้ใช้ เบอร์ อีเมล ชื่อร้าน รหัสล็อก หรือ #ID"
                        aria-label="ค้นหาผู้ใช้">
                    <kbd class="um-kbd" title="กด / เพื่อค้นหา">/</kbd>
                </div>
                <label class="um-sort">
                    <span>เรียง</span>
                    <select id="sortSelect" aria-label="เรียงลำดับ">
                        <option value="role">ตามบทบาท</option>
                        <option value="name">ชื่อ ก–ฮ</option>
                        <option value="newest">สมัครล่าสุด</option>
                        <option value="oldest">สมัครนานที่สุด</option>
                        <option value="activity">คำขอจองมากสุด</option>
                    </select>
                </label>
                <div class="um-chips" id="filterChips" role="group" aria-label="ตัวกรองเพิ่มเติม">
                    <button type="button" class="um-chip" data-filter="shop"><i class="fa-solid fa-store"></i> มีร้านค้า <b></b></button>
                    <button type="button" class="um-chip" data-filter="stall"><i class="fa-solid fa-table-cells-large"></i> ถือล็อกอยู่ <b></b></button>
                    <button type="button" class="um-chip" data-filter="new"><i class="fa-solid fa-seedling"></i> สมัครใหม่ 30 วัน <b></b></button>
                    <button type="button" class="um-chip" data-filter="incomplete"><i class="fa-solid fa-address-card"></i> ข้อมูลติดต่อไม่ครบ <b></b></button>
                    <button type="button" class="um-chip um-chip--danger" data-filter="blacklist"><i class="fa-solid fa-ban"></i> แบล็กลิสต์ <b></b></button>
                </div>
            </section>

            <div class="um-meta">
                <span id="resultMeta" aria-live="polite"></span>
                <button type="button" class="um-link" id="clearFilters" hidden><i class="fa-solid fa-xmark"></i> ล้างตัวกรองทั้งหมด</button>
            </div>

            <section class="um-table" aria-label="รายชื่อผู้ใช้">
                <div class="um-row um-row--head" role="row">
                    <label class="um-check" title="เลือกทั้งหมดในหน้านี้">
                        <input type="checkbox" id="selectPage" aria-label="เลือกทั้งหมดในหน้านี้">
                    </label>
                    <span>สมาชิก</span>
                    <span>ติดต่อ</span>
                    <span>บทบาท</span>
                    <span>ร้าน / ล็อก</span>
                    <span>สมัครเมื่อ</span>
                    <span class="um-col-actions">จัดการ</span>
                </div>
                <div id="userRows"></div>
                <div class="um-empty" id="emptyState" hidden>
                    <i class="fa-solid fa-user-slash"></i>
                    <p>ไม่พบผู้ใช้ที่ตรงกับเงื่อนไข</p>
                    <button type="button" class="um-btn um-btn--ghost" data-action="clear-filters">ล้างตัวกรอง</button>
                </div>
            </section>

            <nav class="um-pager" id="pager" aria-label="เปลี่ยนหน้า"></nav>
        </main>

        <!-- แถบทำรายการหลายคน: โผล่เมื่อเลือกอย่างน้อย 1 คน -->
        <form class="um-bulk" id="bulkBar" action="/admin/users/bulk-role" method="POST" hidden>
            <div class="um-bulk-count"><b id="bulkCount">0</b> คนที่เลือก</div>
            <div id="bulkIds"></div>
            <label class="um-bulk-role">
                <span>เปลี่ยนบทบาทเป็น</span>
                <select name="newRole" id="bulkRole" required>
                    <option value="" selected disabled>เลือกบทบาท</option>
                    <option value="ADMIN">ผู้ดูแล (ADMIN)</option>
                    <option value="STAFF">พนักงาน (STAFF)</option>
                    <option value="SELLER">ผู้ขาย (SELLER)</option>
                    <option value="CUSTOMER">ลูกค้า (CUSTOMER)</option>
                </select>
            </label>
            <button type="submit" class="um-btn" id="bulkApply" disabled>ยืนยัน</button>
            <button type="button" class="um-btn um-btn--ghost" id="bulkExport"><i class="fa-solid fa-file-arrow-down"></i> CSV</button>
            <button type="button" class="um-icon-btn" id="bulkClear" title="ยกเลิกการเลือก" aria-label="ยกเลิกการเลือก"><i class="fa-solid fa-xmark"></i></button>
        </form>

        <!-- แผงรายละเอียดสมาชิก -->
        <div class="um-scrim" id="drawerScrim" hidden></div>
        <aside class="um-drawer" id="drawer" role="dialog" aria-modal="true" aria-labelledby="drawerName" hidden>
            <div class="um-drawer-bar">
                <button type="button" class="um-icon-btn" data-action="close-drawer" aria-label="ปิด"><i class="fa-solid fa-xmark"></i></button>
                <span class="um-drawer-pos" id="drawerPos"></span>
                <div class="um-drawer-nav">
                    <button type="button" class="um-icon-btn" data-action="prev" aria-label="คนก่อนหน้า" title="คนก่อนหน้า (←)"><i class="fa-solid fa-chevron-left"></i></button>
                    <button type="button" class="um-icon-btn" data-action="next" aria-label="คนถัดไป" title="คนถัดไป (→)"><i class="fa-solid fa-chevron-right"></i></button>
                </div>
            </div>
            <div class="um-drawer-body" id="drawerBody"></div>
        </aside>

        <!-- กล่องยืนยันของเว็บ (แทน confirm() ของเบราว์เซอร์) -->
        <div class="um-scrim um-scrim--dialog" id="dialogScrim" hidden></div>
        <div class="um-dialog" id="dialog" role="alertdialog" aria-modal="true" aria-labelledby="dialogTitle" hidden>
            <form id="dialogForm" method="POST">
                <h2 class="um-dialog-title" id="dialogTitle"></h2>
                <div class="um-dialog-body" id="dialogBody"></div>
                <div class="um-dialog-actions">
                    <button type="button" class="um-btn um-btn--ghost" data-action="close-dialog">ยกเลิก</button>
                    <button type="submit" class="um-btn" id="dialogConfirm"></button>
                </div>
            </form>
        </div>

        <div class="um-toast" id="toast" role="status" aria-live="polite" hidden></div>

        <script type="application/json" id="usersData"><%- JSON.stringify(users).replace(/</g, '\\u003c') %></script>
        <script>window.UM_FLASH = <%- JSON.stringify(successMessage || null).replace(/</g, '\\u003c') %>;</script>
        <script src="/js/admin/users.js?v=20261026"></script>
    </body>
</html>
