<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>จัดการผู้ใช้งาน | Kangsadan Admin</title>
        <link rel="icon" type="image/png" href="/img/Logo.png">
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css"
            rel="stylesheet">
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
            rel="stylesheet">
        <link
            href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
            rel="stylesheet">
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260711-5">
        <link rel="stylesheet" href="/stylesheets/admin/theme.css">
        <link rel="stylesheet" href="/stylesheets/admin/users.css">
        <link rel="stylesheet" href="/stylesheets/responsive.css">

    </head>
    <body>
        <script src="/js/common/tabSession.js"></script>
        <%- include('../partials/navbar') %>

        <header class="site-header">
            <a href="javascript:history.back()" class="btn-back"><i
                    class="fa-solid fa-arrow-left"></i></a>
            <h2 class="header-title">จัดการผู้ใช้งาน</h2>
            <div class="header-spacer"></div>
        </header>

        <div class="users-container container py-5">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <div>
                    <p class="text-muted small">ตรวจสอบ แก้ไขบทบาท
                        และดูข้อมูลสมาชิกทั้งหมดตามประเภทสมาชิก</p>
                    <div class="d-flex flex-wrap gap-2">
                        <span
                            class="badge bg-info-subtle text-info-emphasis px-3 py-2">
                            ผู้ใช้ทั้งหมด <span id="totalUsersCount"><%=
                                allUsers.length %></span> คน
                        </span>
                        <span
                            class="badge bg-light text-secondary border px-3 py-2">
                            กำลังแสดง <span id="visibleUsersCount"><%=
                                allUsers.length %></span> คน
                        </span>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <div class="input-group">
                        <span
                            class="input-group-text bg-white border-end-0"><i
                                class="fas fa-search text-muted"></i></span>
                        <input type="text" id="searchInput"
                            class="form-control search-box border-start-0"
                            placeholder="ค้นหาชื่อ หรือ Username...">
                    </div>
                </div>
                <div class="col-md-4">
                    <select id="roleFilter"
                        class="form-select search-box">
                        <option value="ALL">ทุกบทบาท</option>
                        <option value="ADMIN">ADMIN</option>
                        <option value="STAFF">STAFF</option>
                        <option value="SELLER">SELLER</option>
                        <option value="CUSTOMER">CUSTOMER</option>
                    </select>
                </div>
            </div>

            <div
                class="table-card border overflow-hidden">
                <div class="table-responsive">
                    <table class="table align-middle mb-0" id="userTable">
                        <thead class="thead-custom bg-light">
                            <tr class="small fw-bold text-muted text-uppercase">
                                <th class="py-3 px-4">รายชื่อสมาชิก</th>
                                <th class="py-3">ชื่อผู้ใช้</th>
                                <th class="py-3">บทบาท</th>
                                <th class="py-3 text-center">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% allUsers.forEach(u => { %>
                            <tr class="user-row border-bottom"
                                data-name="<%= u.name.toLowerCase() %>"
                                data-username="<%= u.username.toLowerCase() %>"
                                data-role="<%= u.role %>">
                                <td class="px-4">
                                    <div
                                        class="user-info-cell d-flex align-items-center justify-content-between"
                                        onclick="viewUserDetail('<%= encodeURIComponent(JSON.stringify(u)) %>')">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle me-3"><%=
                                                u.name.charAt(0) %></div>
                                            <div>
                                                <div
                                                    class="fw-bold clickable-name text-dark"><%=
                                                    u.name %></div>
                                                <small class="text-muted"
                                                    style="font-size: 0.7rem;">ID:
                                                    #<%= u.id %></small>
                                            </div>
                                        </div>
                                        <span class="detail-arrow"
                                            aria-hidden="true"><i
                                                class="fas fa-chevron-right"></i></span>
                                    </div>
                                </td>
                                <td class="text-muted small font-monospace"><%=
                                    u.username %></td>
                                <td>
                                    <%
                                    let roleClass = 'role-customer';
                                    if (u.role === 'ADMIN') roleClass =
                                    'role-admin';
                                    else if (u.role === 'STAFF') roleClass =
                                    'role-staff';
                                    else if (u.role === 'SELLER') roleClass =
                                    'role-seller';
                                    %>
                                    <span class="role-badge <%= roleClass %>">
                                        <i
                                            class="fas fa-circle me-1 small"></i><%=
                                        u.role %>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button class="btn-action btn-view"
                                        onclick="viewUserDetail('<%= encodeURIComponent(JSON.stringify(u)) %>')"
                                        title="ดูข้อมูล">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="btn-action btn-edit"
                                        onclick="openEditModal('<%= u.id %>', '<%= u.name %>', '<%= u.role %>')"
                                        title="เปลี่ยนสิทธิ์">
                                        <i class="fas fa-user-shield"></i>
                                    </button>
                                    <button class="btn-action btn-delete"
                                        onclick="deleteUser('<%= u.id %>')"
                                        title="ลบผู้ใช้">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <%- include('./userModals') %>

        <script
            src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
        <script src="/js/admin/users.js"></script>
    </body>
</html>