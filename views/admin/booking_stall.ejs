<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>จัดผังตลาด - Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@500;600;700&display=swap"
      rel="stylesheet" />
    <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260826-7">
    <link rel="stylesheet" href="/stylesheets/admin/theme.css">
    <link rel="stylesheet" href="/stylesheets/responsive.css">
    <link rel="stylesheet" href="/stylesheets/admin/bookingStall.css">
  </head>
  <body>

    <%- include('../partials/navbar') %>

    <div class="booking-stall-page">

      <div id="adminTooltip" class="admin-tooltip">
        <div class="tt-header" id="tt-header">แผง <span id="tt-stall-id"></span></div>
        <div class="tt-body">
          <div class="tt-group">
            <span class="tt-label" id="tt-label-shop">ชื่อร้านค้า</span>
            <span class="tt-value" id="tt-shop"></span>
          </div>

          <div class="tt-row" style="margin-bottom:0;">
            <div class="tt-group">
              <span class="tt-label" id="tt-label-lock">หมายเลขล็อก</span>
              <span class="tt-value" id="tt-lock"></span>
            </div>
            <div class="tt-group">
              <span class="tt-label" id="tt-label-date">วันที่จอง</span>
              <span class="tt-value" id="tt-date"></span>
            </div>
          </div>

          <div class="tt-group" style="margin-top: 14px;">
            <span class="tt-label" id="tt-label-name">ผู้จอง</span>
            <span class="tt-value" id="tt-name"></span>
          </div>
          <div class="tt-group" id="tt-phone-group">
            <span class="tt-label" id="tt-label-phone">เบอร์โทรศัพท์</span>
            <span class="tt-value" id="tt-phone"></span>
          </div>
          <div class="tt-group" style="margin-top: 14px;">
            <span class="tt-label" id="tt-label-note">หมายเหตุ</span>
            <span class="tt-value" id="tt-note" style="font-size: 13px;"></span>
          </div>
        </div>
      </div>

      <header class="site-header">
        <a href="/admin/approvals" class="btn-back"><i
            class="fa-solid fa-arrow-left"></i></a>
        <h2 class="header-title">จัดตำแหน่งแผงค้า</h2>
        <div class="header-spacer"></div>
      </header>

      <div class="container">

        <div class="applicant-card" id="applicantCard">
          <div class="applicant-header">
            <i class="fa-solid fa-clipboard-user"></i>
            ข้อมูลผู้ที่ส่งคำขอเช่าแผงเข้ามา
          </div>
          <div class="applicant-body">
            <div class="info-group applicant-image-group" id="app-image-group" style="display:none;">
              <label>รูปสินค้า</label>
              <img id="app-image" class="applicant-product-image" alt="รูปสินค้าที่ยื่นขอจอง" />
            </div>
            <div class="info-group">
              <label>ชื่อผู้จอง</label>
              <span id="app-name">-</span>
            </div>
            <div class="info-group">
              <label>ชื่อร้านค้า</label>
              <span id="app-shop">-</span>
            </div>
            <div class="info-group">
              <label>ประเภทสินค้า</label>
              <span id="app-product-type">-</span>
            </div>
            <div class="info-group">
              <label>เบอร์โทรศัพท์</label>
              <span id="app-phone">-</span>
            </div>
            <div class="info-group">
              <label>โซนที่ต้องการ / แถวเบื้องต้น</label>
              <span id="app-zone"
                style="color: var(--primary-dark); font-weight: 700;">-</span>
            </div>
            <div class="info-group">
              <label>จำนวนล็อกที่ขอ</label>
              <span id="app-stall-count"
                style="color: var(--primary-dark); font-weight: 700;">-</span>
            </div>
            <div class="info-group">
              <label>ระยะเวลาเช่า</label>
              <span id="app-rental-period" style="color: var(--primary-dark); font-weight: 700;">-</span>
            </div>
            <div class="info-group">
              <label>วันที่ส่งคำขอ</label>
              <span id="app-date">-</span>
            </div>
            <div class="info-group" id="app-grand-total-group" style="display:none;">
              <label>ยอดรวมทั้งหมด (ทุกล็อก)</label>
              <span id="app-grand-total" style="color: var(--primary-dark); font-weight: 700;">-</span>
            </div>
            <div class="info-group note-full-width" id="app-corner-note-group" style="display:none;">
              <label
                style="color: #d97706; font-size: 12px;">สนใจแผงพิเศษ (มุมสี)</label>
              <span id="app-corner-note"
                style="color: #333; font-size: 13px; margin-top: 4px;">-</span>
            </div>
            <div class="info-group note-full-width">
              <label
                style="color: #d97706; font-size: 12px;">รายละเอียดร้านค้า/สินค้าที่ขาย (จากผู้จอง)</label>
              <span id="app-note"
                style="color: #333; font-size: 13px; margin-top: 4px;">-</span>
            </div>
          </div>
        </div>

        <div class="map-controls">
          <div class="zone-select-wrapper">
            <label>โซน</label>
            <span>ระบุโซนที่ต้องการจอง</span>
            <div id="zoneRestrictRow" style="display:none; align-items: center; gap: 10px; margin-bottom: 6px;">
              <span id="zoneRestrictNote" style="color: var(--warning-dark, #a06c1f); font-weight: 600;"></span>
              <button type="button" class="btn-color-toggle" id="zoneShowAllToggle" onclick="toggleShowAllZones(this)">
                <i class="fa-solid fa-eye"></i> แสดงทุกโซน</button>
            </div>

            <div class="view-toggle">
              <button type="button" class="toggle-btn active" data-mode="buttons">
                <i class="fa-solid fa-list"></i> เลือกจากรายการ</button>
              <button type="button" class="toggle-btn" data-mode="overview">
                <i class="fa-solid fa-map"></i> ดูแบบผัง</button>
            </div>

            <div class="zone-btn-group" id="zoneButtons">
              <button class="btn-zone active" data-zone="A">โซน A
                <small>(แฟชั่น/อาหาร A901-A923)</small></button>
              <button class="btn-zone" data-zone="B">โซน B
                <small>(อาหาร/แฟชั่น B601-B623)</small></button>
              <button class="btn-zone" data-zone="C">โซน C
                <small>(แฟชั่น)</small></button>
              <button class="btn-zone" data-zone="D">โซน D
                <small>(ฟู้ดทรัค)</small></button>
              <button class="btn-zone" data-zone="E">โซน E
                <small>(แฟชั่น)</small></button>
              <button class="btn-zone" data-zone="F">โซน F
                <small>(อาหาร)</small></button>
              <button class="btn-zone" data-zone="X">โซน X
                <small>(อาหาร)</small></button>
            </div>

            <div class="zone-info-bar" id="zoneInfoBar">
              <span class="zone-info-code" id="zoneInfoCode">A</span>
              <span class="zone-info-text" id="zoneInfoText">-</span>
            </div>

            <div class="ov-zone-canvas" id="zoneOverviewCanvas" style="display:none;">
              <div class="ov-zone-block ov-zone-E" data-zone="E">
                <span class="ov-zone-title">โซน E</span></div>
              <div class="ov-zone-block ov-zone-D" data-zone="D">
                <span class="ov-zone-title">โซน D</span></div>
              <div class="ov-zone-block ov-zone-X" data-zone="X">
                <span class="ov-zone-title">โซน X</span></div>
              <div class="ov-zone-block ov-zone-A" data-zone="A">
                <span class="ov-zone-title">โซน A</span></div>
              <div class="ov-zone-block ov-zone-F" data-zone="F">
                <span class="ov-zone-title">โซน F</span></div>
              <div class="ov-zone-block ov-zone-B" data-zone="B">
                <span class="ov-zone-title">โซน B</span></div>
              <div class="ov-zone-block ov-zone-C" data-zone="C">
                <span class="ov-zone-title">โซน C</span></div>
            </div>

            <div class="legend-box">
              <div class="legend-row">
                <div class="legend-item"><div class="color-box color-empty"></div>
                  ว่าง</div>
                <div class="legend-item"><div class="color-box color-booked"></div>
                  จองแล้ว</div>
                <div class="legend-item"><div
                    class="color-box color-selected"></div>
                  เลือกอยู่</div>
                <div class="legend-item"><div
                    class="color-box color-requested"></div>
                  แถวที่คำขอระบุ</div>
              </div>
              <div class="legend-divider"></div>
              <div class="legend-row">
                <div class="legend-item"><div class="color-box color-pink"></div>
                  มุมพิเศษ สีชมพู (+69)</div>
                <div class="legend-item"><div class="color-box color-blue"></div>
                  มุมพิเศษ สีฟ้า (+29 / A9 +20)</div>
                <div class="legend-item"><div class="color-box color-yellow"></div>
                  มุมพิเศษ สีเหลือง (+89)</div>
                <div class="legend-item"><div class="color-box color-alt-fashion"></div>
                  แถวแฟชั่นปนในโซนอาหาร (B601-B623)</div>
                <div class="legend-item"><div class="color-box color-alt-food"></div>
                  แถวอาหารปนในโซนแฟชั่น (A901-A923)</div>
                <button type="button" class="btn-color-toggle"
                  onclick="toggleLotColors(this)"><i class="fa-solid fa-palette"></i> สีมุมพิเศษ</button>
              </div>
            </div>

          </div>
        </div>

        <div class="map-outer">
          <div class="road-left">
            <div class="road-left-stripe"></div>
            <span class="road-left-text">ทางเข้าตลาด 62 บล็อค</span>
            <i class="fa-solid fa-arrow-down"
              style="position:absolute; bottom:20px; color:#555;"></i>
          </div>

          <div class="map-inner">
            <div class="road-top">
              <div class="road-top-sign"><i class="fa-solid fa-location-dot"
                  style="color:red;"></i> U Seoul Grill</div>
            </div>

            <div class="admin-zone-canvas" id="adminGrid"></div>

            <div class="road-bottom">
              <div class="road-bottom-stripe"></div>
              <span style="font-weight: 700; font-size: 14px;">เข้า-ออก</span>
            </div>
          </div>

          <div class="road-right">
            <span class="road-right-text">ลานจอดรถ กังสดาลไนท์</span>
          </div>
        </div>

        <div class="action-footer">
          <button class="btn-reject-main"
            onclick="rejectStall()">ปฏิเสธการจอง</button>
          <button class="btn-save"
            onclick="confirmStall()">ยืนยันการจัดแผง</button>
        </div>

      </div>

      <div class="confirm-overlay" id="confirmOverlay"
        onclick="closeConfirmOnOverlay(event)">
        <div class="confirm-card">
          <div class="confirm-head">
            <span>ยืนยันการจัดแผง</span>
            <button class="confirm-close" onclick="closeConfirmSummary()">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>

          <div class="confirm-body">
            <div class="confirm-grid">
              <span class="confirm-label">ล็อกที่เลือก</span>
              <span class="confirm-value highlight" id="c-stall">-</span>

              <span class="confirm-label">ชื่อร้านค้า</span>
              <span class="confirm-value" id="c-shop">-</span>

              <span class="confirm-label">ชื่อผู้จอง</span>
              <span class="confirm-value" id="c-name">-</span>

              <span class="confirm-label">เบอร์โทรศัพท์</span>
              <span class="confirm-value" id="c-phone">-</span>

              <span class="confirm-label">โซน/แถวคำขอ</span>
              <span class="confirm-value" id="c-zone">-</span>

              <span class="confirm-label">ประเภทสินค้า</span>
              <span class="confirm-value" id="c-product-type">-</span>

              <span class="confirm-label">ระยะเวลาเช่า</span>
              <span class="confirm-value" id="c-rental">-</span>

              <span class="confirm-label">ราคาล็อกที่เลือก</span>
              <span class="confirm-value" id="c-price-check">-</span>

              <span class="confirm-label">วันที่ส่งคำขอ</span>
              <span class="confirm-value" id="c-date">-</span>
            </div>

            <div class="confirm-note">
              <strong>รายละเอียดร้านค้า/สินค้าที่ขาย:</strong><br>
              <span id="c-note">-</span>
            </div>

            <div class="confirm-actions">
              <button class="btn-cancel-confirm"
                onclick="closeConfirmSummary()">ย้อนกลับ</button>
              <button class="btn-final-confirm"
                onclick="submitConfirmStall()">ยืนยันและกลับหน้าอนุมัติ</button>
            </div>
          </div>
        </div>
      </div>

    </div>

    <script src="/js/common/dialogs.js"></script>
    <script>
  const PAGE_DATA = <%- JSON.stringify(pageData || {}) %>;
  const REQUEST_DATA = PAGE_DATA.bookingRequest || {};
  const ZONE_BY_CODE = PAGE_DATA.zoneByCode || {};
  const BOOKED_STALLS = new Set(PAGE_DATA.bookedStalls || []);

  let showLotColors = false; // เปิด/ปิดสีมุมพิเศษบนผัง

  // map สีจริงของล็อคมุมพิเศษ (จาก data/lots.csv) ไปเป็น class สี — ฟ้า กับ ฟ้า-A9 ใช้เฉดเดียวกัน
  function lotColorClass(color) {
    if (!showLotColors) return '';
    if (color === 'ชมพู') return 'lot-pink';
    if (color === 'ฟ้า' || color === 'ฟ้า-A9') return 'lot-blue';
    if (color === 'เหลือง') return 'lot-yellow';
    return '';
  }

  function toggleLotColors(btn) {
    showLotColors = !showLotColors;
    btn.classList.toggle('active', showLotColors);
    renderGrid(currentZone);
  }
  window.toggleLotColors = toggleLotColors;

  const REQUESTED_STALL_COUNT = Math.max(1, Number.parseInt(REQUEST_DATA.requestedStallCount, 10) || 1);
  // เก็บล็อกที่เลือกไว้เป็น array เพราะ 1 คำขออาจขอมากกว่า 1 ล็อก (REQUESTED_STALL_COUNT > 1)
  let currentSelectedStalls = Array.isArray(REQUEST_DATA.assignedStallCodes) ? [...REQUEST_DATA.assignedStallCodes] : [];
  let currentZone = (REQUEST_DATA.zone || Object.keys(ZONE_BY_CODE)[0] || 'A').toUpperCase();

  const tooltip = document.getElementById('adminTooltip');
  const confirmOverlay = document.getElementById('confirmOverlay');
  const zoneBtns = document.querySelectorAll('.btn-zone');
  const overviewBlocks = document.querySelectorAll('.ov-zone-block');
  const zoneInfoCode = document.getElementById('zoneInfoCode');
  const zoneInfoText = document.getElementById('zoneInfoText');
  const toggleBtns = document.querySelectorAll('.toggle-btn');
  const zoneButtonsPanel = document.getElementById('zoneButtons');
  const zoneOverviewPanel = document.getElementById('zoneOverviewCanvas');

  function setApplicantData() {
    document.getElementById('app-name').textContent = REQUEST_DATA.sellerName || '-';
    document.getElementById('app-shop').textContent = REQUEST_DATA.shop || '-';
    document.getElementById('app-phone').textContent = REQUEST_DATA.phone || '-';
    document.getElementById('app-zone').textContent = REQUEST_DATA.zoneText || '-';
    document.getElementById('app-date').textContent = REQUEST_DATA.dateText || '-';
    document.getElementById('app-note').textContent = REQUEST_DATA.note || '-';
    document.getElementById('app-product-type').textContent = REQUEST_DATA.productTypeText || '-';
    const stallCountEl = document.getElementById('app-stall-count');
    if (stallCountEl) {
      stallCountEl.textContent = REQUESTED_STALL_COUNT > 1 ? `${REQUESTED_STALL_COUNT} ล็อก (ขอมากกว่า 1 ล็อก กรุณาเลือกให้ครบ)` : '1 ล็อก';
    }

    const rentalPeriodEl = document.getElementById('app-rental-period');
    if (rentalPeriodEl) {
      rentalPeriodEl.textContent = REQUEST_DATA.rentalDays
        ? `${REQUEST_DATA.rentalDays} วัน (${REQUEST_DATA.rentalPeriodText})`
        : 'ยังไม่มีข้อมูล';
    }

    if (REQUEST_DATA.grandTotalAllStalls) {
      const applianceParts = [];
      if (REQUEST_DATA.smallApplianceCount) applianceParts.push(`เครื่องเล็ก ${REQUEST_DATA.smallApplianceCount}`);
      if (REQUEST_DATA.largeApplianceCount) applianceParts.push(`เครื่องใหญ่ ${REQUEST_DATA.largeApplianceCount}`);
      if (REQUEST_DATA.lightEnabled) applianceParts.push('เปิดไฟ');
      const extra = applianceParts.length ? ` (${applianceParts.join(', ')})` : '';
      document.getElementById('app-grand-total').textContent =
        `${Number(REQUEST_DATA.grandTotalAllStalls).toLocaleString('th-TH')} บาท${extra}`;
      document.getElementById('app-grand-total-group').style.display = '';
    }

    if (REQUEST_DATA.productImage) {
      document.getElementById('app-image').src = REQUEST_DATA.productImage;
      document.getElementById('app-image-group').style.display = '';
    }

    if (REQUEST_DATA.cornerZoneNote) {
      document.getElementById('app-corner-note').textContent = REQUEST_DATA.cornerZoneNote;
      document.getElementById('app-corner-note-group').style.display = '';
    }
  }

  // จำกัดโซนที่แอดมินเลือกได้ให้ตรงกับประเภทสินค้าที่ผู้ขายลงทะเบียนไว้ (มาจาก allowedZones ที่ backend คำนวณแล้ว)
  // ถ้า backend ส่งมาว่างเปล่า (ไม่มีข้อมูลประเภทสินค้า) ไม่จำกัด ให้เลือกได้ทุกโซนเหมือนเดิม
  // แอดมินกดปุ่ม "แสดงทุกโซน" เพื่อปิดการจำกัดชั่วคราวได้ เผื่อกรณีพิเศษที่อยากดูโซนอื่นด้วย
  const ALLOWED_ZONES = (REQUEST_DATA.allowedZones || []).map((z) => String(z).toUpperCase());
  let showAllZones = false;

  function toggleShowAllZones(btn) {
    showAllZones = !showAllZones;
    btn.classList.toggle('active', showAllZones);
    renderZoneButtons();
  }
  window.toggleShowAllZones = toggleShowAllZones;

  function renderZoneButtons() {
    const zonesInMap = Object.keys(ZONE_BY_CODE);
    const isRestricted = ALLOWED_ZONES.length > 0 && !showAllZones;
    const availableZones = isRestricted
      ? zonesInMap.filter((zone) => ALLOWED_ZONES.includes(zone))
      : zonesInMap;
    zoneBtns.forEach((btn) => {
      const zone = (btn.dataset.zone || '').toUpperCase();
      btn.style.display = availableZones.includes(zone) ? 'inline-flex' : 'none';
    });
    overviewBlocks.forEach((block) => {
      const zone = (block.dataset.zone || '').toUpperCase();
      block.style.display = availableZones.includes(zone) ? 'flex' : 'none';
    });

    const restrictRow = document.getElementById('zoneRestrictRow');
    const restrictNote = document.getElementById('zoneRestrictNote');
    if (restrictRow && restrictNote && ALLOWED_ZONES.length) {
      restrictRow.style.display = 'flex';
      restrictNote.textContent = isRestricted
        ? `— ผู้จองลงทะเบียนขายประเภท "${REQUEST_DATA.productTypeText || '-'}" เลือกได้เฉพาะโซน: ${ALLOWED_ZONES.join(', ')}`
        : `— กำลังแสดงทุกโซน (ปกติจำกัดเฉพาะ: ${ALLOWED_ZONES.join(', ')} ตามประเภทสินค้า "${REQUEST_DATA.productTypeText || '-'}")`;
    }
  }

  function setActiveZoneBtn(zoneCode) {
    zoneBtns.forEach((b) => {
      b.classList.toggle('active', (b.dataset.zone || '').toUpperCase() === zoneCode);
    });
    overviewBlocks.forEach((b) => {
      b.classList.toggle('active', (b.dataset.zone || '').toUpperCase() === zoneCode);
    });
  }

  function setViewMode(mode) {
    toggleBtns.forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.mode === mode);
    });
    zoneButtonsPanel.style.display = mode === 'overview' ? 'none' : 'flex';
    zoneOverviewPanel.style.display = mode === 'overview' ? 'block' : 'none';
  }

  // สรุปขนาด/ราคาของโซนที่เลือกให้เห็นชัดโดยไม่ต้องเอาเมาส์ไปชี้ทีละล็อก
  // ใช้ราคาที่มีจำนวนล็อกมากที่สุดเป็นตัวแทนโซน แล้วโชว์ราคาส่วนน้อย (ถ้ามี) ต่อท้าย เช่น โซน B ที่มีแถว B6 เป็นแฟชั่นปนอยู่
  function updateZoneInfo(zoneKey) {
    if (!zoneInfoCode || !zoneInfoText) return;
    zoneInfoCode.textContent = zoneKey || '-';

    const zoneData = ZONE_BY_CODE[zoneKey];
    if (!zoneData || !zoneData.columns.length) {
      zoneInfoText.textContent = 'ไม่มีข้อมูลแผงสำหรับโซนนี้';
      return;
    }

    // จัดกลุ่มตาม "ประเภท" ก่อน (แฟชั่น 3x3 / อาหาร 3x3 ฯลฯ) ไม่ใช่ตามราคาที่บวกมุมพิเศษแล้ว
    // เพราะล็อกมุมพิเศษ (ชมพู/ฟ้า/เหลือง) ทำให้ราคาแตกย่อยเยอะ ดูรกถ้าแยกทีละราคา — สรุปแค่ "ราคาปกติ" ของแต่ละประเภทพอ
    const typeGroups = new Map();
    zoneData.columns.forEach((column) => {
      column.stalls.forEach((stall) => {
        if (stall.status === 'PLACEHOLDER' || stall.pricePerDay == null || !stall.lotType) return;
        const group = typeGroups.get(stall.lotType) || { count: 0, priceCounts: new Map() };
        group.count += 1;
        group.priceCounts.set(stall.pricePerDay, (group.priceCounts.get(stall.pricePerDay) || 0) + 1);
        typeGroups.set(stall.lotType, group);
      });
    });

    if (!typeGroups.size) {
      zoneInfoText.textContent = 'ไม่มีข้อมูลราคาสำหรับโซนนี้';
      return;
    }

    // ราคา "ปกติ" ของแต่ละประเภท = ราคาที่ล็อกส่วนใหญ่ในประเภทนั้นใช้ (ไม่รวมมุมพิเศษ)
    function normalPriceOf(group) {
      return [...group.priceCounts.entries()].sort((a, b) => b[1] - a[1])[0][0];
    }

    const sortedTypes = [...typeGroups.entries()].sort((a, b) => b[1].count - a[1].count);
    const describeType = ([type, group]) => {
      const hasCornerVariants = group.priceCounts.size > 1;
      const base = `${type} · ${normalPriceOf(group).toLocaleString('th-TH')} บาท/วัน`;
      return hasCornerVariants ? `${base} (บางล็อกมุมพิเศษราคาต่างจากนี้ ดูป้ายสีด้านล่าง)` : base;
    };

    let text = `${describeType(sortedTypes[0])} · ${sortedTypes[0][1].count} ล็อก`;

    if (sortedTypes.length > 1) {
      const minorText = sortedTypes.slice(1)
        .map((entry) => `${describeType(entry)} (${entry[1].count} ล็อก)`)
        .join(', ');
      text += ` — ปนอยู่: ${minorText}`;
    }

    zoneInfoText.textContent = text;
  }

  function selectZone(selectedZone) {
    if (!ZONE_BY_CODE[selectedZone]) return;
    currentZone = selectedZone;
    setActiveZoneBtn(selectedZone);
    updateZoneInfo(selectedZone);
    renderGrid(selectedZone);
  }

  // โซน D ในผังจริงเป็นรูปตัว L (แถวบน D201-D208 8 ช่อง, ต่อลงมาแนวตั้ง D209 ใต้ D208,
  // และมีกลุ่ม D211-D212 แยกอยู่ระดับล่างซ้าย) เก็บตำแหน่งจริงไว้ตรงนี้เหมือนหน้าผังตลาด
  const ZONE_D_LAYOUT = [
    { code: 'D201', col: 3, row: 1 }, { code: 'D202', col: 4, row: 1 },
    { code: 'D203', col: 5, row: 1 }, { code: 'D204', col: 6, row: 1 },
    { code: 'D205', col: 7, row: 1 }, { code: 'D206', col: 8, row: 1 },
    { code: 'D207', col: 9, row: 1 }, { code: 'D208', col: 10, row: 1 },
    { code: 'D211', col: 2, row: 2 }, { code: 'D212', col: 3, row: 2 },
    { code: 'D209', col: 10, row: 2 }
  ];

  // สลับเลือก/ยกเลิกล็อก — เลือกได้ไม่เกินจำนวนล็อกที่คำขอนี้ขอมา (REQUESTED_STALL_COUNT)
  function toggleStallSelection(code, cell) {
    const alreadySelected = currentSelectedStalls.includes(code);
    if (alreadySelected) {
      currentSelectedStalls = currentSelectedStalls.filter((c) => c !== code);
      cell.classList.remove('selected');
      return;
    }

    if (currentSelectedStalls.length >= REQUESTED_STALL_COUNT) {
      window.showAlertDialog({
        title: 'เลือกครบจำนวนแล้ว',
        message: `คำขอนี้ขอมา ${REQUESTED_STALL_COUNT} ล็อก กรุณายกเลิกล็อกที่เลือกไว้ก่อนหากต้องการเปลี่ยน`,
        tone: 'warning'
      });
      return;
    }

    currentSelectedStalls.push(code);
    cell.classList.add('selected');
  }

  // true ถ้าล็อกนี้เป็นคนละประเภทกับหมวดหลักของโซน (เช่น B601-B623 แฟชั่นที่ปนอยู่ในโซน B ซึ่งหลักๆ เป็นอาหาร,
  // หรือ A901-A923 อาหารที่ปนอยู่ในโซน A ซึ่งหลักๆ เป็นแฟชั่น)
  function isAltTypeStall(stall, zoneCategoryLabel) {
    return !!(stall && stall.lotType && zoneCategoryLabel && !stall.lotType.startsWith(zoneCategoryLabel));
  }

  // แยกสีตามประเภทจริงของล็อกที่ปนอยู่ ไม่ใช้สีเดียวรวมกันหมด จะได้แยกออกว่าล็อกที่ปนเป็นอาหารหรือแฟชั่น
  function altTypeClass(stall) {
    if (!stall || !stall.lotType) return '';
    if (stall.lotType.startsWith('อาหาร')) return 'lot-alt-food';
    if (stall.lotType.startsWith('แฟชั่น')) return 'lot-alt-fashion';
    return 'lot-alt-type';
  }

  // groupSize 2 = ล็อก T คู่ที่วางซ้อนกันแบ่งครึ่งล็อคปกติ 1 ล็อก, groupSize 1 = อยู่เดี่ยวเต็มล็อคปกติ (ตามผังจริง)
  function isPairedStall(stall) {
    return !!(stall && stall.small && stall.groupSize === 2);
  }

  function makeStallCell(code, stall, zoneCategoryLabel) {
    const cell = document.createElement('div');
    cell.className = isPairedStall(stall) ? 'stall-cell stall-cell-small' : 'stall-cell';
    cell.textContent = code;

    const lotClass = stall ? lotColorClass(stall.lotColor) : '';
    if (lotClass) cell.classList.add(lotClass);

    if (isAltTypeStall(stall, zoneCategoryLabel)) cell.classList.add(altTypeClass(stall));

    const isBooked = BOOKED_STALLS.has(code);
    if (isBooked) {
      cell.classList.add('booked');
      if (stall && stall.expiryState === 'expired') cell.classList.add('expired');
      else if (stall && stall.expiryState === 'near') cell.classList.add('near-expiry');
      cell.addEventListener('mouseenter', (e) => showTooltip(e, code, stall, true));
      cell.addEventListener('mouseleave', hideTooltip);
      cell.addEventListener('mousemove', moveTooltip);
    } else {
      cell.addEventListener('mouseenter', (e) => showTooltip(e, code, stall, false));
      cell.addEventListener('mouseleave', hideTooltip);
      cell.addEventListener('mousemove', moveTooltip);
      cell.addEventListener('click', () => {
        toggleStallSelection(code, cell);
      });
    }

    if (currentSelectedStalls.includes(code)) {
      cell.classList.add('selected');
    }

    return cell;
  }

  function renderDZoneGrid(gridContainer, stallByCode) {
    const layout = document.createElement('div');
    layout.className = 'zone-d-layout';

    const label = document.createElement('div');
    label.className = 'zone-d-tag';
    label.style.gridColumn = '1 / 2';
    label.style.gridRow = '2 / 3';
    label.textContent = 'D2';
    layout.appendChild(label);

    ZONE_D_LAYOUT.forEach((pos) => {
      const stall = stallByCode[pos.code];
      if (!stall) return;

      const cell = makeStallCell(pos.code, stall);
      cell.classList.add('zone-d-cell');
      cell.style.gridColumn = `${pos.col} / ${pos.col + 1}`;
      cell.style.gridRow = `${pos.row} / ${pos.row + 1}`;
      layout.appendChild(cell);
    });

    gridContainer.appendChild(layout);
  }

  function renderGrid(zoneKey) {
    const gridContainer = document.getElementById('adminGrid');
    gridContainer.innerHTML = '';

    const zoneData = ZONE_BY_CODE[zoneKey];
    if (!zoneData || !zoneData.columns.length) {
      gridContainer.innerHTML = '<div style="padding:24px; color:#666;">ไม่มีข้อมูลแผงสำหรับโซนนี้</div>';
      return;
    }

    if (zoneKey === 'D') {
      const stallByCode = {};
      zoneData.columns.forEach((column) => {
        column.stalls.forEach((stall) => { stallByCode[stall.code] = stall; });
      });
      renderDZoneGrid(gridContainer, stallByCode);
      return;
    }

    // โซน E, X, C ในผังจริงมีแถวเดียวเรียงตามแนวนอน (ซ้ายไปขวา) ไม่ใช่เรียงลงมาแนวตั้งแบบโซนอื่น
    const isHorizontalZone = ['E', 'X', 'C'].includes(zoneKey);

    zoneData.columns.forEach((column) => {
      const blockClasses = ['col-block'];
      if (column.groupEnd) blockClasses.push('col-group-end');

      const blockDiv = document.createElement('div');
      blockDiv.className = blockClasses.join(' ');

      const lbl = document.createElement('div');
      lbl.className = 'col-lbl';
      lbl.textContent = column.rowCode;
      const altStall = column.stalls.find((s) => isAltTypeStall(s, zoneData.description));
      if (altStall) {
        lbl.classList.add('col-lbl-alt', altTypeClass(altStall));
      }

      const wrap = document.createElement('div');
      wrap.className = isHorizontalZone ? 'col-wrap col-wrap-horizontal' : 'col-wrap';
      wrap.appendChild(lbl);

      const colDiv = document.createElement('div');
      colDiv.className = isHorizontalZone ? 'stall-column stall-column-horizontal' : 'stall-column';

      // ล็อกเล็ก (โซน T ที่แทรกอยู่ในคอลัมน์ B2) บางคู่วางซ้อนกันแบ่งครึ่งบน-ล่างของล็อคปกติ 1 ล็อกตามผังจริง
      // (groupSize 2 = จับคู่ซ้อน, groupSize 1 = อยู่เดี่ยวเต็มล็อคปกติ — ดู T_GROUP_SIZES ใน marketController.js)
      let smallWrap = null;
      let currentGroupId = null;
      const getSmallWrap = (groupId) => {
        if (!smallWrap || groupId !== currentGroupId) {
          currentGroupId = groupId;
          smallWrap = document.createElement('div');
          smallWrap.className = 'small-lot-pair';
          colDiv.appendChild(smallWrap);
        }
        return smallWrap;
      };

      column.stalls.forEach((stall) => {
        if (stall.status === 'PLACEHOLDER') {
          const placeholderCell = document.createElement('div');
          placeholderCell.className = isPairedStall(stall) ? 'stall-cell stall-cell-small placeholder' : 'stall-cell placeholder';
          placeholderCell.textContent = 'x';
          (isPairedStall(stall) ? getSmallWrap(stall.groupId) : colDiv).appendChild(placeholderCell);
          return;
        }

        const cell = makeStallCell(stall.code, stall, zoneData.description);
        (isPairedStall(stall) ? getSmallWrap(stall.groupId) : colDiv).appendChild(cell);
      });

      wrap.appendChild(colDiv);
      blockDiv.appendChild(wrap);
      gridContainer.appendChild(blockDiv);
    });
  }

  function showTooltip(e, code, stall, isBooked) {
    document.getElementById('tt-stall-id').textContent = code;
    tooltip.classList.toggle('tt-available', !isBooked);

    if (isBooked) {
      document.getElementById('tt-label-shop').textContent = 'ชื่อร้านค้า';
      document.getElementById('tt-shop').textContent = 'มีผู้จองแล้ว';
      document.getElementById('tt-label-lock').textContent = 'หมายเลขล็อก';
      document.getElementById('tt-lock').textContent = code;
      document.getElementById('tt-label-date').textContent = 'วันที่จอง';
      document.getElementById('tt-date').textContent = '-';
      document.getElementById('tt-label-name').textContent = 'ผู้จอง';
      document.getElementById('tt-name').textContent = '-';
      document.getElementById('tt-phone-group').style.display = '';
      document.getElementById('tt-label-phone').textContent = 'เบอร์โทรศัพท์';
      document.getElementById('tt-phone').textContent = '-';
      document.getElementById('tt-label-note').textContent = 'หมายเหตุ';
      document.getElementById('tt-note').textContent = 'ล็อกนี้ไม่ว่าง';
    } else {
      const colorText = stall && stall.lotColor && stall.lotColor !== 'ไม่มี' ? `สี${stall.lotColor}` : '-';
      document.getElementById('tt-label-shop').textContent = 'สถานะ';
      document.getElementById('tt-shop').textContent = 'ว่าง — พร้อมให้จอง';
      document.getElementById('tt-label-lock').textContent = 'ประเภท/ขนาด';
      document.getElementById('tt-lock').textContent = (stall && stall.lotType) || '-';
      document.getElementById('tt-label-date').textContent = 'ราคา/วัน';
      document.getElementById('tt-date').textContent = stall && stall.pricePerDay != null
        ? `${stall.pricePerDay.toLocaleString('th-TH')} บาท`
        : '-';
      document.getElementById('tt-label-name').textContent = 'มุมพิเศษ';
      document.getElementById('tt-name').textContent = colorText;
      document.getElementById('tt-phone-group').style.display = 'none';
      document.getElementById('tt-label-note').textContent = 'หมายเหตุ';
      document.getElementById('tt-note').textContent = 'คลิกที่ล็อกนี้เพื่อเลือก';
    }

    tooltip.style.display = 'block';
    moveTooltip(e);
  }

  function hideTooltip() {
    tooltip.style.display = 'none';
  }

  function moveTooltip(e) {
    // ให้ tooltip โผล่ด้านข้างเมาส์ (แนวนอน) แทนบน/ล่าง กันไม่ให้ทับแถวล็อกที่อยู่ติดกัน
    // (แถวในผังสูงแค่ ~28px ตัว tooltip สูงกว่านั้นมาก ถ้าวางบน/ล่างจะทับแถวข้างเคียงเสมอ เช่นโซน D ที่มีแค่ 2 แถว)
    let x = e.clientX + 20;
    let y = e.clientY - (tooltip.offsetHeight / 2);

    if (x + tooltip.offsetWidth > window.innerWidth) {
      x = e.clientX - tooltip.offsetWidth - 20;
    }
    if (x < 0) x = 4;

    if (y < 0) y = 4;
    if (y + tooltip.offsetHeight > window.innerHeight) {
      y = window.innerHeight - tooltip.offsetHeight - 4;
    }

    tooltip.style.left = `${x}px`;
    tooltip.style.top = `${y}px`;
  }

  function confirmStall() {
    if (!currentSelectedStalls.length) {
      window.showAlertDialog({
        title: 'ยังไม่ได้เลือกแผงค้า',
        message: `กรุณาคลิกเลือกแผงค้า ${REQUESTED_STALL_COUNT} ล็อกบนแผนที่เพื่อจัดแผงให้ลูกค้า`,
        tone: 'warning'
      });
      return;
    }
    if (currentSelectedStalls.length < REQUESTED_STALL_COUNT) {
      window.showAlertDialog({
        title: 'เลือกล็อกยังไม่ครบ',
        message: `คำขอนี้ขอมา ${REQUESTED_STALL_COUNT} ล็อก แต่เลือกไว้แค่ ${currentSelectedStalls.length} ล็อก กรุณาเลือกให้ครบก่อนยืนยัน`,
        tone: 'warning'
      });
      return;
    }
    openConfirmSummary();
  }

  // หาข้อมูลล็อก (ราคา/ประเภท) จาก ZONE_BY_CODE ด้วยรหัสล็อก ไม่สนใจว่ากำลังดูโซนไหนอยู่บนจอตอนนี้
  function findStallInfo(code) {
    for (const zoneCode of Object.keys(ZONE_BY_CODE)) {
      for (const column of ZONE_BY_CODE[zoneCode].columns) {
        const found = column.stalls.find((s) => s.code === code);
        if (found) return found;
      }
    }
    return null;
  }

  function openConfirmSummary() {
    document.getElementById('c-stall').textContent = currentSelectedStalls.join(', ');
    document.getElementById('c-shop').textContent = document.getElementById('app-shop').textContent || '-';
    document.getElementById('c-name').textContent = document.getElementById('app-name').textContent || '-';
    document.getElementById('c-phone').textContent = document.getElementById('app-phone').textContent || '-';
    document.getElementById('c-zone').textContent = document.getElementById('app-zone').textContent || '-';
    document.getElementById('c-date').textContent = document.getElementById('app-date').textContent || '-';
    document.getElementById('c-note').textContent = document.getElementById('app-note').textContent || '-';
    document.getElementById('c-product-type').textContent = REQUEST_DATA.productTypeText || '-';
    document.getElementById('c-rental').textContent = REQUEST_DATA.rentalDays
      ? `${REQUEST_DATA.rentalDays} วัน (${REQUEST_DATA.rentalPeriodText})`
      : 'ยังไม่มีข้อมูล';

    // เช็คราคาล็อกที่แอดมินเลือกจริงกับยอดรวมที่ผู้ขายเห็นตอนส่งคำขอ เผื่อเลือกล็อกคนละราคากับที่คำนวณไว้
    // (เช่น เผลอเลือกล็อกมุมพิเศษ หรือแถวคนละประเภทในโซนผสมอย่าง B/A9)
    const priceCheckEl = document.getElementById('c-price-check');
    const stallInfos = currentSelectedStalls.map(findStallInfo).filter((s) => s && s.pricePerDay != null);
    if (stallInfos.length !== currentSelectedStalls.length || !REQUEST_DATA.rentalDays) {
      priceCheckEl.textContent = stallInfos.length
        ? `${stallInfos.reduce((sum, s) => sum + s.pricePerDay, 0).toLocaleString('th-TH')} บาท/วัน`
        : 'ไม่มีข้อมูลราคา';
      priceCheckEl.classList.remove('highlight');
    } else {
      const dailyTotal = stallInfos.reduce((sum, s) => sum + s.pricePerDay, 0);
      const computedTotal = dailyTotal * REQUEST_DATA.rentalDays;
      const expectedTotal = Number(REQUEST_DATA.grandTotalAllStalls || 0);
      const matches = !expectedTotal || Math.abs(computedTotal - expectedTotal) < 1;
      priceCheckEl.textContent = `${dailyTotal.toLocaleString('th-TH')} บาท/วัน × ${REQUEST_DATA.rentalDays} วัน = ${computedTotal.toLocaleString('th-TH')} บาท`
        + (matches ? '' : ` (ผู้ขายเห็นยอดรวม ${expectedTotal.toLocaleString('th-TH')} บาท — ไม่ตรงกัน ตรวจสอบก่อนยืนยัน)`);
      priceCheckEl.classList.toggle('highlight', !matches);
      priceCheckEl.style.color = matches ? '' : 'var(--danger-color, #c0392b)';
    }

    confirmOverlay.classList.add('active');
  }

  function closeConfirmSummary() {
    confirmOverlay.classList.remove('active');
  }

  function closeConfirmOnOverlay(event) {
    if (event.target === confirmOverlay) {
      closeConfirmSummary();
    }
  }

  function postForm(action, fields) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = action;

    Object.keys(fields).forEach((key) => {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = key;
      input.value = String(fields[key] || '');
      form.appendChild(input);
    });

    document.body.appendChild(form);
    form.submit();
  }

  function submitConfirmStall() {
    postForm('/admin/booking-stall/confirm', {
      requestId: REQUEST_DATA.id || '',
      selectedStalls: currentSelectedStalls.join(',')
    });
  }

  function rejectStall() {
    window.showConfirmDialog({
      title: 'ปฏิเสธคำขอนี้?',
      message: 'คุณแน่ใจหรือไม่ที่จะปฏิเสธคำขอนี้',
      tone: 'danger',
      confirmText: 'ปฏิเสธคำขอ',
      onConfirm: () => postForm('/admin/booking-stall/reject', {
        requestId: REQUEST_DATA.id || ''
      })
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    setApplicantData();
    renderZoneButtons();
    setActiveZoneBtn(currentZone);
    updateZoneInfo(currentZone);
    renderGrid(currentZone);
    setViewMode('buttons');

    zoneBtns.forEach((btn) => {
      btn.addEventListener('click', function () {
        selectZone(String(this.dataset.zone || '').toUpperCase());
      });
    });

    overviewBlocks.forEach((block) => {
      block.addEventListener('click', function () {
        selectZone(String(this.dataset.zone || '').toUpperCase());
      });
    });

    toggleBtns.forEach((btn) => {
      btn.addEventListener('click', function () {
        setViewMode(this.dataset.mode);
      });
    });
  });

  window.confirmStall = confirmStall;
  window.closeConfirmSummary = closeConfirmSummary;
  window.closeConfirmOnOverlay = closeConfirmOnOverlay;
  window.submitConfirmStall = submitConfirmStall;
  window.rejectStall = rejectStall;

</script>
  </body>
</html>