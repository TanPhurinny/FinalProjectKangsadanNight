<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Market Map | Kangsadan Night Market</title>
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css"
            rel="stylesheet">
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
            rel="stylesheet">
        <link
            href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&display=swap"
            rel="stylesheet">
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css">
        <link rel="stylesheet" href="/stylesheets/admin/theme.css">
        <link rel="stylesheet" href="/stylesheets/admin/slots.css">
        <link rel="stylesheet" href="/stylesheets/responsive.css">
    </head>
    <body>
        <%- include('../partials/navbar') %>

        <div class="slots-wrapper">
            <header
                class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="fw-bold">ผังตลาดกังสดาล (Digital Map)</h1>
                <div class="legend-bar shadow-sm border">
                    <span><i class="fas fa-square text-success"></i> ว่าง</span>
                    <span><i class="fas fa-square text-danger"></i>
                        จองแล้ว</span>
                    <span><i class="fas fa-square text-secondary"></i>
                        ไม่มีข้อมูล</span>
                </div>
            </header>

            <div class="market-layout">
                <div class="layout-column">
                    <div class="zone-header">ZONE A & C</div>
                    <div class="slot-grid grid-left">
                        <%
                        const zoneAC =
                        ['A101','A102','A103','A104','A201','A202','A301','A302','C101','C102','C103'];
                        zoneAC.forEach(id => {
                        const data = slotsData[id];
                        const statusClass = data ? (data.isAvailable ?
                        'is-available' : 'is-occupied') : 'is-empty';
                        %>
                        <div class="slot-box <%= statusClass %>"
                            onclick="manageSlot('<%= id %>')"><%= id %></div>
                        <% }) %>
                    </div>
                </div>

                <div class="layout-column">
                    <div class="zone-header">ZONE D, E, F</div>
                    <div class="slot-grid grid-central">
                        <%
                        const zoneCentral =
                        ['E101','E102','E103','E104','F101','F102','F201','F202','D211','D212','F301','F302'];
                        zoneCentral.forEach(id => {
                        const data = slotsData[id];
                        const statusClass = data ? (data.isAvailable ?
                        'is-available' : 'is-occupied') : 'is-empty';
                        %>
                        <div class="slot-box <%= statusClass %>"
                            onclick="manageSlot('<%= id %>')"><%= id %></div>
                        <% }) %>
                    </div>
                </div>

                <div class="layout-column">
                    <div class="zone-header">ZONE B & FASHION</div>
                    <div class="slot-grid grid-right">
                        <%
                        const zoneBXT =
                        ['B101','B201','B301','X101','X102','T101','T102','T111','T112','B714','B715'];
                        zoneBXT.forEach(id => {
                        const data = slotsData[id];
                        const statusClass = data ? (data.isAvailable ?
                        'is-available' : 'is-occupied') : 'is-empty';
                        %>
                        <div class="slot-box <%= statusClass %>"
                            onclick="manageSlot('<%= id %>')"><%= id %></div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>

        <script>
        function manageSlot(id) {
            window.location.href = `/admin/slots/manage/${id}`;
        }
    </script>
    </body>
</html>