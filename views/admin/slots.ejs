<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>ผังตลาด — Admin</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link
            href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Sarabun:wght@300;400;500;600;700&family=Prompt:wght@400;500;600;700&display=swap"
            rel="stylesheet" />
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css"
            rel="stylesheet" />
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
            rel="stylesheet" />
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css">
        <link rel="stylesheet" href="/stylesheets/admin/theme.css">
        <link rel="stylesheet" href="/stylesheets/admin/slots.css">
        <link rel="stylesheet" href="/stylesheets/responsive.css">
    </head>
    <body class="bg-light">
        <%- include('../partials/navbar') %>

        <div class="slots-page">

            <!-- TOP BAR -->
            <div class="top-bar">
                <div class="bar-title"><i class="fa-solid fa-map fa-sm me-1"
                        style="color:var(--primary)"></i> ผังตลาด</div>
                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" id="searchInput"
                        placeholder="ค้นหา เช่น หมูปิ้ง, เสื้อผ้า, ก๋วยเตี๋ยว..." />
                    <button id="clearBtn" onclick="clearSearch()">✕</button>
                </div>
                <span id="resultBadge"></span>
            </div>

            <!-- QUICK TAGS -->
            <div class="tag-bar">
                <span class="tag-lbl">ค้นหาด่วน:</span>
                <button class="qtag"
                    onclick="quickSearch(this,'หมูปิ้ง')">หมูปิ้ง</button>
                <button class="qtag"
                    onclick="quickSearch(this,'เสื้อผ้า')">เสื้อผ้า</button>
                <button class="qtag"
                    onclick="quickSearch(this,'ก๋วยเตี๋ยว')">ก๋วยเตี๋ยว</button>
                <button class="qtag"
                    onclick="quickSearch(this,'ผัดไทย')">ผัดไทย</button>
                <button class="qtag"
                    onclick="quickSearch(this,'ของทอด')">ของทอด</button>
                <button class="qtag"
                    onclick="quickSearch(this,'ขนม')">ขนม</button>
                <button class="qtag"
                    onclick="quickSearch(this,'เครื่องดื่ม')">เครื่องดื่ม</button>
                <button class="qtag"
                    onclick="quickSearch(this,'ฟู้ดทรัค')">ฟู้ดทรัค</button>
                <button class="qtag"
                    onclick="quickSearch(this,'ไก่ย่าง')">ไก่ย่าง</button>
            </div>

            <!-- PAGE BODY -->
            <div class="page-body">
                <div class="map-shell">
                    <div class="road-top">
                        <div class="sign-charoen"><div class="sign-dot"></div>
                            เจริญหมูกระทะ</div>
                    </div>
                    <div class="map-mid">
                        <div class="road-left">
                            <div class="stripe-v"></div>
                            <span class="road-left-text">ทางเข้าตลาด 62
                                บล็อค</span>
                            <span class="road-arrow"><i
                                    class="fa-solid fa-arrow-down"></i></span>
                        </div>

                        <div class="zone-canvas">
                            <div class="zone-block" id="zone-E"
                                onclick="openZone('E')">
                                <div class="zone-label"><div class="z-title">โซน
                                        E</div><div
                                        class="z-sub">แฟชั่น</div></div>
                            </div>
                            <div class="zone-block" id="zone-D"
                                onclick="openZone('D')">
                                <div class="zone-label"><div class="z-title">โซน
                                        D</div><div
                                        class="z-sub">ฟู้ดทรัค</div></div>
                            </div>
                            <div class="zone-block" id="zone-A"
                                onclick="openZone('A')">
                                <div class="zone-label"><div class="z-title">โซน
                                        A</div><div
                                        class="z-sub">แฟชั่นและอาหาร</div></div>
                            </div>
                            <div class="zone-block" id="zone-F"
                                onclick="openZone('F')">
                                <div class="zone-label"><div class="z-title">โซน
                                        F</div><div
                                        class="z-sub">อาหาร</div></div>
                            </div>
                            <div class="zone-block" id="zone-B"
                                onclick="openZone('B')">
                                <div class="zone-label"><div class="z-title">โซน
                                        B</div><div
                                        class="z-sub">อาหาร</div></div>
                            </div>
                            <div class="zone-block" id="zone-C"
                                onclick="openZone('C')">
                                <div class="zone-label"><div class="z-title">โซน
                                        C</div><div
                                        class="z-sub">แฟชั่น</div></div>
                            </div>
                            <div class="facility-btns">
                                <button class="btn-facility"><i
                                        class="fa-solid fa-restroom fa-xs"></i>
                                    ห้องน้ำ</button>
                                <button class="btn-facility"><i
                                        class="fa-solid fa-user-tie fa-xs"></i>
                                    ออฟฟิศ</button>
                            </div>
                        </div>

                        <div class="road-right">
                            <span class="road-right-text">ลานจอดรถ
                                กังสดาลไนท์</span>
                        </div>
                    </div>
                    <div class="road-bottom">
                        <div class="stripe-h"></div>
                        <span class="sign-inout">เข้า-ออก</span>
                    </div>
                </div>
            </div>

            <!-- BACKDROP -->
            <div class="backdrop" id="backdrop" onclick="closeZone()"></div>

            <!-- BOTTOM DRAWER -->
            <div class="drawer" id="drawer">

                <div class="drawer-handle-wrap">
                    <div class="drawer-handle"></div>
                </div>

                <div class="drawer-head">
                    <div>
                        <div class="zone-pill" id="zonePill">
                            <div class="zone-dot" id="zoneDot"></div>
                            <span id="drawerTitle">—</span>
                        </div>
                        <div class="head-sub" id="drawerSub"></div>
                    </div>
                    <div class="head-right">
                        <div class="drawer-stats" id="drawerStats"></div>
                        <button class="btn-close-drawer"
                            onclick="closeZone()">✕</button>
                    </div>
                </div>

                <div class="drawer-legend">
                    <div class="leg"><div class="leg-box"
                            style="background:#fff;"></div>ว่าง</div>
                    <div class="leg"><div class="leg-box"
                            style="background:#9ca3af;border-color:#555;"></div>จองแล้ว</div>
                    <div class="leg"><div class="leg-box"
                            style="background:#3BB8D4;border-color:#2a9ab5;"></div>กำลังดู</div>
                    <div class="leg"><div class="leg-box"
                            style="border:2px solid #f5c200;background:#fff;"></div>ผลค้นหา</div>
                </div>

                <div class="info-card" id="infoCard">
                    <div class="ic-title"><i
                            class="fa-solid fa-store fa-xs"></i><span
                            id="ic-head"></span></div>
                    <div class="ic-grid">
                        <div class="ig"><label>ชื่อร้านค้า</label><span
                                id="ic-shop"></span></div>
                        <div class="ig"><label>ประเภทสินค้า</label><span
                                id="ic-product"></span></div>
                        <div class="ig"><label>วันที่จอง</label><span
                                id="ic-date"></span></div>
                        <div class="ig"><label>ผู้จอง</label><span
                                id="ic-name"></span></div>
                        <div class="ig"><label>เบอร์โทรศัพท์</label><span
                                id="ic-phone"></span></div>
                        <div class="ig"><label>หมายเหตุ</label><span
                                id="ic-note"></span></div>
                    </div>
                </div>

                <div class="drawer-grid">
                    <div class="stall-flex" id="stallGrid"></div>
                </div>

            </div>

        </div>

        <script
            src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
        <script src="/js/admin/slots.js"></script>
    </body>
</html>
