<div class="modal fade" id="userDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered user-detail-dialog">
        <div
            class="modal-content border shadow-none user-detail-content">
            <div
                class="modal-header border-0 pb-0 pt-4 px-4 user-detail-header">
                <h5
                    class="modal-title fw-bold mb-0">ข้อมูลสมาชิกอย่างละเอียด</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 pt-3" id="detailBody"></div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0">
                <button type="button"
                    class="btn btn-outline-primary px-4"
                    data-bs-dismiss="modal">
                    ปิดหน้าต่าง
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editRoleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border shadow-none">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="fw-bold text-dark">เปลี่ยนสิทธิ์ผู้ใช้</h5>
                <button type="button" class="btn-close"
                    data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/users/update-role" method="POST">
                <div class="modal-body px-4">
                    <input type="hidden" name="userId" id="modalUserId">
                    <div class="mb-3">
                        <label class="small text-muted mb-2">สมาชิก: <b
                                id="modalUserName"
                                class="text-dark"></b></label>
                        <select name="newRole" id="modalRoleSelect"
                            class="form-select bg-light border py-2">
                            <option value="ADMIN">ADMIN (ผู้ดูแล)</option>
                            <option value="STAFF">STAFF (พนักงาน)</option>
                            <option value="SELLER">SELLER
                                (พ่อค้าแม่ค้า)</option>
                            <option value="CUSTOMER">CUSTOMER (ลูกค้า)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="submit"
                        class="btn btn-primary w-100"
                        style="background: #a73b24; border:none;">บันทึกการเปลี่ยนแปลง</button>
                </div>
            </form>
        </div>
    </div>
</div>