<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>รายการจองรออนุมัติ - Admin</title>

        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css"
            rel="stylesheet">
        <link rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link
            href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Sarabun:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap"
            rel="stylesheet">
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css">
        <link rel="stylesheet" href="/stylesheets/admin/theme.css">
        <link rel="stylesheet" href="/stylesheets/admin/approvals.css">
        <link rel="stylesheet" href="/stylesheets/responsive.css">
    </head>
    <body class="bg-light">

        <%- include('../partials/navbar') %>

        <div class="approvals-page">

            <header class="site-header">
                <a href="javascript:history.back()" class="btn-back"><i
                        class="fa-solid fa-arrow-left"></i></a>
                <h2 class="header-title">รายการจองรออนุมัติ</h2>
                <div class="header-spacer"></div>
            </header>

            <div class="container">

                <div class="filter-section">
                    <div class="summary-strip">
                        <div class="summary-card">
                            <span class="summary-label">ทั้งหมด</span>
                            <span class="summary-value" id="count-all">0</span>
                        </div>
                        <div class="summary-card">
                            <span class="summary-label">รออนุมัติ</span>
                            <span class="summary-value"
                                id="count-pending">0</span>
                        </div>
                        <div class="summary-card">
                            <span class="summary-label">อนุมัติแล้ว</span>
                            <span class="summary-value"
                                id="count-approved">0</span>
                        </div>
                        <div class="summary-card">
                            <span class="summary-label">ปฏิเสธ</span>
                            <span class="summary-value"
                                id="count-rejected">0</span>
                        </div>
                    </div>

                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" id="shopSearch"
                            placeholder="ค้นหาร้านค้า...">
                    </div>

                    <div class="filter-title">สถานะการจอง</div>
                    <div class="filter-group" id="statusFilters">
                        <button class="btn-filter active"
                            data-status="all">ทั้งหมด</button>
                        <button class="btn-filter"
                            data-status="pending">รออนุมัติ</button>
                        <button class="btn-filter"
                            data-status="approved">อนุมัติแล้ว</button>
                        <button class="btn-filter"
                            data-status="rejected">ปฏิเสธ</button>
                    </div>

                    <div
                        class="filter-title filter-title-spaced">โซน</div>
                    <div class="filter-group" id="zoneFilters">
                        <button class="btn-filter active"
                            data-zone="all">ทุกโซน</button>
                        <button class="btn-filter" data-zone="A">โซน A</button>
                        <button class="btn-filter" data-zone="B">โซน B</button>
                        <button class="btn-filter" data-zone="C">โซน C</button>
                        <button class="btn-filter" data-zone="D">โซน D</button>
                        <button class="btn-filter" data-zone="E">โซน E</button>
                        <button class="btn-filter" data-zone="F">โซน F</button>
                    </div>

                    <div class="type-summary" id="typeSummary">
                        <span>A: <strong id="count-A">0</strong></span>
                        <span>B: <strong id="count-B">0</strong></span>
                        <span>C: <strong id="count-C">0</strong></span>
                        <span>D: <strong id="count-D">0</strong></span>
                        <span>E: <strong id="count-E">0</strong></span>
                        <span>F: <strong id="count-F">0</strong></span>
                    </div>
                </div>

                <div class="list-meta">พบ <span id="visibleCount">0</span>
                    ร้าน</div>

                <div class="card-list" id="bookingList">

                    <div class="booking-card" data-status="pending"
                        data-zone="F" data-stall="F101-F117"
                        data-shop="ร้านหมูปิ้งเจ๊จู"
                        onclick="openDetail('ร้านหมูปิ้งเจ๊จู', 'F101-F117', 'อาหาร', '14 ต.ค. 68', '16 ต.ค. 68', 'นางสาวสมหญิง ใจดี', '081-234-5678', 'pending', 'ขอพื้นที่ใกล้ทางเดินหลักค่ะ')">
                        <div class="card-header">
                            <h3 class="shop-name">ร้านหมูปิ้งเจ๊จู</h3>
                            <span class="badge pending">รออนุมัติ</span>
                        </div>
                        <div class="card-body">
                            <p><i class="fa-solid fa-map-location-dot"></i> โซน:
                                F (อาหาร)</p>
                            <p><i class="fa-solid fa-store"></i> แถวที่เลือก:
                                F101-F117</p>
                            <p><i class="fa-solid fa-calendar-check"></i> เริ่ม:
                                14 ต.ค. 68</p>
                            <p><i class="fa-solid fa-user"></i> ผู้จอง: สมหญิง
                                ใจดี</p>
                        </div>
                        <div class="card-actions">
                            <button class="btn-action btn-reject"
                                onclick="event.stopPropagation(); rejectBooking('F101-F117', 'ร้านหมูปิ้งเจ๊จู');">ปฏิเสธ</button>
                            <button class="btn-action btn-approve"
                                onclick="event.stopPropagation(); confirmArrangeStall('F101-F117');">จัดแผง</button>
                        </div>
                    </div>

                    <div class="booking-card" data-status="pending"
                        data-zone="A" data-stall="A101-A119"
                        data-shop="เสื้อผ้าแฟชั่นวินเทจ"
                        onclick="openDetail('เสื้อผ้าแฟชั่นวินเทจ', 'A101-A119', 'แฟชั่น', '15 ต.ค. 68', '15 ต.ค. 68', 'นายสมชาย รักดี', '082-333-9999', 'pending', 'ไม่มี')">
                        <div class="card-header">
                            <h3 class="shop-name">เสื้อผ้าแฟชั่นวินเทจ</h3>
                            <span class="badge pending">รออนุมัติ</span>
                        </div>
                        <div class="card-body">
                            <p><i class="fa-solid fa-map-location-dot"></i> โซน:
                                A (แฟชั่น)</p>
                            <p><i class="fa-solid fa-store"></i> แถวที่เลือก:
                                A101-A119</p>
                            <p><i class="fa-solid fa-calendar-check"></i> เริ่ม:
                                15 ต.ค. 68</p>
                            <p><i class="fa-solid fa-user"></i> ผู้จอง: สมชาย
                                รักดี</p>
                        </div>
                        <div class="card-actions">
                            <button class="btn-action btn-reject"
                                onclick="event.stopPropagation(); rejectBooking('A101-A119', 'เสื้อผ้าแฟชั่นวินเทจ');">ปฏิเสธ</button>
                            <button class="btn-action btn-approve"
                                onclick="event.stopPropagation(); confirmArrangeStall('A101-A119');">จัดแผง</button>
                        </div>
                    </div>

                    <div class="booking-card" data-status="approved"
                        data-zone="D" data-stall="D201-D212"
                        data-shop="Burger Truck BKK"
                        onclick="openDetail('Burger Truck BKK', 'D201-D212', 'ฟู้ดทรัค', '10 ต.ค. 68', '20 ต.ค. 68', 'นายเอกพล คนขยัน', '089-987-6543', 'approved', 'ใช้ไฟเยอะครับ (มีตู้แช่)')">
                        <div class="card-header">
                            <h3 class="shop-name">Burger Truck BKK</h3>
                            <span class="badge approved">อนุมัติแล้ว</span>
                        </div>
                        <div class="card-body">
                            <p><i class="fa-solid fa-map-location-dot"></i> โซน:
                                D (ฟู้ดทรัค)</p>
                            <p><i class="fa-solid fa-store"></i> แถวที่เลือก:
                                D201-D212</p>
                            <p><i class="fa-solid fa-calendar-check"></i> เริ่ม:
                                10 ต.ค. 68</p>
                            <p><i class="fa-solid fa-user"></i> ผู้จอง: เอกพล
                                คนขยัน</p>
                        </div>
                        <div class="card-actions" style="display: none;"></div>
                    </div>

                </div>

            </div>

            <div class="modal-overlay" id="detailModal"
                onclick="closeModalOnOverlay(event)">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3>รายละเอียดการจอง</h3>
                        <button class="btn-close" onclick="closePopup()"><i
                                class="fa-solid fa-xmark"></i></button>
                    </div>

                    <div class="modal-body">
                        <div class="detail-grid">
                            <span class="detail-label">ชื่อร้านค้า:</span>
                            <span class="detail-value detail-highlight"
                                id="m-shop"></span>

                            <span class="detail-label">ประเภท/โซน:</span>
                            <span class="detail-value" id="m-zone"></span>

                            <span class="detail-label">แถวที่เลือก:</span>
                            <span class="detail-value detail-highlight"
                                id="m-stall"></span>

                            <span class="detail-label">วันที่เริ่ม:</span>
                            <span class="detail-value" id="m-start"></span>

                            <span class="detail-label">วันที่สิ้นสุด:</span>
                            <span class="detail-value" id="m-end"></span>

                            <span class="detail-label">ผู้จอง:</span>
                            <span class="detail-value" id="m-name"></span>

                            <span class="detail-label">เบอร์โทรศัพท์:</span>
                            <span class="detail-value" id="m-phone"></span>
                        </div>

                        <div class="note-box">
                            <strong>หมายเหตุจากผู้เช่า:</strong><br>
                            <span id="m-note"></span>
                        </div>

                        <div class="modal-footer" id="m-footer-actions">
                            <button class="btn-action btn-reject"
                                onclick="rejectCurrentBooking()">ปฏิเสธการจอง</button>
                            <button class="btn-action btn-approve"
                                id="m-approve-btn">ไปหน้าจัดแผง</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <script src="/js/admin/approvals.js"></script>

    </body>
</html>