<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>รายการจองรออนุมัติ - Admin</title>

        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css"
            rel="stylesheet">
        <link rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link
            href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Sarabun:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap"
            rel="stylesheet">
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css">
        <link rel="stylesheet" href="/stylesheets/admin/theme.css">
        <link rel="stylesheet" href="/stylesheets/admin/approvals.css">
        <link rel="stylesheet" href="/stylesheets/responsive.css">
    </head>
    <body class="bg-light">

        <%- include('../partials/navbar') %>

        <div class="approvals-page">
            <%
                const bookingRequestsList = (typeof bookingRequests !== 'undefined' && Array.isArray(bookingRequests)) ? bookingRequests : [];
                const summaryCounts = (typeof counts !== 'undefined' && counts) ? counts : { all: 0, pending: 0, approved: 0, rejected: 0, zones: {} };
                const zoneCounts = summaryCounts.zones || {};
            %>

            <header class="site-header">
                <a href="javascript:history.back()" class="btn-back"><i
                        class="fa-solid fa-arrow-left"></i></a>
                <h2 class="header-title">รายการจองรออนุมัติ</h2>
                <div class="header-spacer"></div>
            </header>

            <div class="container">

                <%
                const flashError = (typeof error !== 'undefined' && error) ? error : null;
                const flashReason = (typeof errorReason !== 'undefined' && errorReason) ? errorReason : null;
                const flashRequestId = (typeof errorRequestId !== 'undefined' && errorRequestId) ? errorRequestId : null;
                const flashSlipAmount = (typeof locals.slipAmount !== 'undefined' && locals.slipAmount !== null && locals.slipAmount !== '') ? Number(locals.slipAmount) : null;
                const flashExpectedAmount = (typeof locals.expectedAmount !== 'undefined' && locals.expectedAmount !== null && locals.expectedAmount !== '') ? Number(locals.expectedAmount) : null;
                const hasAmountMismatch = flashError === 'slip_verification_failed' && Number.isFinite(flashSlipAmount) && Number.isFinite(flashExpectedAmount);
                const formatBaht = (n) => Number(n || 0).toLocaleString('th-TH') + ' ฿';
                const flashSuccess = (typeof success !== 'undefined' && success) ? success : null;
                const flashErrorMessages = {
                    missing_request_id: 'ไม่พบรหัสคำขอ',
                    request_not_found: 'ไม่พบคำขอนี้',
                    history_round_locked: 'รอบนี้เป็นประวัติแล้ว แก้ไขไม่ได้',
                    no_slip_to_confirm: 'คำขอนี้ยังไม่มีสลิปให้ตรวจ หรือสถานะไม่ตรง',
                    confirm_payment_failed: 'เกิดข้อผิดพลาดขณะยืนยันการชำระเงิน',
                    slip_verification_failed: `ตรวจสลิปอัตโนมัติไม่ผ่าน: ${flashReason || 'ไม่ทราบสาเหตุ'}`,
                    missing_reject_slip_reason: 'กรุณาระบุเหตุผลที่สลิปไม่ถูกต้อง',
                    reject_slip_failed: 'เกิดข้อผิดพลาดขณะปฏิเสธสลิป',
                    missing_confirm_payload: 'กรุณาเลือกแผงค้าก่อนยืนยัน',
                    duplicate_stall_selected: 'เลือกแผงค้าซ้ำกัน กรุณาเลือกล็อกที่ต่างกัน',
                    stall_count_mismatch: 'จำนวนล็อกที่เลือกไม่ตรงกับจำนวนที่ผู้ขายขอมา กรุณาเลือกให้ครบ',
                    stall_not_found: 'ไม่พบแผงค้าที่เลือก',
                    stall_unavailable: 'แผงค้าที่เลือกบางล็อกถูกจองไปแล้ว กรุณาเลือกล็อกอื่น'
                };
                const flashSuccessMessages = {
                    payment_confirmed: 'ยืนยันการชำระเงินเรียบร้อย เปิดเผยเลขล็อกให้ลูกค้าแล้ว',
                    status_updated: 'อัปเดตสถานะเรียบร้อย',
                    stall_assigned: 'จัดล็อกเรียบร้อย',
                    slip_rejected: 'ปฏิเสธสลิปแล้ว ระบบแจ้งผู้ขายให้อัปโหลดสลิปใหม่'
                };
                %>
                <% if (flashError === 'slip_verification_failed' && hasAmountMismatch) { %>
                <div class="flash-banner flash-banner--warning" id="flashBanner">
                    <div class="flash-banner__body">
                        <span class="flash-banner__title">ยอดในสลิปไม่ตรงกับยอดที่ต้องชำระ</span>
                        <span class="flash-banner__amounts">
                            สลิป <strong><%= formatBaht(flashSlipAmount) %></strong>
                            <i class="fa-solid fa-not-equal"></i>
                            ต้องชำระ <strong><%= formatBaht(flashExpectedAmount) %></strong>
                        </span>
                    </div>
                    <% if (flashRequestId) { %>
                    <button type="button" class="flash-banner__force-btn flash-banner__force-btn--warning" onclick="submitForcePayment(<%= flashRequestId %>)">ยืนยันต่อโดยไม่ตรวจสลิป</button>
                    <% } %>
                </div>
                <% } else if (flashError) { %>
                <div class="flash-banner flash-banner--error" id="flashBanner">
                    <span><%= flashErrorMessages[flashError] || 'เกิดข้อผิดพลาด' %></span>
                    <% if (flashError === 'slip_verification_failed' && flashRequestId) { %>
                    <button type="button" class="flash-banner__force-btn" onclick="submitForcePayment(<%= flashRequestId %>)">ยืนยันต่อโดยไม่ตรวจสลิป</button>
                    <% } %>
                </div>
                <% } %>
                <% if (flashSuccess) { %>
                <div class="flash-banner flash-banner--success">
                    <span><%= flashSuccessMessages[flashSuccess] || 'สำเร็จ' %></span>
                </div>
                <% } %>

                <div class="round-navigation compact">
                    <div class="round-nav-tools">
                        <a class="round-nav-icon <%= selectedRoundNumber === previousRoundNumber ? 'active' : '' %>"
                            href="/admin/approvals?round=<%= previousRoundNumber %>"
                            title="รอบก่อนหน้า"
                            aria-label="ไปที่รอบก่อนหน้า">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>

                        <a class="round-nav-current <%= isCurrentRound ? 'active' : '' %>"
                            href="/admin/approvals?round=<%= currentRoundNumber %>"
                            title="รอบปัจจุบัน">
                            <span class="round-current-label">รอบปัจจุบัน</span>
                            <span class="round-current-number">#<%= currentRoundNumber %></span>
                        </a>

                        <a class="round-nav-icon <%= selectedRoundNumber === nextRoundNumber ? 'active' : '' %>"
                            href="/admin/approvals?round=<%= nextRoundNumber %>"
                            title="รอบถัดไป"
                            aria-label="ไปที่รอบถัดไป">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </div>

                    <div class="round-nav-detail">
                        <span class="round-detail-label">รอบที่เลือก:</span>
                        <strong>#<%= selectedRoundNumber %></strong>
                        <span class="round-detail-separator">•</span>
                        <span><%= new Date(roundMeta.cycleStart).toLocaleDateString('th-TH', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
                        <span class="round-detail-separator">-</span>
                        <span><%= new Date(roundMeta.cycleEnd).toLocaleDateString('th-TH', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
                    </div>
                </div>

                <div class="filter-section">
                    <div class="summary-strip">
                        <div class="summary-card">
                            <span class="summary-label">ทั้งหมด</span>
                            <span class="summary-value" id="count-all"><%= summaryCounts.all %></span>
                        </div>
                        <div class="summary-card">
                            <span class="summary-label">รออนุมัติ</span>
                            <span class="summary-value"
                                id="count-pending"><%= summaryCounts.pending %></span>
                        </div>
                        <div class="summary-card">
                            <span class="summary-label">อนุมัติแล้ว</span>
                            <span class="summary-value"
                                id="count-approved"><%= summaryCounts.approved %></span>
                        </div>
                        <div class="summary-card">
                            <span class="summary-label">จัดล็อกแล้ว/รอจ่าย</span>
                            <span class="summary-value"
                                id="count-in_progress"><%= summaryCounts.inProgress || 0 %></span>
                        </div>
                        <div class="summary-card">
                            <span class="summary-label">จ่ายเงินแล้ว</span>
                            <span class="summary-value"
                                id="count-success"><%= summaryCounts.success || 0 %></span>
                        </div>
                        <div class="summary-card">
                            <span class="summary-label">ปฏิเสธ</span>
                            <span class="summary-value"
                                id="count-rejected"><%= summaryCounts.rejected %></span>
                        </div>
                    </div>

                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" id="shopSearch"
                            placeholder="ค้นหาร้านค้า...">
                    </div>

                    <div class="filter-title">สถานะการจอง</div>
                    <div class="filter-group" id="statusFilters">
                        <button class="btn-filter active"
                            data-status="all">ทั้งหมด</button>
                        <button class="btn-filter"
                            data-status="pending">รออนุมัติ</button>
                        <button class="btn-filter"
                            data-status="approved">อนุมัติแล้ว</button>
                        <button class="btn-filter"
                            data-status="in_progress">จัดล็อกแล้ว/รอจ่าย</button>
                        <button class="btn-filter"
                            data-status="success">จ่ายเงินแล้ว</button>
                        <button class="btn-filter"
                            data-status="rejected">ปฏิเสธ</button>
                    </div>

                    <div
                        class="filter-title filter-title-spaced">โซน</div>
                    <div class="filter-group" id="zoneFilters">
                        <button class="btn-filter active"
                            data-zone="all">ทุกโซน</button>
                        <button class="btn-filter" data-zone="A">โซน A</button>
                        <button class="btn-filter" data-zone="B">โซน B</button>
                        <button class="btn-filter" data-zone="C">โซน C</button>
                        <button class="btn-filter" data-zone="D">โซน D</button>
                        <button class="btn-filter" data-zone="E">โซน E</button>
                        <button class="btn-filter" data-zone="F">โซน F</button>
                    </div>

                    <div class="type-summary" id="typeSummary">
                        <span>A: <strong id="count-A"><%= zoneCounts.A || 0 %></strong></span>
                        <span>B: <strong id="count-B"><%= zoneCounts.B || 0 %></strong></span>
                        <span>C: <strong id="count-C"><%= zoneCounts.C || 0 %></strong></span>
                        <span>D: <strong id="count-D"><%= zoneCounts.D || 0 %></strong></span>
                        <span>E: <strong id="count-E"><%= zoneCounts.E || 0 %></strong></span>
                        <span>F: <strong id="count-F"><%= zoneCounts.F || 0 %></strong></span>
                    </div>
                </div>

                <div class="list-meta">
                    พบ <span id="visibleCount">0</span> ร้าน
                    <% if (!isEditable) { %>
                        <span class="readonly-hint">• เป็นประวัติการจอง รอบนี้ไม่สามารถแก้ไขได้</span>
                    <% } else { %>
                        <span class="readonly-hint">• กำลังเปิดรอบปัจจุบัน สามารถอนุมัติได้</span>
                    <% } %>
                </div>

                <div class="card-list" id="bookingList">
                    <% if (bookingRequestsList.length === 0) { %>
                        <div class="empty-state text-center py-5">
                            <i class="fa-solid fa-inbox fa-2x mb-3 text-muted"></i>
                            <div class="fw-semibold text-secondary">ยังไม่มีรายการจองจากผู้ขาย</div>
                            <div class="text-muted small">เมื่อมีการจองใหม่จากหน้า seller ระบบจะแสดงรายการที่นี่</div>
                        </div>
                    <% } %>

                    <% bookingRequestsList.forEach(function(request) { %>
                        <%
                        const openDetailArgs = `${JSON.stringify(request.productName || "-")}, ${JSON.stringify(request.zoneLabel || "-")}, ${JSON.stringify(request.sellerName || "-")}, ${JSON.stringify(request.phone || "-")}, ${JSON.stringify(request.statusLabel || "-")}, ${JSON.stringify(request.description || "-")}, ${request.id}, ${JSON.stringify(request.createdAtText || "-")}, ${JSON.stringify(request.status || "pending")}, ${JSON.stringify(request.productImage || "")}, ${JSON.stringify(request.assignedStallCode || "")}, ${JSON.stringify(request.paymentSlipImage || "")}, ${JSON.stringify(Boolean(request.paymentConfirmedAt))}, ${JSON.stringify(Boolean(request.isExtension))}, ${JSON.stringify(request.extendOfRequestId || "")}, ${JSON.stringify(request.cornerZoneNote || "")}, ${JSON.stringify(Boolean(request.isFinalPrice))}, ${JSON.stringify(request.booking || null)}, ${JSON.stringify(request.slipVerified)}, ${JSON.stringify(request.slipVerifyReason || "")}`;
                        %>
                        <div class="booking-card" data-request-id="<%= request.id %>" data-status="<%= request.status %>" data-zone="<%= request.zone || '' %>" data-shop="<%= request.productName || '' %>" onclick='openDetail(<%- openDetailArgs %>)'>
                            <div class="card-header">
                                <h3 class="shop-name"><%= request.productName %></h3>
                                <span class="badge <%= request.status %>"><%= request.statusLabel %></span>
                            </div>
                            <% if (request.isExtension || request.cornerZoneNote || request.paymentSlipImage || request.requestedStallCount > 1) { %>
                            <div class="card-tags">
                                <% if (request.requestedStallCount > 1) { %>
                                <span class="tag tag--multi-stall"><i class="fa-solid fa-layer-group"></i> ขอ <%= request.requestedStallCount %> ล็อก</span>
                                <% } %>
                                <% if (request.isExtension) { %>
                                <span class="tag tag--extend"><i class="fa-solid fa-rotate"></i> ต่อล็อคจากคำขอ #<%= request.extendOfRequestId %></span>
                                <% } %>
                                <% if (request.cornerZoneNote) { %>
                                <span class="tag tag--corner"><i class="fa-solid fa-star"></i> สนใจล็อคเต็ง: <%= request.cornerZoneNote %></span>
                                <% } %>
                                <% if (request.paymentSlipImage && request.slipVerified === true) { %>
                                <span class="tag tag--slip-ok"><i class="fa-solid fa-circle-check"></i> สลิปจริง ยอดตรง</span>
                                <% } else if (request.paymentSlipImage && request.slipVerified === false) { %>
                                <span class="tag tag--slip-bad"><i class="fa-solid fa-triangle-exclamation"></i> สลิปมีปัญหา: <%= request.slipVerifyReason || 'ตรวจไม่ผ่าน' %></span>
                                <% } else if (request.paymentSlipImage) { %>
                                <span class="tag tag--slip-pending"><i class="fa-solid fa-hourglass-half"></i> ยังไม่ตรวจสลิปอัตโนมัติ</span>
                                <% } %>
                            </div>
                            <% } %>
                            <div class="card-body">
                                <p><i class="fa-solid fa-map-location-dot"></i> โซน: <%= request.zoneLabel %></p>
                                <p><i class="fa-solid fa-store"></i> ผู้จอง: <%= request.sellerName %></p>
                                <p><i class="fa-solid fa-phone"></i> เบอร์: <%= request.phone %></p>
                                <p><i class="fa-solid fa-calendar-check"></i> ยื่นคำขอ: <%= request.createdAtText %></p>
                                <p><i class="fa-solid fa-hashtag"></i> แผงที่จัด: <%= request.assignedStallCode || '-' %></p>
                                <% if (request.booking) { %>
                                <p><i class="fa-solid fa-calendar-days"></i> วันเช่า: <%= request.booking.rentalStartDateText %> - <%= request.booking.rentalEndDateText %> (<%= request.booking.rentalDays %> วัน)</p>
                                <p><i class="fa-solid fa-coins"></i> ราคา<%= request.isFinalPrice ? 'จริง' : 'ประเมิน' %>: <%= Number(request.booking.grandTotal).toLocaleString('th-TH') %> บาท</p>
                                <% } %>
                            </div>
                            <div class="card-actions">
                                <button type="button" class="btn-action btn-approve" onclick='event.stopPropagation(); openDetail(<%- openDetailArgs %>)'>ดูรายละเอียด</button>
                            </div>
                        </div>
                    <% }) %>

                </div>

            </div>

            <div class="modal-overlay" id="detailModal"
                onclick="closeModalOnOverlay(event)">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3>รายละเอียดการจอง</h3>
                        <button class="btn-close" onclick="closePopup()"><i
                                class="fa-solid fa-xmark"></i></button>
                    </div>

                    <div class="modal-body">
                        <div class="shop-image-box" id="m-shop-image-box">
                            <img id="m-shop-image" class="shop-image" src="" alt="รูปภาพร้านค้า">
                            <div id="m-shop-image-empty" class="shop-image-empty d-none">ไม่มีรูปภาพร้านค้า</div>
                        </div>

                        <div class="detail-grid">
                            <span class="detail-label">ชื่อร้านค้า:</span>
                            <span class="detail-value detail-highlight"
                                id="m-shop"></span>

                            <span class="detail-label">โซนที่ขอ:</span>
                            <span class="detail-value" id="m-zone"></span>

                            <span class="detail-label">ผู้จอง:</span>
                            <span class="detail-value detail-highlight" id="m-name"></span>

                            <span class="detail-label">เบอร์โทรศัพท์:</span>
                            <span class="detail-value" id="m-phone"></span>

                            <span class="detail-label">วันที่ยื่นคำขอ:</span>
                            <span class="detail-value" id="m-start"></span>

                            <span class="detail-label">สถานะ:</span>
                            <span class="detail-value" id="m-status"></span>

                            <span class="detail-label">แผงที่จัด:</span>
                            <span class="detail-value" id="m-assigned-stall"></span>

                            <span class="detail-label">วันที่เช่า:</span>
                            <span class="detail-value" id="m-rental-dates"></span>

                            <span class="detail-label">จำนวนล็อก/เครื่องใช้ไฟฟ้า:</span>
                            <span class="detail-value" id="m-stall-appliance"></span>

                            <span class="detail-label" id="m-price-label">ราคา:</span>
                            <span class="detail-value" id="m-price"></span>
                        </div>

                        <div class="card-tags d-none" id="m-tags"></div>

                        <div class="note-box">
                            <strong>รายละเอียดร้าน/สินค้า:</strong><br>
                            <span id="m-note"></span>
                        </div>

                        <div class="note-box d-none" id="m-payment-slip-box">
                            <strong>สลิปโอนเงิน:</strong><br>
                            <img id="m-payment-slip" class="img-fluid rounded mt-2" style="max-width:260px;" src="" alt="สลิปโอนเงิน">
                        </div>

                        <div class="modal-footer" id="m-footer-actions">
                            <button type="button" class="btn-action btn-reject" id="m-reject-btn">ปฏิเสธการจอง</button>
                            <button type="button" class="btn-action btn-approve" id="m-approve-btn">อนุมัติการจอง</button>
                            <button type="button" class="btn-action btn-reject d-none" id="m-reject-slip-btn">สลิปไม่ถูกต้อง</button>
                            <button type="button" class="btn-action btn-approve d-none" id="m-confirm-payment-btn">ยืนยันการชำระเงิน</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <script>
            window.APPROVAL_PAGE_STATE = {
                isEditable: <%= Boolean(isEditable) %>
            };
        </script>
        <script src="/js/common/dialogs.js"></script>
        <script src="/js/admin/approvals.js"></script>

    </body>
</html>