<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>รายการจองรออนุมัติ - Admin</title>

        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css"
            rel="stylesheet">
        <link rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
            rel="stylesheet">
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20261008-font">
        <link rel="stylesheet" href="/stylesheets/admin/theme.css">
        <link rel="stylesheet" href="/stylesheets/admin/approvals.css">
        <link rel="stylesheet" href="/stylesheets/responsive.css">
    </head>
    <body class="bg-light">

        <%- include('../partials/navbar') %>

        <div class="approvals-page approvals-page--queue">
            <%
                const bookingRequestsList = (typeof bookingRequests !== 'undefined' && Array.isArray(bookingRequests)) ? bookingRequests : [];
                const summaryCounts = (typeof counts !== 'undefined' && counts) ? counts : { all: 0, pending: 0, approved: 0, rejected: 0, zones: {} };
                const zoneCounts = summaryCounts.zones || {};
            %>

            <header class="site-header">
                <a href="javascript:history.back()" class="btn-back"><i
                        class="fa-solid fa-arrow-left"></i></a>
                <h2 class="header-title">รายการจองรออนุมัติ</h2>
                <div class="header-spacer"></div>
            </header>

            <div class="container">

                <%
                const flashError = (typeof error !== 'undefined' && error) ? error : null;
                const flashReason = (typeof errorReason !== 'undefined' && errorReason) ? errorReason : null;
                const flashRequestId = (typeof errorRequestId !== 'undefined' && errorRequestId) ? errorRequestId : null;
                const flashSlipAmount = (typeof locals.slipAmount !== 'undefined' && locals.slipAmount !== null && locals.slipAmount !== '') ? Number(locals.slipAmount) : null;
                const flashExpectedAmount = (typeof locals.expectedAmount !== 'undefined' && locals.expectedAmount !== null && locals.expectedAmount !== '') ? Number(locals.expectedAmount) : null;
                const hasAmountMismatch = flashError === 'slip_verification_failed' && Number.isFinite(flashSlipAmount) && Number.isFinite(flashExpectedAmount);
                const formatBaht = (n) => Number(n || 0).toLocaleString('th-TH') + ' ฿';
                const flashSuccess = (typeof success !== 'undefined' && success) ? success : null;
                const flashErrorMessages = {
                    missing_request_id: 'ไม่พบรหัสคำขอ',
                    request_not_found: 'ไม่พบคำขอนี้',
                    history_round_locked: 'รอบนี้เป็นประวัติแล้ว แก้ไขไม่ได้',
                    no_slip_to_confirm: 'คำขอนี้ยังไม่มีสลิปให้ตรวจ หรือสถานะไม่ตรง',
                    confirm_payment_failed: 'เกิดข้อผิดพลาดขณะยืนยันการชำระเงิน',
                    slip_verification_failed: `ตรวจสลิปอัตโนมัติไม่ผ่าน: ${flashReason || 'ไม่ทราบสาเหตุ'}`,
                    missing_reject_slip_reason: 'กรุณาระบุเหตุผลที่สลิปไม่ถูกต้อง',
                    reject_slip_failed: 'เกิดข้อผิดพลาดขณะปฏิเสธสลิป',
                    missing_confirm_payload: 'กรุณาเลือกแผงค้าก่อนยืนยัน',
                    duplicate_stall_selected: 'เลือกแผงค้าซ้ำกัน กรุณาเลือกล็อกที่ต่างกัน',
                    stall_count_mismatch: 'เลือกล็อกเกินจำนวนที่ผู้ขายขอมา (เลือกได้ตั้งแต่ 1 ล็อกจนถึงจำนวนที่ขอ)',
                    stall_not_found: 'ไม่พบแผงค้าที่เลือก',
                    stall_unavailable: 'แผงค้าที่เลือกบางล็อกถูกจองไปแล้ว กรุณาเลือกล็อกอื่น',
                    load_approvals_failed: 'เกิดข้อผิดพลาดขณะโหลดรายการอนุมัติ กรุณาลองใหม่',
                    load_booking_stall_failed: 'เปิดหน้าจัดล็อกไม่สำเร็จ กรุณาลองใหม่',
                    confirm_booking_stall_failed: 'บันทึกการจัดล็อกไม่สำเร็จ กรุณาลองใหม่',
                    reject_booking_stall_failed: 'ปฏิเสธ/ยกเลิกคำขอไม่สำเร็จ กรุณาลองใหม่',
                    invalid_state_transition: 'คำขอนี้จัดล็อกไปแล้ว ต้องยกเลิกผ่านปุ่ม "ยกเลิกการจัดล็อก" เพื่อคืนล็อกด้วย',
                    invalid_status: 'สถานะที่ส่งมาไม่ถูกต้อง',
                    update_failed: 'อัปเดตสถานะไม่สำเร็จ กรุณาลองใหม่',
                    stale_round_invalid: 'ปิดคำขอค้างทั้งรอบได้เฉพาะรอบที่ผ่านไปแล้ว',
                    stale_close_failed: 'ปิดคำขอค้างทั้งรอบไม่สำเร็จ กรุณาลองใหม่'
                };
                const flashSuccessMessages = {
                    payment_confirmed: 'ยืนยันการชำระเงินเรียบร้อย เปิดเผยเลขล็อกให้ผู้ขายแล้ว',
                    status_updated: 'อัปเดตสถานะเรียบร้อย',
                    stall_assigned: 'จัดล็อกเรียบร้อย ผู้ขายมีเวลาส่งสลิป 6 ชม.',
                    slip_rejected: 'ปฏิเสธสลิปแล้ว ระบบแจ้งผู้ขายให้อัปโหลดสลิปใหม่',
                    request_rejected: 'ปฏิเสธ/ยกเลิกคำขอแล้ว ล็อกที่จัดไว้ถูกคืนเรียบร้อย',
                    stale_closed: `ปิดคำขอค้างในรอบนี้แล้ว ${Number(locals.closedCount) || 0} รายการ ผู้ขายจะเห็นเหตุผลในแจ้งเตือน`,
                    slips_confirmed: `ยืนยันการชำระเงินแล้ว ${Number(locals.closedCount) || 0} ใบ (เฉพาะสลิปที่ระบบตรวจว่ายอดตรง)`
                };
                %>
                <% if (flashError === 'slip_verification_failed' && hasAmountMismatch) { %>
                <div class="flash-banner flash-banner--warning" id="flashBanner">
                    <div class="flash-banner__body">
                        <span class="flash-banner__title">ยอดในสลิปไม่ตรงกับยอดที่ต้องชำระ</span>
                        <span class="flash-banner__amounts">
                            สลิป <strong><%= formatBaht(flashSlipAmount) %></strong>
                            <i class="fa-solid fa-not-equal"></i>
                            ต้องชำระ <strong><%= formatBaht(flashExpectedAmount) %></strong>
                        </span>
                    </div>
                    <% if (flashRequestId) { %>
                    <button type="button" class="flash-banner__force-btn flash-banner__force-btn--warning" onclick="submitForcePayment(<%= flashRequestId %>)">ยืนยันต่อโดยไม่ตรวจสลิป</button>
                    <% } %>
                </div>
                <% } else if (flashError) { %>
                <div class="flash-banner flash-banner--error" id="flashBanner">
                    <span><%= flashErrorMessages[flashError] || 'เกิดข้อผิดพลาด' %></span>
                    <% if (flashError === 'slip_verification_failed' && flashRequestId) { %>
                    <button type="button" class="flash-banner__force-btn" onclick="submitForcePayment(<%= flashRequestId %>)">ยืนยันต่อโดยไม่ตรวจสลิป</button>
                    <% } %>
                </div>
                <% } %>
                <% if (flashSuccess) { %>
                <div class="flash-banner flash-banner--success">
                    <span><%= flashSuccessMessages[flashSuccess] || 'สำเร็จ' %></span>
                </div>
                <% } %>

                <%
                const fmtRoundDate = (d) => new Date(d).toLocaleDateString('th-TH', { day: '2-digit', month: 'short' });
                %>
                <div class="round-navigation">
                    <div class="round-switch">
                        <a class="round-cell round-cell--prev"
                            href="/admin/approvals?round=<%= previousRoundNumber %>"
                            aria-label="ไปที่รอบก่อนหน้า">
                            <span class="round-cell-dir"><i class="fa-solid fa-chevron-left"></i> ก่อนหน้า</span>
                            <span class="round-cell-number">รอบ #<%= previousRoundNumber %></span>
                            <span class="round-cell-range"><%= fmtRoundDate(previousRoundMeta.cycleStart) %> - <%= fmtRoundDate(previousRoundMeta.cycleEnd) %></span>
                        </a>

                        <div class="round-cell round-cell--selected">
                            <span class="round-cell-dir"><%= isCurrentRound ? 'รอบปัจจุบัน' : 'กำลังดูรอบ' %></span>
                            <span class="round-cell-number">รอบ #<%= selectedRoundNumber %></span>
                            <span class="round-cell-range"><%= fmtRoundDate(roundMeta.cycleStart) %> - <%= fmtRoundDate(roundMeta.cycleEnd) %></span>
                            <% if (!isCurrentRound) { %>
                            <a class="round-cell-back" href="/admin/approvals?round=<%= currentRoundNumber %>">กลับไปรอบปัจจุบัน (#<%= currentRoundNumber %>)</a>
                            <% } %>
                        </div>

                        <a class="round-cell round-cell--next"
                            href="/admin/approvals?round=<%= nextRoundNumber %>"
                            aria-label="ไปที่รอบถัดไป">
                            <span class="round-cell-dir">ถัดไป <i class="fa-solid fa-chevron-right"></i></span>
                            <span class="round-cell-number">รอบ #<%= nextRoundNumber %></span>
                            <span class="round-cell-range"><%= fmtRoundDate(nextRoundMeta.cycleStart) %> - <%= fmtRoundDate(nextRoundMeta.cycleEnd) %></span>
                        </a>
                    </div>
                </div>

                <%
                const sections = (typeof stageSections !== 'undefined' && Array.isArray(stageSections)) ? stageSections : [];
                const fmtMoney = (n) => Number(n || 0).toLocaleString('th-TH');
                // ปุ่มหลักต่อขั้นตอน — คำขอต่อล็อกที่รอจัด ยืนยันล็อกเดิมได้เลย (หน้าจัดล็อกเลือกไว้ให้แล้ว)
                // รอบที่ผ่านไปแล้ว: จัดล็อกไม่ได้ (วันเช่าผ่านไปแล้ว) แต่ปิดคำขอค้างได้ — ปฏิเสธ/ยกเลิก/ตรวจสลิป
                const primaryActionFor = (row) => {
                    if (row.stage === 'assign' && !isEditable) return { action: 'reject', label: 'ปฏิเสธ (หมดรอบแล้ว)', tone: 'danger-ghost' };
                    if (row.stage === 'assign') return row.kind === 'extend'
                        ? { action: 'assign', label: `ยืนยันล็อกเดิม ${row.extension ? row.extension.originalStallText : ''}`.trim(), tone: 'go' }
                        : { action: 'assign', label: 'จัดล็อก', tone: 'go' };
                    if (row.stage === 'slip') return { action: 'detail', label: 'ตรวจสลิป', tone: 'go' };
                    if (row.stage === 'overdue') return { action: 'cancel', label: 'ยกเลิกการจัดล็อก', tone: 'danger' };
                    return null;
                };
                %>

                <%
                // ตัวกรองแยก 3 แถว (ประเภท / สถานะ / โซน) — ทุกตัวเป็นปุ่มมีขอบ + ตัวเลข เลือกได้แถวละ 1 ค่า
                const stageMetaOf = (stage) => sections.find((s) => s.stage === stage) || { label: stage };
                const stageChips = [
                    // ชื่อปุ่ม = ชื่อหัวกลุ่มรายการ (STAGE_META ใน approvalController.js) ใช้คำเดียวกันทุกที่
                    { stage: 'slip', urgent: true },
                    { stage: 'overdue', urgent: true, danger: true },
                    { stage: 'assign', urgent: true },
                    { stage: 'awaiting' },
                    { stage: 'done' },
                    { stage: 'rejected' }
                ];
                %>
                <section class="filter-panel" aria-label="ตัวกรองคำขอ">
                    <header class="filter-panel__head">
                        <h3 class="filter-panel__title"><i class="fa-solid fa-sliders" aria-hidden="true"></i> ตัวกรอง</h3>
                        <span class="filter-panel__result">แสดง <strong class="mono" id="visibleCount">0</strong> จาก <span class="mono"><%= summaryCounts.all %></span> รายการ</span>
                        <button type="button" class="filter-panel__reset" id="resetFilters" aria-label="ล้างตัวกรอง" disabled>
                            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> <span>ล้างตัวกรอง</span>
                        </button>
                    </header>

                    <label class="filter-search">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <input type="search" id="shopSearch" placeholder="ค้นหาร้าน / ผู้จอง / เบอร์ / ล็อก" aria-label="ค้นหา">
                    </label>

                    <div class="filter-row">
                        <span class="filter-row__label" id="filterKindLabel">ประเภท</span>
                        <div class="filter-row__chips filter-row__chips--segment" role="group" aria-labelledby="filterKindLabel">
                            <button type="button" class="f-chip" data-kind="all" aria-pressed="true">ทั้งหมด <span class="f-chip__count" data-count></span></button>
                            <button type="button" class="f-chip" data-kind="new" aria-pressed="false"><span class="stage-ic stage-ic--new" aria-hidden="true"><i class="fa-solid fa-plus"></i></span>จองใหม่ <span class="f-chip__count" data-count></span></button>
                            <button type="button" class="f-chip" data-kind="extend" aria-pressed="false"><span class="stage-ic stage-ic--extend" aria-hidden="true"><i class="fa-solid fa-rotate"></i></span>ต่อล็อก <span class="f-chip__count" data-count></span></button>
                        </div>
                    </div>

                    <div class="filter-row">
                        <span class="filter-row__label" id="filterStageLabel">สถานะ</span>
                        <div class="filter-row__chips filter-row__chips--scroll" role="group" aria-labelledby="filterStageLabel">
                            <button type="button" class="f-chip" data-stage="all" aria-pressed="true">ทั้งหมด <span class="f-chip__count" data-count></span></button>
                            <button type="button" class="f-chip f-chip--todo" data-stage="todo" aria-pressed="false"><span class="stage-ic stage-ic--todo" aria-hidden="true"><i class="fa-solid fa-list-check"></i></span>งานที่ต้องทำ <span class="f-chip__count" data-count></span></button>
                            <span class="filter-row__sep" aria-hidden="true"></span>
                            <% stageChips.forEach(function(chip) { %>
                            <% if (chip.stage === 'awaiting') { %><span class="filter-row__break" aria-hidden="true"></span><span class="filter-row__group-label">ติดตาม</span><% } %>
                            <button type="button" class="f-chip<%= chip.urgent ? ' f-chip--urgent' : '' %><%= chip.danger ? ' f-chip--danger' : '' %>" data-stage="<%= chip.stage %>" aria-pressed="false" title="<%= stageMetaOf(chip.stage).hint || stageMetaOf(chip.stage).label %>">
                                <span class="stage-ic stage-ic--<%= chip.stage %>" aria-hidden="true"><i class="fa-solid <%= stageMetaOf(chip.stage).icon %>"></i></span><%= stageMetaOf(chip.stage).label %> <span class="f-chip__count" data-count></span>
                            </button>
                            <% }) %>
                        </div>
                    </div>

                    <div class="filter-row">
                        <span class="filter-row__label" id="filterZoneLabel">โซน</span>
                        <div class="filter-row__chips filter-row__chips--scroll" role="group" aria-labelledby="filterZoneLabel">
                            <button type="button" class="f-chip" data-zone="all" aria-pressed="true">ทุกโซน <span class="f-chip__count" data-count></span></button>
                            <% ['A', 'B', 'C', 'D', 'E', 'F'].forEach(function(zone) { %>
                            <button type="button" class="f-chip f-chip--zone" data-zone="<%= zone %>" aria-pressed="false">โซน <%= zone %> <span class="f-chip__count" data-count></span></button>
                            <% }) %>
                        </div>
                    </div>
                </section>

                <% if (!isEditable) {
                    // ปิดได้ทั้งรอบ = รอจัดล็อก / รอจ่าย / เลยกำหนดจ่าย (ไม่รวมที่ส่งสลิปแล้ว ต้องตรวจทีละรายการ)
                    const closableCount = bookingRequestsList.filter((r) => ['assign', 'awaiting', 'overdue'].includes(r.stage)).length;
                    const slipCount = bookingRequestsList.filter((r) => r.stage === 'slip').length;
                %>
                <div class="round-close">
                    <div class="round-close__text">
                        <strong>รอบนี้ผ่านไปแล้ว</strong>
                        <span>จัดล็อกไม่ได้ แต่ปิดคำขอที่ค้างได้<% if (slipCount) { %> — มี <span class="mono"><%= slipCount %></span> รายการส่งสลิปแล้ว ต้องตรวจทีละรายการ<% } %></span>
                    </div>
                    <% if (closableCount) { %>
                    <button type="button" class="q-btn q-btn--danger" id="closeStaleRound" data-count="<%= closableCount %>">
                        <i class="fa-solid fa-broom" aria-hidden="true"></i> ปิดคำขอค้างทั้งรอบ (<span class="mono"><%= closableCount %></span>)
                    </button>
                    <% } else { %>
                    <span class="flag flag--ok">ไม่มีคำขอค้างแล้ว</span>
                    <% } %>
                </div>
                <% } else if (!isCurrentRound) { %>
                <p class="round-note">รอบยังไม่เริ่ม จัดการคำขอที่จองล่วงหน้าได้</p>
                <% } %>

                <div class="queue" id="bookingList">
                    <% if (bookingRequestsList.length === 0) { %>
                        <div class="queue-empty">
                            <div class="queue-empty__title">รอบนี้ยังไม่มีคำขอจอง</div>
                            <div class="queue-empty__text">คำขอจองใหม่และคำขอต่อล็อกจากผู้ขายจะแสดงที่นี่ แยกตามสิ่งที่ต้องทำต่อ</div>
                        </div>
                    <% } %>
                    <div class="queue-empty queue-empty--filtered d-none" id="filteredEmpty">
                        <div class="queue-empty__title">ไม่มีรายการตรงกับตัวกรอง</div>
                        <button type="button" class="q-btn q-btn--ghost queue-empty__action" data-reset-filters>ล้างตัวกรอง</button>
                    </div>

                    <% sections.forEach(function(section) { if (!section.rows.length) return; %>
                    <section class="queue-section queue-section--<%= section.stage %>" data-section="<%= section.stage %>">
                        <header class="queue-section__head">
                            <h3 class="queue-section__title"><span class="stage-ic stage-ic--lg stage-ic--<%= section.stage %>" aria-hidden="true"><i class="fa-solid <%= section.icon %>"></i></span><%= section.label %> <span class="mono" data-section-count><%= section.rows.length %></span></h3>
                            <% if (section.hint) { %><p class="queue-section__hint"><%= section.hint %></p><% } %>
                            <% if (section.stage === 'slip') { const verifiedCount = section.rows.filter((r) => r.slipVerified === true).length; if (verifiedCount) { %>
                            <button type="button" class="q-btn q-btn--go queue-section__action" id="confirmVerifiedSlips" data-count="<%= verifiedCount %>">
                                <i class="fa-solid fa-check-double" aria-hidden="true"></i> ยืนยันทุกใบที่ยอดตรง (<span class="mono"><%= verifiedCount %></span>)
                            </button>
                            <% } } %>
                        </header>

                        <% section.rows.forEach(function(request) {
                            const primary = primaryActionFor(request);
                            const detail = {
                                id: request.id, kind: request.kind, stage: request.stage, stageLabel: request.stageLabel,
                                shop: request.productName || '-', zoneLabel: request.zoneLabel, sellerName: request.sellerName || '-',
                                phone: request.phone || '-', createdAtText: request.createdAtText, note: request.description || '-',
                                productImage: request.productImage || '', assignedStallCode: request.assignedStallCode || '',
                                paymentSlipImage: request.paymentSlipImage || '', slipVerified: request.slipVerified,
                                slipVerifyReason: request.slipVerifyReason || '', rejectReason: request.rejectReason || '',
                                cornerZoneNote: request.cornerZoneNote || '', isFinalPrice: Boolean(request.isFinalPrice),
                                booking: request.booking, extension: request.extension, extendOfRequestId: request.extendOfRequestId,
                                paymentDeadlineText: request.paymentDeadlineText, stageIcon: request.stageIcon,
                                actionLogs: request.actionLogs, createdAtFullText: request.createdAtFullText
                            };
                            const searchText = [request.productName, request.sellerName, request.phone, request.assignedStallCode, request.extension && request.extension.originalStallText, '#' + request.id].filter(Boolean).join(' ').toLowerCase();
                        %>
                        <article class="q-row q-row--<%= request.kind %>" data-request-id="<%= request.id %>" data-kind="<%= request.kind %>" data-stage="<%= request.stage %>" data-zone="<%= request.zone || '' %>" data-search="<%= searchText %>" data-detail="<%= JSON.stringify(detail) %>">
                            <div class="q-row__who">
                                <div class="q-row__kind">
                                    <% if (request.kind === 'extend') { %>
                                    <i class="fa-solid fa-rotate" aria-hidden="true"></i> ต่อล็อก <span class="mono">#<%= request.id %></span>
                                    <% } else { %>
                                    <i class="fa-solid fa-plus" aria-hidden="true"></i> จองใหม่ <span class="mono">#<%= request.id %></span>
                                    <% } %>
                                </div>
                                <h4 class="q-row__shop"><%= request.productName || '-' %></h4>
                                <div class="q-row__seller"><%= request.sellerName || '-' %> ·
                                    <% const telDigits = String(request.phone || '').replace(/[^0-9+]/g, ''); %>
                                    <% if (telDigits.length >= 9) { %><a class="q-tel mono" href="tel:<%= telDigits %>" title="โทรหาผู้ขาย"><i class="fa-solid fa-phone" aria-hidden="true"></i> <%= request.phone %></a><% } else { %><span class="mono"><%= request.phone || '-' %></span><% } %>
                                </div>
                            </div>

                            <dl class="q-row__facts">
                                <div><dt>โซน</dt><dd class="mono"><%= request.zone || '-' %></dd></div>
                                <div>
                                    <dt><%= request.kind === 'extend' && !request.assignedStallCode ? 'ล็อกเดิม' : 'ล็อก' %></dt>
                                    <dd class="mono"><%= request.assignedStallCode || (request.extension ? request.extension.originalStallText : '') || (request.requestedStallCount > 1 ? `ขอ ${request.requestedStallCount} ล็อก` : '-') %></dd>
                                </div>
                                <% if (request.booking) { %>
                                <div><dt><%= request.isFinalPrice ? 'ยอดจริง' : 'ยอดประเมิน' %></dt><dd class="mono"><%= fmtMoney(request.booking.grandTotal) %> ฿</dd></div>
                                <div class="q-row__fact--wide"><dt>วันเช่า</dt><dd><span class="mono"><%= request.booking.rentalStartDateText %> – <%= request.booking.rentalEndDateText %></span> <span class="q-muted">คิดเงิน <%= request.booking.billableDays %> วัน</span></dd></div>
                                <% } %>
                            </dl>

                            <div class="q-row__state">
                                <% if (request.stage === 'assign' && request.extension) { %>
                                    <% if (request.extension.cutoffState === 'passed') { %>
                                    <span class="flag flag--danger">เลย 20:00 แล้ว</span>
                                    <span class="q-row__note">ล็อกเดิมยังถูกกันไว้ให้คำขอนี้ — จัดหรือปฏิเสธเพื่อไม่ให้ล็อกค้าง</span>
                                    <% } else if (request.extension.cutoffText) { %>
                                    <span class="flag <%= request.extension.cutoffState === 'soon' ? 'flag--warn' : 'flag--plain' %>" data-deadline="<%= request.extension.cutoffMs %>" data-deadline-kind="cutoff">จัดก่อน <span class="mono"><%= request.extension.cutoffText %></span></span>
                                    <span class="q-row__note">สัญญาเดิมหมด <span class="mono"><%= request.extension.originalEndText %></span></span>
                                    <% } %>
                                <% } else if (request.stage === 'assign') { %>
                                    <span class="q-row__note">ยื่นคำขอ <span class="mono"><%= request.createdAtText %></span></span>
                                    <% if (request.cornerZoneNote) { %><span class="flag flag--plain">สนใจล็อกเต็ง: <%= request.cornerZoneNote %></span><% } %>
                                <% } else if (request.stage === 'slip') { %>
                                    <% if (request.slipVerified === true) { %><span class="flag flag--ok">สลิปจริง ยอดตรง</span>
                                    <% } else if (request.slipVerified === false) { %><span class="flag flag--danger">สลิปมีปัญหา</span><span class="q-row__note"><%= request.slipVerifyReason || 'ตรวจไม่ผ่าน' %></span>
                                    <% } else { %><span class="flag flag--plain">ยังไม่ตรวจอัตโนมัติ</span><% } %>
                                <% } else if (request.stage === 'overdue') { %>
                                    <span class="flag flag--danger" data-deadline="<%= request.paymentDeadlineMs %>" data-deadline-kind="payment">เลยกำหนด <span class="mono"><%= request.paymentDeadlineText %></span></span>
                                    <span class="q-row__note"><%= request.kind === 'extend' ? 'ระบบคืนล็อกเป็นสัญญาเดิมแล้ว' : 'ล็อกยังถูกกันไว้ จนกว่าจะยกเลิก' %></span>
                                <% } else if (request.stage === 'awaiting') { %>
                                    <span class="flag flag--plain" data-deadline="<%= request.paymentDeadlineMs %>" data-deadline-kind="payment">ต้องจ่ายภายใน <span class="mono"><%= request.paymentDeadlineText %></span></span>
                                <% } else if (request.stage === 'rejected') { %>
                                    <span class="q-row__note"><%= request.rejectReason ? `เหตุผล: ${request.rejectReason}` : 'ไม่ระบุเหตุผล' %></span>
                                <% } else if (request.stage === 'done') { %>
                                    <span class="flag flag--ok">จ่ายแล้ว</span>
                                <% } %>
                            </div>

                            <div class="q-row__actions">
                                <% if (primary) { %>
                                <button type="button" class="q-btn q-btn--<%= primary.tone %>" data-action="<%= primary.action %>"><%= primary.label %></button>
                                <% } %>
                                <% if (request.stage === 'done') { %>
                                <a class="q-btn q-btn--ghost" href="/admin/quotations/<%= request.id %>"><i class="fa-solid fa-receipt" aria-hidden="true"></i> ใบเสนอราคา</a>
                                <% } %>
                                <button type="button" class="q-btn q-btn--link" data-action="detail">รายละเอียด</button>
                            </div>
                        </article>
                        <% }) %>
                    </section>
                    <% }) %>
                </div>

            </div>

            <div class="modal-overlay" id="detailModal" onclick="closeModalOnOverlay(event)">
                <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="m-title">
                    <div class="modal-header">
                        <div>
                            <div class="modal-kicker" id="m-kicker"></div>
                            <h3 id="m-title">รายละเอียดคำขอ</h3>
                        </div>
                        <button class="btn-close" onclick="closePopup()" aria-label="ปิด"><i class="fa-solid fa-xmark"></i></button>
                    </div>

                    <div class="modal-body">
                        <div class="modal-stage" id="m-stage"></div>

                        <div class="modal-ext d-none" id="m-ext"></div>

                        <div class="payment-slip-box d-none" id="m-payment-slip-box">
                            <div class="payment-slip-box-top">
                                <strong>สลิปโอนเงิน</strong>
                                <span class="payment-slip-amount" id="m-slip-expected"></span>
                            </div>
                            <div class="card-tags" id="m-slip-tags"></div>
                            <button type="button" class="slip-zoom-btn" id="m-payment-slip-zoom" title="กดเพื่อขยายสลิป">
                                <img id="m-payment-slip" class="payment-slip-thumb" src="" alt="สลิปโอนเงิน">
                                <span class="slip-zoom-btn__hint"><i class="fa-solid fa-magnifying-glass-plus" aria-hidden="true"></i> กดเพื่อขยาย</span>
                            </button>
                        </div>

                        <div class="detail-grid">
                            <span class="detail-label">ร้าน</span><span class="detail-value detail-highlight" id="m-shop"></span>
                            <span class="detail-label">ผู้จอง</span><span class="detail-value" id="m-name"></span>
                            <span class="detail-label">เบอร์โทร</span><span class="detail-value mono" id="m-phone"></span>
                            <span class="detail-label">โซนที่ขอ</span><span class="detail-value" id="m-zone"></span>
                            <span class="detail-label">ล็อกที่จัด</span><span class="detail-value mono" id="m-assigned-stall"></span>
                            <span class="detail-label">วันเช่า</span><span class="detail-value" id="m-rental-dates"></span>
                            <span class="detail-label">ล็อก/เครื่องใช้ไฟฟ้า</span><span class="detail-value" id="m-stall-appliance"></span>
                            <span class="detail-label" id="m-price-label">ยอด</span><span class="detail-value mono" id="m-price"></span>
                            <span class="detail-label">ยื่นคำขอ</span><span class="detail-value mono" id="m-start"></span>
                        </div>

                        <div class="card-tags d-none" id="m-tags"></div>

                        <section class="modal-block" aria-label="ประวัติร้าน">
                            <h4 class="modal-block__title"><i class="fa-solid fa-store" aria-hidden="true"></i> ประวัติร้าน</h4>
                            <div id="m-history" class="seller-history"><span class="q-muted">กำลังโหลด…</span></div>
                        </section>

                        <section class="modal-block" aria-label="ประวัติการดำเนินการ">
                            <h4 class="modal-block__title"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i> ประวัติการดำเนินการ</h4>
                            <ol id="m-timeline" class="action-timeline"></ol>
                        </section>

                        <div class="note-box">
                            <strong>รายละเอียดร้าน/สินค้า</strong><br>
                            <span id="m-note"></span>
                        </div>

                        <div class="shop-image-box" id="m-shop-image-box">
                            <img id="m-shop-image" class="shop-image" src="" alt="รูปภาพร้านค้า">
                            <div id="m-shop-image-empty" class="shop-image-empty d-none">ไม่มีรูปภาพร้านค้า</div>
                        </div>
                    </div>

                    <div class="modal-footer-wrap">
                        <label class="auto-next" title="กดยืนยัน/ปฏิเสธแล้ว เปิดรายการถัดไปในขั้นตอนเดียวกันให้ทันที">
                            <input type="checkbox" id="m-auto-next"> ทำรายการถัดไปต่อ
                        </label>
                        <div class="modal-footer" id="m-footer-actions"></div>
                    </div>
                </div>
            </div>

            <div class="slip-lightbox" id="slipLightbox" hidden role="dialog" aria-modal="true" aria-label="สลิปโอนเงินขนาดเต็ม">
                <div class="slip-lightbox__bar">
                    <span id="slipLightboxAmount"></span>
                    <button type="button" class="slip-lightbox__close" id="slipLightboxClose" aria-label="ปิด"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <img id="slipLightboxImg" src="" alt="สลิปโอนเงินขนาดเต็ม">
            </div>

            <div class="new-toast" id="newRequestToast" hidden role="status">
                <span id="newRequestToastText"></span>
                <button type="button" class="q-btn q-btn--go" onclick="window.location.reload()">โหลดใหม่</button>
                <button type="button" class="new-toast__close" id="newRequestToastClose" aria-label="ปิด"><i class="fa-solid fa-xmark"></i></button>
            </div>

        </div>
        <script>
            window.APPROVAL_PAGE_STATE = {
                isEditable: <%= Boolean(isEditable) %>,
                round: <%= Number(selectedRoundNumber) || 0 %>,
                loadedAt: <%= Date.now() %>,
                flashSuccess: <%- JSON.stringify((typeof success !== 'undefined' && success) || null) %>
            };
        </script>
        <script src="/js/common/dialogs.js"></script>
        <script src="/js/admin/approvals.js"></script>

    </body>
</html>