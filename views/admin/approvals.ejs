<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>รายการจองรออนุมัติ - Admin</title>
        <link rel="icon" type="image/png" href="/img/Logo.png">

        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css"
            rel="stylesheet">
        <link rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link
            href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Sarabun:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap"
            rel="stylesheet">
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260711-5">
        <link rel="stylesheet" href="/stylesheets/admin/theme.css">
        <link rel="stylesheet" href="/stylesheets/admin/approvals.css">
        <link rel="stylesheet" href="/stylesheets/responsive.css">
    </head>
    <body class="bg-light">

        <%- include('../partials/navbar') %>

        <div class="approvals-page">
            <%
                const bookingRequestsList = (typeof bookingRequests !== 'undefined' && Array.isArray(bookingRequests)) ? bookingRequests : [];
                const summaryCounts = (typeof counts !== 'undefined' && counts) ? counts : { all: 0, pending: 0, approved: 0, rejected: 0, zones: {} };
                const zoneCounts = summaryCounts.zones || {};
            %>

            <header class="site-header">
                <a href="javascript:history.back()" class="btn-back"><i
                        class="fa-solid fa-arrow-left"></i></a>
                <h2 class="header-title">รายการจองรออนุมัติ</h2>
                <div class="header-spacer"></div>
            </header>

            <div class="container">

                <div class="filter-section">
                    <div class="summary-strip">
                        <div class="summary-card">
                            <span class="summary-label">ทั้งหมด</span>
                            <span class="summary-value" id="count-all"><%= summaryCounts.all %></span>
                        </div>
                        <div class="summary-card">
                            <span class="summary-label">รออนุมัติ</span>
                            <span class="summary-value"
                                id="count-pending"><%= summaryCounts.pending %></span>
                        </div>
                        <div class="summary-card">
                            <span class="summary-label">อนุมัติแล้ว</span>
                            <span class="summary-value"
                                id="count-approved"><%= summaryCounts.approved %></span>
                        </div>
                        <div class="summary-card">
                            <span class="summary-label">ปฏิเสธ</span>
                            <span class="summary-value"
                                id="count-rejected"><%= summaryCounts.rejected %></span>
                        </div>
                    </div>

                    <div class="search-row">
                        <div class="search-box">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text" id="shopSearch"
                                placeholder="ค้นหาร้านค้า...">
                        </div>
                        <button type="button" class="btn-clear-filters"
                            id="clearFiltersBtn"><i
                                class="fa-solid fa-rotate-left"></i>
                            ล้างตัวกรอง</button>
                    </div>

                    <div class="filter-title">สถานะการจอง</div>
                    <div class="filter-group" id="statusFilters">
                        <button class="btn-filter active"
                            data-status="all">ทั้งหมด</button>
                        <button class="btn-filter"
                            data-status="pending">รออนุมัติ</button>
                        <button class="btn-filter"
                            data-status="approved">อนุมัติแล้ว</button>
                        <button class="btn-filter"
                            data-status="rejected">ปฏิเสธ</button>
                    </div>

                    <div
                        class="filter-title filter-title-spaced">หมวดหมู่</div>
                    <div class="filter-group" id="categoryFilters">
                        <button class="btn-filter active"
                            data-category="all">ทั้งหมด</button>
                        <button class="btn-filter"
                            data-category="FASHION"><i class="fa-solid fa-shirt"></i> แฟชั่น</button>
                        <button class="btn-filter"
                            data-category="FOOD"><i class="fa-solid fa-utensils"></i> อาหาร</button>
                    </div>

                    <div
                        class="filter-title filter-title-spaced">โซน</div>
                    <div class="filter-group" id="zoneFilters">
                        <button class="btn-filter active"
                            data-zone="all">ทุกโซน</button>
                        <button class="btn-filter" data-zone="A">โซน A</button>
                        <button class="btn-filter" data-zone="B">โซน B</button>
                        <button class="btn-filter" data-zone="C">โซน C</button>
                        <button class="btn-filter" data-zone="D">โซน D</button>
                        <button class="btn-filter" data-zone="E">โซน E</button>
                        <button class="btn-filter" data-zone="F">โซน F</button>
                    </div>

                    <div class="type-summary" id="typeSummary">
                        <span>A: <strong id="count-A"><%= zoneCounts.A || 0 %></strong></span>
                        <span>B: <strong id="count-B"><%= zoneCounts.B || 0 %></strong></span>
                        <span>C: <strong id="count-C"><%= zoneCounts.C || 0 %></strong></span>
                        <span>D: <strong id="count-D"><%= zoneCounts.D || 0 %></strong></span>
                        <span>E: <strong id="count-E"><%= zoneCounts.E || 0 %></strong></span>
                        <span>F: <strong id="count-F"><%= zoneCounts.F || 0 %></strong></span>
                    </div>
                </div>

                <div class="list-meta">พบ <span id="visibleCount">0</span>
                    ร้าน</div>

                <div class="card-list" id="bookingList">
                    <% if (bookingRequestsList.length === 0) { %>
                        <div class="empty-state text-center py-5">
                            <i class="fa-solid fa-inbox fa-2x mb-3 text-muted"></i>
                            <div class="fw-semibold text-secondary">ยังไม่มีรายการจองจากผู้ขาย</div>
                            <div class="text-muted small">เมื่อมีการจองใหม่จากหน้า seller ระบบจะแสดงรายการที่นี่</div>
                        </div>
                    <% } %>

                    <% bookingRequestsList.forEach(function(request) { %>
                        <% const detailPayload = encodeURIComponent(JSON.stringify({
                            productName: request.productName || '-',
                            zoneLabel: request.zoneLabel || '-',
                            sellerName: request.sellerName || '-',
                            phone: request.phone || '-',
                            statusLabel: request.statusLabel || '-',
                            requestId: request.id,
                            createdAtText: request.createdAtText || '-',
                            rawStatus: request.status || 'pending',
                            productImage: request.productImage || '',
                            smallApplianceCount: request.smallApplianceCount || 0,
                            largeApplianceCount: request.largeApplianceCount || 0,
                            electricityFee: request.electricityFee || 0,
                            rentTotal: request.rentTotal || 0,
                            grandTotalText: request.grandTotalText || '-',
                            rentalStartDateText: request.rentalStartDateText || '-',
                            rentalEndDateText: request.rentalEndDateText || '-'
                        })); %>
                        <div class="booking-card" data-request-id="<%= request.id %>" data-status="<%= request.status %>" data-zone="<%= request.zone || '' %>" data-shop="<%= request.productName || '' %>" data-detail="<%= detailPayload %>" onclick="openDetailFromElement(this)">
                            <div class="card-header">
                                <h3 class="shop-name"><%= request.productName %></h3>
                                <span class="badge <%= request.status %>"><%= request.statusLabel %></span>
                            </div>
                            <div class="card-body">
                                <p><i class="fa-solid fa-map-location-dot"></i> โซน: <%= request.zoneLabel %></p>
                                <p><i class="fa-solid fa-store"></i> ผู้จอง: <%= request.sellerName %></p>
                                <p><i class="fa-solid fa-phone"></i> เบอร์: <%= request.phone %></p>
                                <p><i class="fa-solid fa-calendar-check"></i> ยื่นคำขอ: <%= request.createdAtText %></p>
                            </div>
                            <div class="card-actions">
                                <button type="button" class="btn-action btn-approve" onclick="event.stopPropagation(); openDetailFromElement(this.closest('.booking-card'))">ดูรายละเอียด</button>
                            </div>
                        </div>
                    <% }) %>

                </div>

            </div>

            <div class="modal-overlay" id="detailModal"
                onclick="closeModalOnOverlay(event)">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3>รายละเอียดการจอง</h3>
                        <button class="btn-close" onclick="closePopup()"><i
                                class="fa-solid fa-xmark"></i></button>
                    </div>

                    <div class="modal-body">
                        <div class="shop-image-box" id="m-shop-image-box">
                            <img id="m-shop-image" class="shop-image" src="" alt="รูปภาพร้านค้า">
                            <div id="m-shop-image-empty" class="shop-image-empty d-none">ไม่มีรูปภาพร้านค้า</div>
                        </div>

                        <div class="detail-grid">
                            <span class="detail-label">ชื่อร้านค้า:</span>
                            <span class="detail-value detail-highlight"
                                id="m-shop"></span>

                            <span class="detail-label">โซนที่ขอ:</span>
                            <span class="detail-value" id="m-zone"></span>

                            <span class="detail-label">ผู้จอง:</span>
                            <span class="detail-value detail-highlight" id="m-name"></span>

                            <span class="detail-label">เบอร์โทรศัพท์:</span>
                            <span class="detail-value" id="m-phone"></span>

                            <span class="detail-label">วันที่ยื่นคำขอ:</span>
                            <span class="detail-value" id="m-start"></span>

                            <span class="detail-label">สถานะ:</span>
                            <span class="detail-value" id="m-status"></span>

                            <span class="detail-label">เครื่องใช้ไฟฟ้าขนาดเล็ก:</span>
                            <span class="detail-value" id="m-small-appliance"></span>

                            <span class="detail-label">เครื่องใช้ไฟฟ้าขนาดใหญ่:</span>
                            <span class="detail-value" id="m-large-appliance"></span>

                            <span class="detail-label">ค่าไฟฟ้ารวม:</span>
                            <span class="detail-value" id="m-electricity-fee"></span>

                            <span class="detail-label">วันเริ่มจอง:</span>
                            <span class="detail-value" id="m-rental-start"></span>

                            <span class="detail-label">วันสิ้นสุดจอง:</span>
                            <span class="detail-value" id="m-rental-end"></span>

                            <span class="detail-label">ราคารวมทั้งหมด:</span>
                            <span class="detail-value detail-highlight" id="m-grand-total"></span>
                        </div>

                        <div class="modal-footer" id="m-footer-actions">
                            <button type="button" class="btn-action btn-reject" id="m-reject-btn">ปฏิเสธการจอง</button>
                            <button type="button" class="btn-action btn-approve" id="m-approve-btn">อนุมัติการจอง</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <script src="/js/admin/approvals.js"></script>

    </body>
</html>