<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>คำขอใบกำกับภาษี | Kangsadan Night Market</title>
        <link rel="icon" type="image/png" href="/img/favicon.png">

        <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

        <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260826-7">
        <link rel="stylesheet" href="/stylesheets/admin/theme.css">
        <link rel="stylesheet" href="/stylesheets/admin/taxInvoiceRequests.css">
    </head>
    <body class="tax-invoice-page">
        <%- include('../partials/navbar') %>

        <header class="site-header">
            <a href="javascript:history.back()" class="btn-back"><i class="fa-solid fa-arrow-left"></i></a>
            <h2 class="header-title">คำขอใบกำกับภาษี</h2>
            <div class="header-spacer"></div>
        </header>

        <div class="container">
            <%
            const flashSuccess = {
                'issued': 'ออกใบกำกับภาษีเรียบร้อยแล้ว',
                'cancelled': 'ยกเลิกคำขอเรียบร้อยแล้ว',
                'reissued': 'ยกเลิกฉบับเดิมและออกใบกำกับภาษีใหม่เรียบร้อยแล้ว'
            }[typeof success !== 'undefined' ? success : null] || null;
            const flashError = {
                'request_not_found': 'ไม่พบคำขอนี้',
                'load_failed': 'เกิดข้อผิดพลาดในการโหลดข้อมูล'
            }[typeof error !== 'undefined' ? error : null] || null;
            const rows = Array.isArray(requests) ? requests : [];
            const pendingCount = rows.filter((r) => r.status === 'PENDING').length;
            const issuedCount = rows.filter((r) => r.status === 'ISSUED').length;
            const cancelledCount = rows.filter((r) => r.status === 'CANCELLED').length;
            const fmtDate = (d) => new Date(d).toLocaleDateString('th-TH', { day: '2-digit', month: 'short', year: '2-digit' });
            const fmtMoney = (n) => Number(n || 0).toLocaleString('th-TH', { minimumFractionDigits: 2 });
            %>

            <% if (flashSuccess) { %>
            <div class="flash-banner flash-banner--success"><i class="fas fa-circle-check"></i><span><%= flashSuccess %></span></div>
            <% } %>
            <% if (flashError) { %>
            <div class="flash-banner flash-banner--error"><i class="fas fa-triangle-exclamation"></i><span><%= flashError %></span></div>
            <% } %>

            <div class="filter-section">
                <div class="summary-strip" id="statusFilters">
                    <button type="button" class="summary-card active" data-status="ALL">
                        <span class="summary-label">ทั้งหมด</span>
                        <span class="summary-value"><%= rows.length %></span>
                    </button>
                    <button type="button" class="summary-card" data-status="PENDING">
                        <span class="summary-label">รอดำเนินการ</span>
                        <span class="summary-value"><%= pendingCount %></span>
                    </button>
                    <button type="button" class="summary-card" data-status="ISSUED">
                        <span class="summary-label">ออกแล้ว</span>
                        <span class="summary-value"><%= issuedCount %></span>
                    </button>
                    <button type="button" class="summary-card" data-status="CANCELLED">
                        <span class="summary-label">ยกเลิกแล้ว</span>
                        <span class="summary-value"><%= cancelledCount %></span>
                    </button>
                </div>

                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" id="taxSearch" placeholder="ค้นหาชื่อผู้เสียภาษี / ผู้ขอ / เลขผู้เสียภาษี...">
                </div>
            </div>

            <div class="list-meta">พบ <span id="visibleCount"><%= rows.length %></span> คำขอ</div>

            <div class="card-list" id="taxList">
                <% if (!rows.length) { %>
                <div class="empty-state">
                    <i class="fa-solid fa-file-invoice fa-2x mb-3"></i>
                    <div class="fw-semibold">ยังไม่มีคำขอใบกำกับภาษี</div>
                    <div class="small">เมื่อผู้ขายส่งคำขอเข้ามา ระบบจะแสดงรายการที่นี่</div>
                </div>
                <% } %>

                <% rows.forEach(function(r) { %>
                <div class="tax-card"
                    data-status="<%= r.status %>"
                    data-search="<%= String(`${r.taxpayerName} ${r.requestedByName} ${r.taxId}`).toLowerCase() %>">
                    <div class="card-header">
                        <h3 class="shop-name"><%= r.taxpayerName %></h3>
                        <span class="badge <%= r.status.toLowerCase() %>"><%= r.statusLabel %></span>
                    </div>

                    <div class="card-tags">
                        <span class="tag tag--tax-id"><i class="fa-solid fa-id-card"></i> เลขผู้เสียภาษี <%= r.taxId %></span>
                        <% if (r.documentNumber) { %>
                        <span class="tag tag--doc-number"><i class="fa-solid fa-hashtag"></i> เลขที่ <%= r.documentNumber %></span>
                        <% } %>
                        <% if (r.replacesRequestId) { %>
                        <span class="tag tag--replaces"><i class="fa-solid fa-rotate"></i> ออกใหม่แทนคำขอ #<%= r.replacesRequestId %></span>
                        <% } %>
                        <% if (r.rejectReason) { %>
                        <span class="tag tag--reason"><i class="fa-solid fa-circle-xmark"></i> <%= r.rejectReason %></span>
                        <% } %>
                    </div>

                    <div class="card-body">
                        <p><i class="fa-solid fa-user"></i> ผู้ขอ: <%= r.requestedByName %></p>
                        <p><i class="fa-solid fa-calendar-check"></i> ยื่นคำขอ: <%= fmtDate(r.requestedAt) %></p>
                        <p><i class="fa-solid fa-receipt"></i> <%= r.quotationCount %> ใบเสนอราคา</p>
                        <p><i class="fa-solid fa-coins"></i> ยอดรวม: <%= fmtMoney(r.netTotal) %> บาท</p>
                    </div>

                    <div class="card-actions">
                        <% if (r.status === 'PENDING') { %>
                        <a class="btn-action btn-approve" href="/admin/tax-invoice-requests/<%= r.id %>/fulfill"><i class="fa-solid fa-pen"></i>&nbsp; กรอกข้อมูล &amp; ออก</a>
                        <form action="/admin/tax-invoice-requests/<%= r.id %>/cancel" method="POST" onsubmit="return confirm('ยืนยันปฏิเสธคำขอนี้?');">
                            <input type="hidden" name="reason" value="แอดมินปฏิเสธคำขอ">
                            <button type="submit" class="btn-action btn-reject">ปฏิเสธ</button>
                        </form>
                        <% } else if (r.status === 'ISSUED') { %>
                        <a class="btn-action btn-neutral" href="/admin/tax-invoices/<%= r.id %>"><i class="fa-solid fa-print"></i>&nbsp; ดู/พิมพ์</a>
                        <a class="btn-action btn-neutral" href="/admin/tax-invoice-requests/<%= r.id %>/fulfill"><i class="fa-solid fa-rotate"></i>&nbsp; ยกเลิก &amp; ออกใหม่</a>
                        <% } %>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>

        <script>
            const statusFilters = document.getElementById('statusFilters');
            const taxSearch = document.getElementById('taxSearch');
            const taxCards = Array.from(document.querySelectorAll('#taxList .tax-card'));
            const visibleCountEl = document.getElementById('visibleCount');
            let activeStatus = 'ALL';

            function applyFilters() {
                const search = String(taxSearch?.value || '').trim().toLowerCase();
                let visible = 0;
                taxCards.forEach((card) => {
                    const statusMatch = activeStatus === 'ALL' || card.dataset.status === activeStatus;
                    const searchMatch = !search || String(card.dataset.search || '').includes(search);
                    const show = statusMatch && searchMatch;
                    card.style.display = show ? '' : 'none';
                    if (show) visible += 1;
                });
                if (visibleCountEl) visibleCountEl.textContent = String(visible);
            }

            if (statusFilters) {
                statusFilters.querySelectorAll('.summary-card').forEach((btn) => {
                    btn.addEventListener('click', () => {
                        statusFilters.querySelectorAll('.summary-card').forEach((b) => b.classList.remove('active'));
                        btn.classList.add('active');
                        activeStatus = btn.dataset.status;
                        applyFilters();
                    });
                });
            }
            if (taxSearch) taxSearch.addEventListener('input', applyFilters);
        </script>
    </body>
</html>
