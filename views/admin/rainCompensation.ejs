<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>ชดเชยฝนตก — Admin</title>
        <link rel="icon" type="image/png" href="/img/favicon.png">

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap"
            rel="stylesheet" />
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
            rel="stylesheet" />
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20261023-ios">
        <link rel="stylesheet" href="/stylesheets/admin/theme.css">
        <link rel="stylesheet" href="/stylesheets/admin/bookingHolidays.css">
        <link rel="stylesheet" href="/stylesheets/admin/rainCompensation.css?v=20261027-today">
        <link rel="stylesheet" href="/stylesheets/responsive.css">
    </head>
    <%
        const fmtDate = (d) => new Date(d).toLocaleDateString('th-TH', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
        const fmtShort = (d) => new Date(d).toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: '2-digit' });
        const fmtTime = (d) => new Date(d).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
        const money = (n) => Number(n || 0).toLocaleString('th-TH');
        const levelOf = (code) => levels.find((l) => l.code === code) || null;
        const STATUS = {
            ACTIVE: ['ใช้ได้', 'state-upcoming'],
            USED: ['ใช้แล้ว', 'state-used'],
            REVOKED: ['เพิกถอน', 'state-revoked'],
            SKIPPED_CAP: ['ครบ 5 ครั้ง', 'state-past'],
            EXPIRED: ['หมดอายุ', 'state-past']
        };
    %>
    <body class="bg-light">
        <script src="/js/common/tabSession.js"></script>
        <%- include('../partials/navbar') %>

        <div class="holidays-page">
            <header class="page-header">
                <a href="javascript:history.back()" class="btn-back"><i class="fa-solid fa-arrow-left"></i></a>
                <h2 class="header-title">ชดเชยฝนตก</h2>
                <div class="header-spacer"></div>
            </header>

            <div class="container">
                <p class="page-sub">
                    ประเมินระดับฝนตามตารางประเมินชดเชยฝนตก (ฝนเล็กน้อย 50% / ฝนปานกลาง 75% / ฝนหนักมาก 100% / เงื่อนไขพิเศษตามดุลยพินิจ) —
                    ร้านที่ชำระเงินแล้วได้ส่วนลดตาม % ของค่าเช่าล็อกวันนั้น ทุกร้านเท่ากัน ปัดเศษขึ้น
                    ใช้กับการจองครั้งถัดไปภายใน <%= limits.expiryDays %> วัน ต้องใช้ทั้งหมดในครั้งเดียว และสะสมได้ไม่เกิน <%= limits.maxActive %> ครั้ง
                </p>

                <% if (error) { %>
                <div class="notice notice-danger"><%= error %></div>
                <% } %>
                <% if (success) { %>
                <div class="notice notice-success"><%= success %></div>
                <% } %>

                <div class="summary-cards">
                    <div class="summary-card">
                        <div class="summary-count"><%= counts.days %></div>
                        <div class="summary-label">วันที่ประกาศชดเชย</div>
                    </div>
                    <div class="summary-card summary-upcoming">
                        <div class="summary-count"><%= money(counts.activeTotal) %></div>
                        <div class="summary-label">ส่วนลดที่ร้านยังใช้ได้ (บาท)</div>
                    </div>
                    <div class="summary-card summary-past">
                        <div class="summary-count"><%= money(counts.usedTotal) %></div>
                        <div class="summary-label">ใช้เป็นส่วนลดไปแล้ว (บาท)</div>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-title">1. เลือกระดับฝน — วันขายวันนี้ <%= fmtDate(today.date) %></div>
                    <div class="panel-body">
                        <%# ประกาศได้เฉพาะวันขายวันนี้ (ตัดวันตอนตี 5 เหมือน utils/shopOpenStatus.js) ไม่ต้องเลือกวัน %>
                        <% if (today.error) { %>
                        <div class="notice notice-danger"><%= today.error %></div>
                        <% } else if (!today.shopCount) { %>
                        <div class="notice notice-danger">วันนี้ไม่มีร้านที่ชำระเงินแล้วและมีล็อก จึงไม่มีร้านให้ชดเชย (ร้านที่ยังไม่จ่ายเงินหรือสัญญาหมดแล้วไม่นับ)</div>
                        <% } else { %>
                        <div class="notice">วันนี้มีร้านที่ชำระเงินแล้วและมีล็อก <strong><%= today.shopCount %> ร้าน</strong> — เลือกระดับฝนแล้วกด "ดูรายชื่อร้าน"</div>
                        <% } %>
                        <form method="GET" action="/admin/rain-compensation" class="js-pick-form">

                            <%# ตารางประเมินชดเชยฝนตก (RAIN_LEVELS ใน utils/rainCompensation.js) — กดการ์ดเพื่อเลือกระดับ % ตามระดับ %>
                            <span class="field-label">ระดับฝน (ตามตารางประเมินชดเชยฝนตก)</span>
                            <div class="rain-levels">
                                <% levels.forEach(function (lv) { %>
                                <label class="rain-level rain-level--<%= lv.code.toLowerCase() %>">
                                    <input type="radio" name="level" value="<%= lv.code %>" <%= pick.level === lv.code ? 'checked' : '' %> required>
                                    <span class="rain-level__head">
                                        <span class="rain-level__name"><%= lv.label %></span>
                                        <span class="rain-level__pct"><%= lv.percent !== null ? `${lv.percent}%` : 'เลือก %' %></span>
                                    </span>
                                    <span class="rain-level__scale"><%= lv.scale %></span>
                                    <ul class="rain-level__criteria">
                                        <% lv.criteria.forEach(function (c) { %><li><%= c %></li><% }) %>
                                    </ul>
                                    <% if (lv.percent === null) { %>
                                    <select class="field-input rain-level__select js-special-percent" name="percent" <%= pick.level === 'SPECIAL' ? '' : 'disabled' %>>
                                        <% specialPercents.forEach(function (p) { %>
                                        <option value="<%= p %>" <%= (pick.level === 'SPECIAL' ? pick.percent : 50) === p ? 'selected' : '' %>><%= p %>%</option>
                                        <% }) %>
                                    </select>
                                    <% } %>
                                </label>
                                <% }) %>
                            </div>
                            <button type="submit" class="btn-submit rain-pick-submit" <%= today.error || !today.shopCount ? 'disabled' : '' %>>ดูรายชื่อร้าน</button>
                        </form>

                    </div>
                </div>

                <% if (preview) { %>
                <div class="panel">
                    <div class="panel-title">2. ตรวจรายชื่อแล้วประกาศ — <%= fmtDate(preview.date) %> · <span class="rain-tag rain-tag--<%= preview.level.code.toLowerCase() %>"><%= preview.level.label %></span> ชดเชย <%= preview.percent %>% ทุกร้าน</div>
                    <div class="panel-body">
                        <% if (preview.error) { %>
                        <div class="notice notice-danger mb-0"><%= preview.error %></div>
                        <% } else if (!preview.shops.length) { %>
                        <div class="notice notice-danger mb-0">วันนี้ไม่มีร้านที่ชำระเงินแล้วและมีล็อก จึงไม่มีร้านให้ชดเชย (ร้านที่ยังไม่จ่ายเงินหรือสัญญาหมดแล้วไม่นับ)</div>
                        <% } else { %>
                        <form method="POST" action="/admin/rain-compensation" class="js-announce-form">
                            <input type="hidden" name="date" value="<%= preview.dateKey %>">
                            <input type="hidden" name="level" value="<%= preview.level.code %>">
                            <input type="hidden" name="percent" value="<%= preview.percent %>">

                            <div class="table-wrap rain-table-wrap">
                                <table class="holidays-table rain-table">
                                    <thead>
                                        <tr>
                                            <th class="cell-check"><input type="checkbox" class="js-check-all" checked aria-label="เลือกทั้งหมด"></th>
                                            <th>ร้าน</th>
                                            <th>ล็อก</th>
                                            <th class="num">ค่าเช่า/วัน</th>
                                            <th class="num">ได้รับ (บาท)</th>
                                            <th>หมายเหตุ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% preview.shops.forEach(function (shop) { %>
                                        <tr class="<%= shop.include ? '' : 'is-off' %>" data-amount="<%= shop.capped ? 0 : shop.amount %>">
                                            <td class="cell-check"><input type="checkbox" name="include_<%= shop.userId %>" value="1" class="js-include" <%= shop.include ? 'checked' : '' %>></td>
                                            <td><strong><%= shop.shopName || shop.name %></strong><% if (shop.shopName) { %><div class="cell-sub"><%= shop.name %></div><% } %></td>
                                            <td class="mono"><%= shop.stallCodes.join(', ') %></td>
                                            <td class="num mono"><%= money(shop.baseRent) %></td>
                                            <td class="num mono js-amount"><%= money(shop.amount) %></td>
                                            <td class="cell-note">
                                                <% if (shop.closed) { %><span class="state-badge state-revoked">กดปิดร้านวันนี้</span><% } %>
                                                <% if (shop.capped) { %><span class="state-badge state-past">สะสมครบ <%= limits.maxActive %> ครั้ง ไม่ได้รับ</span><% } else if (shop.activeCount) { %><span class="cell-sub">มีอยู่ <%= shop.activeCount %> ครั้ง</span><% } %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="4">รวม <span class="js-count">0</span> ร้าน</td>
                                            <td class="num mono"><strong class="js-total">0</strong></td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div class="rain-confirm">
                                <label class="check-line"><input type="checkbox" name="confirmLevel" value="1" required> ตรวจสภาพฝนแล้ว ตรงตามเกณฑ์ "<%= preview.level.label %>" (<%= preview.level.scale %>)</label>
                                <ul class="rain-confirm__criteria">
                                    <% preview.level.criteria.forEach(function (c) { %><li><%= c %></li><% }) %>
                                </ul>
                            </div>

                            <div class="holiday-form rain-announce-form">
                                <div>
                                    <label class="field-label">ประกาศผลให้ผู้ขายเห็นเวลา</label>
                                    <%# เลือกเวลาแบบ 24 ชม. (ช่อง type="time" ขึ้น AM/PM ตามภาษาเครื่อง อ่านยาก) — ทุก 30 นาที 17:00–23:30 %>
                                    <select class="field-input" name="announceTime">
                                        <option value="now">ทันทีที่กดประกาศ</option>
                                        <% for (let h = 17; h <= 23; h += 1) { ['00', '30'].forEach(function (m) { const t = `${h}:${m}`; %>
                                        <option value="<%= t %>" <%= preview.announceTime === t ? 'selected' : '' %>><%= t %> น.</option>
                                        <% }) } %>
                                    </select>
                                </div>
                                <div class="rain-note-field">
                                    <% const isSpecial = preview.level.code === 'SPECIAL'; %>
                                    <label class="field-label"><%= isSpecial ? 'เหตุผล (เงื่อนไขพิเศษต้องระบุ)' : 'หมายเหตุ' %> <span><%= isSpecial ? '' : '(ไม่บังคับ)' %></span></label>
                                    <input type="text" class="field-input" name="note" maxlength="500" value="<%= preview.note %>" placeholder="<%= isSpecial ? 'เช่น ฝนตก 20:30–22:00 ลูกค้าน้อยมาก' : 'เช่น ฝนตกหนัก 17:30–19:45' %>" <%= isSpecial ? 'required' : '' %>>
                                </div>
                                <button type="submit" class="btn-submit">ประกาศชดเชย</button>
                            </div>
                        </form>
                        <% } %>
                    </div>
                </div>
                <% } %>

                <h3 class="section-title">ประวัติการชดเชย</h3>
                <% if (!days.length) { %>
                <div class="table-wrap"><table class="holidays-table"><tbody><tr class="empty-row"><td>ยังไม่เคยประกาศชดเชยฝนตก</td></tr></tbody></table></div>
                <% } %>
                <% days.forEach(function (day) {
                    const announced = new Date(day.announceAt) <= now;
                    const granted = day.credits.filter((c) => c.status !== 'SKIPPED_CAP');
                    const sum = granted.reduce((s, c) => s + (c.status === 'REVOKED' ? 0 : c.amount), 0);
                    const hasUsed = day.credits.some((c) => c.status === 'USED');
                %>
                <details class="rain-day">
                    <summary>
                        <span class="cell-date"><%= fmtDate(day.date) %></span>
                        <% const dayLevel = levelOf(day.level); %>
                        <% if (dayLevel) { %><span class="rain-tag rain-tag--<%= dayLevel.code.toLowerCase() %>"><%= dayLevel.label %></span><% } %>
                        <span class="rain-day__meta"><%= day.percent %>% · <%= granted.length %> ร้าน · <span class="mono"><%= money(sum) %></span> บาท</span>
                        <span class="state-badge <%= announced ? 'state-upcoming' : 'state-past' %>"><%= announced ? `ประกาศแล้ว ${fmtTime(day.announceAt)}` : `จะประกาศ ${fmtTime(day.announceAt)}` %></span>
                    </summary>
                    <% if (day.note) { %><p class="rain-day__note"><%= day.note %></p><% } %>
                    <div class="table-wrap">
                        <table class="holidays-table">
                            <thead>
                                <tr><th>ร้าน</th><th>ล็อก</th><th class="num">%</th><th class="num">ส่วนลด</th><th>หมดอายุ</th><th>สถานะ</th><th></th></tr>
                            </thead>
                            <tbody>
                                <% day.credits.forEach(function (credit) {
                                    const key = credit.status === 'ACTIVE' && new Date(credit.expiresAt) <= now ? 'EXPIRED' : credit.status;
                                %>
                                <tr>
                                    <td><strong><%= credit.shopName || credit.name %></strong><% if (credit.shopName) { %><div class="cell-sub"><%= credit.name %></div><% } %></td>
                                    <td class="mono"><%= credit.stallCodes.replace(/,/g, ', ') %></td>
                                    <td class="num mono"><%= credit.percent %></td>
                                    <td class="num mono"><%= money(credit.amount) %></td>
                                    <td class="mono"><%= fmtShort(credit.expiresAt) %></td>
                                    <td>
                                        <span class="state-badge <%= STATUS[key][1] %>"><%= STATUS[key][0] %></span>
                                        <% if (credit.status === 'USED' && credit.usedOnRequestId) { %><div class="cell-sub">คำขอ #<%= credit.usedOnRequestId %></div><% } %>
                                        <% if (credit.revokeReason) { %><div class="cell-sub"><%= credit.revokeReason %></div><% } %>
                                    </td>
                                    <td class="cell-actions">
                                        <% if (key === 'ACTIVE') { %>
                                        <form method="POST" action="/admin/rain-compensation/credits/<%= credit.id %>/revoke" class="js-revoke-form">
                                            <input type="hidden" name="reason" value="">
                                            <button type="submit" class="btn-row-delete">เพิกถอน</button>
                                        </form>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% if (!hasUsed) { %>
                    <form method="POST" action="/admin/rain-compensation/<%= day.id %>/delete" class="rain-day__delete js-delete-day-form">
                        <button type="submit" class="btn-row-delete">ยกเลิกประกาศของวันนี้ทั้งหมด</button>
                    </form>
                    <% } %>
                </details>
                <% }) %>
            </div>
        </div>

        <script src="/js/common/dialogs.js"></script>
        <script>
            (function () {
                // ช่องเลือก % ของเงื่อนไขพิเศษใช้ได้เฉพาะตอนเลือกการ์ดนั้น (ช่องที่ disabled จะไม่ถูกส่งไปกับฟอร์ม)
                var pickForm = document.querySelector('.js-pick-form');
                if (pickForm) {
                    var specialSelect = pickForm.querySelector('.js-special-percent');
                    var syncSpecial = function () {
                        var checked = pickForm.querySelector('input[name="level"]:checked');
                        if (specialSelect) specialSelect.disabled = !(checked && checked.value === 'SPECIAL');
                    };
                    pickForm.addEventListener('change', syncSpecial);
                    syncSpecial();
                }

                var form = document.querySelector('.js-announce-form');
                if (form) {
                    var rows = Array.prototype.slice.call(form.querySelectorAll('tbody tr'));
                    var checkAll = form.querySelector('.js-check-all');
                    var recalc = function () {
                        var total = 0;
                        var count = 0;
                        rows.forEach(function (row) {
                            var include = row.querySelector('.js-include').checked;
                            // ยอดคำนวณฝั่ง server แล้ว (ทุกร้าน % เดียวกัน ปัดเศษขึ้น) ร้านที่ครบ 5 ครั้งเป็น 0
                            var amount = Number(row.dataset.amount) || 0;
                            row.classList.toggle('is-off', !include);
                            if (include && !row.querySelector('.state-badge.state-past')) { total += amount; count += 1; }
                        });
                        form.querySelector('.js-total').textContent = total.toLocaleString('th-TH');
                        form.querySelector('.js-count').textContent = count;
                        checkAll.checked = rows.every(function (row) { return row.querySelector('.js-include').checked; });
                    };
                    form.addEventListener('input', recalc);
                    form.addEventListener('change', recalc);
                    checkAll.addEventListener('change', function () {
                        rows.forEach(function (row) { row.querySelector('.js-include').checked = checkAll.checked; });
                        recalc();
                    });
                    recalc();
                    form.addEventListener('submit', function (event) {
                        if (form.dataset.confirmed === '1') return;
                        event.preventDefault();
                        window.showConfirmDialog({
                            title: 'ประกาศชดเชยฝนตก',
                            message: '<%= preview ? `${preview.level.label} ชดเชย ${preview.percent}%` : '' %>\nให้ส่วนลดชดเชย ' + form.querySelector('.js-count').textContent + ' ร้าน รวม ' + form.querySelector('.js-total').textContent + ' บาท\nผู้ขายจะเห็นตามเวลาที่ตั้งไว้ ตรวจรายชื่อให้ครบก่อนยืนยัน',
                            confirmText: 'ประกาศชดเชย',
                            onConfirm: function () { form.dataset.confirmed = '1'; form.submit(); }
                        });
                    });
                }

                document.querySelectorAll('.js-revoke-form').forEach(function (revokeForm) {
                    revokeForm.addEventListener('submit', function (event) {
                        if (revokeForm.dataset.confirmed === '1') return;
                        event.preventDefault();
                        window.showConfirmDialog({
                            title: 'เพิกถอนส่วนลดชดเชย',
                            message: 'ร้านนี้จะใช้ส่วนลดชดเชยของวันนี้ไม่ได้อีก',
                            tone: 'danger',
                            confirmText: 'เพิกถอน',
                            inputPlaceholder: 'เหตุผล (ไม่บังคับ)',
                            onConfirm: function (reason) {
                                revokeForm.querySelector('[name="reason"]').value = reason || '';
                                revokeForm.dataset.confirmed = '1';
                                revokeForm.submit();
                            }
                        });
                    });
                });

                document.querySelectorAll('.js-delete-day-form').forEach(function (deleteForm) {
                    deleteForm.addEventListener('submit', function (event) {
                        if (deleteForm.dataset.confirmed === '1') return;
                        event.preventDefault();
                        window.showConfirmDialog({
                            title: 'ยกเลิกประกาศชดเชย',
                            message: 'ส่วนลดชดเชยของทุกร้านในวันนี้จะถูกลบ ใช้เมื่อประกาศผิดวันเท่านั้น',
                            tone: 'danger',
                            confirmText: 'ยกเลิกประกาศ',
                            onConfirm: function () { deleteForm.dataset.confirmed = '1'; deleteForm.submit(); }
                        });
                    });
                });
            })();
        </script>
    </body>
</html>
