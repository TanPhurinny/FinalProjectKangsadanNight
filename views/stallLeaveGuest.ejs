<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>ขายแทนชั่วคราว — ตลาดกังสดาลไนท์</title>
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20261023-ios">
    <link rel="stylesheet" href="/stylesheets/seller/stallLeave.css?v=20261028-edit2">
</head>
<body class="sl-body">
    <% if (!user) { %>
    <header class="sl-guestbar">
        <a href="/"><img src="/img/favicon.png" alt=""><span>ตลาดกังสดาลไนท์</span></a>
        <a href="/login"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i> เข้าสู่ระบบ</a>
    </header>
    <% } else if (user.role === 'ADMIN' || user.role === 'STAFF') { %>
    <%- include('partials/navbar') %>
    <% } else if (user.role === 'SELLER') { %>
    <%- include('partials/navbarSeller') %>
    <% } else { %>
    <%- include('partials/navbarCustomer') %>
    <% } %>
    <%
        const toneOf = { PENDING: 'tone-wait', APPROVED: 'tone-ok', REJECTED: 'tone-bad' };
        const resultText = row ? {
            PENDING: 'ตลาดได้รับข้อมูลแล้ว รอแอดมินพิจารณา ร้านเจ้าของแผงจะได้รับแจ้งผล',
            APPROVED: `อนุมัติแล้ว มาขายที่แผง ${row.stallCode} ได้ตามวันที่ระบุ ปฏิบัติตามกติกาตลาดและคำแนะนำของเจ้าหน้าที่หน้างาน`,
            REJECTED: `ไม่อนุมัติ${row.rejectReason ? ` — ${row.rejectReason}` : ''}`,
            CANCELLED: 'ร้านเจ้าของแผงยกเลิกคำขอนี้แล้ว',
            EXPIRED: 'ลิงก์หมดอายุแล้ว ขอลิงก์ใหม่จากร้านเจ้าของแผง'
        }[row.status] : null;
    %>

    <main class="sl-page">
        <header class="sl-head">
            <div>
                <p class="sl-kicker">ขายแทนชั่วคราว · เช่าช่วงแผง</p>
                <h1 class="sl-title">ข้อมูลผู้มาขายแทน</h1>
                <p class="sl-lead">ตลาดต้องรู้ว่าใครมาขายและขายอะไร เพื่อไม่ให้สินค้าซ้ำกับร้านข้างๆ และเป็นไปตามกติกาตลาด ค่าเช่าช่วงตกลงกับร้านเจ้าของแผงเอง ไม่ต้องชำระผ่านระบบ</p>
            </div>
            <% if (row) { %>
            <div class="sl-head__actions">
                <a class="sl-btn sl-btn--line" href="/market-map?stall=<%= row.stallCode %>"><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i> ดูตำแหน่งแผง</a>
            </div>
            <% } %>
        </header>

        <% if (!row) { %>
        <div class="sl-notice sl-notice--bad" role="alert">ไม่พบคำขอ ลิงก์อาจพิมพ์ไม่ครบ ติดต่อร้านที่ส่งลิงก์ให้คุณ</div>
        <% } else { %>
        <div class="sl-brief" aria-label="รายละเอียดคำขอ">
            <div><small>แผง</small><b><%= row.stallCode %></b></div>
            <div><small>วันที่ขายแทน</small><b><%= row.rangeText %></b></div>
            <div><small>ร้านเจ้าของแผง</small><b><%= row.shopName %></b></div>
        </div>

        <% if (row.status !== 'WAITING_SUBTENANT') { %>
            <% if (submitted) { %><div class="sl-notice" role="status">ส่งข้อมูลแล้ว เก็บลิงก์นี้ไว้เปิดดูผลการพิจารณาได้</div><% } %>
            <ul class="sl-ledger" style="margin-top:32px">
                <li class="sl-row <%= toneOf[row.status] || '' %>">
                    <div class="sl-row__stall">
                        <span class="sl-row__kind">ผลการพิจารณา</span>
                        <span class="sl-row__code"><%= row.stallCode %></span>
                    </div>
                    <div class="sl-row__body">
                        <span class="sl-row__date"><%= row.rangeText %></span>
                        <% if (row.guestName) { %><p class="sl-row__meta">ผู้มาขายแทน <b><%= row.guestName %></b> · สินค้า <b><%= row.guestProductTypeLabel || '-' %><%= row.guestProductSubtype ? ` · ${row.guestProductSubtype}` : '' %></b></p><% } %>
                        <p class="sl-quote<%= row.status === 'REJECTED' ? ' sl-quote--bad' : '' %>"><%= resultText %></p>
                    </div>
                    <div class="sl-row__side">
                        <span class="sl-status"><%= row.status === 'EXPIRED' ? 'ลิงก์หมดอายุ' : row.statusLabel %></span>
                    </div>
                </li>
            </ul>
        <% } else { %>
            <% if (error) { %><div class="sl-notice sl-notice--bad" role="alert"><%= error %></div><% } %>
            <form method="POST" action="/sublet/guest/<%= token %>" enctype="multipart/form-data" class="sl-form" id="guestForm" style="margin-top:8px">
                <section class="sl-step" aria-labelledby="gStep1">
                    <span class="sl-step__num">1</span>
                    <div>
                        <h2 class="sl-step__title" id="gStep1">ผู้มาขายแทน</h2>
                        <p class="sl-step__hint">ใช้ยืนยันตัวตนและติดต่อกรณีมีปัญหาหน้างาน ตลาดไม่เปิดเผยข้อมูลนี้ให้ร้านอื่นหรือลูกค้า</p>
                        <div class="sl-fields">
                            <div class="sl-field sl-field--full">
                                <label for="guestName">ชื่อ-นามสกุล <em>*</em></label>
                                <input class="sl-input" id="guestName" name="guestName" maxlength="100" required autocomplete="name" value="<%= values.guestName || '' %>">
                            </div>
                            <div class="sl-field">
                                <label for="guestPhone">เบอร์โทร <em>*</em></label>
                                <input class="sl-input" id="guestPhone" name="guestPhone" type="tel" inputmode="tel" maxlength="12" required autocomplete="tel" placeholder="08xxxxxxxx" value="<%= values.guestPhone || '' %>">
                            </div>
                            <div class="sl-field">
                                <label for="guestIdCard">เลขบัตรประชาชน <em>*</em> <span>13 หลัก</span></label>
                                <input class="sl-input" id="guestIdCard" name="guestIdCard" inputmode="numeric" maxlength="17" required autocomplete="off" value="<%= values.guestIdCard || '' %>">
                            </div>
                        </div>
                    </div>
                </section>

                <section class="sl-step" aria-labelledby="gStep2">
                    <span class="sl-step__num">2</span>
                    <div>
                        <h2 class="sl-step__title" id="gStep2">สินค้าที่จะขาย</h2>
                        <p class="sl-step__hint">แอดมินใช้เทียบกับร้านข้างๆ ไม่ให้ขายของชนิดเดียวกันติดกัน ขายได้เฉพาะสินค้าที่แจ้งไว้</p>
                        <div class="sl-fields">
                            <div class="sl-field">
                                <label for="guestProductType">ประเภทสินค้า <em>*</em></label>
                                <select class="sl-input" id="guestProductType" name="guestProductType" required>
                                    <option value="">เลือกประเภท</option>
                                    <% Object.entries(productTypes).forEach(function ([code, label]) { %>
                                    <option value="<%= code %>" <%= values.guestProductType === code ? 'selected' : '' %>><%= label %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="sl-field">
                                <label for="guestProductSubtype">ชนิดสินค้าหลัก <em id="subtypeMust">*</em></label>
                                <select class="sl-input" id="guestProductSubtype" name="guestProductSubtype">
                                    <option value="">เลือกประเภทก่อน</option>
                                    <% Object.entries(subtypeGroups).forEach(function ([code, groups]) { groups.forEach(function (g) { %>
                                    <optgroup label="<%= g.group %>" data-type="<%= code %>">
                                        <% g.items.forEach(function (item) { %><option value="<%= item %>" <%= values.guestProductSubtype === item ? 'selected' : '' %>><%= item %></option><% }) %>
                                    </optgroup>
                                    <% }) }) %>
                                </select>
                            </div>
                            <div class="sl-field sl-field--full">
                                <label for="guestProductDetail">รายละเอียดสินค้า/เมนู <em>*</em></label>
                                <textarea class="sl-input" id="guestProductDetail" name="guestProductDetail" maxlength="1000" required placeholder="ขายอะไรบ้าง ราคาประมาณเท่าไร ใช้เครื่องใช้ไฟฟ้าอะไร"><%= values.guestProductDetail || '' %></textarea>
                            </div>
                            <div class="sl-field sl-field--full">
                                <label for="productImages">รูปสินค้า <em>*</em> <span>1–<%= maxImages %> รูป ไม่เกินรูปละ 5MB</span></label>
                                <input class="sl-input" id="productImages" name="productImages" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple required>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="sl-step" aria-labelledby="gStep3">
                    <span class="sl-step__num">3</span>
                    <div>
                        <h2 class="sl-step__title" id="gStep3">ยอมรับกติกา</h2>
                        <p class="sl-step__hint">แผงยังเป็นสิทธิ์ของร้านเจ้าของแผง ตลาดยกเลิกการขายแทนได้หากไม่ปฏิบัติตาม</p>
                        <label class="sl-terms">
                            <input type="checkbox" name="acceptTerms" value="1" required>
                            <span>ฉันจะขายเฉพาะสินค้าที่แจ้งไว้ ปฏิบัติตามกติกาตลาดและคำแนะนำของเจ้าหน้าที่ และรักษาความสะอาดแผง</span>
                        </label>
                    </div>
                </section>

                <div class="sl-submit">
                    <button type="submit" class="sl-btn"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> ส่งข้อมูลให้ตลาดพิจารณา</button>
                    <small>ส่งแล้วเปิดลิงก์เดิมเพื่อดูผลได้</small>
                </div>
            </form>
        <% } %>
        <% } %>
    </main>

    <script>
        // ชนิดสินค้าเลือกได้เฉพาะของประเภทที่เลือก ("อื่นๆ" ไม่บังคับ)
        (function () {
            const type = document.getElementById('guestProductType');
            const sub = document.getElementById('guestProductSubtype');
            if (!type || !sub) return;
            const must = document.getElementById('subtypeMust');
            function sync() {
                sub.querySelectorAll('optgroup').forEach((g) => {
                    const show = g.dataset.type === type.value;
                    g.hidden = !show;
                    g.disabled = !show;
                });
                const selected = sub.selectedOptions[0];
                if (selected && selected.parentElement.tagName === 'OPTGROUP' && selected.parentElement.dataset.type !== type.value) sub.value = '';
                sub.options[0].textContent = type.value ? 'เลือกชนิดสินค้า' : 'เลือกประเภทก่อน';
                sub.required = Boolean(type.value) && type.value !== 'อื่นๆ';
                must.hidden = !sub.required;
            }
            type.addEventListener('change', sync);
            sync();
        })();
    </script>
</body>
</html>
