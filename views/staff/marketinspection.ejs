<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content">
        <title>งานตรวจตลาด | Kangsadan Staff</title>
        <link rel="icon" type="image/png" href="/img/favicon.png">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260724-6">
        <link rel="stylesheet" href="/stylesheets/admin/theme.css">
        <link rel="stylesheet" href="/stylesheets/staff/marketinspection.css">
        <link rel="stylesheet" href="/stylesheets/staff/marketinspection-map.css">
    </head>
    <body
        data-small-appliance-price="<%= smallAppliancePrice %>"
        data-large-appliance-price="<%= largeAppliancePrice %>"
    >
        <script src="/js/common/tabSession.js"></script>
        <%- include('./partials/navbar') %>

        <section class="inspection-page container-fluid px-2 px-md-3 py-4">
            <div class="inspection-header row g-3 align-items-end">
                <div class="col-12 col-lg-6">
                    <h1 class="inspection-title"><%= inspectionRoundLabel %></h1>
                    <p class="inspection-subtitle">วันที่: <%= inspectionDateLabel %></p>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="inspection-toolbar">
                        <div class="search-box-wrapper">
                            <i class="fas fa-search"></i>
                            <input
                                type="text"
                                id="inspectionSearch"
                                placeholder="ค้นหาชื่อล็อค/เลขล็อค"
                                value="<%= query %>"
                            >
                        </div>
                        <div class="view-toggle">
                            <button type="button" class="view-toggle-btn active" id="viewToggleTable" data-mode="table">
                                <i class="fas fa-table"></i> ตาราง</button>
                            <button type="button" class="view-toggle-btn" id="viewToggleZone" data-mode="zone">
                                <i class="fas fa-border-all"></i> โซน</button>
                        </div>
                        <div class="filter-row">
                            <span class="filter-label">กรองข้อมูล</span>
                            <select id="zoneFilter" class="filter-select">
                                <option value="ALL" <%= selectedZone === 'ALL' ? 'selected' : '' %>>โซนทั้งหมด</option>
                                <% zones.forEach((zone) => { %>
                                <option value="<%= zone %>" <%= selectedZone === zone ? 'selected' : '' %>>โซน <%= zone %></option>
                                <% }) %>
                            </select>
                            <select id="issueFilter" class="filter-select">
                                <option value="ALL" selected>ทุกประเภท</option>
                                <option value="no-show">ไม่มาขาย</option>
                                <option value="sublease">ปล่อยเช่าช่วง</option>
                                <option value="other-market">ไปเปิดท้ายหรือขายอื่น</option>
                                <option value="wrong-seller">ขายไม่ตรง(แจ้งเจ้าของล็อค)</option>
                                <option value="electric-overuse">เครื่องใช้ไฟฟ้าเกิน</option>
                                <option value="other-issue">ปัญหาอื่นๆ</option>
                            </select>
                        </div>
                        <div class="inspection-stats" id="inspectionStats">
                            <span class="stats-chip">ทั้งหมด <b id="totalCount">0</b></span>
                            <span class="stats-chip">ที่แสดง <b id="visibleCount">0</b></span>
                            <span class="stats-chip">ล็อคว่าง <b id="vacantCount">0</b></span>
                            <span class="stats-chip">มีปัญหา <b id="flaggedCount">0</b></span>
                            <span class="stats-chip">ตรวจแล้ว <b id="inspectedCount">0</b></span>
                        </div>
                    </div>
                </div>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger mt-3"><%= error %></div>
            <% } %>

            <div class="inspection-flow-hint" id="inspectionFlowHint">โหมดตรวจ: ทุกหัวข้อ</div>

            <div class="inspection-table-wrap mt-3" id="inspectionTableWrap">
                <table class="inspection-table" id="inspectionTable" data-active-issue="ALL">
                    <thead>
                        <tr>
                            <th data-issue="stall">ร้านค้า</th>
                            <th data-issue="no-show">ไม่มาขาย</th>
                            <th data-issue="sublease">ปล่อยเช่าช่วง</th>
                            <th data-issue="other-market">ไปเปิดท้ายหรือขายอื่น</th>
                            <th data-issue="wrong-seller">ขายไม่ตรง(แจ้งเจ้าของล็อค)</th>
                            <th data-issue="electric-overuse">เครื่องใช้ไฟฟ้าเกิน</th>
                            <th data-issue="other-issue">ปัญหาอื่นๆ</th>
                            <th>ตรวจสอบแล้ว</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% stalls.forEach((stall, index) => {
                            const fieldsLocked = stall.inspectionEnabled && stall.isInspected;
                            const fieldsDisabled = !stall.inspectionEnabled || fieldsLocked;
                        %>
                        <tr
                            class="inspection-row <%= stall.isVacant ? 'is-vacant' : '' %> <%= stall.isInspected ? 'is-inspected' : '' %>"
                            data-zone="<%= stall.zoneCode %>"
                            data-stall-id="<%= stall.id %>"
                            data-stall-code="<%= stall.stallCode %>"
                            data-search="<%= String(`${stall.stallCode} ${stall.shopName} ${stall.sellerName}`).toLowerCase() %>"
                        >
                            <td>
                                <div class="stall-main">#<%= index + 1 %> <%= stall.stallCode %> (โซน <%= stall.zoneCode %>)</div>
                                <div class="stall-meta">แถว <%= stall.rowCode %> | ร้าน <%= stall.shopName %></div>
                                <div class="stall-meta">ชื่อผู้ขาย <%= stall.sellerName %> | โทร <%= stall.sellerPhone %></div>
                                <div class="stall-meta">สินค้าหลัก <%= stall.productDetail %></div>
                            </td>
                            <td data-label="ไม่มาขาย" data-issue="no-show"><input type="checkbox" data-issue="no-show" data-role="issue-field" data-stall-id="<%= stall.id %>" <%= stall.issues.noShow ? 'checked' : '' %> <%= fieldsDisabled ? 'disabled' : '' %>></td>
                            <td data-label="ปล่อยเช่าช่วง" data-issue="sublease"><input type="checkbox" data-issue="sublease" data-role="issue-field" data-stall-id="<%= stall.id %>" <%= stall.issues.sublease ? 'checked' : '' %> <%= fieldsDisabled ? 'disabled' : '' %>></td>
                            <td data-label="ไปเปิดท้ายหรือขายอื่น" data-issue="other-market"><input type="checkbox" data-issue="other-market" data-role="issue-field" data-stall-id="<%= stall.id %>" <%= stall.issues.otherMarket ? 'checked' : '' %> <%= fieldsDisabled ? 'disabled' : '' %>></td>
                            <td data-label="ขายไม่ตรง(แจ้งเจ้าของล็อค)" data-issue="wrong-seller"><input type="checkbox" data-issue="wrong-seller" data-role="issue-field" data-stall-id="<%= stall.id %>" <%= stall.issues.wrongSeller ? 'checked' : '' %> <%= fieldsDisabled ? 'disabled' : '' %>></td>
                            <td data-label="เครื่องใช้ไฟฟ้าเกิน" data-issue="electric-overuse">
                                <button
                                    type="button"
                                    class="electric-excess-btn"
                                    data-issue="electric-overuse"
                                    data-stall-id="<%= stall.id %>"
                                    data-stall-code="<%= stall.stallCode %>"
                                    data-small-count="<%= stall.electricExcess ? stall.electricExcess.smallCount : 0 %>"
                                    data-large-count="<%= stall.electricExcess ? stall.electricExcess.largeCount : 0 %>"
                                    data-note="<%= stall.electricExcess ? stall.electricExcess.note : '' %>"
                                    data-active="<%= stall.electricExcess && (stall.electricExcess.smallCount > 0 || stall.electricExcess.largeCount > 0) ? 'true' : 'false' %>"
                                    <%= fieldsDisabled ? 'disabled' : '' %>
                                >
                                    <% if (stall.electricExcess && (stall.electricExcess.smallCount > 0 || stall.electricExcess.largeCount > 0)) { %>
                                    เล็ก x<%= stall.electricExcess.smallCount %> / ใหญ่ x<%= stall.electricExcess.largeCount %> • <%= stall.electricExcess.subtotal %>฿
                                    <% } else { %>
                                    <i class="fas fa-plus"></i> ไม่มี
                                    <% } %>
                                </button>
                            </td>
                            <td class="text-start" data-label="ปัญหาอื่นๆ" data-issue="other-issue">
                                <% if (stall.inspectionEnabled) { %>
                                <input
                                    type="text"
                                    class="other-issue-input"
                                    data-role="issue-field"
                                    data-stall-id="<%= stall.id %>"
                                    value="<%= stall.issues.otherIssueNote %>"
                                    data-last-saved="<%= stall.issues.otherIssueNote %>"
                                    maxlength="1000"
                                    placeholder="พิมพ์รายละเอียดปัญหาอื่นๆ"
                                    <%= fieldsDisabled ? 'disabled' : '' %>
                                >
                                <% } else { %>
                                <span class="issue-placeholder">ล็อคว่าง (ไม่ต้องให้คะแนน)</span>
                                <% } %>
                            </td>
                            <td data-label="ตรวจสอบแล้ว">
                                <div class="inspected-cell-actions">
                                    <input
                                        type="checkbox"
                                        data-role="inspected"
                                        data-stall-id="<%= stall.id %>"
                                        <%= stall.isInspected ? 'checked' : '' %>
                                        <%= stall.inspectionEnabled ? '' : 'disabled' %>
                                    >
                                    <button
                                        type="button"
                                        class="row-edit-btn <%= fieldsLocked ? '' : 'd-none' %>"
                                        data-role="row-edit"
                                        data-stall-id="<%= stall.id %>"
                                    >แก้ไข</button>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                <div id="noResults" class="no-results d-none">ไม่พบข้อมูลตามเงื่อนไขที่เลือก</div>
            </div>

            <div class="inspection-map-wrap d-none" id="inspectionMapWrap">
                <div class="inspection-map-legend">
                    <span class="map-legend-item"><span class="legend-swatch legend-issue"></span> มีปัญหา</span>
                    <span class="map-legend-item"><span class="legend-swatch legend-inspected"></span> ตรวจแล้ว</span>
                    <span class="map-legend-item"><span class="legend-swatch legend-pending"></span> ยังไม่ตรวจ</span>
                    <span class="map-legend-item"><span class="legend-swatch legend-vacant"></span> ว่าง</span>
                </div>

                <div class="insp-zone-overview" id="inspectionZoneOverview">
                    <div class="insp-ov-zone-canvas" id="zoneOverviewCanvas">
                        <div class="insp-ov-zone-block insp-ov-zone-E" data-zone="E"><span class="insp-ov-zone-title">โซน E</span></div>
                        <div class="insp-ov-zone-block insp-ov-zone-D" data-zone="D"><span class="insp-ov-zone-title">โซน D</span></div>
                        <div class="insp-ov-zone-block insp-ov-zone-X" data-zone="X"><span class="insp-ov-zone-title">โซน X</span></div>
                        <div class="insp-ov-zone-block insp-ov-zone-A" data-zone="A"><span class="insp-ov-zone-title">โซน A</span></div>
                        <div class="insp-ov-zone-block insp-ov-zone-F" data-zone="F"><span class="insp-ov-zone-title">โซน F</span></div>
                        <div class="insp-ov-zone-block insp-ov-zone-B" data-zone="B"><span class="insp-ov-zone-title">โซน B</span></div>
                        <div class="insp-ov-zone-block insp-ov-zone-C" data-zone="C"><span class="insp-ov-zone-title">โซน C</span></div>
                    </div>
                </div>

                <div class="insp-zone-detail d-none" id="inspectionZoneDetail">
                    <button type="button" class="zone-back-btn" id="zoneBackBtn">
                        <i class="fas fa-arrow-left"></i> กลับ
                    </button>
                    <h3 class="zone-detail-title" id="zoneDetailTitle">โซน</h3>
                    <div class="inspection-zone-canvas-wrap">
                        <div class="inspection-zone-canvas" id="inspectionZoneCanvas"></div>
                    </div>
                </div>
            </div>
        </section>

        <div class="inspection-map-tooltip" id="inspectionMapTooltip"></div>

        <script type="application/json" id="inspectionZonesDataJson"><%- JSON.stringify(zoneByCode || {}).replace(/</g, '\\u003c') %></script>
        <script type="application/json" id="inspectionStatusByCodeJson"><%- JSON.stringify(inspectionByStallCode || {}).replace(/</g, '\\u003c') %></script>

        <div class="excess-panel-backdrop d-none" id="excessPanelBackdrop"></div>
        <div class="excess-panel d-none" id="excessPanel" role="dialog" aria-modal="true" aria-labelledby="excessPanelTitle">
            <div class="excess-panel-header">
                <h3 id="excessPanelTitle">เครื่องใช้ไฟฟ้าเกิน</h3>
                <button type="button" class="excess-panel-close" id="excessPanelClose" aria-label="ปิด"><i class="fas fa-times"></i></button>
            </div>
            <div class="excess-panel-body">
                <div class="excess-stepper-row">
                    <div class="excess-stepper-info">
                        <div class="excess-stepper-label">เครื่องเล็ก (1-1200W)</div>
                        <div class="excess-stepper-price" id="excessSmallPriceLabel">20 บาท/เครื่อง</div>
                    </div>
                    <div class="excess-stepper-control">
                        <button type="button" class="excess-step-btn" data-step="small" data-dir="-1" aria-label="ลดจำนวนเครื่องเล็ก">&minus;</button>
                        <input type="number" min="0" max="50" id="excessSmallCount" value="0" inputmode="numeric">
                        <button type="button" class="excess-step-btn" data-step="small" data-dir="1" aria-label="เพิ่มจำนวนเครื่องเล็ก">+</button>
                    </div>
                </div>
                <div class="excess-stepper-row">
                    <div class="excess-stepper-info">
                        <div class="excess-stepper-label">เครื่องใหญ่ (1201W ขึ้นไป)</div>
                        <div class="excess-stepper-price" id="excessLargePriceLabel">40 บาท/เครื่อง</div>
                    </div>
                    <div class="excess-stepper-control">
                        <button type="button" class="excess-step-btn" data-step="large" data-dir="-1" aria-label="ลดจำนวนเครื่องใหญ่">&minus;</button>
                        <input type="number" min="0" max="50" id="excessLargeCount" value="0" inputmode="numeric">
                        <button type="button" class="excess-step-btn" data-step="large" data-dir="1" aria-label="เพิ่มจำนวนเครื่องใหญ่">+</button>
                    </div>
                </div>
                <label class="excess-note-label" for="excessNote">หมายเหตุ (ถ้ามี)</label>
                <textarea id="excessNote" maxlength="500" placeholder="เช่น พบไมโครเวฟเพิ่ม 1 เครื่องหลังเคาน์เตอร์"></textarea>
                <div class="excess-subtotal-row">ยอดรวม: <b id="excessSubtotalPreview">0</b> บาท</div>
                <div class="excess-panel-error d-none" id="excessPanelError"></div>
            </div>
            <div class="excess-panel-footer">
                <button type="button" class="btn-excess-cancel" id="excessPanelCancel">ยกเลิก</button>
                <button type="button" class="btn-excess-save" id="excessPanelSave">บันทึก</button>
            </div>
        </div>

        <script src="/js/staff/marketinspection.js"></script>
        <script src="/js/staff/marketinspection-map.js"></script>
    </body>
</html>
