<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>คะแนนร้านค้า | Kangsadan Staff</title>
        <link rel="icon" type="image/png" href="/img/favicon.png">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260826-7">
        <link rel="stylesheet" href="/stylesheets/admin/theme.css">
    </head>
    <body class="bg-light">
        <script src="/js/common/tabSession.js"></script>
        <%- include('./partials/navbar') %>

        <div class="container py-4">
            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger mb-3"><%= error %></div>
            <% } %>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <div>
                    <h1 class="fw-bold mb-1"><i class="fas fa-star me-2"></i>คะแนนร้านค้า รอบที่ <%= roundNumber %></h1>
                    <p class="text-muted mb-0">คะแนนสะสม = ค่าเฉลี่ยคะแนนของทุกรอบที่ร้านนั้นเคยขาย คำนวณจากผลตรวจตลาดรายวัน</p>
                </div>
                <div class="d-flex gap-2">
                    <a class="hero-btn" href="<%= basePath %>?round=<%= roundNumber - 1 %>"><i class="fas fa-arrow-left"></i> รอบก่อนหน้า</a>
                    <a class="hero-btn" href="<%= basePath %>?round=<%= currentRoundNumber %>">รอบปัจจุบัน</a>
                    <a class="hero-btn" href="<%= basePath %>?round=<%= roundNumber + 1 %>">รอบถัดไป <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>

            <%- include('../partials/seller-score-table') %>
        </div>
    </body>
</html>
