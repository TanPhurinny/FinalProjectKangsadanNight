<%
const currentPath = locals.path || '';
%>

<nav class="management-nav">
    <div class="nav-container">
        <a href="/staff/dashboard" class="nav-brand">
            <img src="/img/favicon.png" alt="Kang Night Logo" class="nav-logo">
            KangsadanNight
        </a>

        <button class="nav-toggle" id="navToggle">
            <i class="fas fa-bars"></i>
        </button>

        <div class="nav-links" id="navMenu">
            <a href="/staff/dashboard"
                class="nav-item <%= currentPath.includes('/staff/dashboard') ? 'active' : '' %>">
                <i class="fas fa-th-large"></i> แดชบอร์ด
            </a>
            <a href="/admin/slots"
                class="nav-item <%= currentPath.includes('/admin/slots') ? 'active' : '' %>">
                <i class="fas fa-map-marked-alt"></i> ผังตลาด
            </a>
            <a href="/admin/requests"
                class="nav-item <%= currentPath.includes('/admin/requests') ? 'active' : '' %>">
                <i class="fas fa-tools"></i> การแจ้งคำร้อง
            </a>
            <a href="/staff/marketinspection"
                class="nav-item <%= currentPath.includes('/staff/marketinspection') && !currentPath.includes('/report') ? 'active' : '' %>">
                <i class="fas fa-clipboard-check"></i> งานตรวจตลาด
            </a>
            <a href="/staff/marketinspection/report"
                class="nav-item <%= currentPath.includes('/staff/marketinspection/report') ? 'active' : '' %>">
                <i class="fas fa-chart-line"></i> รายงานตรวจตลาด
            </a>
            <a href="/staff/seller-scores"
                class="nav-item <%= currentPath.includes('/staff/seller-scores') ? 'active' : '' %>">
                <i class="fas fa-star"></i> คะแนนร้านค้า
            </a>

            <div class="nav-actions d-flex align-items-center">
                <a href="/profile"
                    class="user-badge user-badge-link shadow-sm <%= currentPath.includes('/profile') ? 'active' : '' %>">
                    <i class="fas fa-user-circle"></i>
                    <%= user.name %>
                </a>
                <a href="/logout" class="logout-link">
                    <i class="fas fa-sign-out-alt me-1"></i>ออกจากระบบ
                </a>
            </div>
        </div>
    </div>
</nav>

<script src="/js/partials/navbar.js"></script>
