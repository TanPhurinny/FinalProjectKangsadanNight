<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>สถานะการจอง</title>
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260711-5" />
  <link rel="stylesheet" href="/stylesheets/seller/statusbook.css" />
</head>
<%
  const bookingPayload = typeof booking !== 'undefined' ? booking : null;
  const pageDataJson = JSON.stringify({ booking: bookingPayload });
%>
<body data-page="booking-status" data-page-data="<%= encodeURIComponent(pageDataJson) %>">
<script src="/js/common/tabSession.js"></script>
  <% if (user && user.role === 'SELLER') { %>
  <%- include('../partials/navbarSeller') %>
  <% } else { %>
  <%- include('../partials/navbarCustomer') %>
  <% } %>

  <main class="container page-shell">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger" role="alert">
        <%
          const errorMessages = {
            upload_failed: 'อัปโหลดไฟล์ไม่สำเร็จ กรุณาลองใหม่อีกครั้ง',
            missing_slip: 'กรุณาแนบสลิปโอนเงินก่อนยืนยัน',
            not_awaiting_payment: 'ไม่พบรายการที่รอชำระเงินอยู่ในขณะนี้',
            slip_already_uploaded: 'คุณส่งสลิปโอนเงินไปแล้ว กรุณารอแอดมินตรวจสอบ',
            payment_confirm_failed: 'เกิดข้อผิดพลาดขณะบันทึกการยืนยันชำระเงิน กรุณาลองใหม่'
          };
        %>
        <%= errorMessages[error] || 'เกิดข้อผิดพลาด กรุณาลองใหม่อีกครั้ง' %>
      </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success === 'slip_uploaded') { %>
      <div class="alert alert-success" role="alert">ส่งสลิปโอนเงินสำเร็จแล้ว กรุณารอแอดมินตรวจสอบและยืนยันการชำระเงิน</div>
    <% } %>
    <% if (typeof success !== 'undefined' && success === 'payment_confirmed') { %>
      <div class="alert alert-success" role="alert">แอดมินยืนยันการชำระเงินแล้ว ระบบบันทึกล็อกนี้เป็นของคุณเรียบร้อย</div>
    <% } %>
    <div class="page-hero card-custom">
      <div>
        <h1 class="page-hero__title">สถานะการจอง</h1>
        <p class="page-hero__subtitle">ติดตามสถานะการจองจากฐานข้อมูลแบบเรียลไทม์</p>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <a href="/select-zone" class="btn btn-custom-primary btn-custom">จองแผงใหม่</a>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-8">
        <div class="card card-custom booking-main-card p-4 shadow-soft">
          <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
              <span class="text-muted small d-block">เลขที่การจอง</span>
              <span class="fw-bold text-dark-custom fs-5" id="bookingNumber">#BK-000000</span>
            </div>
            <div id="statusBadgeContainer"></div>
          </div>

          <div class="status-hero__meta mb-3">
            <span><i class="bi bi-calendar-event me-1"></i>วันที่ยื่นคำขอ: <span id="bookingDate">-</span></span>
            <span><i class="bi bi-clock me-1"></i>เวลา: <span id="bookingTime">-</span></span>
          </div>

          <div id="scenarioContent"></div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card card-custom timeline-card p-4 shadow-soft h-100">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark-custom m-0"><i class="bi bi-hourglass-split text-primary-custom me-2"></i>ลำดับสถานะ</h5>
          </div>
          <div class="timeline-vertical" id="timelineContainer"></div>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/seller/statusbook.js"></script>
</body>
</html>
