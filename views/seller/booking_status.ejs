<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>สถานะการจอง</title>
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20261023-ios" />
  <link rel="stylesheet" href="/stylesheets/seller/statusbook.css" />
</head>
<%
  const bookingPayload = typeof booking !== 'undefined' ? booking : null;
  const pageDataJson = JSON.stringify({ booking: bookingPayload });
%>
<body data-page="booking-status" data-page-data="<%= encodeURIComponent(pageDataJson) %>">
<script src="/js/common/tabSession.js"></script>
  <% if (user && user.role === 'SELLER' && !viewAsCustomer) { %>
  <%- include('../partials/navbarSeller') %>
  <% } else { %>
  <%- include('../partials/navbarCustomer') %>
  <% } %>

  <main class="container page-shell">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger" role="alert">
        <%
          const errorMessages = {
            upload_failed: 'อัปโหลดไฟล์ไม่สำเร็จ กรุณาลองใหม่อีกครั้ง',
            missing_slip: 'กรุณาแนบสลิปโอนเงินก่อนยืนยัน',
            no_slip_to_remove: 'ไม่มีสลิปที่ลบได้ (แอดมินอาจยืนยันการชำระเงินไปแล้ว)',
            remove_slip_failed: 'ลบสลิปไม่สำเร็จ กรุณาลองใหม่',
            slip_too_large: 'ไฟล์สลิปใหญ่เกิน 5MB กรุณาแคปหน้าจอสลิปจากแอปธนาคารแล้วส่งใหม่',
            slip_invalid_type: 'รองรับเฉพาะรูป JPG, PNG, GIF หรือ WEBP (รูป HEIC จาก iPhone ให้แคปหน้าจอสลิปแทน)',
            not_awaiting_payment: 'ไม่พบรายการที่รอชำระเงินอยู่ในขณะนี้',
            slip_already_uploaded: 'คุณส่งสลิปโอนเงินไปแล้ว กรุณารอแอดมินตรวจสอบ',
            payment_confirm_failed: 'เกิดข้อผิดพลาดขณะบันทึกการยืนยันชำระเงิน กรุณาลองใหม่',
            no_active_lock_to_extend: 'ไม่พบล็อกที่จัดสรรแล้วในรอบปัจจุบันให้ต่อ',
            extend_failed: 'เกิดข้อผิดพลาดขณะส่งคำขอต่อล็อค กรุณาลองใหม่',
            extend_already_requested: 'คุณส่งคำขอต่อล็อกไปแล้ว กรุณารอแอดมินตรวจสอบหรือชำระเงินของคำขอเดิมก่อน',
            blacklisted: 'ร้านค้าของคุณถูกระงับสิทธิ์การจอง/ต่อล็อก (Blacklist) กรุณาติดต่อผู้ดูแลตลาด'
          };
        %>
        <%= errorMessages[error] || 'เกิดข้อผิดพลาด กรุณาลองใหม่อีกครั้ง' %>
      </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success === 'slip_uploaded') { %>
      <div class="alert alert-success" role="alert">ส่งสลิปโอนเงินสำเร็จแล้ว กรุณารอแอดมินตรวจสอบและยืนยันการชำระเงิน</div>
    <% } %>
    <% if (typeof success !== 'undefined' && success === 'slip_removed') { %>
      <div class="alert alert-success" role="alert">ลบสลิปเดิมแล้ว อัปโหลดสลิปใหม่ได้ด้านล่าง</div>
    <% } %>
    <% if (typeof success !== 'undefined' && success === 'payment_confirmed') { %>
      <div class="alert alert-success" role="alert">แอดมินยืนยันการชำระเงินแล้ว ระบบบันทึกล็อกนี้เป็นของคุณเรียบร้อย</div>
    <% } %>
    <% if (typeof success !== 'undefined' && success === 'extend_requested') { %>
      <div class="alert alert-success" role="alert">ส่งคำขอต่อล็อคแล้ว กรุณารอแอดมินอนุมัติ</div>
    <% } %>
    <div class="page-hero card-custom">
      <div>
        <h1 class="page-hero__title">สถานะการจอง</h1>
        <p class="page-hero__subtitle">ติดตามสถานะการจองจากฐานข้อมูลแบบเรียลไทม์</p>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <a href="/select-zone" class="btn btn-custom-primary btn-custom">จองแผงใหม่</a>
        <% if (typeof canExtendLock !== 'undefined' && canExtendLock) { %>
        <a href="/booking-stall/extend" class="btn btn-custom-primary btn-custom">ต่อล็อค</a>
        <% } %>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-8">
        <div class="card card-custom booking-main-card p-4 shadow-soft">
          <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
              <span class="text-muted small d-block">เลขที่การจอง</span>
              <span class="fw-bold text-dark-custom fs-5" id="bookingNumber">#BK-000000</span>
            </div>
            <div id="statusBadgeContainer"></div>
          </div>

          <div class="status-hero__meta mb-3">
            <span><i class="bi bi-calendar-event me-1"></i>วันที่ยื่นคำขอ: <span id="bookingDate">-</span></span>
            <span><i class="bi bi-clock me-1"></i>เวลา: <span id="bookingTime">-</span></span>
          </div>

          <div id="scenarioContent"></div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card card-custom timeline-card p-4 shadow-soft h-100">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark-custom m-0"><i class="bi bi-hourglass-split text-primary-custom me-2"></i>ลำดับสถานะ</h5>
          </div>
          <div class="timeline-vertical" id="timelineContainer"></div>
        </div>
      </div>
    </div>
  </main>

  <% if (typeof slipCheck !== 'undefined' && slipCheck && success === 'slip_uploaded') { %>
  <%# popup หลังส่งสลิปที่ระบบตรวจอัตโนมัติไม่ได้ (ดู verifySlip ใน utils/slipVerification.js) %>
  <div class="modal fade" id="slipCheckModal" tabindex="-1" aria-labelledby="slipCheckModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-custom">
        <div class="modal-header">
          <h5 class="modal-title" id="slipCheckModalTitle"><i class="bi bi-qr-code-scan me-2"></i><%= slipCheck === 'no_qr' ? 'สลิปนี้ไม่มี QR code' : 'ระบบตรวจสลิปอัตโนมัติใช้งานไม่ได้ชั่วคราว' %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
        </div>
        <div class="modal-body">
          <% if (slipCheck === 'no_qr') { %>
          <p>ระบบส่งสลิปของคุณให้แอดมินเรียบร้อยแล้ว แต่สลิปนี้<strong>ไม่มี QR code ตรวจสลิปของธนาคาร</strong> (เช่น สลิป TrueMoney Wallet, ใบเสร็จ 7-Eleven/Counter Service หรือใบเสร็จของบริษัท) ระบบจึงตรวจอัตโนมัติไม่ได้</p>
          <p class="mb-0">แอดมินจะตรวจสลิปนี้เอง ซึ่ง<strong>อาจใช้เวลานานกว่าปกติ</strong> ครั้งหน้าถ้าโอนผ่านแอปธนาคาร (สลิปมี QR code มุมล่าง) ระบบจะตรวจให้ทันที</p>
          <% } else { %>
          <p class="mb-0">ระบบส่งสลิปของคุณให้แอดมินเรียบร้อยแล้ว แต่ตอนนี้ระบบตรวจสลิปอัตโนมัติใช้งานไม่ได้ แอดมินจะตรวจสลิปนี้เอง ซึ่ง<strong>อาจใช้เวลานานกว่าปกติ</strong> ไม่ต้องส่งสลิปซ้ำ</p>
          <% } %>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-custom-primary btn-custom" data-bs-dismiss="modal">รับทราบ</button>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/common/dialogs.js"></script>
  <script src="/js/seller/statusbook.js?v=20261023-pay"></script>
  <script>
    (function () {
      var el = document.getElementById('slipCheckModal');
      if (!el || !window.bootstrap) return;
      new bootstrap.Modal(el).show();
      // ลบ slipCheck ออกจาก URL กัน popup เด้งซ้ำตอนรีเฟรช
      var url = new URL(window.location.href);
      url.searchParams.delete('slipCheck');
      window.history.replaceState(null, '', url.pathname + url.search + url.hash);
    })();
  </script>
</body>
</html>
