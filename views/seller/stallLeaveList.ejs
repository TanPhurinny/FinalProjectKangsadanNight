<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ลาหยุด / เช่าช่วงแผง — ตลาดกังสดาลไนท์</title>
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20261023-ios">
    <link rel="stylesheet" href="/stylesheets/seller/stallLeave.css?v=20261028-edit2">
</head>
<body class="sl-body">
    <script src="/js/common/tabSession.js"></script>
    <%- include('../partials/navbarSeller') %>
    <%
        const successMessages = {
            created: 'ส่งคำขอลาหยุดแล้ว รอแอดมินพิจารณา ผลจะแจ้งในหน้าแจ้งเตือน',
            sublet_sent: 'ส่งคำขอให้ร้านผู้รับเช่าช่วงแล้ว รอร้านนั้นตอบรับ แล้วคำขอจะส่งต่อให้แอดมิน',
            guest_link: 'สร้างลิงก์แล้ว คัดลอกหรือแชร์ลิงก์ในแถวด้านล่างให้คนที่จะมาขายแทนกรอกข้อมูล (ใช้ได้ 72 ชม. และไม่เกินวันเริ่ม)',
            accepted: 'ตอบรับแล้ว คำขอส่งให้แอดมินพิจารณา',
            declined: 'ปฏิเสธการรับเช่าช่วงแล้ว ร้านเจ้าของแผงได้รับแจ้ง',
            cancelled: 'ยกเลิกคำขอแล้ว',
            edited: 'บันทึกการแก้ไขแล้ว คำขอต้องผ่านการพิจารณาใหม่ (ดูสถานะในแถวด้านล่าง)'
        };
        const toneOf = { WAITING_SUBTENANT: 'tone-wait', PENDING: 'tone-wait', APPROVED: 'tone-ok', REJECTED: 'tone-bad' };
        const kindShort = { LEAVE: 'ลาหยุด', SUBLET_MEMBER: 'เช่าช่วง · สมาชิก', SUBLET_GUEST: 'เช่าช่วง · คนนอก' };
        const todayStart = new Date(new Date().setHours(0, 0, 0, 0));
        const waiting = rows.filter((r) => r.status === 'WAITING_SUBTENANT' || r.status === 'PENDING').length;
        const approvedUpcoming = rows.filter((r) => r.status === 'APPROVED' && new Date(r.endDate) >= todayStart).length;
        const needReply = incoming.filter((r) => r.canRespond).length;
    %>

    <main class="sl-page">
        <header class="sl-head">
            <div>
                <p class="sl-kicker">จัดการร้าน · แผงของฉัน</p>
                <h1 class="sl-title">ลาหยุด / เช่าช่วงแผง</h1>
                <p class="sl-lead">ไม่สะดวกมาขายบางวันในช่วงสัญญา แจ้งลาหยุด หรือให้ร้านอื่นมาขายแทนชั่วคราว ทุกคำขอต้องผ่านแอดมิน ยกเลิกหรือแก้ไขได้ถึง 15:00 น. ของวันเริ่ม (เวลาตลาดเปิด)</p>
            </div>
            <div class="sl-head__actions">
                <a class="sl-btn" href="/stall-leave/new"><i class="fa-solid fa-calendar-minus" aria-hidden="true"></i> แจ้งลาหยุด</a>
                <a class="sl-btn sl-btn--line" href="/stall-leave/new?kind=sublet"><i class="fa-solid fa-handshake" aria-hidden="true"></i> ปล่อยเช่าช่วง</a>
            </div>
        </header>

        <% if (success && successMessages[success]) { %>
        <div class="sl-notice" role="status"><%= successMessages[success] %></div>
        <% } %>
        <% if (error) { %>
        <div class="sl-notice sl-notice--bad" role="alert"><%= error %></div>
        <% } %>

        <div class="sl-stats" aria-label="สรุปคำขอ">
            <div class="sl-stat"><small>กำลังดำเนินการ</small><b><%= waiting %></b></div>
            <div class="sl-stat"><small>อนุมัติแล้ว ยังไม่จบ</small><b><%= approvedUpcoming %></b></div>
            <div class="sl-stat"><small>คำขอทั้งหมด</small><b><%= rows.length %></b></div>
            <a class="sl-stat<%= needReply ? ' is-active' : '' %>" href="#incoming"><small>รอคุณตอบรับเช่าช่วง</small><b><%= needReply %></b></a>
        </div>

        <section class="sl-section sl-section--first" aria-labelledby="mineTitle">
            <div class="sl-section__head">
                <h2 class="sl-section__title" id="mineTitle">คำขอของแผงร้านคุณ</h2>
                <p class="sl-section__hint">เรียงจากล่าสุด</p>
            </div>
            <% if (!rows.length) { %>
            <div class="sl-empty"><b>ยังไม่มีคำขอ</b>กด "แจ้งลาหยุด" หรือ "ปล่อยเช่าช่วง" ด้านบนเมื่อไม่สะดวกมาขาย</div>
            <% } %>
            <ul class="sl-ledger">
                <% rows.forEach(function (r) { %>
                <li class="sl-row <%= toneOf[r.status] || '' %> <%= r.id === focusId ? 'is-focus' : '' %>" id="leave-<%= r.id %>">
                    <div class="sl-row__stall">
                        <span class="sl-row__kind"><%= kindShort[r.kind] %></span>
                        <span class="sl-row__code"><%= r.stallCode %></span>
                        <span class="sl-row__id">#<%= r.id %></span>
                    </div>
                    <div class="sl-row__body">
                        <span class="sl-row__date"><%= r.rangeText %></span>
                        <p class="sl-row__meta">ร้าน <b><%= r.shopName %></b><% if (r.subShopName) { %> · ผู้มาขายแทน <b><%= r.subShopName %></b><% } %> · ส่งเมื่อ <%= r.createdText %></p>
                        <p class="sl-quote"><%= r.reason %></p>
                        <% if (r.kind === 'SUBLET_GUEST' && r.guestName) { %>
                        <p class="sl-row__meta">สินค้าที่จะขาย <b><%= r.guestProductTypeLabel || '-' %><%= r.guestProductSubtype ? ` · ${r.guestProductSubtype}` : '' %></b></p>
                        <% } %>
                        <% if (r.status === 'REJECTED' && r.rejectReason) { %>
                        <p class="sl-quote sl-quote--bad"><%= r.rejectReason %></p>
                        <% } %>
                    </div>
                    <div class="sl-row__side">
                        <span class="sl-status"><%= r.statusLabel %></span>
                        <% if (r.reviewedText) { %><small>พิจารณา <%= r.reviewedText %><%= r.reviewedByName ? ` · ${r.reviewedByName}` : '' %></small><% } %>
                        <% if (r.canCancel) { %>
                        <div class="sl-row__actions">
                            <a class="sl-btn sl-btn--line sl-btn--sm" href="/stall-leave/<%= r.id %>/edit"><i class="fa-solid fa-pen" aria-hidden="true"></i> แก้ไข</a>
                            <form method="POST" action="/stall-leave/<%= r.id %>/cancel" data-confirm-title="ยกเลิกคำขอนี้?" data-confirm-message="<%= r.kindLabel %> แผง <%= r.stallCode %> · <%= r.rangeText %>" data-confirm-text="ยกเลิกคำขอ">
                                <button type="submit" class="sl-btn sl-btn--danger sl-btn--sm">ยกเลิก</button>
                            </form>
                        </div>
                        <small class="sl-row__deadline">แก้/ยกเลิกได้ถึง <%= r.changeDeadlineText %></small>
                        <% } else if (r.status === 'APPROVED' || r.status === 'PENDING' || r.status === 'WAITING_SUBTENANT') { %>
                        <small class="sl-row__deadline">เลย <%= r.changeDeadlineText %> แล้ว ตลาดเปิด แก้/ยกเลิกไม่ได้</small>
                        <% } %>
                    </div>
                    <% if (r.kind === 'SUBLET_GUEST' && r.status === 'WAITING_SUBTENANT' && r.guestToken) { const link = guestBaseUrl + r.guestToken; %>
                    <div class="sl-row__extra">
                        <div class="sl-link">
                            <span class="sl-link__label">ส่งลิงก์นี้ให้คนที่จะมาขายแทนกรอกข้อมูลและรูปสินค้า · หมดอายุ <%= new Date(r.guestTokenExpiresAt).toLocaleString('th-TH', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %> น.</span>
                            <input type="text" readonly value="<%= link %>" aria-label="ลิงก์ให้คนนอกกรอกข้อมูล" data-link-input>
                            <button type="button" class="sl-btn sl-btn--sm" data-copy-link><i class="fa-regular fa-copy" aria-hidden="true"></i> คัดลอก</button>
                            <a class="sl-btn sl-btn--line sl-btn--sm" href="https://line.me/R/msg/text/?<%= encodeURIComponent(`กรอกข้อมูลขายแทนที่แผง ${r.stallCode} ตลาดกังสดาลไนท์ ${link}`) %>" target="_blank" rel="noopener"><i class="fa-brands fa-line" aria-hidden="true"></i> แชร์ LINE</a>
                        </div>
                    </div>
                    <% } %>
                </li>
                <% }) %>
            </ul>
        </section>

        <section class="sl-section" id="incoming" aria-labelledby="incomingTitle">
            <div class="sl-section__head">
                <h2 class="sl-section__title" id="incomingTitle">คำขอให้ร้านคุณเช่าช่วง</h2>
                <p class="sl-section__hint">ตอบรับแล้วคำขอจะส่งให้แอดมิน · เงินค่าเช่าช่วงตกลงกับร้านเจ้าของแผงเอง</p>
            </div>
            <% if (!incoming.length) { %>
            <div class="sl-empty"><b>ยังไม่มีร้านไหนขอให้คุณไปขายแทน</b>ร้านอื่นในตลาดค้นหาร้านคุณได้จากชื่อร้าน หรือเบอร์โทรเต็ม</div>
            <% } %>
            <ul class="sl-ledger">
                <% incoming.forEach(function (r) { %>
                <li class="sl-row <%= toneOf[r.status] || '' %>" id="incoming-<%= r.id %>">
                    <div class="sl-row__stall">
                        <span class="sl-row__kind">ขายแทนที่แผง</span>
                        <span class="sl-row__code"><%= r.stallCode %></span>
                        <span class="sl-row__id">#<%= r.id %></span>
                    </div>
                    <div class="sl-row__body">
                        <span class="sl-row__date"><%= r.rangeText %></span>
                        <p class="sl-row__meta">จากร้าน <b><%= r.shopName %></b> · ให้ร้าน <b><%= r.subShopName %></b> · <a href="/market-map?stall=<%= r.stallCode %>">ดูตำแหน่งบนผัง</a></p>
                        <p class="sl-quote"><%= r.reason %></p>
                        <% if (r.status === 'REJECTED' && r.rejectReason) { %><p class="sl-quote sl-quote--bad"><%= r.rejectReason %></p><% } %>
                    </div>
                    <div class="sl-row__side">
                        <span class="sl-status"><%= r.status === 'WAITING_SUBTENANT' ? 'รอคุณตอบรับ' : r.statusLabel %></span>
                        <% if (r.canRespond) { %>
                        <form method="POST" action="/stall-leave/<%= r.id %>/respond">
                            <input type="hidden" name="accept" value="1">
                            <button type="submit" class="sl-btn sl-btn--sm"><i class="fa-solid fa-check" aria-hidden="true"></i> ตอบรับ</button>
                        </form>
                        <form method="POST" action="/stall-leave/<%= r.id %>/respond" data-confirm-title="ปฏิเสธการรับเช่าช่วง?" data-confirm-message="แผง <%= r.stallCode %> · <%= r.rangeText %>&#10;ร้าน <%= r.shopName %> จะได้รับแจ้ง" data-confirm-text="ปฏิเสธ">
                            <input type="hidden" name="accept" value="0">
                            <button type="submit" class="sl-btn sl-btn--danger sl-btn--sm">ปฏิเสธ</button>
                        </form>
                        <% } %>
                    </div>
                </li>
                <% }) %>
            </ul>
        </section>
    </main>

    <script src="/js/common/dialogs.js?v=20261023-input"></script>
    <script>
        // คัดลอกลิงก์ให้คนนอก
        document.querySelectorAll('[data-copy-link]').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const input = btn.closest('.sl-link').querySelector('[data-link-input]');
                try {
                    await navigator.clipboard.writeText(input.value);
                } catch (error) {
                    input.select();
                    document.execCommand('copy');
                }
                btn.innerHTML = '<i class="fa-solid fa-check" aria-hidden="true"></i> คัดลอกแล้ว';
            });
        });
        const focused = document.querySelector('.sl-row.is-focus');
        if (focused) focused.scrollIntoView({ block: 'center' });
        // ยืนยันก่อนยกเลิก/ปฏิเสธ
        document.querySelectorAll('form[data-confirm-title]').forEach((form) => {
            form.addEventListener('submit', (e) => {
                if (form.dataset.confirmed === '1') return;
                e.preventDefault();
                window.showConfirmDialog({
                    title: form.dataset.confirmTitle,
                    message: form.dataset.confirmMessage,
                    tone: 'danger',
                    confirmText: form.dataset.confirmText,
                    onConfirm: () => { form.dataset.confirmed = '1'; form.submit(); }
                });
            });
        });
    </script>
</body>
</html>
