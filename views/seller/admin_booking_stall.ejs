<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>เลือกแผงค้า</title>

<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>

<link rel="stylesheet" href="/css/select_stall.css"/>

<style>

/* จุด filter บนแผง */

.stall-dot{
position:absolute;
width:8px;
height:8px;
background:#27C840;
border-radius:50%;
top:3px;
right:3px;
}

/* popup filter */

.filter-popup{
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:rgba(0,0,0,0.5);
display:none;
align-items:center;
justify-content:center;
z-index:999;
}

.filter-box{
background:white;
padding:25px;
border-radius:10px;
width:260px;
display:flex;
flex-direction:column;
gap:10px;
}

.filter-box h3{
margin:0 0 10px 0;
}

.filter-box button{
margin-top:10px;
background:#3BB8D4;
color:white;
border:none;
padding:10px;
border-radius:6px;
cursor:pointer;
}

</style>
</head>

<body>

<!-- ======= ZONE SELECTOR BAR ======= -->
<div class="topbar">

<div class="topbar-left">

<div class="zone-label-block">
<span class="zone-label-title">โซน</span>
<span class="zone-label-sub">ระบุโซนที่ต้องการจอง</span>
</div>

<div class="zone-select-wrap">

<select id="zoneSelect" class="zone-select">
<option value="">-- เลือกโซน --</option>
<option value="A">โซน A</option>
<option value="B">โซน B</option>
<option value="C">โซน C</option>
<option value="D">โซน D</option>
<option value="E">โซน E</option>
<option value="F">โซน F</option>
</select>

<button class="btn-filter" onclick="openFilter()" title="ตัวกรอง">
<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
<line x1="4" y1="6" x2="20" y2="6"/>
<line x1="8" y1="12" x2="16" y2="12"/>
<line x1="11" y1="18" x2="13" y2="18"/>
</svg>
</button>

</div>
</div>

<div class="legend-group">
<div class="legend-item">
<span class="legend-box legend-available"></span>
<span class="legend-text">ว่าง</span>
</div>

<div class="legend-item">
<span class="legend-box legend-booked"></span>
<span class="legend-text">จองแล้ว</span>
</div>

<div class="legend-item">
<span class="legend-box legend-selected"></span>
<span class="legend-text">เลือกอยู่</span>
</div>
</div>

</div>


<!-- ======= MAP ======= -->

<div class="map-outer">

<div class="map-scroll-area" id="mapScrollArea">

<div class="empty-prompt" id="emptyPrompt">
<div class="empty-icon">🏪</div>
<div class="empty-title">เลือกโซนที่ต้องการ</div>
<div class="empty-sub">เลือกโซนจาก dropdown ด้านบนเพื่อดูแผงค้าที่ว่าง</div>
</div>

<div class="stall-columns" id="stallColumns" style="display:none;"></div>

</div>
</div>


<!-- confirm bar -->

<div class="confirm-bar" id="confirmBar">
<div class="confirm-info">
<span class="confirm-label">แผงที่เลือก :</span>
<span class="confirm-stall-id" id="confirmStallId">—</span>
</div>

<button class="btn-book" id="btnBook">จองแผงนี้ →</button>
</div>


<!-- popup filter -->

<div class="filter-popup" id="filterPopup">

<div class="filter-box">

<h3>การกรอง</h3>

<label><input type="checkbox" value="ลูกชิ้น"> ลูกชิ้น</label>
<label><input type="checkbox" value="น้ำปั่น"> น้ำปั่น</label>
<label><input type="checkbox" value="ส้มตำ"> ส้มตำ</label>
<label><input type="checkbox" value="ซูชิ"> ซูชิ</label>
<label><input type="checkbox" value="หมาล่า"> หมาล่า</label>

<button onclick="applyFilter()">ยืนยัน</button>

</div>

</div>


<script>

'use strict';

const ZONE_DATA = {

A:{
groups:[
[{prefix:'A1',start:101,end:119}],
[{prefix:'A2',start:201,end:219},{prefix:'A3',start:301,end:319}],
[{prefix:'A4',start:401,end:421},{prefix:'A5',start:501,end:521}],
[{prefix:'A6',start:601,end:622},{prefix:'A7',start:701,end:721}],
[{prefix:'A8',start:801,end:823},{prefix:'A9',start:901,end:923}]
],

booked:['A101','A205','A306','A410','A119','A502','A618','A715','A820','A903'],

stallType:{
"A103":"ส้มตำ",
"A108":"ซูชิ",
"A205":"หมาล่า",
"A304":"ลูกชิ้น",
"A410":"น้ำปั่น"
}

}

};


let selectedStall=null;

const zoneSelect=document.getElementById('zoneSelect');
const stallColumns=document.getElementById('stallColumns');
const emptyPrompt=document.getElementById('emptyPrompt');
const confirmBar=document.getElementById('confirmBar');
const confirmStallId=document.getElementById('confirmStallId');
const btnBook=document.getElementById('btnBook');

zoneSelect.addEventListener('change',onZoneChange);
btnBook.addEventListener('click',goBooking);


function onZoneChange(){

const zone=zoneSelect.value;

selectedStall=null;

if(!ZONE_DATA[zone]){
stallColumns.style.display='none';
emptyPrompt.style.display='flex';
stallColumns.innerHTML='';
return;
}

renderZone(zone);

}


function renderZone(zone){

const data=ZONE_DATA[zone];
const booked=new Set(data.booked);

stallColumns.innerHTML='';
stallColumns.style.display='flex';
emptyPrompt.style.display='none';

data.groups.forEach(group=>{

const groupEl=document.createElement('div');
groupEl.className='col-group';

group.forEach(colDef=>{

const colEl=document.createElement('div');
colEl.className='stall-col';

for(let n=colDef.start;n<=colDef.end;n++){

const stallId=colDef.prefix+n;
const isBooked=booked.has(stallId);

const stallEl=document.createElement('div');
stallEl.className='stall'+(isBooked?' stall--booked':'');
stallEl.textContent=stallId;
stallEl.dataset.id=stallId;

if(!isBooked){
stallEl.addEventListener('click',()=>onStallClick(stallEl,stallId));
}

colEl.appendChild(stallEl);

}

groupEl.appendChild(colEl);

});

stallColumns.appendChild(groupEl);

});

}


function onStallClick(el,stallId){

document.querySelectorAll('.stall--selected').forEach(s=>{
s.classList.remove('stall--selected');
});

el.classList.add('stall--selected');

selectedStall=stallId;

confirmBar.classList.add('active');
confirmStallId.textContent=stallId;

}


function goBooking(){

if(!selectedStall)return;

window.location.href='/booking-stall?stall='+selectedStall;

}


function openFilter(){
document.getElementById('filterPopup').style.display='flex';
}

function closeFilter(){
document.getElementById('filterPopup').style.display='none';
}


function applyFilter(){

const checked=[...document.querySelectorAll('#filterPopup input:checked')]
.map(e=>e.value);

document.querySelectorAll('.stall').forEach(stall=>{

const id=stall.dataset.id;
const type=ZONE_DATA[zoneSelect.value].stallType?.[id];

const oldDot=stall.querySelector('.stall-dot');
if(oldDot)oldDot.remove();

if(checked.includes(type)){
const dot=document.createElement('div');
dot.className='stall-dot';
stall.appendChild(dot);
}

});

closeFilter();

}

</script>

</body>
</html>
<style>
    /* ============================================
   select_stall.css
   Night Market — Stall Selection Map
   ============================================ */

:root {
  --primary:       #3BB8D4;
  --primary-light: #A0E3F3;
  --primary-dark:  #2a9ab5;
  --green:         #27C840;
  --yellow:        #FFCA08;
  --red:           #E51837;
  --booked:        #9ca3af;
  --booked-text:   #6b7280;
  --map-bg:        #d6d8da;
  --road-bg:       #c4c6c8;
  --stripe-yellow: #FFCA08;
  --stripe-black:  #1a1a1a;
  --white:         #ffffff;
  --border-light:  #e2e8ed;
  --text-main:     #1a1d23;
  --text-sub:      #6b7280;
  --shadow-sm:     0 1px 4px rgba(0,0,0,0.08);
  --shadow-md:     0 4px 16px rgba(0,0,0,0.10);
  --radius:        4px;
  --stall-w:       46px;
  --stall-h:       28px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  height: 100%;
  font-family: 'Sarabun', sans-serif;
  background: #eef0f2;
  color: var(--text-main);
  font-size: 14px;
}

/* ============================================
   TOP BAR
   ============================================ */
.topbar {
  position: sticky;
  top: 0;
  z-index: 200;
  background: var(--white);
  border-bottom: 1.5px solid var(--border-light);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 20px;
  gap: 16px;
  flex-wrap: wrap;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

.zone-label-block {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.zone-label-title {
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--text-main);
}

.zone-label-sub {
  font-size: 0.75rem;
  color: var(--text-sub);
}

.zone-select-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
}

.zone-select {
  font-family: 'Sarabun', sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
  padding: 7px 28px 7px 12px;
  border: 1.5px solid var(--border-light);
  border-radius: var(--radius);
  background: var(--white);
  color: var(--text-main);
  cursor: pointer;
  min-width: 130px;
  outline: none;
  transition: border-color 0.18s;
  appearance: auto;
}
.zone-select:focus { border-color: var(--primary); }

.btn-filter {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border: 1.5px solid var(--border-light);
  border-radius: var(--radius);
  background: var(--white);
  cursor: pointer;
  color: var(--text-sub);
  transition: background 0.15s, border-color 0.15s;
}
.btn-filter:hover { background: #f3f4f6; border-color: var(--primary); color: var(--primary); }

/* Legend */
.legend-group {
  display: flex;
  align-items: center;
  gap: 18px;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
}

.legend-box {
  width: 22px;
  height: 16px;
  border-radius: 3px;
  display: inline-block;
  border: 1.5px solid #ccc;
}

.legend-available { background: var(--white);   border-color: var(--primary); }
.legend-booked    { background: var(--booked);  border-color: #8a9099; }
.legend-selected  { background: var(--primary); border-color: var(--primary-dark); }

.legend-text {
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--text-sub);
}

/* ============================================
   MAP OUTER FRAME
   ============================================ */
.map-outer {
  position: relative;
  margin: 18px auto;
  max-width: 1100px;
  background: var(--map-bg);
  border: 2px solid #b8bcbf;
  border-radius: 6px;
  min-height: 680px;
  display: grid;
  grid-template-columns: 54px 1fr 44px;
  grid-template-rows: auto 1fr auto;
  grid-template-areas:
    "left  top   right"
    "left  main  right"
    "left  bot   right";
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

/* Top road sign */
.road-sign-top {
  grid-area: top;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 10px 12px 6px 12px;
  gap: 6px;
}

.road-sign-top > span,
.road-sign-top {
  background: var(--yellow);
  color: #111;
  font-size: 0.92rem;
  font-weight: 700;
  padding: 6px 14px;
  border-radius: var(--radius);
  white-space: nowrap;
  width: fit-content;
  align-self: flex-start;
  margin-top: 4px;
  margin-right: 4px;
}

/* Left road */
.road-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--road-bg);
  position: relative;
  overflow: hidden;
  padding: 8px 0;
  gap: 8px;
}

.road-left  { grid-area: left;  }
.road-right { grid-area: right; }

.road-stripe-bar {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 18px;
  background: repeating-linear-gradient(
    to bottom,
    var(--stripe-yellow)  0px,
    var(--stripe-yellow)  16px,
    var(--stripe-black)   16px,
    var(--stripe-black)   32px
  );
}

.road-text-vertical {
  writing-mode: vertical-rl;
  transform: rotate(180deg);
  font-size: 12px;
  font-weight: 700;
  color: #222;
  white-space: nowrap;
  letter-spacing: 0.04em;
  padding-left: 20px;
  user-select: none;
}

.road-right .road-text-vertical {
  padding-left: 0;
  padding-right: 4px;
}

.road-arrow-down {
  font-size: 20px;
  font-weight: 700;
  color: #333;
  padding-left: 20px;
  user-select: none;
}

/* Scroll area */
.map-scroll-area {
  grid-area: main;
  overflow-x: auto;
  overflow-y: auto;
  padding: 16px 18px 12px;
  min-height: 540px;
  display: flex;
  align-items: flex-start;
  background: var(--map-bg);
}

/* Scrollbar styling */
.map-scroll-area::-webkit-scrollbar { height: 6px; width: 6px; }
.map-scroll-area::-webkit-scrollbar-thumb { background: #b0b8bf; border-radius: 3px; }

/* Empty prompt */
.empty-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  min-height: 400px;
  color: var(--text-sub);
  text-align: center;
}
.empty-icon  { font-size: 3rem; }
.empty-title { font-size: 1.1rem; font-weight: 700; color: #555; }
.empty-sub   { font-size: 0.85rem; }

/* ============================================
   STALL COLUMNS LAYOUT
   ============================================ */
.stall-columns {
  display: flex;
  flex-direction: row;
  gap: 6px;
  align-items: flex-start;
  padding-bottom: 4px;
  /* horizontal scroll handled by parent */
}

/* Group separator (visual gap between column groups) */
.col-group {
  display: flex;
  flex-direction: row;
  gap: 4px;
  align-items: flex-start;
}

.col-gap {
  width: 14px;
  flex-shrink: 0;
}

/* Single column of stalls */
.stall-col {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

/* ============================================
   INDIVIDUAL STALL
   ============================================ */
.stall {
  width: var(--stall-w);
  height: var(--stall-h);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10.5px;
  font-weight: 700;
  font-family: 'Sarabun', sans-serif;
  border-radius: 3px;
  border: 1.5px solid var(--primary);
  background: var(--white);
  color: var(--text-main);
  cursor: pointer;
  user-select: none;
  transition: transform 0.12s, background 0.12s, box-shadow 0.12s;
  letter-spacing: 0.01em;
  white-space: nowrap;
}

.stall:hover:not(.stall--booked) {
  transform: scale(1.08);
  box-shadow: 0 2px 8px rgba(59,184,212,0.25);
  z-index: 2;
  position: relative;
}

/* Booked */
.stall--booked {
  background: var(--booked);
  border-color: #8a9099;
  color: #fff;
  cursor: not-allowed;
}

/* Selected */
.stall--selected {
  background: var(--primary);
  border-color: var(--primary-dark);
  color: var(--white);
  box-shadow: 0 0 0 2.5px rgba(59,184,212,0.4);
  transform: scale(1.05);
  z-index: 3;
  position: relative;
}

/* ============================================
   BOTTOM BAR
   ============================================ */
.map-bottom {
  grid-area: bot;
  background: var(--map-bg);
  padding-bottom: 10px;
}

.road-stripe-bottom {
  height: 16px;
  background: repeating-linear-gradient(
    to right,
    var(--stripe-yellow) 0px,
    var(--stripe-yellow) 26px,
    var(--stripe-black)  26px,
    var(--stripe-black)  52px
  );
  margin-bottom: 8px;
}

.bottom-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 14px;
  gap: 12px;
}

.facilities { display: flex; gap: 8px; }

.btn-facility {
  background: var(--yellow);
  border: 1.5px solid #d9a800;
  border-radius: 5px;
  padding: 7px 16px;
  font-family: 'Sarabun', sans-serif;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  color: #111;
  white-space: nowrap;
  transition: background 0.15s;
}
.btn-facility:hover { background: #e6b800; }

.entry-exit-label {
  font-size: 14px;
  font-weight: 700;
  color: #222;
  padding-left: 8px;
}

/* ============================================
   CONFIRM BAR (sticky bottom)
   ============================================ */
.confirm-bar {
  position: fixed;
  bottom: 0;
  left: 0; right: 0;
  z-index: 300;
  background: var(--white);
  border-top: 2px solid var(--primary-light);
  box-shadow: 0 -4px 20px rgba(0,0,0,0.10);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 28px;
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.confirm-bar.active {
  transform: translateY(0);
}

.confirm-info {
  display: flex;
  align-items: center;
  gap: 10px;
}

.confirm-label {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-sub);
}

.confirm-stall-id {
  font-size: 1.2rem;
  font-weight: 800;
  color: var(--primary-dark);
  background: var(--primary-light);
  padding: 4px 14px;
  border-radius: 20px;
  letter-spacing: 0.04em;
}

.btn-book {
  background: var(--primary);
  color: var(--white);
  border: none;
  border-radius: 6px;
  padding: 12px 32px;
  font-family: 'Sarabun', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(59,184,212,0.35);
  transition: background 0.15s, transform 0.1s;
}
.btn-book:hover { background: var(--primary-dark); transform: translateY(-1px); }

/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 640px) {
  .topbar { flex-direction: column; align-items: flex-start; }
  .legend-group { gap: 12px; }
  .map-outer { margin: 10px 8px; }
  :root { --stall-w: 40px; --stall-h: 26px; }
  .confirm-bar { padding: 12px 16px; }
  .btn-book { padding: 10px 20px; font-size: 0.9rem; }
}
</style>
<script>
    /**
 * select_stall.js
 * Night Market — Stall Selection Map
 *
 * Renders vertical stall columns per zone.
 * Clicking an available stall selects it (1 at a time).
 * Confirm bar slides up; clicking "จองแผงนี้" redirects to /booking-stall?stall=XXXX
 */

'use strict';

// ============================================================
// ZONE DATA DEFINITION
// Each zone defines column groups. Each group = array of cols.
// Each col = { prefix, start, end }
// "booked" array lists stall IDs that are already taken.
// ============================================================
const ZONE_DATA = {
  A: {
    groups: [
      // Group 1: A1xx, A2xx, A3xx  (cols paired with gap between groups)
      [
        { prefix: 'A1', start: 101, end: 119 },
      ],
      [
        { prefix: 'A2', start: 201, end: 219 },
        { prefix: 'A3', start: 301, end: 319 },
      ],
      [
        { prefix: 'A4', start: 401, end: 421 },
        { prefix: 'A5', start: 501, end: 521 },
      ],
      [
        { prefix: 'A6', start: 601, end: 622 },
        { prefix: 'A7', start: 701, end: 721 },
      ],
      [
        { prefix: 'A8', start: 801, end: 823 },
        { prefix: 'A9', start: 901, end: 923 },
      ],
    ],
    booked: ['A101', 'A205', 'A306', 'A410', 'A119', 'A502', 'A618', 'A715', 'A820', 'A903']
  },
  B: {
    groups: [
      [
        { prefix: 'B1', start: 101, end: 119 },
      ],
      [
        { prefix: 'B2', start: 201, end: 219 },
        { prefix: 'B3', start: 301, end: 319 },
      ],
      [
        { prefix: 'B4', start: 401, end: 421 },
        { prefix: 'B5', start: 501, end: 521 },
      ],
      [
        { prefix: 'B6', start: 601, end: 622 },
        { prefix: 'B7', start: 701, end: 721 },
      ],
    ],
    booked: ['B102', 'B210', 'B315', 'B418', 'B509', 'B605', 'B720']
  },
  C: {
    groups: [
      [
        { prefix: 'C1', start: 101, end: 112 },
      ],
      [
        { prefix: 'C2', start: 201, end: 212 },
        { prefix: 'C3', start: 301, end: 312 },
      ],
    ],
    booked: ['C101', 'C205', 'C310']
  },
  D: {
    groups: [
      [
        { prefix: 'D1', start: 101, end: 108 },
        { prefix: 'D2', start: 201, end: 208 },
      ],
      [
        { prefix: 'D3', start: 301, end: 308 },
        { prefix: 'D4', start: 401, end: 408 },
      ],
    ],
    booked: ['D103', 'D202', 'D305']
  },
  E: {
    groups: [
      [
        { prefix: 'E1', start: 101, end: 104 },
        { prefix: 'E2', start: 201, end: 204 },
      ],
    ],
    booked: ['E102']
  },
  F: {
    groups: [
      [
        { prefix: 'F1', start: 101, end: 117 },
        { prefix: 'F2', start: 201, end: 217 },
      ],
      [
        { prefix: 'F3', start: 301, end: 334 },
        { prefix: 'F4', start: 401, end: 434 },
      ],
      [
        { prefix: 'F5', start: 501, end: 536 },
        { prefix: 'F6', start: 601, end: 636 },
      ],
    ],
    booked: ['F101', 'F212', 'F318', 'F425', 'F530', 'F602']
  }
};

// ============================================================
// STATE
// ============================================================
let selectedStall = null;  // currently selected stall ID string

// ============================================================
// DOM REFS
// ============================================================
const zoneSelect      = document.getElementById('zoneSelect');
const stallColumns    = document.getElementById('stallColumns');
const emptyPrompt     = document.getElementById('emptyPrompt');
const confirmBar      = document.getElementById('confirmBar');
const confirmStallId  = document.getElementById('confirmStallId');
const btnBook         = document.getElementById('btnBook');

// ============================================================
// INIT
// ============================================================
document.addEventListener('DOMContentLoaded', () => {
  zoneSelect.addEventListener('change', onZoneChange);
  btnBook.addEventListener('click', goBooking);

  // If zone is pre-selected (e.g. via query param), render it
  const params = new URLSearchParams(window.location.search);
  const preZone = params.get('zone');
  if (preZone && ZONE_DATA[preZone]) {
    zoneSelect.value = preZone;
    renderZone(preZone);
  }
});

// ============================================================
// ZONE CHANGE
// ============================================================
function onZoneChange() {
  const zone = zoneSelect.value;
  selectedStall = null;
  hideConfirmBar();

  if (!zone || !ZONE_DATA[zone]) {
    stallColumns.style.display = 'none';
    emptyPrompt.style.display  = 'flex';
    stallColumns.innerHTML     = '';
    return;
  }

  renderZone(zone);
}

// ============================================================
// RENDER ZONE
// ============================================================
function renderZone(zone) {
  const data   = ZONE_DATA[zone];
  const booked = new Set(data.booked || []);

  stallColumns.innerHTML    = '';
  stallColumns.style.display = 'flex';
  emptyPrompt.style.display  = 'none';

  data.groups.forEach((group, gIdx) => {
    // Add visual gap between groups
    if (gIdx > 0) {
      const gap = document.createElement('div');
      gap.className = 'col-gap';
      stallColumns.appendChild(gap);
    }

    const groupEl = document.createElement('div');
    groupEl.className = 'col-group';

    group.forEach(colDef => {
      const colEl = document.createElement('div');
      colEl.className = 'stall-col';

      for (let n = colDef.start; n <= colDef.end; n++) {
        const stallId = colDef.prefix + n;
        const isBooked = booked.has(stallId);

        const stallEl = document.createElement('div');
        stallEl.className = 'stall' + (isBooked ? ' stall--booked' : '');
        stallEl.textContent = stallId;
        stallEl.dataset.id  = stallId;
        stallEl.title       = isBooked ? 'จองแล้ว' : 'ว่าง - คลิกเพื่อเลือก';

        if (!isBooked) {
          stallEl.addEventListener('click', () => onStallClick(stallEl, stallId));
        }

        colEl.appendChild(stallEl);
      }

      groupEl.appendChild(colEl);
    });

    stallColumns.appendChild(groupEl);
  });
}

// ============================================================
// STALL CLICK
// ============================================================
function onStallClick(el, stallId) {
  // Deselect previous
  if (selectedStall) {
    const prev = stallColumns.querySelector(`.stall[data-id="${selectedStall}"]`);
    if (prev) prev.classList.remove('stall--selected');
  }

  // Toggle: clicking the same stall deselects
  if (selectedStall === stallId) {
    selectedStall = null;
    hideConfirmBar();
    return;
  }

  // Select new
  el.classList.add('stall--selected');
  selectedStall = stallId;
  showConfirmBar(stallId);
}

// ============================================================
// CONFIRM BAR
// ============================================================
function showConfirmBar(stallId) {
  confirmStallId.textContent = stallId;
  confirmBar.classList.add('active');
}

function hideConfirmBar() {
  confirmBar.classList.remove('active');
  confirmStallId.textContent = '—';
}

// ============================================================
// GO TO BOOKING
// ============================================================
function goBooking() {
  if (!selectedStall) return;
  window.location.href = `/booking-stall?stall=${encodeURIComponent(selectedStall)}`;
}
function openFilter(){
document.getElementById("filterPopup").style.display="flex"
}

function closeFilter(){
document.getElementById("filterPopup").style.display="none"
}
function applyFilter(){

const checked=[...document.querySelectorAll("#filterPopup input:checked")]
.map(e=>e.value)

document.querySelectorAll(".stall").forEach(stall=>{

const id=stall.dataset.id
const type=ZONE_DATA[zoneSelect.value].stallType?.[id]

const oldDot=stall.querySelector(".stall-dot")
if(oldDot) oldDot.remove()

if(checked.includes(type)){
const dot=document.createElement("div")
dot.className="stall-dot"
stall.appendChild(dot)
}

})

closeFilter()

}
</script>