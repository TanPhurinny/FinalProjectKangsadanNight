<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ขอเอกสาร — Seller Center</title>
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20261023-ios">
  <link rel="stylesheet" href="/stylesheets/rentalStatement.css?v=20261026b">
  <link rel="stylesheet" href="/stylesheets/documents.css?v=20261026b">
</head>
<body class="rs-body">
<script src="/js/common/tabSession.js"></script>
  <%- include('../partials/navbarSeller') %>
  <%
    const countBy = (list, status) => list.filter((r) => r.status === status).length;
    const taxPill = { PENDING: 'rs-pill--pending', ISSUED: 'rs-pill--paid', CANCELLED: 'rs-pill--danger' };
    const recent = [
      ...taxInvoiceRequests.map((r) => ({
        kind: 'ใบกำกับภาษี', at: new Date(r.requestedAt), title: r.taxpayerName + (r.documentNumber ? ' · ' + r.documentNumber : ''),
        status: r.status, statusLabel: r.statusLabel, link: r.status === 'ISSUED' ? '/tax-invoices/' + r.id : '/documents/tax-invoice'
      })),
      ...leaseRequests.map((r) => ({
        kind: 'สัญญาเช่า', at: new Date(r.createdAt), title: r.periodText + (r.documentNumber ? ' · ' + r.documentNumber : ''),
        status: r.status, statusLabel: r.statusLabel, link: r.status === 'ISSUED' ? '/lease-contracts/' + r.id : '/documents/lease-contract'
      }))
    ].sort((a, b) => b.at - a.at).slice(0, 8);
  %>

  <main class="rs-page" style="max-width:960px">
    <header class="rs-head">
      <div>
        <p class="rs-kicker">Seller Center · เอกสาร</p>
        <h1 class="rs-title">ขอเอกสาร</h1>
        <p class="rs-lead">เลือกว่าจะขอเอกสารอะไร แต่ละอย่างมีหน้าของตัวเอง ทั้งสองอย่างสร้างจากประวัติการจองที่ชำระเงินแล้ว และต้องรอแอดมินอนุมัติก่อน</p>
      </div>
      <div class="rs-head-actions">
        <a class="rs-btn" href="/rental-statement"><i class="fa-solid fa-file-invoice-dollar"></i> รายงานการเช่าและชำระเงิน</a>
      </div>
    </header>

    <div class="doc-choices">
      <a class="doc-choice" href="/documents/tax-invoice">
        <span class="doc-choice__kicker"><i class="fa-solid fa-file-invoice"></i> ภาษี</span>
        <h2 class="doc-choice__title">ขอใบกำกับภาษี</h2>
        <p class="doc-choice__desc">เลือกใบเสนอราคาที่ชำระแล้ว แล้วระบุชื่อ/เลขผู้เสียภาษี (ในนามตัวเองหรือบริษัท) แอดมินตรวจแล้วออกใบกำกับภาษีให้</p>
        <div class="doc-choice__meta">
          <span>รออนุมัติ <b><%= countBy(taxInvoiceRequests, 'PENDING') %></b></span>
          <span>ออกแล้ว <b><%= countBy(taxInvoiceRequests, 'ISSUED') %></b></span>
        </div>
        <span class="doc-choice__cta">ขอใบกำกับภาษี <i class="fa-solid fa-arrow-right"></i></span>
      </a>
      <a class="doc-choice" href="/documents/lease-contract">
        <span class="doc-choice__kicker"><i class="fa-solid fa-file-signature"></i> สัญญา</span>
        <h2 class="doc-choice__title">ขอสัญญาเช่า</h2>
        <p class="doc-choice__desc">เลือกช่วงวันจากปฏิทิน ระบบสร้างสัญญาจากล็อกและยอดที่ชำระแล้วในช่วงนั้นให้อัตโนมัติ แอดมินอนุมัติแล้วเปิด/พิมพ์สัญญาได้ทันที</p>
        <div class="doc-choice__meta">
          <span>รออนุมัติ <b><%= countBy(leaseRequests, 'PENDING') %></b></span>
          <span>อนุมัติแล้ว <b><%= countBy(leaseRequests, 'ISSUED') %></b></span>
        </div>
        <span class="doc-choice__cta">ขอสัญญาเช่า <i class="fa-solid fa-arrow-right"></i></span>
      </a>
    </div>

    <section class="rs-section">
      <div class="rs-section-head">
        <h2 class="rs-section-title">คำขอล่าสุดของฉัน</h2>
        <span class="rs-section-meta">ทั้งใบกำกับภาษีและสัญญาเช่า</span>
      </div>
      <% if (!recent.length) { %>
      <div class="rs-empty">ยังไม่เคยขอเอกสาร</div>
      <% } else { %>
      <div class="rs-table-wrap">
        <table class="rs-table">
          <thead><tr><th>ประเภท</th><th>รายละเอียด</th><th>ส่งคำขอเมื่อ</th><th>สถานะ</th><th></th></tr></thead>
          <tbody>
            <% recent.forEach((r) => { %>
            <tr>
              <td><%= r.kind %></td>
              <td><%= r.title %></td>
              <td><%= r.at.toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
              <td><span class="rs-pill <%= taxPill[r.status] || 'rs-pill--soft' %>"><%= r.statusLabel %></span></td>
              <td><a href="<%= r.link %>"><%= r.status === 'ISSUED' ? 'เปิดเอกสาร' : 'ดูคำขอ' %></a></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </section>
  </main>
</body>
</html>
