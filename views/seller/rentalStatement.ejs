<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>รายงานการเช่าและชำระเงิน — Seller Center</title>
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20261023-ios">
  <link rel="stylesheet" href="/stylesheets/rentalStatement.css?v=20261026">
</head>
<body class="rs-body">
<script src="/js/common/tabSession.js"></script>
  <%- include('../partials/navbarSeller') %>

  <main class="rs-page">
    <div class="rs-print-head">
      <div>
        <strong><%= company.nameTh %></strong>
        <%= company.address %> · เลขประจำตัวผู้เสียภาษี <%= company.taxId %>
      </div>
      <div style="text-align:right">
        <strong>รายงานการเช่าและชำระเงิน</strong>
        ผู้เช่า: <%= statement.seller.name %> (ร้าน <%= statement.seller.shopName %>)<br>
        ช่วง: <%= statement.range.label %> · พิมพ์เมื่อ <%= printedAt %>
      </div>
    </div>

    <header class="rs-head">
      <div>
        <p class="rs-kicker">Seller Center · <%= statement.seller.shopName %></p>
        <h1 class="rs-title">รายงานการเช่าและชำระเงิน</h1>
        <p class="rs-lead">ทุกรอบที่ร้านคุณเช่าล็อกในช่วงที่เลือก ยอดที่ชำระแล้ว ยอดค้าง และเลขที่ใบเสร็จ/ใบกำกับภาษี
          ใช้ประกอบการขอสัญญาเช่าหรือทำบัญชีได้ — ข้อมูลนี้ดูได้อย่างเดียว ถ้ายอดไม่ตรงกรุณาติดต่อแอดมิน</p>
      </div>
      <div class="rs-head-actions">
        <button type="button" class="rs-btn" onclick="window.print()"><i class="fa-solid fa-print"></i> พิมพ์</button>
        <a class="rs-btn" href="/rental-statement.csv?<%= queryString %>"><i class="fa-solid fa-file-csv"></i> ดาวน์โหลด CSV</a>
        <a class="rs-btn" href="/booking-history"><i class="fa-solid fa-clock-rotate-left"></i> ประวัติการจอง</a>
      </div>
    </header>

    <% if (typeof success !== 'undefined' && success) { %><div class="rs-notice rs-notice--success" role="status"><%= success %></div><% } %>
    <% if (typeof error !== 'undefined' && error) { %><div class="rs-notice rs-notice--danger" role="alert"><%= error %></div><% } %>

    <%- include('../partials/rentalStatementFilter', { action: '/rental-statement', range: statement.range }) %>

    <%- include('../partials/rentalStatementBody', { statement, docPrefix: '' }) %>

    <%
      const leaseErrors = {
        invalid_period: 'กรุณาเลือกเดือนเริ่มต้นและเดือนสิ้นสุดให้ถูกต้อง (เดือนเริ่มต้องไม่หลังเดือนสิ้นสุด)',
        period_too_long: 'ขอสัญญาได้ครั้งละไม่เกิน 24 เดือน',
        note_too_long: 'หมายเหตุยาวเกิน 500 ตัวอักษร',
        duplicate_pending: 'มีคำขอสัญญาช่วงเดียวกันที่รอแอดมินดำเนินการอยู่แล้ว',
        action_failed: 'ส่งคำขอไม่สำเร็จ กรุณาลองใหม่'
      };
      const leasePill = { PENDING: 'rs-pill--pending', ISSUED: 'rs-pill--paid', CANCELLED: 'rs-pill--danger' };
    %>
    <section class="rs-section rs-no-print" id="lease">
      <div class="rs-section-head">
        <h2 class="rs-section-title">สัญญาเช่า</h2>
        <span class="rs-section-meta">แอดมินจะจัดทำสัญญาจากข้อมูลการเช่าด้านบน แล้วแนบไฟล์ให้ดาวน์โหลดที่นี่</span>
      </div>
      <% if (leaseSuccess) { %><div class="rs-notice rs-notice--success" role="status" style="margin-top:12px">ส่งคำขอสัญญาเช่าแล้ว แอดมินจะแนบไฟล์สัญญาให้ที่ส่วนนี้ และแจ้งเตือนในกระดิ่ง</div><% } %>
      <% if (leaseError) { %><div class="rs-notice rs-notice--danger" role="alert" style="margin-top:12px"><%= leaseErrors[leaseError] || 'ส่งคำขอไม่สำเร็จ' %></div><% } %>

      <form class="rs-form" method="post" action="/lease-contracts">
        <label class="rs-field">ตั้งแต่เดือน
          <input type="month" name="periodStart" value="<%= leaseDefaults.start %>" required>
        </label>
        <label class="rs-field">ถึงเดือน
          <input type="month" name="periodEnd" value="<%= leaseDefaults.end %>" required>
        </label>
        <label class="rs-field rs-field--wide">หมายเหตุถึงแอดมิน (ไม่บังคับ)
          <textarea name="note" maxlength="500" placeholder="เช่น ขอสัญญาในนามบริษัท / ใช้ยื่นธนาคาร / ล็อกที่ต้องการให้ระบุ"></textarea>
        </label>
        <div class="rs-form-actions">
          <button type="submit" class="rs-btn rs-btn--primary"><i class="fa-solid fa-file-signature"></i> ขอสัญญาเช่า</button>
          <p class="rs-hint">ช่วงเริ่มต้นตรงกับช่วงรายงานที่เลือกด้านบน เปลี่ยนได้ · ขอได้ครั้งละไม่เกิน 24 เดือน</p>
        </div>
      </form>

      <% if (leaseRequests.length) { %>
      <div class="rs-table-wrap">
        <table class="rs-table">
          <thead>
            <tr><th>ช่วงสัญญา</th><th>ส่งคำขอเมื่อ</th><th>สถานะ</th><th>ข้อความจากแอดมิน</th><th>ไฟล์สัญญา</th></tr>
          </thead>
          <tbody>
            <% leaseRequests.forEach((lr) => { %>
            <tr>
              <td><a href="/rental-statement?<%= lr.rangeQuery %>"><%= lr.periodText %></a><% if (lr.note) { %><div class="rs-muted" style="white-space:normal;max-width:280px"><%= lr.note %></div><% } %></td>
              <td><%= lr.createdAtText %></td>
              <td><span class="rs-pill <%= leasePill[lr.status] %>"><%= lr.statusLabel %></span><% if (lr.issuedAtText) { %><div class="rs-muted"><%= lr.issuedAtText %></div><% } %></td>
              <td style="white-space:normal;max-width:280px"><%= lr.adminNote || '-' %></td>
              <td>
                <% if (lr.status === 'ISSUED' && lr.contractFileUrl) { %>
                <a href="/lease-contracts/<%= lr.id %>/file" target="_blank" rel="noopener"><i class="fa-solid <%= lr.fileIsPdf ? 'fa-file-pdf' : 'fa-file-image' %>"></i> ดาวน์โหลด</a>
                <% } else { %><span class="rs-muted">-</span><% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </section>
  </main>
</body>
</html>
