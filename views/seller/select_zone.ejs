<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>เลือกแผงค้า - กังสดาลไนท์</title>
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260724-6">
  <link rel="stylesheet" href="/stylesheets/seller/selectZone.css">
</head>

<body>
<script src="/js/common/tabSession.js"></script>
  <%- include('../partials/navbarSeller') %>

  <div class="page-wrapper">
    <header class="map-page-header">
      <div class="zone-filter">
        <label for="zoneSelect" class="zone-filter__title">โซน</label>
        <p class="zone-filter__subtitle">ระบุโซนที่ต้องการจอง</p>
        <div class="zone-filter__select-wrap">
          <select id="zoneSelect" class="zone-filter__select" aria-label="เลือกโซน">
            <%
              var normalizedAllowedZones = Array.isArray(allowedZones) ? allowedZones.map(function(zoneCode) {
                return String(zoneCode).toLowerCase();
              }) : [];
              var sellerProductTypeLabel = productType || 'ยังไม่ระบุประเภทสินค้า';
              var zoneOptions = [
                { value: 'all', label: 'ทั้งหมด', disabled: false },
                { value: 'a', label: 'โซน A', disabled: normalizedAllowedZones.length > 0 && !normalizedAllowedZones.includes('a') },
                { value: 'b', label: 'โซน B', disabled: normalizedAllowedZones.length > 0 && !normalizedAllowedZones.includes('b') },
                { value: 'c', label: 'โซน C', disabled: normalizedAllowedZones.length > 0 && !normalizedAllowedZones.includes('c') },
                { value: 'd', label: 'โซน D', disabled: normalizedAllowedZones.length > 0 && !normalizedAllowedZones.includes('d') },
                { value: 'e', label: 'โซน E', disabled: normalizedAllowedZones.length > 0 && !normalizedAllowedZones.includes('e') },
                { value: 'f', label: 'โซน F', disabled: normalizedAllowedZones.length > 0 && !normalizedAllowedZones.includes('f') },
                { value: 'x', label: 'โซน X', disabled: normalizedAllowedZones.length > 0 && !normalizedAllowedZones.includes('x') }
              ].map(function(option) {
                if (option.value === 'all' || !option.disabled) {
                  return option;
                }

                return {
                  value: option.value,
                  label: option.label + ' - ไม่สอดคล้องกับประเภทร้านค้า',
                  disabled: true
                };
              });
            %>
            <% zoneOptions.forEach(function(opt){ %>
              <option value="<%= opt.value %>" <%= opt.disabled ? 'disabled' : '' %>><%= opt.label %></option>
            <% }) %>
          </select>
        </div>
        <p class="zone-filter__helper">ประเภทร้านของคุณ: <strong><%= sellerProductTypeLabel %></strong> | โซนที่ไม่สอดคล้องกับประเภทร้านค้าจะไม่สามารถเลือกได้</p>
      </div>

      <div class="zone-legend" aria-label="สีและประเภทสินค้าประจำโซน">
        <span class="zone-legend__item"><span class="zone-legend__swatch zone-legend__swatch--a"></span><span class="zone-legend__text">โซน A<small>แฟชั่น/อาหารพิเศษ</small></span></span>
        <span class="zone-legend__item"><span class="zone-legend__swatch zone-legend__swatch--b"></span><span class="zone-legend__text">โซน B / D / F / X<small>อาหาร</small></span></span>
        <span class="zone-legend__item"><span class="zone-legend__swatch zone-legend__swatch--c"></span><span class="zone-legend__text">โซน C / E<small>แฟชั่น</small></span></span>
      </div>
    </header>

    <main class="map-board" aria-label="แผนผังตลาด">
      <div class="location-badge">
        <i class="bi bi-geo-alt-fill"></i>
        <span>ร้านยูโซกริล</span>
      </div>

      <div class="entrance-label">เข้า-ออก</div>

      <div class="side-frame side-frame--left">
        <div class="hazard-strip hazard-strip--vertical" aria-hidden="true"></div>
        <div class="side-frame__label">ทางเข้าลาด 62 บล็อค</div>
      </div>

      <div class="side-frame side-frame--right">
        <div class="side-frame__label">ลานจอดรถ หลังตลาดไนท์</div>
      </div>

        <div class="map-inner">
        <div class="zone zone--e <%= (typeof allowedZones !== 'undefined' && Array.isArray(allowedZones) && !allowedZones.includes('e')) ? 'is-disabled' : '' %>" data-zone="e" role="button" tabindex="0" aria-label="โซน E - แฟชั่น">
          <span class="zone__name">โซน E</span>
          <span class="zone__category">แฟชั่น</span>
        </div>

        <div class="zone-dx-row">
          <div class="zone zone--d <%= (typeof allowedZones !== 'undefined' && Array.isArray(allowedZones) && !allowedZones.includes('d')) ? 'is-disabled' : '' %>" data-zone="d" role="button" tabindex="0" aria-label="โซน D - อาหาร">
            <span class="zone__name">โซน D</span>
            <span class="zone__category">อาหาร</span>
          </div>

          <div class="zone zone--x <%= (typeof allowedZones !== 'undefined' && Array.isArray(allowedZones) && !allowedZones.includes('x')) ? 'is-disabled' : '' %>" data-zone="x" role="button" tabindex="0" aria-label="โซน X - อาหาร">
            <span class="zone__name">โซน X</span>
            <span class="zone__category">อาหาร</span>
          </div>
        </div>

        <div class="zone zone--a <%= (typeof allowedZones !== 'undefined' && Array.isArray(allowedZones) && !allowedZones.includes('a')) ? 'is-disabled' : '' %>" data-zone="a" role="button" tabindex="0" aria-label="โซน A - แฟชั่นและอาหารพิเศษ">
          <span class="zone__name">โซน A</span>
          <span class="zone__category">แฟชั่น/อาหารพิเศษ</span>
        </div>

        <div class="main-road">
          <span class="main-road__label">ทางเดินหลัก</span>
        </div>

        <div class="zone-f-column">
          <div class="zone zone--f <%= (typeof allowedZones !== 'undefined' && Array.isArray(allowedZones) && !allowedZones.includes('f')) ? 'is-disabled' : '' %>" data-zone="f" role="button" tabindex="0" aria-label="โซน F - อาหาร">
            <span class="zone__name">โซน F</span>
            <span class="zone__category">อาหาร</span>
          </div>
          <div class="seating-area">
            <i class="bi bi-person-workspace"></i>
            <span>พื้นที่นั่งทานอาหาร</span>
          </div>
        </div>

        <div class="zone zone--b <%= (typeof allowedZones !== 'undefined' && Array.isArray(allowedZones) && !allowedZones.includes('b')) ? 'is-disabled' : '' %>" data-zone="b" role="button" tabindex="0" aria-label="โซน B - อาหาร">
          <span class="zone__name">โซน B</span>
          <span class="zone__category">อาหาร</span>
        </div>

        <div class="zone zone--c <%= (typeof allowedZones !== 'undefined' && Array.isArray(allowedZones) && !allowedZones.includes('c')) ? 'is-disabled' : '' %>" data-zone="c" role="button" tabindex="0" aria-label="โซน C - แฟชั่น">
          <span class="zone__name">โซน C</span>
          <span class="zone__category">แฟชั่น</span>
        </div>

        <div class="bottom-buttons">
          <button type="button" class="facility-btn" data-facility="restroom">
            <i class="bi bi-person-standing"></i>
            <span>ห้องน้ำ</span>
          </button>
          <button type="button" class="facility-btn" data-facility="office">
            <i class="bi bi-building"></i>
            <span>ออฟฟิศ</span>
          </button>
        </div>
      </div>

      <div class="hazard-strip hazard-strip--horizontal" aria-hidden="true"></div>
    </main>

    <footer class="map-legend">
      <p class="map-legend__title">ค่าไฟสว่าง</p>
      <p class="map-legend__line">
        <span class="map-legend__badge">พิเศษ</span>
        ค่าไฟแสงสว่างคิดจากล็อคละ
        <span class="map-legend__highlight">15 บาท</span>/วัน
      </p>
      <p class="map-legend__sub">
        *เงื่อนไข หลอดไฟต่อล็อค ไม่เกิน 4 ดวงใหญ่ หรือ 10 ดวงเล็ก หรือ รวมกันไม่เกิน 150 วัตต์ ต่อล็อคและต้องเป็นหลอดชนิด LED เท่านั้น
      </p>
      <p class="map-legend__line">
        <i class="bi bi-lightning-charge-fill"></i>
        เครื่องใช้ไฟฟ้าเล็ก <span class="map-legend__underline">เครื่องละ</span>
        <span class="map-legend__highlight">20 บาท</span>/วัน
      </p>
      <p class="map-legend__sub">
        หมายเหตุ เครื่องใช้ไฟฟ้าขนาดเล็กเล็กต้องต่ำกว่า 1200 วัตต์ เช่น เครื่องปั่น, เครื่องปิ้งขนมปัง, กาน้ำร้อน ฯลฯ
      </p>
      <p class="map-legend__line">
        <i class="bi bi-record-circle-fill"></i>
        เครื่องใช้ไฟฟ้าใหญ่ <span class="map-legend__underline">เครื่องละ</span>
        <span class="map-legend__highlight">40 บาท</span>/วัน
        เช่น กระทะไฟฟ้า, เตาไฟฟ้า, เตาอบ, หม้อทอด, ตู้แช่ ฯลฯ
      </p>
    </footer>
  </div>

  <div class="stall-modal" id="stallModal" aria-hidden="true">
    <div class="stall-modal__panel" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <button type="button" class="stall-modal__close" id="modalCloseBtn" aria-label="ปิด">&times;</button>
      <h3 id="modalTitle">รายละเอียดแผง</h3>
      <p id="modalZoneText" class="stall-modal__zone"></p>
      <ul class="stall-modal__list">
        <li id="modalSize"></li>
        <li id="modalPrice"></li>
        <li>มีไฟฟ้าในแผง</li>
        <li>อยู่ในตำแหน่งที่มองเห็นง่าย</li>
      </ul>

      <div class="stall-modal__corner">
        <p class="stall-modal__corner-title">สนใจแผงหัวมุม/แผงพิเศษไหม? <span class="stall-modal__corner-note">(มีค่าใช้จ่ายเพิ่ม เลือกได้ 1 ระดับ)</span></p>
        <div class="stall-modal__corner-options" id="cornerZoneOptions">
          <label class="stall-modal__corner-option">
            <input type="radio" name="cornerZoneModal" value="0" checked>
            <span class="stall-modal__corner-option-text">
              <strong>ไม่สนใจ</strong>
              <small>แผงมาตรฐาน ไม่มีค่าใช้จ่ายเพิ่ม</small>
            </span>
          </label>
          <% (typeof cornerZoneOptions !== 'undefined' ? cornerZoneOptions : []).forEach(function(opt) { %>
            <label class="stall-modal__corner-option">
              <input type="radio" name="cornerZoneModal" value="<%= opt.value %>">
              <span class="stall-modal__corner-option-text">
                <strong><%= opt.label %> <span class="stall-modal__corner-option-tag">+<%= opt.value %> บาท/ล็อก/วัน</span></strong>
                <small><%= opt.desc %></small>
              </span>
            </label>
          <% }) %>
        </div>
      </div>

      <button type="button" class="stall-modal__btn" id="bookStallBtn">จองแถวนี้</button>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // allowed zones provided by server - used by client to disable interactions
    window.ALLOWED_ZONES = <%- (typeof allowedZones !== 'undefined' ? JSON.stringify(allowedZones) : '[]') %>;
    window.ZONE_DETAILS = <%- (typeof zoneDetails !== 'undefined' ? JSON.stringify(zoneDetails) : '{}') %>;
    window.SELLER_PRODUCT_TYPE = "<%= typeof productType !== 'undefined' ? productType : '' %>";
  </script>
  <script src="/js/market-map.js"></script>
</body>
</html>