<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ต่อล็อค</title>
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20261023-ios">
  <link rel="stylesheet" href="/stylesheets/seller/bookingStall.css">
  <link rel="stylesheet" href="/stylesheets/seller/extendLock.css">
</head>
<body>
<script src="/js/common/tabSession.js"></script>
  <% if (user && user.role === 'SELLER') { %>
  <%- include('../partials/navbarSeller') %>
  <% } else { %>
  <%- include('../partials/navbarCustomer') %>
  <% } %>

  <header class="site-header">
    <button class="btn-back" onclick="history.back()" title="ย้อนกลับ">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <h1 class="header-title">ต่อล็อค</h1>
    <div class="header-spacer"></div>
  </header>

  <main class="main-content">
    <form class="form-card" method="POST" action="/booking-stall/extend" id="extendForm">
      <% if (error) { %>
        <%
        const errorMsg = {
            'invalid_extend_date': 'กรุณาเลือกวันที่ให้ถูกต้อง (ต้องอยู่หลังวันสิ้นสุดปัจจุบัน และไม่เกินวันจบรอบ)',
            'too_early_to_extend': 'ต่อไม่ถึงสิ้นรอบ เริ่มขอต่อได้ตั้งแต่ 1 วันก่อนวันขายสุดท้าย (ต่อจนสุดรอบขอได้ทันที)',
            'extend_window_closed': 'เลยเวลา 20:00 น. ของวันขายสุดท้ายแล้ว ล็อกนี้หมดสิทธิ์การต่อ',
            'extend_failed': 'เกิดข้อผิดพลาด กรุณาลองใหม่อีกครั้ง',
            'blacklisted': 'ร้านค้าของคุณถูกระงับสิทธิ์การต่อล็อก (Blacklist) กรุณาติดต่อผู้ดูแลตลาด',
            'all_days_are_holiday': 'ช่วงที่ขอต่อเป็นวันหยุดทั้งหมด ไม่สามารถต่อล็อกได้ กรุณาเลือกวันสิ้นสุดใหม่',
            'stall_no_longer_yours': 'ล็อกนี้ไม่ได้อยู่ในสัญญาของคุณแล้ว (อาจถูกปล่อยหรือย้าย) ต่ออัตโนมัติไม่ได้ กรุณาติดต่อผู้ดูแลตลาด หรือจองรอบใหม่'
        }[error] || null;
        %>
        <% if (errorMsg) { %>
        <div class="alert-box"><%= errorMsg %></div>
        <% } %>
      <% } %>

      <% const fmtD = (d) => new Date(d).toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: 'numeric' }); %>

      <section class="ext-step">
        <h2 class="ext-title"><span class="ext-num">1</span>ล็อกของคุณตอนนี้</h2>
        <div class="ext-stall">
          <div class="ext-stall-code"><%= request.assignedStallCode || '-' %></div>
          <div class="ext-stall-info">
            <div>โซน <strong><%= request.zone %></strong></div>
            <div>ขายได้ถึงวันที่ <strong><%= fmtD(activeLock.rentalEndDate) %></strong></div>
            <div>รอบนี้จบวันที่ <strong><%= fmtD(roundMeta.cycleEnd) %></strong></div>
          </div>
        </div>
      </section>

      <% if (!renewal.isOpen) { %>
      <div class="ext-status ext-status-closed">
        <strong>หมดเวลาต่อล็อกแล้ว</strong>
        เลย 20:00 น. ของวันขายสุดท้ายแล้ว ล็อกนี้ถูกเปิดให้ร้านอื่นจองแทน
      </div>
      <% } else { %>
      <div class="ext-status ext-status-open">
        <strong>ต่อได้ถึง 20:00 น. วันที่ <%= fmtD(renewal.currentEnd) %></strong>
        เลยเวลานี้ล็อกจะถูกเปิดให้ร้านอื่นจอง
      </div>
      <% } %>

      <section class="ext-step">
        <h2 class="ext-title"><span class="ext-num">2</span>เลือกวันที่จะขายต่อ</h2>
        <label class="ext-label" for="newEndDate">ขายต่อถึงวันที่</label>
        <input type="date" class="field-input" id="newEndDate" name="newEndDate" <%= renewal.isOpen ? 'required' : 'disabled' %> />
        <button type="button" class="ext-round-btn" id="extendToRoundEndBtn" <%= renewal.isOpen ? '' : 'disabled' %>>
          ต่อจนจบรอบ (<%= fmtD(renewal.roundEnd) %>)
        </button>
        <% if (renewal.isOpen && !renewal.canRenewShort) { %>
        <p class="ext-hint">อยากต่อสั้นกว่านี้ ต้องรอถึงวันที่ <%= fmtD(renewal.opensAt) %> ตอนนี้เลือกได้เฉพาะจนจบรอบ</p>
        <% } %>
      </section>

      <section class="ext-step ext-step-plain">
        <h2 class="ext-title"><span class="ext-num">3</span>กดต่อล็อก แล้วชำระเงิน</h2>
        <div class="ext-price">
          <span>ค่าต่อล็อกต่อวัน (ราคาเดิม รวมไฟ/เครื่องใช้ไฟฟ้า)</span>
          <strong><%= Number(dailyTotal || 0).toLocaleString('th-TH') %> บาท</strong>
        </div>
        <div class="ext-price ext-price-total" id="extendTotalRow" hidden>
          <span>ประมาณ <b id="extendDays">0</b> วัน (วันหยุดตลาดไม่คิดเงิน)</span>
          <strong id="extendTotal">0 บาท</strong>
        </div>
        <ul class="ext-notes">
          <li>ได้ล็อกเดิม <strong><%= request.assignedStallCode %></strong> ต่อทันที ไม่ต้องรอแอดมินจัดล็อกใหม่</li>
          <li>กดแล้วไปหน้าชำระเงิน สแกน QR พร้อมเพย์แล้วแนบสลิป แอดมินยืนยันสลิปตามปกติ</li>
          <li>ไม่ชำระภายในกำหนด ล็อกกลับไปหมดสัญญาตามวันเดิม</li>
        </ul>
      </section>

      <div class="bottom-buttons">
        <button type="button" class="btn-cancel-main" onclick="history.back()">ยกเลิก</button>
        <button type="submit" class="btn-confirm" <%= renewal.isOpen ? '' : 'disabled' %>>ต่อล็อกและไปชำระเงิน</button>
      </div>
    </form>
  </main>

  <script>
    (function () {
      var newEndDateInput = document.getElementById('newEndDate');
      var extendToRoundEndBtn = document.getElementById('extendToRoundEndBtn');

      var toDateInputValue = function (d) {
        var date = new Date(d);
        var year = date.getFullYear();
        var month = String(date.getMonth() + 1).padStart(2, '0');
        var day = String(date.getDate()).padStart(2, '0');
        return year + '-' + month + '-' + day;
      };
      var currentEnd = toDateInputValue(<%- JSON.stringify(new Date(activeLock.rentalEndDate)) %>);
      var roundEnd = toDateInputValue(<%- JSON.stringify(new Date(roundMeta.cycleEnd)) %>);
      var canRenewShort = <%- renewal.canRenewShort %>;

      var extendStart = new Date(currentEnd);
      extendStart.setDate(extendStart.getDate() + 1);

      // ต่อไม่ถึงสิ้นรอบยังไม่เปิด (ก่อน D-1) = เลือกได้แค่วันสิ้นรอบวันเดียว
      newEndDateInput.min = canRenewShort ? toDateInputValue(extendStart) : roundEnd;
      newEndDateInput.max = roundEnd;

      // ยอดประมาณ = ราคาต่อวัน x จำนวนวัน (ยังไม่หักวันหยุด ยอดจริงคิดที่ server)
      var dailyTotal = <%- JSON.stringify(Number(dailyTotal || 0)) %>;
      var totalRow = document.getElementById('extendTotalRow');
      var updateTotal = function () {
        if (!newEndDateInput.value) { totalRow.hidden = true; return; }
        var days = Math.round((new Date(newEndDateInput.value) - new Date(toDateInputValue(extendStart))) / 86400000) + 1;
        if (!(days > 0)) { totalRow.hidden = true; return; }
        document.getElementById('extendDays').textContent = days;
        document.getElementById('extendTotal').textContent = (dailyTotal * days).toLocaleString('th-TH') + ' บาท';
        totalRow.hidden = false;
      };
      newEndDateInput.addEventListener('change', updateTotal);

      extendToRoundEndBtn.addEventListener('click', function () {
        newEndDateInput.value = roundEnd;
        updateTotal();
      });

      // มาจากปุ่ม "ต่อล็อก" ในแจ้งเตือน — เลือกต่อจนจบรอบไว้ให้เลย กดยืนยันได้ทันที
      if (!newEndDateInput.disabled) {
        newEndDateInput.value = roundEnd;
        updateTotal();
      }
    })();
  </script>
</body>
</html>
