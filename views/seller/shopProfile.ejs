<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>ร้านค้าของฉัน - กังสดาลไนท์</title>
        <link rel="icon" type="image/png" href="/img/favicon.png">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260826-7">
        <link rel="stylesheet" href="/stylesheets/seller/repair.css">
        <link rel="stylesheet" href="/stylesheets/seller/shopProfile.css">
        <link rel="stylesheet" href="/stylesheets/seller/taxInvoiceRequest.css">
    </head>

    <body>
        <script src="/js/common/tabSession.js"></script>
        <%- include('../partials/navbarSeller') %>

        <header class="site-header">
            <button class="btn-back" onclick="history.back()" title="ย้อนกลับ">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>
            <h1 class="header-title">ร้านค้าของฉัน</h1>
            <div class="header-spacer"></div>
        </header>

        <div class="container">
            <div class="form-card">
                <%
                const errorParam = (typeof error !== 'undefined' && error) ? error : null;
                const successParam = (typeof success !== 'undefined' && success) ? success : null;
                const fd = (typeof formData !== 'undefined' && formData) ? formData : {};
                const shopRecord = (typeof shop !== 'undefined' && shop) ? shop : {};
                const successMsg = successParam === 'profile_updated' ? 'บันทึกข้อมูลร้านค้าสำเร็จ' : null;
                const errorMsg = {
                    'missing_fields': 'กรุณากรอกข้อมูลให้ครบถ้วน',
                    'upload_failed': 'อัปโหลดรูปภาพล้มเหลว กรุณาลองใหม่',
                    'db_error': 'เกิดข้อผิดพลาดในการบันทึกข้อมูล กรุณาลองใหม่'
                }[errorParam] || null;
                const currentShopName = fd.shopName || shopRecord.shopName || '';
                const currentProductType = fd.productType || shopRecord.productType || '';
                const currentProductDetail = fd.productDetail || shopRecord.productDetail || '';
                const currentShopSummary = fd.shopSummary || shopRecord.shopSummary || '';
                const currentShopTags = fd.shopTags || shopRecord.shopTags || '';
                const currentProductImages = shopRecord.productImages || [];
                const maxProductImagesCount = (typeof maxProductImages !== 'undefined' && maxProductImages) ? maxProductImages : 6;
                %>

                <% if (successMsg) { %>
                <div class="form-alert form-alert--success">
                    <i class="fa-solid fa-check-circle"></i>
                    <span><%= successMsg %></span>
                </div>
                <% } %>

                <% if (errorMsg) { %>
                <div class="form-alert form-alert--danger">
                    <i class="fa-solid fa-exclamation-circle"></i>
                    <span><%= errorMsg %></span>
                </div>
                <% } %>

                <div class="shop-status-row">
                    <span class="tier-badge <%= shopRecord.isVerified ? 'tier-badge--primary' : 'tier-badge--neutral' %>">
                        <i class="bi bi-award-fill"></i> <%= shopRecord.sellerTier || 'General Seller' %>
                    </span>
                    <span class="zone-badge">
                        <i class="bi bi-geo-alt-fill"></i> <%= shopRecord.shopZoneLabel || 'ยังไม่ได้ระบุโซนร้าน' %>
                    </span>
                </div>
                <p class="text-muted small">ป้ายระดับร้านค้าและโซนร้านกำหนดโดยแอดมิน ผู้ขายแก้ไขไม่ได้</p>

                <div class="locked-field-row">
                    <div class="locked-field">
                        <label>ชื่อร้านค้า</label>
                        <p><%= currentShopName || 'ยังไม่ได้ตั้งชื่อร้าน' %></p>
                    </div>
                    <div class="locked-field">
                        <label>ประเภทสินค้า</label>
                        <p><%= currentProductType || 'ยังไม่ระบุ' %></p>
                    </div>
                </div>
                <p class="text-muted small">ชื่อร้านและประเภทสินค้ามาจากใบสมัครที่ผ่านการอนุมัติแล้ว แก้ไขไม่ได้ที่นี่
                    เพื่อให้ตรงกับข้อมูลที่แอดมินตรวจสอบไว้เสมอ — หากต้องการเปลี่ยน ติดต่อแอดมิน</p>

                <form action="/shop-profile" method="POST" enctype="multipart/form-data">
                    <div class="form-grid">
                        <div class="form-group full-width">
                            <label>ป้ายกำกับร้าน</label>
                            <input type="text" name="shopTags" class="input-white"
                                value="<%= currentShopTags %>"
                                placeholder="คั่นด้วยจุลภาค เช่น เผ็ด, ของหวาน, ฮาลาล">
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label>แนะนำร้านสั้น ๆ</label>
                        <textarea name="shopSummary" class="input-white" style="min-height: 70px;"
                            placeholder="แนะนำร้านสั้น ๆ ให้ลูกค้าเห็นบนหน้าคอมมูนิตี้/ผังตลาด"><%= currentShopSummary %></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label>รายละเอียดสินค้า</label>
                        <textarea name="productDetail" class="input-white"
                            placeholder="เพิ่มรายละเอียดสินค้าที่ขาย..."><%= currentProductDetail %></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label>รูปสินค้า/โลโก้ร้าน (สูงสุด <%= maxProductImagesCount %> รูป)</label>
                        <div class="upload-wrapper" id="productImagesWrapper">
                            <% currentProductImages.forEach(function (img) { %>
                            <div class="upload-thumb-item existing-thumb" data-image-id="<%= img.id %>">
                                <img src="<%= img.imageUrl %>" alt="รูปสินค้า">
                                <button type="button" class="upload-thumb-remove existing-remove-btn"
                                    data-image-id="<%= img.id %>" title="ลบรูปนี้">&times;</button>
                            </div>
                            <% }); %>
                            <label for="productImagesUpload" class="upload-box" id="productImagesUploadLabel"></label>
                        </div>
                        <input type="file" name="productImages" id="productImagesUpload"
                            class="upload-input" accept="image/*" multiple
                            data-max="<%= maxProductImagesCount %>" data-existing="<%= currentProductImages.length %>">
                        <input type="hidden" name="removeProductImageIds" id="removeProductImageIdsInput" value="">
                    </div>

                    <div class="form-group full-width">
                        <label>รูปหน้าปกร้าน</label>
                        <div class="upload-wrapper">
                            <div class="upload-box-frame upload-box-frame--cover<%= shopRecord.shopCoverImage ? ' has-image' : '' %>" id="shopCoverImageFrame">
                                <label for="shopCoverImageUpload" class="upload-box upload-box--cover" id="shopCoverImageUploadLabel">
                                    <img id="shopCoverImagePreview"
                                        src="<%= shopRecord.shopCoverImage || '' %>"
                                        style="<%= shopRecord.shopCoverImage ? 'display:block;' : '' %>"
                                        alt="Preview">
                                </label>
                                <button type="button" class="upload-thumb-remove" id="shopCoverImageRemoveBtn"
                                    style="<%= shopRecord.shopCoverImage ? '' : 'display:none;' %>" title="ลบรูป">&times;</button>
                            </div>
                            <input type="file" name="shopCoverImage" id="shopCoverImageUpload"
                                class="upload-input" accept="image/*">
                            <input type="hidden" name="removeShopCoverImage" id="removeShopCoverImageFlag" value="">
                        </div>
                    </div>
                    <p class="text-muted small mb-3">ไม่เลือกรูปใหม่ = ใช้รูปเดิมต่อ, กดปุ่ม &times; เพื่อลบรูปที่ไม่ต้องการ</p>

                    <button type="submit" class="submit-btn" id="submitBtn">บันทึกข้อมูลร้านค้า</button>
                </form>
            </div>

            <div class="form-card">
                <%
                const eligibleQuotationList = (typeof eligibleQuotations !== 'undefined' && Array.isArray(eligibleQuotations)) ? eligibleQuotations : [];
                const taxInvoiceProfileList = (typeof taxInvoiceProfiles !== 'undefined' && Array.isArray(taxInvoiceProfiles)) ? taxInvoiceProfiles : [];
                const taxInvoiceRequestList = (typeof taxInvoiceRequests !== 'undefined' && Array.isArray(taxInvoiceRequests)) ? taxInvoiceRequests : [];
                const taxSuccessMsg = successParam === 'tax_invoice_requested' ? 'ส่งคำขอใบกำกับภาษีเรียบร้อยแล้ว รอแอดมินดำเนินการ' : null;
                const taxErrorMsg = {
                    'missing_booking_requests': 'กรุณาเลือกใบเสนอราคาอย่างน้อย 1 ใบ',
                    'booking_request_not_eligible': 'ใบเสนอราคาที่เลือกไม่สามารถขอใบกำกับภาษีได้ (อาจถูกผูกกับคำขออื่นไปแล้ว)',
                    'missing_profile_data': 'กรุณาเลือกโปรไฟล์ผู้เสียภาษี หรือกรอกข้อมูลนามใหม่ให้ครบ',
                    'profile_not_found': 'ไม่พบโปรไฟล์ผู้เสียภาษีที่เลือก'
                }[errorParam] || null;
                %>

                <div class="section-title">ขอใบกำกับภาษี</div>

                <% if (taxSuccessMsg) { %>
                <div class="form-alert form-alert--success"><i class="fa-solid fa-check-circle"></i><span><%= taxSuccessMsg %></span></div>
                <% } %>
                <% if (taxErrorMsg) { %>
                <div class="form-alert form-alert--danger"><i class="fa-solid fa-exclamation-circle"></i><span><%= taxErrorMsg %></span></div>
                <% } %>

                <form action="/tax-invoice-requests" method="POST" id="taxInvoiceForm">
                    <p class="text-muted small mb-2">1. เลือกใบเสนอราคาที่ต้องการออกใบกำกับภาษี</p>
                    <div class="quotation-pick-list">
                        <% if (!eligibleQuotationList.length) { %>
                        <div class="quotation-pick-empty">ไม่มีใบเสนอราคาที่ขอใบกำกับภาษีได้ในขณะนี้</div>
                        <% } %>
                        <% eligibleQuotationList.forEach(function(q) { %>
                        <label class="quotation-pick-row">
                            <input type="checkbox" name="bookingRequestIds" value="<%= q.id %>">
                            <span class="qn">เลขที่ <%= q.quotationNumber %></span>
                            <span class="qa"><%= q.issuedDateLabel %> — <%= Number(q.netTotal).toLocaleString('th-TH', { minimumFractionDigits: 2 }) %> บาท</span>
                        </label>
                        <% }) %>
                    </div>

                    <p class="text-muted small mb-2">2. ข้อมูลผู้เสียภาษี</p>
                    <div class="profile-toggle">
                        <button type="button" id="btnUseExisting">ใช้โปรไฟล์เดิม</button>
                        <button type="button" id="btnUseNew">ขอในนามใหม่</button>
                    </div>

                    <div id="existingProfileBlock" class="form-group full-width">
                        <label>เลือกโปรไฟล์ผู้เสียภาษี</label>
                        <select name="taxInvoiceProfileId" class="input-white" id="taxInvoiceProfileId">
                            <option value="">-- เลือก --</option>
                            <% taxInvoiceProfileList.forEach(function(p) { %>
                            <option value="<%= p.id %>"><%= p.taxpayerName %> (<%= p.taxId %>)</option>
                            <% }) %>
                        </select>
                        <% if (!taxInvoiceProfileList.length) { %>
                        <small style="color: var(--ink-soft); margin-top: 6px;">ยังไม่มีโปรไฟล์เดิม — กรุณาเลือก "ขอในนามใหม่"</small>
                        <% } %>
                    </div>

                    <div id="newProfileBlock" class="form-grid" style="display:none;">
                        <div class="form-group">
                            <label>ประเภทผู้เสียภาษี</label>
                            <select name="taxpayerType" class="input-white" id="taxpayerTypeInput">
                                <option value="COMPANY">นิติบุคคล (บริษัท/ห้างหุ้นส่วน)</option>
                                <option value="INDIVIDUAL">บุคคลธรรมดา</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>เลขประจำตัวผู้เสียภาษี (13 หลัก)</label>
                            <input type="text" name="taxId" id="taxIdInput" class="input-white" placeholder="0-0000-00000-00-0">
                        </div>
                        <div class="form-group full-width">
                            <label>ชื่อที่จะขึ้นในใบกำกับภาษี</label>
                            <input type="text" name="taxpayerName" id="taxpayerNameInput" class="input-white" placeholder="เช่น บริษัท ตัวอย่าง จำกัด">
                        </div>
                        <div class="form-group">
                            <label>สาขา</label>
                            <input type="text" name="branch" class="input-white" placeholder="สำนักงานใหญ่ / สาขาเลขที่...">
                        </div>
                        <div class="form-group">
                            <label>เบอร์โทร</label>
                            <input type="text" name="phoneNumber" class="input-white">
                        </div>
                        <div class="form-group full-width">
                            <label>ที่อยู่สำหรับออกใบกำกับภาษี</label>
                            <textarea name="address" id="addressInput" class="input-white" rows="3"></textarea>
                        </div>
                        <small style="color: var(--ink-soft); grid-column: 1 / -1;">แอดมินจะตรวจสอบและยืนยัน/แก้ไขข้อมูลนี้อีกครั้งก่อนออกใบกำกับภาษีจริง</small>
                    </div>

                    <button type="submit" class="btn-submit" style="margin-top: 18px;">ส่งคำขอใบกำกับภาษี</button>
                </form>

                <% if (taxInvoiceRequestList.length) { %>
                <p class="text-muted small mt-4 mb-2">คำขอใบกำกับภาษีของฉัน</p>
                <div class="request-list">
                    <% taxInvoiceRequestList.forEach(function(r) { %>
                    <div class="request-row">
                        <div class="request-row-main">
                            <span class="request-row-title"><%= r.taxpayerName %> <% if (r.documentNumber) { %>(เลขที่ <%= r.documentNumber %>)<% } %></span>
                            <span class="request-row-meta"><%= r.quotationCount %> ใบเสนอราคา — <%= Number(r.netTotal).toLocaleString('th-TH', { minimumFractionDigits: 2 }) %> บาท</span>
                        </div>
                        <span class="badge <%= r.status.toLowerCase() %>"><%= r.statusLabel %></span>
                        <% if (r.status === 'ISSUED') { %>
                        <a href="/tax-invoices/<%= r.id %>" class="link-view">ดูเอกสาร</a>
                        <% } %>
                    </div>
                    <% }) %>
                </div>
                <% } %>
            </div>
        </div>

        <script>
            (function() {
                const btnUseExisting = document.getElementById('btnUseExisting');
                const btnUseNew = document.getElementById('btnUseNew');
                if (!btnUseExisting || !btnUseNew) return;
                const existingBlock = document.getElementById('existingProfileBlock');
                const newBlock = document.getElementById('newProfileBlock');
                const profileSelect = document.getElementById('taxInvoiceProfileId');
                const newRequiredFields = [
                    document.getElementById('taxIdInput'),
                    document.getElementById('taxpayerNameInput'),
                    document.getElementById('addressInput')
                ];

                function showExisting() {
                    btnUseExisting.classList.add('active');
                    btnUseNew.classList.remove('active');
                    existingBlock.style.display = '';
                    newBlock.style.display = 'none';
                    profileSelect.disabled = false;
                    newRequiredFields.forEach((el) => { el.disabled = true; el.required = false; });
                }
                function showNew() {
                    btnUseNew.classList.add('active');
                    btnUseExisting.classList.remove('active');
                    existingBlock.style.display = 'none';
                    newBlock.style.display = '';
                    profileSelect.value = '';
                    profileSelect.disabled = true;
                    newRequiredFields.forEach((el) => { el.disabled = false; el.required = true; });
                }

                btnUseExisting.addEventListener('click', showExisting);
                btnUseNew.addEventListener('click', showNew);

                <% if (taxInvoiceProfileList.length) { %>
                showExisting();
                <% } else { %>
                showNew();
                <% } %>
            })();
        </script>

        <script src="/js/seller/shopProfile.js"></script>
    </body>
</html>
