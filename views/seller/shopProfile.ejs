<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>ร้านค้าของฉัน - กังสดาลไนท์</title>
        <link rel="icon" type="image/png" href="/img/favicon.png">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20261023-ios">
        <link rel="stylesheet" href="/stylesheets/seller/repair.css">
        <link rel="stylesheet" href="/stylesheets/seller/shopProfile.css?v=20261028-head">
        <link rel="stylesheet" href="/stylesheets/partials/shopSwitch.css?v=20261028">
    </head>

    <body>
        <script src="/js/common/tabSession.js"></script>
        <%- include('../partials/navbarSeller') %>

        <header class="site-header">
            <button class="btn-back" onclick="history.back()" title="ย้อนกลับ">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>
            <h1 class="header-title">ร้านค้าของฉัน</h1>
            <div class="header-spacer"></div>
        </header>

        <div class="container">
            <div class="form-card">
                <%
                const errorParam = (typeof error !== 'undefined' && error) ? error : null;
                const successParam = (typeof success !== 'undefined' && success) ? success : null;
                const fd = (typeof formData !== 'undefined' && formData) ? formData : {};
                const shopRecord = (typeof shop !== 'undefined' && shop) ? shop : {};
                const successMsg = successParam === 'profile_updated' ? 'บันทึกข้อมูลร้านค้าสำเร็จ' : null;
                const errorMsg = {
                    'missing_fields': 'กรุณากรอกข้อมูลให้ครบถ้วน',
                    'upload_failed': 'อัปโหลดรูปภาพล้มเหลว กรุณาลองใหม่',
                    'db_error': 'เกิดข้อผิดพลาดในการบันทึกข้อมูล กรุณาลองใหม่',
                    'shop_not_found': 'ไม่พบร้านที่เลือก กรุณาเลือกร้านใหม่'
                }[errorParam] || null;
                const profileShops = (typeof shops !== 'undefined' && shops) || [];
                // ร้านหลายร้าน: ฟอร์มบันทึกเข้าร้านที่เลือกอยู่ (?shop=) เสมอ
                const shopQuery = profileShops.length > 1 && shopRecord.id ? `?shop=${shopRecord.id}` : '';
                const currentShopName = fd.shopName || shopRecord.shopName || '';
                const currentProductType = fd.productType || shopRecord.productType || '';
                const currentProductDetail = fd.productDetail || shopRecord.productDetail || '';
                const currentShopSummary = fd.shopSummary || shopRecord.shopSummary || '';
                const currentShopTags = fd.shopTags || shopRecord.shopTags || '';
                const currentProductImages = shopRecord.productImages || [];
                const maxProductImagesCount = (typeof maxProductImages !== 'undefined' && maxProductImages) ? maxProductImages : 6;
                const currentMenuImages = shopRecord.menuImages || [];
                const maxMenuImagesCount = (typeof maxMenuImages !== 'undefined' && maxMenuImages) ? maxMenuImages : 4;
                %>

                <%
                const pendingList = (typeof pendingShops !== 'undefined' && pendingShops) || [];
                const shopIndex = profileShops.findIndex((s) => s.id === shopRecord.id);
                %>
                <!-- หัวร้าน: ร้านที่กำลังแก้ + สมัครเปิดร้านเพิ่ม + สลับร้าน + ใบสมัครร้านใหม่ที่ยังรอ -->
                <section class="shop-head" aria-labelledby="shopHeadName">
                    <div class="shop-head__top">
                        <div class="shop-head__who">
                            <span class="shop-head__label">ร้านที่กำลังแก้ไข<% if (profileShops.length > 1 && shopIndex >= 0) { %> · <%= shopIndex + 1 %>/<%= profileShops.length %><% } %></span>
                            <strong class="shop-head__name" id="shopHeadName"><%= currentShopName || 'ยังไม่ได้ตั้งชื่อร้าน' %></strong>
                        </div>
                        <a href="/shop-application?new=1" class="shop-head__add">
                            <i class="fa-solid fa-plus" aria-hidden="true"></i> สมัครเปิดร้านเพิ่ม
                        </a>
                    </div>
                    <%- include('../partials/shopSwitch', { shops: profileShops, selectedShopId: shopRecord.id, href: function (id) { return '/shop-profile?shop=' + id; }, label: 'สลับร้าน' }) %>
                    <% pendingList.forEach((p) => { %>
                    <div class="shop-head__pending">
                        <span><b><%= p.shopName || 'ร้านใหม่' %></b> ใบสมัครรอตรวจ — จองแผงได้เลย ระบบเปิดร้านให้เมื่อแอดมินยืนยันสลิป</span>
                        <a href="/select-zone?shop=<%= encodeURIComponent(p.id) %>">จองแผงให้ร้านนี้ <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                    </div>
                    <% }) %>
                    <% if (profileShops.length > 1) { %>
                    <p class="shop-head__note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> รีวิวและสถิติคนเปิดดูร้านด้านล่างยังรวมทุกร้านของคุณ</p>
                    <% } %>
                </section>

                <% if (successMsg) { %>
                <div class="form-alert form-alert--success">
                    <i class="fa-solid fa-check-circle"></i>
                    <span><%= successMsg %></span>
                </div>
                <% } %>

                <% if (errorMsg) { %>
                <div class="form-alert form-alert--danger">
                    <i class="fa-solid fa-exclamation-circle"></i>
                    <span><%= errorMsg %></span>
                </div>
                <% } %>

                <div class="shop-status-row">
                    <span class="tier-badge <%= shopRecord.isVerified ? 'tier-badge--primary' : 'tier-badge--neutral' %>">
                        <i class="bi bi-award-fill"></i> <%= shopRecord.sellerTier || 'General Seller' %>
                    </span>
                    <span class="zone-badge">
                        <i class="bi bi-geo-alt-fill"></i> <%= shopRecord.shopZoneLabel || 'ยังไม่ได้ระบุโซนร้าน' %>
                    </span>
                </div>
                <p class="text-muted small">ป้ายระดับร้านค้าและโซนร้านกำหนดโดยแอดมิน ผู้ขายแก้ไขไม่ได้</p>

                <div class="locked-field-row">
                    <div class="locked-field">
                        <label>ชื่อร้านค้า</label>
                        <p><%= currentShopName || 'ยังไม่ได้ตั้งชื่อร้าน' %></p>
                    </div>
                    <div class="locked-field">
                        <label>ประเภทสินค้า</label>
                        <p><%= currentProductType || 'ยังไม่ระบุ' %></p>
                    </div>
                </div>
                <p class="text-muted small">ชื่อร้านและประเภทสินค้ามาจากใบสมัครที่ผ่านการอนุมัติแล้ว แก้ไขไม่ได้ที่นี่
                    เพื่อให้ตรงกับข้อมูลที่แอดมินตรวจสอบไว้เสมอ — หากต้องการเปลี่ยน ติดต่อแอดมิน</p>

                <% if (locals.myStalls) { const ms = locals.myStalls; const os = ms.openStatus; %>
                <!-- แผงของร้านนี้: ปิดร้านวันนี้ (แยกต่อร้าน) + แจ้งลาหยุดรายแผง (utils/stallLeave.js) -->
                <section class="my-stalls" id="my-stalls" aria-labelledby="myStallsTitle" data-shop-id="<%= ms.shopId %>" data-open="<%= os.isOpen ? '1' : '0' %>">
                    <div class="pm-head">
                        <span class="pm-title" id="myStallsTitle">แผงของร้านนี้</span>
                        <span class="pm-score"><b><%= ms.stalls.length %></b> แผง</span>
                    </div>
                    <% if (ms.stalls.length) { %>
                    <div class="ms-open">
                        <span data-ms-open-text><%= os.isOpen ? 'วันนี้ร้านเปิดอยู่' : 'ปิดร้านแล้ววันนี้' %></span>
                        <button type="button" class="ms-btn" data-ms-open-btn><%= os.isOpen ? 'ปิดร้านวันนี้' : 'ยกเลิกการปิด' %></button>
                    </div>
                    <ul class="ms-list">
                        <% ms.stalls.forEach(function (s) { %>
                        <li class="ms-item">
                            <div class="ms-code"><b><%= s.code %></b><small>สัญญา <%= s.contractText %></small></div>
                            <div class="ms-leaves">
                                <% if (!s.leaves.length) { %><small>ไม่มีคำขอลาหยุด/เช่าช่วง</small><% } %>
                                <% s.leaves.forEach(function (l) { %>
                                <small class="ms-leave ms-leave--<%= l.status.toLowerCase() %>"><%= l.kindLabel %> <%= l.rangeText %> · <%= l.statusLabel %></small>
                                <% }) %>
                            </div>
                            <div class="ms-actions">
                                <a class="ms-btn" href="/stall-leave/new?shop=<%= ms.shopId %>&stall=<%= s.code %>">แจ้งลาหยุด</a>
                                <a class="ms-btn ms-btn--ghost" href="/stall-leave/new?shop=<%= ms.shopId %>&stall=<%= s.code %>&kind=sublet">ปล่อยเช่าช่วง</a>
                                <a class="ms-btn ms-btn--ghost" href="/market-map?stall=<%= s.code %>">ดูบนผัง</a>
                            </div>
                        </li>
                        <% }) %>
                    </ul>
                    <% } else { %>
                    <p class="pm-done ms-empty">ร้านนี้ยังไม่มีแผงที่ชำระเงินแล้วและสัญญายังไม่หมด <a href="/select-zone?shop=<%= ms.shopId %>">จองแผง</a></p>
                    <% } %>
                </section>
                <% } %>

                <%
                // ความครบของโปรไฟล์ร้าน — นับจากข้อมูลที่บันทึกแล้วเท่านั้น (ไม่ใช่ค่าที่ค้างในฟอร์มตอน error)
                // ยิ่งครบ ลูกค้ายิ่งค้นเจอและรู้ว่าร้านขายอะไรในผังตลาด
                const profileSummary = locals.profile || { checks: [], done: 0 };
                const profileChecks = profileSummary.checks;
                const profileDone = profileSummary.done;
                %>
                <% if (locals.viewStats) {
                    const vs = locals.viewStats;
                    const maxDay = Math.max(1, ...vs.daily.map((d) => d.card));
                    const dayFmt = { weekday: 'short' };
                %>
                <section class="view-stats" aria-labelledby="viewStatsTitle">
                    <div class="pm-head">
                        <span class="pm-title" id="viewStatsTitle">คนดูร้านคุณในผังตลาด</span>
                        <span class="pm-score"><%= vs.days %> วันล่าสุด</span>
                    </div>
                    <div class="vs-tiles">
                        <div class="vs-tile"><span>เปิดดูร้าน</span><b><%= vs.totals.card %></b></div>
                        <div class="vs-tile"><span>ดูเมนู</span><b><%= vs.totals.menu %></b></div>
                        <div class="vs-tile"><span>แชร์ร้าน</span><b><%= vs.totals.share %></b></div>
                    </div>
                    <div class="vs-chart" role="img" aria-label="จำนวนครั้งที่เปิดดูร้านรายวัน <%= vs.daily.map((d) => d.date.toLocaleDateString('th-TH', dayFmt) + ' ' + d.card + ' ครั้ง').join(', ') %>">
                        <% vs.daily.forEach(function (d, i) { const isToday = i === vs.daily.length - 1; %>
                        <div class="vs-col" data-tip="<%= d.date.toLocaleDateString('th-TH', { day: 'numeric', month: 'short' }) %> · เปิดดู <%= d.card %> ครั้ง">
                            <div class="vs-bar-area"><div class="vs-bar" style="height: <%= Math.round((d.card / maxDay) * 100) %>%"></div></div>
                            <span class="vs-day<%= isToday ? ' is-today' : '' %>"><%= isToday ? 'วันนี้' : d.date.toLocaleDateString('th-TH', dayFmt) %></span>
                        </div>
                        <% }); %>
                    </div>
                    <% if (!vs.totals.card) { %>
                    <p class="vs-empty">ยังไม่มีคนเปิดดูร้านใน 7 วันนี้ — ใส่ป้ายเมนูกับรูปเมนูให้ครบ แล้วพิมพ์ป้าย QR ติดหน้าร้านจากผังตลาด ลูกค้าจะเจอร้านง่ายขึ้น</p>
                    <% } %>
                </section>
                <% } %>

                <% if (locals.reviewPanel) {
                    const rp = locals.reviewPanel;
                    const starRow = function (n) { return [1, 2, 3, 4, 5].map(function (i) { return '<i class="fa-' + (i <= Math.round(n) ? 'solid' : 'regular') + ' fa-star"></i>'; }).join(''); };
                    const dateFmt = { day: 'numeric', month: 'short', year: '2-digit' };
                %>
                <section class="shop-reviews" id="shop-reviews" aria-labelledby="shopReviewsTitle">
                    <div class="pm-head">
                        <span class="pm-title" id="shopReviewsTitle">รีวิวร้านคุณจากสมาชิก</span>
                        <span class="pm-score">ลูกค้าเห็นในการ์ดร้านบนผังตลาด</span>
                    </div>
                    <div class="vs-tiles">
                        <div class="vs-tile"><span>คะแนนเฉลี่ย</span><b><%= rp.count ? rp.avg.toFixed(1) : '–' %></b><span class="sr-stars" aria-hidden="true"><%- starRow(rp.avg) %></span></div>
                        <div class="vs-tile"><span>รีวิวทั้งหมด</span><b><%= rp.count %></b></div>
                        <div class="vs-tile"><span>ยังไม่ได้ตอบ</span><b data-unanswered-count><%= rp.unanswered %></b><% if (rp.newThisWeek) { %><span>ใหม่ 7 วัน <%= rp.newThisWeek %></span><% } %></div>
                    </div>
                    <% if (!rp.reviews.length) { %>
                    <p class="vs-empty">ยังไม่มีรีวิว — สมาชิกรีวิวได้จากการ์ดร้านบนผังตลาด ป้าย QR หน้าร้านช่วยให้ลูกค้าเปิดร้านคุณแล้วรีวิวได้ทันที</p>
                    <% } else {
                        // แท็บกรอง: ยังไม่ตอบ (นับแบบเดียวกับช่อง "ยังไม่ได้ตอบ" = มีความเห็น ยังไม่ตอบ ไม่ถูกซ่อน) / ตอบแล้ว / ทั้งหมด
                        // เปิดมาที่ "ยังไม่ตอบ" ก่อนถ้ามี — รายการแสดงทีละ 10 กด "ดูเพิ่ม" (public/js/seller/shopReviews.js)
                        const stateOf = function (rv) { return rv.isHidden ? 'hidden' : rv.reply ? 'replied' : rv.comment ? 'pending' : 'rating'; };
                        const repliedCount = rp.reviews.filter(function (rv) { return !rv.isHidden && rv.reply; }).length;
                    %>
                    <div class="sr-tabs" role="tablist" aria-label="กรองรีวิว">
                        <button type="button" role="tab" data-review-tab="pending" aria-selected="false">ยังไม่ตอบ <span data-tab-count="pending"><%= rp.unanswered %></span></button>
                        <button type="button" role="tab" data-review-tab="replied" aria-selected="false">ตอบแล้ว <span data-tab-count="replied"><%= repliedCount %></span></button>
                        <button type="button" role="tab" data-review-tab="all" aria-selected="false">ทั้งหมด <span data-tab-count="all"><%= rp.reviews.length %></span></button>
                    </div>
                    <ol class="sr-list" data-default-tab="<%= rp.unanswered ? 'pending' : 'all' %>">
                        <% rp.reviews.forEach(function (rv) { %>
                        <li class="sr-item<%= rv.isHidden ? ' is-hidden' : '' %>" data-review-id="<%= rv.id %>" data-review-state="<%= stateOf(rv) %>" data-has-comment="<%= rv.comment ? '1' : '' %>">
                            <div class="sr-head">
                                <span class="sr-stars" aria-label="<%= rv.rating %> ดาว"><%- starRow(rv.rating) %></span>
                                <b><%= rv.author %></b>
                                <% if (rv.isHidden) { %><span class="sr-badge sr-badge-hidden" title="<%= rv.hiddenReason || '' %>">แอดมินซ่อนแล้ว</span><% } else if (rv.reported) { %><span class="sr-badge">รายงานแล้ว รอแอดมินตรวจ</span><% } %>
                                <small><%= new Date(rv.createdAt).toLocaleDateString('th-TH', dateFmt) %></small>
                            </div>
                            <% if (rv.comment) { %><p class="sr-comment"><%= rv.comment %></p><% } %>
                            <% if (rv.isHidden && rv.hiddenReason) { %><p class="sr-hidden-reason">เหตุผลที่ซ่อน: <%= rv.hiddenReason %></p><% } %>
                            <div class="sr-reply<%= rv.reply ? '' : ' d-none' %>" data-reply-view>
                                <b>คำตอบของร้าน</b>
                                <p data-reply-text><%= rv.reply ? rv.reply.text : '' %></p>
                            </div>
                            <% if (!rv.isHidden) { %>
                            <form class="sr-reply-form d-none" data-reply-form>
                                <textarea maxlength="500" rows="2" placeholder="ขอบคุณลูกค้า หรือชี้แจงสั้นๆ (ทุกคนเห็นคำตอบนี้)"><%= rv.reply ? rv.reply.text : '' %></textarea>
                                <div class="sr-actions">
                                    <button type="button" class="sr-btn sr-btn-ghost" data-reply-cancel>ยกเลิก</button>
                                    <button type="submit" class="sr-btn">บันทึกคำตอบ</button>
                                </div>
                            </form>
                            <div class="sr-actions" data-review-actions>
                                <button type="button" class="sr-btn sr-btn-ghost" data-reply-open><i class="fa-solid fa-reply"></i> <%= rv.reply ? 'แก้คำตอบ' : 'ตอบรีวิว' %></button>
                                <% if (!rv.reported) { %>
                                <button type="button" class="sr-btn sr-btn-ghost sr-btn-report" data-report><i class="fa-regular fa-flag"></i> รายงานรีวิวไม่เหมาะสม</button>
                                <% } %>
                            </div>
                            <% } %>
                        </li>
                        <% }); %>
                    </ol>
                    <p class="sr-empty d-none" data-review-empty></p>
                    <button type="button" class="sr-more d-none" data-review-more></button>
                    <% } %>
                </section>
                <% } %>

                <div class="profile-meter">
                    <div class="pm-head">
                        <span class="pm-title">ความครบของร้านในผังตลาด</span>
                        <span class="pm-score"><b><%= profileDone %></b>/<%= profileChecks.length %></span>
                    </div>
                    <div class="pm-bar" aria-hidden="true">
                        <% profileChecks.forEach(function (c) { %><span class="<%= c.done ? 'on' : '' %>"></span><% }); %>
                    </div>
                    <% if (profileDone < profileChecks.length) { %>
                    <ul class="pm-list">
                        <% profileChecks.filter((c) => !c.done).forEach(function (c) { %>
                        <li><a href="#<%= c.id %>"><i class="fa-regular fa-square"></i> <%= c.label %></a> <small><%= c.why %></small></li>
                        <% }); %>
                    </ul>
                    <% } else { %>
                    <p class="pm-done"><i class="fa-solid fa-check"></i> ข้อมูลร้านครบแล้ว ลูกค้าค้นเจอและเห็นเมนูได้เต็มที่</p>
                    <% } %>
                </div>

                <form action="/shop-profile<%= shopQuery %>" method="POST" enctype="multipart/form-data">

                    <div class="form-section">
                        <div class="form-section-head">
                            <span class="form-section-title">แนะนำร้าน</span>
                            <span class="form-section-hint">แสดงบนผังตลาด/คอมมูนิตี้</span>
                        </div>

                        <div class="form-group full-width" id="field-tags">
                            <label>เมนูเด่น (คำค้นหา)</label>
                            <div class="tag-input-box" id="shopTagsBox">
                                <input type="text" id="shopTagsField" class="tag-input-field"
                                    placeholder="พิมพ์ชื่อเมนู แล้วกด Enter เช่น หมูปิ้งนมสด">
                            </div>
                            <input type="hidden" name="shopTags" id="shopTagsHidden" value="<%= currentShopTags %>">
                            <p class="field-hint">ใส่ชื่อเมนูที่ขายแบบเจาะจงไปเลย เช่น "หมูปิ้งนมสด" แทน
                                "หมูปิ้ง" เฉยๆ ลูกค้าจะค้นร้านในผังตลาดเจอง่ายขึ้น — พิมพ์เสร็จกด Enter หรือ , เพื่อเพิ่ม
                                แต่ละป้ายมีปุ่ม &times; กดเพื่อลบทิ้งได้เลย</p>
                        </div>

                        <div class="form-group full-width" id="field-summary">
                            <label>แนะนำร้านสั้น ๆ</label>
                            <textarea name="shopSummary" class="input-white" style="min-height: 70px;"
                                placeholder="แนะนำร้านสั้น ๆ ให้ลูกค้าเห็นบนหน้าคอมมูนิตี้/ผังตลาด"><%= currentShopSummary %></textarea>
                        </div>

                        <div class="form-group full-width" id="field-detail">
                            <label>รายละเอียดสินค้า</label>
                            <textarea name="productDetail" class="input-white"
                                placeholder="เพิ่มรายละเอียดสินค้าที่ขาย..."><%= currentProductDetail %></textarea>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="form-section-head">
                            <span class="form-section-title">รูปภาพร้าน</span>
                            <span class="form-section-hint">JPG / PNG</span>
                        </div>

                        <div class="form-group full-width" id="field-logo">
                            <label>โลโก้ร้าน</label>
                            <div class="upload-wrapper">
                                <div class="upload-box-frame upload-box-frame--logo<%= shopRecord.logoImage ? ' has-image' : '' %>" id="logoImageFrame">
                                    <label for="logoImageUpload" class="upload-box upload-box--cover upload-box--logo" id="logoImageUploadLabel">
                                        <img id="logoImagePreview"
                                            <% if (shopRecord.logoImage) { %>src="<%= shopRecord.logoImage %>"<% } %>
                                            style="<%= shopRecord.logoImage ? 'display:block;' : '' %>"
                                            alt="โลโก้ร้าน">
                                        <span class="cover-upload-placeholder">
                                            <i class="fa-solid fa-store"></i>
                                            <span>อัปโหลดโลโก้</span>
                                        </span>
                                    </label>
                                    <button type="button" class="upload-thumb-remove" id="logoImageRemoveBtn"
                                        style="<%= shopRecord.logoImage ? '' : 'display:none;' %>" title="ลบโลโก้">&times;</button>
                                </div>
                                <input type="file" name="logoImage" id="logoImageUpload"
                                    class="upload-input" accept="image/*">
                                <input type="hidden" name="removeLogoImage" id="removeLogoImageFlag" value="">
                            </div>
                            <p class="field-hint">ใช้เป็นรูปย่อของร้านบนผังตลาดและคอมมูนิตี้ — ไม่แสดงปนกับรูปสินค้าตอนลูกค้ากดดูเมนู</p>
                        </div>

                        <div class="form-group full-width" id="field-photos">
                            <label>รูปสินค้า (สูงสุด <%= maxProductImagesCount %> รูป)</label>
                            <div class="upload-wrapper" id="productImagesWrapper">
                                <% currentProductImages.forEach(function (img) { %>
                                <div class="upload-thumb-item existing-thumb" data-image-id="<%= img.id %>">
                                    <img src="<%= img.imageUrl %>" alt="รูปสินค้า">
                                    <button type="button" class="upload-thumb-remove existing-remove-btn"
                                        data-image-id="<%= img.id %>" title="ลบรูปนี้">&times;</button>
                                </div>
                                <% }); %>
                                <label for="productImagesUpload" class="upload-box" id="productImagesUploadLabel"></label>
                            </div>
                            <input type="file" name="productImages" id="productImagesUpload"
                                class="upload-input" accept="image/*" multiple
                                data-max="<%= maxProductImagesCount %>" data-existing="<%= currentProductImages.length %>">
                            <input type="hidden" name="removeProductImageIds" id="removeProductImageIdsInput" value="">
                            <p class="field-hint">รูปอาหาร/สินค้าจริงของร้าน ลูกค้าเห็นในแท็บ "รูปสินค้า" ตอนกดดูเมนูบนผังตลาด (ถ้ายังไม่มีโลโก้ รูปแรกจะใช้เป็นรูปย่อของร้านแทน)</p>
                        </div>

                        <div class="form-group full-width" id="field-menu">
                            <label>รูปเมนูร้าน (สูงสุด <%= maxMenuImagesCount %> รูป)</label>
                            <div class="upload-wrapper" id="menuImagesWrapper">
                                <% currentMenuImages.forEach(function (img) { %>
                                <div class="upload-thumb-item existing-thumb" data-image-id="<%= img.id %>">
                                    <img src="<%= img.imageUrl %>" alt="รูปเมนู">
                                    <button type="button" class="upload-thumb-remove existing-remove-btn"
                                        data-image-id="<%= img.id %>" title="ลบรูปนี้">&times;</button>
                                </div>
                                <% }); %>
                                <label for="menuImagesUpload" class="upload-box" id="menuImagesUploadLabel"></label>
                            </div>
                            <input type="file" name="menuImages" id="menuImagesUpload"
                                class="upload-input" accept="image/*" multiple
                                data-max="<%= maxMenuImagesCount %>" data-existing="<%= currentMenuImages.length %>">
                            <input type="hidden" name="removeMenuImageIds" id="removeMenuImageIdsInput" value="">
                            <p class="field-hint">ถ่ายป้ายเมนู/ใบราคาของร้านให้อ่านชื่อเมนูและราคาได้ชัด
                                ลูกค้ากดปุ่ม "ดูเมนูร้าน" ในผังตลาดเพื่อดูรูปนี้ได้เลย ไม่ต้องเดินไปถึงหน้าร้าน</p>
                        </div>

                        <div class="form-group full-width" id="field-cover">
                            <label>รูปหน้าปกร้าน</label>
                            <div class="upload-wrapper">
                                <div class="upload-box-frame upload-box-frame--cover<%= shopRecord.shopCoverImage ? ' has-image' : '' %>" id="shopCoverImageFrame">
                                    <label for="shopCoverImageUpload" class="upload-box upload-box--cover" id="shopCoverImageUploadLabel">
                                        <img id="shopCoverImagePreview"
                                            <% if (shopRecord.shopCoverImage) { %>src="<%= shopRecord.shopCoverImage %>"<% } %>
                                            style="<%= shopRecord.shopCoverImage ? 'display:block;' : '' %>"
                                            alt="รูปหน้าปกร้าน">
                                        <span class="cover-upload-placeholder">
                                            <i class="fa-solid fa-camera"></i>
                                            <span>อัปโหลดรูปหน้าปก</span>
                                        </span>
                                    </label>
                                    <button type="button" class="upload-thumb-remove" id="shopCoverImageRemoveBtn"
                                        style="<%= shopRecord.shopCoverImage ? '' : 'display:none;' %>" title="ลบรูป">&times;</button>
                                </div>
                                <input type="file" name="shopCoverImage" id="shopCoverImageUpload"
                                    class="upload-input" accept="image/*">
                                <input type="hidden" name="removeShopCoverImage" id="removeShopCoverImageFlag" value="">
                            </div>
                            <p class="field-hint">ไม่เลือกรูปใหม่ = ใช้รูปเดิมต่อ, กดปุ่ม &times; เพื่อลบรูปที่ไม่ต้องการ</p>
                        </div>
                    </div>

                    <button type="submit" class="submit-btn" id="submitBtn">บันทึกข้อมูลร้านค้า</button>
                </form>
            </div>

            <% const docShopQuery = (typeof shops !== 'undefined' && shops && shops.length > 1 && shop) ? `?shop=${shop.id}` : ''; %>
            <div class="form-card">
                <section class="doc-links" aria-labelledby="docLinksTitle">
                    <div class="pm-head">
                        <span class="pm-title" id="docLinksTitle">เอกสารร้านค้า</span>
                        <span class="pm-score">ขอเอกสาร · รายงาน</span>
                    </div>
                    <a class="doc-link" href="/documents">
                        <i class="fa-solid fa-folder-open doc-link__icon" aria-hidden="true"></i>
                        <span class="doc-link__text">
                            <b>ขอเอกสาร</b>
                            <small>ใบกำกับภาษี และสัญญาเช่า (ออก 1 ฉบับต่อ 1 ร้าน)</small>
                        </span>
                        <i class="fa-solid fa-arrow-right doc-link__go" aria-hidden="true"></i>
                    </a>
                    <a class="doc-link" href="/rental-statement<%= docShopQuery %>">
                        <i class="fa-solid fa-file-invoice-dollar doc-link__icon" aria-hidden="true"></i>
                        <span class="doc-link__text">
                            <b>รายงานการเช่าและชำระเงิน</b>
                            <small>ยอดเช่าและยอดชำระทุกรอบ<%= docShopQuery ? 'ของร้านนี้' : '' %></small>
                        </span>
                        <i class="fa-solid fa-arrow-right doc-link__go" aria-hidden="true"></i>
                    </a>
                </section>
            </div>
        </div>

        <script src="/js/seller/shopProfile.js?v=20261023-logo"></script>
        <script src="/js/common/dialogs.js"></script>
        <script src="/js/seller/shopReviews.js?v=20261026-tabs"></script>
        <script>
            // ปิดร้านวันนี้ของร้านที่กำลังดู (ร้านอื่นของผู้ใช้ไม่โดน) — endpoint เดียวกับหน้าแรกผู้ขาย
            (function () {
                const box = document.getElementById('my-stalls');
                const btn = box && box.querySelector('[data-ms-open-btn]');
                if (!btn) return;
                const text = box.querySelector('[data-ms-open-text]');
                async function save(open) {
                    btn.disabled = true;
                    try {
                        const response = await fetch('/shop-status', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                            body: JSON.stringify({ open, shopId: box.dataset.shopId })
                        });
                        const payload = await response.json();
                        if (!response.ok || !payload.success) throw new Error(payload.message || 'บันทึกไม่สำเร็จ');
                        box.dataset.open = payload.isOpen ? '1' : '0';
                        text.textContent = payload.isOpen ? 'วันนี้ร้านเปิดอยู่' : 'ปิดร้านแล้ววันนี้';
                        btn.textContent = payload.isOpen ? 'ปิดร้านวันนี้' : 'ยกเลิกการปิด';
                    } catch (error) {
                        window.showAlertDialog({ title: 'บันทึกไม่สำเร็จ', message: error.message, tone: 'danger' });
                    } finally {
                        btn.disabled = false;
                    }
                }
                btn.addEventListener('click', () => {
                    if (box.dataset.open !== '1') { save(true); return; }
                    window.showConfirmDialog({
                        title: 'ปิดร้านวันนี้?',
                        message: 'ลูกค้าจะเห็นบนผังตลาดว่าร้านนี้ปิดแล้ว ร้านจะกลับมาเปิดเองในวันขายถัดไป',
                        tone: 'warning',
                        confirmText: 'ปิดร้าน',
                        onConfirm: () => save(false)
                    });
                });
            })();
        </script>
    </body>
</html>
