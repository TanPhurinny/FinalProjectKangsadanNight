<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>ร้านค้าของฉัน - กังสดาลไนท์</title>
        <link rel="icon" type="image/png" href="/img/favicon.png">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260826-7">
        <link rel="stylesheet" href="/stylesheets/seller/repair.css">
        <link rel="stylesheet" href="/stylesheets/seller/shopProfile.css">
    </head>

    <body>
        <script src="/js/common/tabSession.js"></script>
        <%- include('../partials/navbarSeller') %>

        <header class="site-header">
            <button class="btn-back" onclick="history.back()" title="ย้อนกลับ">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>
            <h1 class="header-title">ร้านค้าของฉัน</h1>
            <div class="header-spacer"></div>
        </header>

        <div class="container">
            <div class="form-card">
                <%
                const errorParam = (typeof error !== 'undefined' && error) ? error : null;
                const successParam = (typeof success !== 'undefined' && success) ? success : null;
                const fd = (typeof formData !== 'undefined' && formData) ? formData : {};
                const shopRecord = (typeof shop !== 'undefined' && shop) ? shop : {};
                const successMsg = successParam === 'profile_updated' ? 'บันทึกข้อมูลร้านค้าสำเร็จ' : null;
                const errorMsg = {
                    'missing_fields': 'กรุณากรอกข้อมูลให้ครบถ้วน',
                    'upload_failed': 'อัปโหลดรูปภาพล้มเหลว กรุณาลองใหม่',
                    'db_error': 'เกิดข้อผิดพลาดในการบันทึกข้อมูล กรุณาลองใหม่'
                }[errorParam] || null;
                const currentShopName = fd.shopName || shopRecord.shopName || '';
                const currentProductType = fd.productType || shopRecord.productType || '';
                const currentProductDetail = fd.productDetail || shopRecord.productDetail || '';
                const currentShopSummary = fd.shopSummary || shopRecord.shopSummary || '';
                const currentShopTags = fd.shopTags || shopRecord.shopTags || '';
                %>

                <% if (successMsg) { %>
                <div class="form-alert form-alert--success">
                    <i class="fa-solid fa-check-circle"></i>
                    <span><%= successMsg %></span>
                </div>
                <% } %>

                <% if (errorMsg) { %>
                <div class="form-alert form-alert--danger">
                    <i class="fa-solid fa-exclamation-circle"></i>
                    <span><%= errorMsg %></span>
                </div>
                <% } %>

                <div class="shop-status-row">
                    <span class="tier-badge <%= shopRecord.isVerified ? 'tier-badge--primary' : 'tier-badge--neutral' %>">
                        <i class="bi bi-award-fill"></i> <%= shopRecord.sellerTier || 'General Seller' %>
                    </span>
                    <span class="zone-badge">
                        <i class="bi bi-geo-alt-fill"></i> <%= shopRecord.shopZoneLabel || 'ยังไม่ได้ระบุโซนร้าน' %>
                    </span>
                </div>
                <p class="text-muted small">ป้ายระดับร้านค้าและโซนร้านกำหนดโดยแอดมิน ผู้ขายแก้ไขไม่ได้</p>

                <div class="locked-field-row">
                    <div class="locked-field">
                        <label>ชื่อร้านค้า</label>
                        <p><%= currentShopName || 'ยังไม่ได้ตั้งชื่อร้าน' %></p>
                    </div>
                    <div class="locked-field">
                        <label>ประเภทสินค้า</label>
                        <p><%= currentProductType || 'ยังไม่ระบุ' %></p>
                    </div>
                </div>
                <p class="text-muted small">ชื่อร้านและประเภทสินค้ามาจากใบสมัครที่ผ่านการอนุมัติแล้ว แก้ไขไม่ได้ที่นี่
                    เพื่อให้ตรงกับข้อมูลที่แอดมินตรวจสอบไว้เสมอ — หากต้องการเปลี่ยน ติดต่อแอดมิน</p>

                <form action="/shop-profile" method="POST" enctype="multipart/form-data">
                    <div class="form-grid">
                        <div class="form-group full-width">
                            <label>ป้ายกำกับร้าน</label>
                            <input type="text" name="shopTags" class="input-white"
                                value="<%= currentShopTags %>"
                                placeholder="คั่นด้วยจุลภาค เช่น เผ็ด, ของหวาน, ฮาลาล">
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label>แนะนำร้านสั้น ๆ</label>
                        <textarea name="shopSummary" class="input-white" style="min-height: 70px;"
                            placeholder="แนะนำร้านสั้น ๆ ให้ลูกค้าเห็นบนหน้าคอมมูนิตี้/ผังตลาด"><%= currentShopSummary %></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label>รายละเอียดสินค้า</label>
                        <textarea name="productDetail" class="input-white"
                            placeholder="เพิ่มรายละเอียดสินค้าที่ขาย..."><%= currentProductDetail %></textarea>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label>รูปสินค้า/โลโก้ร้าน</label>
                            <div class="upload-wrapper">
                                <label for="productImageUpload" class="upload-box" id="productImageUploadLabel">
                                    <img id="productImagePreview"
                                        src="<%= shopRecord.productImage || '' %>"
                                        style="<%= shopRecord.productImage ? 'display:block;' : '' %>"
                                        alt="Preview">
                                </label>
                                <input type="file" name="productImage" id="productImageUpload"
                                    class="upload-input" accept="image/*">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>รูปหน้าปกร้าน</label>
                            <div class="upload-wrapper">
                                <label for="shopCoverImageUpload" class="upload-box" id="shopCoverImageUploadLabel">
                                    <img id="shopCoverImagePreview"
                                        src="<%= shopRecord.shopCoverImage || '' %>"
                                        style="<%= shopRecord.shopCoverImage ? 'display:block;' : '' %>"
                                        alt="Preview">
                                </label>
                                <input type="file" name="shopCoverImage" id="shopCoverImageUpload"
                                    class="upload-input" accept="image/*">
                            </div>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">ไม่เลือกรูปใหม่ = ใช้รูปเดิมต่อ</p>

                    <button type="submit" class="submit-btn" id="submitBtn">บันทึกข้อมูลร้านค้า</button>
                </form>
            </div>
        </div>

        <script src="/js/seller/shopProfile.js"></script>
    </body>
</html>
