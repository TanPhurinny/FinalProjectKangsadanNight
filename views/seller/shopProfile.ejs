<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>ร้านค้าของฉัน - กังสดาลไนท์</title>
        <link rel="icon" type="image/png" href="/img/favicon.png">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260826-7">
        <link rel="stylesheet" href="/stylesheets/seller/repair.css">
        <link rel="stylesheet" href="/stylesheets/seller/shopProfile.css?v=20261002-stats">
        <link rel="stylesheet" href="/stylesheets/seller/taxInvoiceRequest.css">
    </head>

    <body>
        <script src="/js/common/tabSession.js"></script>
        <%- include('../partials/navbarSeller') %>

        <header class="site-header">
            <button class="btn-back" onclick="history.back()" title="ย้อนกลับ">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>
            <h1 class="header-title">ร้านค้าของฉัน</h1>
            <div class="header-spacer"></div>
        </header>

        <div class="container">
            <div class="form-card">
                <%
                const errorParam = (typeof error !== 'undefined' && error) ? error : null;
                const successParam = (typeof success !== 'undefined' && success) ? success : null;
                const fd = (typeof formData !== 'undefined' && formData) ? formData : {};
                const shopRecord = (typeof shop !== 'undefined' && shop) ? shop : {};
                const successMsg = successParam === 'profile_updated' ? 'บันทึกข้อมูลร้านค้าสำเร็จ' : null;
                const errorMsg = {
                    'missing_fields': 'กรุณากรอกข้อมูลให้ครบถ้วน',
                    'upload_failed': 'อัปโหลดรูปภาพล้มเหลว กรุณาลองใหม่',
                    'db_error': 'เกิดข้อผิดพลาดในการบันทึกข้อมูล กรุณาลองใหม่'
                }[errorParam] || null;
                const currentShopName = fd.shopName || shopRecord.shopName || '';
                const currentProductType = fd.productType || shopRecord.productType || '';
                const currentProductDetail = fd.productDetail || shopRecord.productDetail || '';
                const currentShopSummary = fd.shopSummary || shopRecord.shopSummary || '';
                const currentShopTags = fd.shopTags || shopRecord.shopTags || '';
                const currentProductImages = shopRecord.productImages || [];
                const maxProductImagesCount = (typeof maxProductImages !== 'undefined' && maxProductImages) ? maxProductImages : 6;
                const currentMenuImages = shopRecord.menuImages || [];
                const maxMenuImagesCount = (typeof maxMenuImages !== 'undefined' && maxMenuImages) ? maxMenuImages : 4;
                %>

                <% if (successMsg) { %>
                <div class="form-alert form-alert--success">
                    <i class="fa-solid fa-check-circle"></i>
                    <span><%= successMsg %></span>
                </div>
                <% } %>

                <% if (errorMsg) { %>
                <div class="form-alert form-alert--danger">
                    <i class="fa-solid fa-exclamation-circle"></i>
                    <span><%= errorMsg %></span>
                </div>
                <% } %>

                <div class="shop-status-row">
                    <span class="tier-badge <%= shopRecord.isVerified ? 'tier-badge--primary' : 'tier-badge--neutral' %>">
                        <i class="bi bi-award-fill"></i> <%= shopRecord.sellerTier || 'General Seller' %>
                    </span>
                    <span class="zone-badge">
                        <i class="bi bi-geo-alt-fill"></i> <%= shopRecord.shopZoneLabel || 'ยังไม่ได้ระบุโซนร้าน' %>
                    </span>
                </div>
                <p class="text-muted small">ป้ายระดับร้านค้าและโซนร้านกำหนดโดยแอดมิน ผู้ขายแก้ไขไม่ได้</p>

                <div class="locked-field-row">
                    <div class="locked-field">
                        <label>ชื่อร้านค้า</label>
                        <p><%= currentShopName || 'ยังไม่ได้ตั้งชื่อร้าน' %></p>
                    </div>
                    <div class="locked-field">
                        <label>ประเภทสินค้า</label>
                        <p><%= currentProductType || 'ยังไม่ระบุ' %></p>
                    </div>
                </div>
                <p class="text-muted small">ชื่อร้านและประเภทสินค้ามาจากใบสมัครที่ผ่านการอนุมัติแล้ว แก้ไขไม่ได้ที่นี่
                    เพื่อให้ตรงกับข้อมูลที่แอดมินตรวจสอบไว้เสมอ — หากต้องการเปลี่ยน ติดต่อแอดมิน</p>

                <%
                // ความครบของโปรไฟล์ร้าน — นับจากข้อมูลที่บันทึกแล้วเท่านั้น (ไม่ใช่ค่าที่ค้างในฟอร์มตอน error)
                // ยิ่งครบ ลูกค้ายิ่งค้นเจอและรู้ว่าร้านขายอะไรในผังตลาด
                const profileSummary = locals.profile || { checks: [], done: 0 };
                const profileChecks = profileSummary.checks;
                const profileDone = profileSummary.done;
                %>
                <% if (locals.viewStats) {
                    const vs = locals.viewStats;
                    const maxDay = Math.max(1, ...vs.daily.map((d) => d.card));
                    const dayFmt = { weekday: 'short' };
                %>
                <section class="view-stats" aria-labelledby="viewStatsTitle">
                    <div class="pm-head">
                        <span class="pm-title" id="viewStatsTitle">คนดูร้านคุณในผังตลาด</span>
                        <span class="pm-score"><%= vs.days %> วันล่าสุด</span>
                    </div>
                    <div class="vs-tiles">
                        <div class="vs-tile"><span>เปิดดูร้าน</span><b><%= vs.totals.card %></b></div>
                        <div class="vs-tile"><span>ดูเมนู</span><b><%= vs.totals.menu %></b></div>
                        <div class="vs-tile"><span>แชร์ร้าน</span><b><%= vs.totals.share %></b></div>
                    </div>
                    <div class="vs-chart" role="img" aria-label="จำนวนครั้งที่เปิดดูร้านรายวัน <%= vs.daily.map((d) => d.date.toLocaleDateString('th-TH', dayFmt) + ' ' + d.card + ' ครั้ง').join(', ') %>">
                        <% vs.daily.forEach(function (d, i) { const isToday = i === vs.daily.length - 1; %>
                        <div class="vs-col" data-tip="<%= d.date.toLocaleDateString('th-TH', { day: 'numeric', month: 'short' }) %> · เปิดดู <%= d.card %> ครั้ง">
                            <div class="vs-bar-area"><div class="vs-bar" style="height: <%= Math.round((d.card / maxDay) * 100) %>%"></div></div>
                            <span class="vs-day<%= isToday ? ' is-today' : '' %>"><%= isToday ? 'วันนี้' : d.date.toLocaleDateString('th-TH', dayFmt) %></span>
                        </div>
                        <% }); %>
                    </div>
                    <% if (!vs.totals.card) { %>
                    <p class="vs-empty">ยังไม่มีคนเปิดดูร้านใน 7 วันนี้ — ใส่ป้ายเมนูกับรูปเมนูให้ครบ แล้วพิมพ์ป้าย QR ติดหน้าร้านจากผังตลาด ลูกค้าจะเจอร้านง่ายขึ้น</p>
                    <% } %>
                </section>
                <% } %>

                <div class="profile-meter">
                    <div class="pm-head">
                        <span class="pm-title">ความครบของร้านในผังตลาด</span>
                        <span class="pm-score"><b><%= profileDone %></b>/<%= profileChecks.length %></span>
                    </div>
                    <div class="pm-bar" aria-hidden="true">
                        <% profileChecks.forEach(function (c) { %><span class="<%= c.done ? 'on' : '' %>"></span><% }); %>
                    </div>
                    <% if (profileDone < profileChecks.length) { %>
                    <ul class="pm-list">
                        <% profileChecks.filter((c) => !c.done).forEach(function (c) { %>
                        <li><a href="#<%= c.id %>"><i class="fa-regular fa-square"></i> <%= c.label %></a> <small><%= c.why %></small></li>
                        <% }); %>
                    </ul>
                    <% } else { %>
                    <p class="pm-done"><i class="fa-solid fa-check"></i> ข้อมูลร้านครบแล้ว ลูกค้าค้นเจอและเห็นเมนูได้เต็มที่</p>
                    <% } %>
                </div>

                <form action="/shop-profile" method="POST" enctype="multipart/form-data">

                    <div class="form-section">
                        <div class="form-section-head">
                            <span class="form-section-title">แนะนำร้าน</span>
                            <span class="form-section-hint">แสดงบนผังตลาด/คอมมูนิตี้</span>
                        </div>

                        <div class="form-group full-width" id="field-tags">
                            <label>เมนูเด่น (คำค้นหา)</label>
                            <div class="tag-input-box" id="shopTagsBox">
                                <input type="text" id="shopTagsField" class="tag-input-field"
                                    placeholder="พิมพ์ชื่อเมนู แล้วกด Enter เช่น หมูปิ้งนมสด">
                            </div>
                            <input type="hidden" name="shopTags" id="shopTagsHidden" value="<%= currentShopTags %>">
                            <p class="field-hint">ใส่ชื่อเมนูที่ขายแบบเจาะจงไปเลย เช่น "หมูปิ้งนมสด" แทน
                                "หมูปิ้ง" เฉยๆ ลูกค้าจะค้นร้านในผังตลาดเจอง่ายขึ้น — พิมพ์เสร็จกด Enter หรือ , เพื่อเพิ่ม
                                แต่ละป้ายมีปุ่ม &times; กดเพื่อลบทิ้งได้เลย</p>
                        </div>

                        <div class="form-group full-width" id="field-summary">
                            <label>แนะนำร้านสั้น ๆ</label>
                            <textarea name="shopSummary" class="input-white" style="min-height: 70px;"
                                placeholder="แนะนำร้านสั้น ๆ ให้ลูกค้าเห็นบนหน้าคอมมูนิตี้/ผังตลาด"><%= currentShopSummary %></textarea>
                        </div>

                        <div class="form-group full-width" id="field-detail">
                            <label>รายละเอียดสินค้า</label>
                            <textarea name="productDetail" class="input-white"
                                placeholder="เพิ่มรายละเอียดสินค้าที่ขาย..."><%= currentProductDetail %></textarea>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="form-section-head">
                            <span class="form-section-title">รูปภาพร้าน</span>
                            <span class="form-section-hint">JPG / PNG</span>
                        </div>

                        <div class="form-group full-width" id="field-photos">
                            <label>รูปสินค้า/โลโก้ร้าน (สูงสุด <%= maxProductImagesCount %> รูป)</label>
                            <div class="upload-wrapper" id="productImagesWrapper">
                                <% currentProductImages.forEach(function (img) { %>
                                <div class="upload-thumb-item existing-thumb" data-image-id="<%= img.id %>">
                                    <img src="<%= img.imageUrl %>" alt="รูปสินค้า">
                                    <button type="button" class="upload-thumb-remove existing-remove-btn"
                                        data-image-id="<%= img.id %>" title="ลบรูปนี้">&times;</button>
                                </div>
                                <% }); %>
                                <label for="productImagesUpload" class="upload-box" id="productImagesUploadLabel"></label>
                            </div>
                            <input type="file" name="productImages" id="productImagesUpload"
                                class="upload-input" accept="image/*" multiple
                                data-max="<%= maxProductImagesCount %>" data-existing="<%= currentProductImages.length %>">
                            <input type="hidden" name="removeProductImageIds" id="removeProductImageIdsInput" value="">
                            <p class="field-hint">รูปแรกในแกลเลอรีจะใช้เป็นรูปย่อของร้านในผังตลาด/คอมมูนิตี้</p>
                        </div>

                        <div class="form-group full-width" id="field-menu">
                            <label>รูปเมนูร้าน (สูงสุด <%= maxMenuImagesCount %> รูป)</label>
                            <div class="upload-wrapper" id="menuImagesWrapper">
                                <% currentMenuImages.forEach(function (img) { %>
                                <div class="upload-thumb-item existing-thumb" data-image-id="<%= img.id %>">
                                    <img src="<%= img.imageUrl %>" alt="รูปเมนู">
                                    <button type="button" class="upload-thumb-remove existing-remove-btn"
                                        data-image-id="<%= img.id %>" title="ลบรูปนี้">&times;</button>
                                </div>
                                <% }); %>
                                <label for="menuImagesUpload" class="upload-box" id="menuImagesUploadLabel"></label>
                            </div>
                            <input type="file" name="menuImages" id="menuImagesUpload"
                                class="upload-input" accept="image/*" multiple
                                data-max="<%= maxMenuImagesCount %>" data-existing="<%= currentMenuImages.length %>">
                            <input type="hidden" name="removeMenuImageIds" id="removeMenuImageIdsInput" value="">
                            <p class="field-hint">ถ่ายป้ายเมนู/ใบราคาของร้านให้อ่านชื่อเมนูและราคาได้ชัด
                                ลูกค้ากดปุ่ม "ดูเมนูร้าน" ในผังตลาดเพื่อดูรูปนี้ได้เลย ไม่ต้องเดินไปถึงหน้าร้าน</p>
                        </div>

                        <div class="form-group full-width" id="field-cover">
                            <label>รูปหน้าปกร้าน</label>
                            <div class="upload-wrapper">
                                <div class="upload-box-frame upload-box-frame--cover<%= shopRecord.shopCoverImage ? ' has-image' : '' %>" id="shopCoverImageFrame">
                                    <label for="shopCoverImageUpload" class="upload-box upload-box--cover" id="shopCoverImageUploadLabel">
                                        <img id="shopCoverImagePreview"
                                            <% if (shopRecord.shopCoverImage) { %>src="<%= shopRecord.shopCoverImage %>"<% } %>
                                            style="<%= shopRecord.shopCoverImage ? 'display:block;' : '' %>"
                                            alt="รูปหน้าปกร้าน">
                                        <span class="cover-upload-placeholder">
                                            <i class="fa-solid fa-camera"></i>
                                            <span>อัปโหลดรูปหน้าปก</span>
                                        </span>
                                    </label>
                                    <button type="button" class="upload-thumb-remove" id="shopCoverImageRemoveBtn"
                                        style="<%= shopRecord.shopCoverImage ? '' : 'display:none;' %>" title="ลบรูป">&times;</button>
                                </div>
                                <input type="file" name="shopCoverImage" id="shopCoverImageUpload"
                                    class="upload-input" accept="image/*">
                                <input type="hidden" name="removeShopCoverImage" id="removeShopCoverImageFlag" value="">
                            </div>
                            <p class="field-hint">ไม่เลือกรูปใหม่ = ใช้รูปเดิมต่อ, กดปุ่ม &times; เพื่อลบรูปที่ไม่ต้องการ</p>
                        </div>
                    </div>

                    <button type="submit" class="submit-btn" id="submitBtn">บันทึกข้อมูลร้านค้า</button>
                </form>
            </div>

            <div class="form-card">
                <%
                const eligibleQuotationList = (typeof eligibleQuotations !== 'undefined' && Array.isArray(eligibleQuotations)) ? eligibleQuotations : [];
                const taxInvoiceProfileList = (typeof taxInvoiceProfiles !== 'undefined' && Array.isArray(taxInvoiceProfiles)) ? taxInvoiceProfiles : [];
                const taxInvoiceRequestList = (typeof taxInvoiceRequests !== 'undefined' && Array.isArray(taxInvoiceRequests)) ? taxInvoiceRequests : [];
                const taxSuccessMsg = successParam === 'tax_invoice_requested' ? 'ส่งคำขอใบกำกับภาษีเรียบร้อยแล้ว รอแอดมินดำเนินการ' : null;
                const taxErrorMsg = {
                    'missing_booking_requests': 'กรุณาเลือกใบเสนอราคาอย่างน้อย 1 ใบ',
                    'booking_request_not_eligible': 'ใบเสนอราคาที่เลือกไม่สามารถขอใบกำกับภาษีได้ (อาจถูกผูกกับคำขออื่นไปแล้ว)',
                    'missing_profile_data': 'กรุณาเลือกโปรไฟล์ผู้เสียภาษี หรือกรอกข้อมูลนามใหม่ให้ครบ',
                    'profile_not_found': 'ไม่พบโปรไฟล์ผู้เสียภาษีที่เลือก',
                    'invalid_tax_id': 'เลขประจำตัวผู้เสียภาษีต้องเป็นตัวเลข 13 หลัก',
                    'invalid_taxpayer_name': 'ชื่อที่จะขึ้นในใบกำกับภาษีต้องไม่ว่าง และยาวไม่เกิน 120 ตัวอักษร',
                    'invalid_address': 'ที่อยู่ต้องยาว 10–300 ตัวอักษร',
                    'invalid_phone': 'เบอร์โทรต้องเป็นตัวเลข 9–10 หลัก ขึ้นต้นด้วย 0',
                    'invalid_branch': 'สาขาต้องเป็น "สำนักงานใหญ่" หรือ "สาขาที่" ตามด้วยเลข 5 หลัก'
                }[errorParam] || null;
                %>

                <div class="section-title">ขอใบกำกับภาษี</div>

                <% if (taxSuccessMsg) { %>
                <div class="form-alert form-alert--success"><i class="fa-solid fa-check-circle"></i><span><%= taxSuccessMsg %></span></div>
                <% } %>
                <% if (taxErrorMsg) { %>
                <div class="form-alert form-alert--danger"><i class="fa-solid fa-exclamation-circle"></i><span><%= taxErrorMsg %></span></div>
                <% } %>

                <form action="/tax-invoice-requests" method="POST" id="taxInvoiceForm" novalidate>
                    <p class="text-muted small mb-2">1. เลือกใบเสนอราคาที่ต้องการออกใบกำกับภาษี</p>
                    <div class="quotation-pick-list">
                        <% if (!eligibleQuotationList.length) { %>
                        <div class="quotation-pick-empty">ไม่มีใบเสนอราคาที่ขอใบกำกับภาษีได้ในขณะนี้</div>
                        <% } %>
                        <% if (eligibleQuotationList.length > 1) { %>
                        <label class="quotation-pick-row quotation-pick-all">
                            <input type="checkbox" id="pickAllQuotations">
                            <span class="qn">เลือกทั้งหมด (<%= eligibleQuotationList.length %> ใบ)</span>
                        </label>
                        <% } %>
                        <% eligibleQuotationList.forEach(function(q) { %>
                        <label class="quotation-pick-row">
                            <input type="checkbox" name="bookingRequestIds" value="<%= q.id %>" data-amount="<%= Number(q.netTotal) || 0 %>">
                            <span class="qn">เลขที่ <%= q.quotationNumber %></span>
                            <span class="qa"><%= q.issuedDateLabel %> — <%= Number(q.netTotal).toLocaleString('th-TH', { minimumFractionDigits: 2 }) %> บาท</span>
                        </label>
                        <% }) %>
                    </div>
                    <div class="tax-pick-summary" id="quotationSummary" aria-live="polite">เลือกแล้ว 0 ใบ</div>
                    <div class="tax-field-msg is-error" id="quotationError" hidden>กรุณาเลือกใบเสนอราคาอย่างน้อย 1 ใบ</div>

                    <p class="text-muted small mb-2">2. ข้อมูลผู้เสียภาษี</p>
                    <div class="profile-toggle">
                        <button type="button" id="btnUseExisting">ใช้โปรไฟล์เดิม</button>
                        <button type="button" id="btnUseNew">ขอในนามใหม่</button>
                    </div>

                    <div id="existingProfileBlock" class="form-group full-width">
                        <label for="taxInvoiceProfileId">เลือกโปรไฟล์ผู้เสียภาษี</label>
                        <select name="taxInvoiceProfileId" class="input-white" id="taxInvoiceProfileId">
                            <option value="">-- เลือก --</option>
                            <% taxInvoiceProfileList.forEach(function(p) { %>
                            <option value="<%= p.id %>"
                                data-type="<%= p.taxpayerType %>"
                                data-name="<%= p.taxpayerName %>"
                                data-taxid="<%= p.taxId %>"
                                data-branch="<%= p.branch || '' %>"
                                data-address="<%= p.address %>"
                                data-phone="<%= p.phoneNumber || '' %>"><%= p.taxpayerName %> (<%= p.taxId %>)</option>
                            <% }) %>
                        </select>
                        <div class="tax-profile-preview" id="profilePreview" hidden></div>
                        <div class="tax-field-msg is-error" id="profileError" hidden>กรุณาเลือกโปรไฟล์ผู้เสียภาษี</div>
                        <% if (!taxInvoiceProfileList.length) { %>
                        <small style="color: var(--ink-soft); margin-top: 6px;">ยังไม่มีโปรไฟล์เดิม — กรุณาเลือก "ขอในนามใหม่"</small>
                        <% } %>
                    </div>

                    <div id="newProfileBlock" class="form-grid" style="display:none;">
                        <div class="form-group full-width tax-prefill-row">
                            <button type="button" class="tax-prefill-btn" id="btnPrefill"><i class="fa-solid fa-wand-magic-sparkles"></i> เติมจากข้อมูลร้านของฉัน</button>
                            <span class="tax-draft-note" id="draftNote" hidden><i class="fa-solid fa-floppy-disk"></i> บันทึกฉบับร่างในเครื่องนี้ให้อัตโนมัติ · <button type="button" id="btnClearDraft">ล้างฟอร์ม</button></span>
                        </div>
                        <div class="form-group">
                            <label for="taxpayerTypeInput">ประเภทผู้เสียภาษี</label>
                            <select name="taxpayerType" class="input-white" id="taxpayerTypeInput">
                                <option value="COMPANY">นิติบุคคล (บริษัท/ห้างหุ้นส่วน)</option>
                                <option value="INDIVIDUAL">บุคคลธรรมดา</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="taxIdInput" id="taxIdLabel">เลขประจำตัวผู้เสียภาษี (13 หลัก)</label>
                            <input type="text" name="taxId" id="taxIdInput" class="input-white tax-mono" placeholder="0-0000-00000-00-0"
                                inputmode="numeric" maxlength="17" autocomplete="off" aria-describedby="taxIdHint">
                            <div class="tax-field-msg" id="taxIdHint"></div>
                        </div>
                        <div class="form-group full-width">
                            <label for="taxpayerNameInput">ชื่อที่จะขึ้นในใบกำกับภาษี</label>
                            <input type="text" name="taxpayerName" id="taxpayerNameInput" class="input-white" placeholder="เช่น บริษัท ตัวอย่าง จำกัด"
                                maxlength="120" autocomplete="organization">
                            <div class="tax-field-msg"><span class="tax-counter" id="nameCounter">0/120</span><span id="nameHint"></span></div>
                        </div>
                        <div class="form-group" id="branchGroup">
                            <label for="branchKind">สาขา</label>
                            <div class="tax-branch-row">
                                <select id="branchKind" class="input-white">
                                    <option value="HQ">สำนักงานใหญ่</option>
                                    <option value="BRANCH">สาขาเลขที่</option>
                                </select>
                                <input type="text" id="branchNo" class="input-white tax-mono" placeholder="00001" inputmode="numeric" maxlength="5" autocomplete="off" hidden aria-label="เลขที่สาขา 5 หลัก">
                            </div>
                            <input type="hidden" name="branch" id="branchValue" value="สำนักงานใหญ่">
                            <div class="tax-field-msg" id="branchHint"></div>
                        </div>
                        <div class="form-group">
                            <label for="phoneInput">เบอร์โทร <span class="tax-optional">(ไม่บังคับ)</span></label>
                            <input type="tel" name="phoneNumber" id="phoneInput" class="input-white tax-mono" placeholder="081-234-5678"
                                inputmode="tel" maxlength="12" autocomplete="tel">
                            <div class="tax-field-msg" id="phoneHint"></div>
                        </div>
                        <div class="form-group full-width">
                            <label for="addressInput">ที่อยู่สำหรับออกใบกำกับภาษี</label>
                            <textarea name="address" id="addressInput" class="input-white" rows="3" maxlength="300"
                                placeholder="เลขที่ ถนน ตำบล/แขวง อำเภอ/เขต จังหวัด รหัสไปรษณีย์" autocomplete="street-address"></textarea>
                            <div class="tax-field-msg"><span class="tax-counter" id="addressCounter">0/300</span><span id="addressHint"></span></div>
                        </div>
                        <small style="color: var(--ink-soft); grid-column: 1 / -1;">แอดมินจะตรวจสอบและยืนยัน/แก้ไขข้อมูลนี้อีกครั้งก่อนออกใบกำกับภาษีจริง</small>
                    </div>

                    <div class="tax-form-error" id="formError" role="alert" hidden></div>
                    <button type="submit" class="btn-submit" id="taxSubmitBtn" style="margin-top: 18px;">ส่งคำขอใบกำกับภาษี</button>
                </form>

                <% if (taxInvoiceRequestList.length) { %>
                <p class="text-muted small mt-4 mb-2">คำขอใบกำกับภาษีของฉัน</p>
                <div class="request-list">
                    <% taxInvoiceRequestList.forEach(function(r) { %>
                    <div class="request-row">
                        <div class="request-row-main">
                            <span class="request-row-title"><%= r.taxpayerName %> <% if (r.documentNumber) { %>(เลขที่ <%= r.documentNumber %>)<% } %></span>
                            <span class="request-row-meta"><%= r.quotationCount %> ใบเสนอราคา — <%= Number(r.netTotal).toLocaleString('th-TH', { minimumFractionDigits: 2 }) %> บาท</span>
                        </div>
                        <span class="badge <%= r.status.toLowerCase() %>"><%= r.statusLabel %></span>
                        <% if (r.status === 'ISSUED') { %>
                        <a href="/tax-invoices/<%= r.id %>" class="link-view">ดูเอกสาร</a>
                        <% } %>
                    </div>
                    <% }) %>
                </div>
                <% } %>
            </div>
        </div>

        <script type="application/json" id="taxPrefillJson"><%- JSON.stringify(typeof taxPrefill !== 'undefined' ? taxPrefill : {}).replace(/</g, '\\u003c') %></script>
        <script src="/js/seller/taxInvoiceForm.js?v=20261008"></script>

        <script src="/js/seller/shopProfile.js?v=20261002-menu"></script>
    </body>
</html>
