<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Market Seller Center — แดชบอร์ดผู้ขาย</title>
  <link rel="icon" type="image/png" href="/img/Logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260711-5">
  <link rel="stylesheet" href="/stylesheets/seller/sellerindex.css">
</head>
<body>
<script src="/js/common/tabSession.js"></script>
  <%- include('../partials/navbar2') %>

  <main class="seller-dashboard-page">
    <div class="seller-dashboard-shell container-xxl">
      <header class="seller-dashboard-header">
        <div>
          <p class="seller-dashboard-header__eyebrow">Seller Center</p>
          <h1 class="seller-dashboard-header__title">แดชบอร์ดผู้ขาย</h1>
          <p class="seller-dashboard-header__subtitle">ภาพรวมร้านค้าและข้อมูลสำคัญของผู้ขายที่กำลังเข้าสู่ระบบ</p>
        </div>
        <div class="seller-dashboard-header__actions">
          <a href="/profile" class="btn btn-outline-primary"><i class="bi bi-person-lines-fill me-2"></i>แก้ไขโปรไฟล์</a>
        </div>
      </header>

      <section class="shop-hero mb-4">
        <div class="shop-cover">
          <div class="shop-cover__placeholder">
            <i class="bi bi-shop"></i>
          </div>
          <% if (dashboard.coverImage) { %>
            <img
              src="<%= dashboard.coverImage %>"
              alt=""
              class="shop-cover__img"
              onerror="this.remove()"
            >
          <% } %>
          <div class="shop-cover__overlay"></div>
          <div class="cover-badge"><i class="bi bi-geo-alt-fill"></i> <%= dashboard.zoneLabel %></div>
        </div>
        <div class="shop-hero-body">
          <div class="shop-logo">
            <span class="shop-logo__fallback"><%= dashboard.displayLetter %></span>
            <% if (dashboard.productImage) { %>
              <img
                src="<%= dashboard.productImage %>"
                alt="<%= dashboard.shopName %>"
                class="shop-logo__img"
                onerror="this.remove()"
              >
            <% } %>
          </div>

          <div class="shop-hero-row">
            <div class="shop-title-block">
              <h2>
                <%= dashboard.shopName %>
                <% if (dashboard.isVerified) { %>
                  <i class="bi bi-patch-check-fill verify-tick" title="ร้านค้ายืนยันตัวตนแล้ว"></i>
                <% } %>
              </h2>
              <p class="shop-desc"><%= dashboard.shopDescription %></p>
              <div class="shop-tags">
                <span class="tier-badge tier-badge--primary"><i class="bi bi-award-fill"></i> <%= dashboard.sellerTier %></span>
                <span class="tier-badge tier-badge--info"><i class="bi bi-grid-1x2-fill"></i> <%= dashboard.productType %></span>
                <% dashboard.tags.forEach(function(tag) { %>
                  <span class="badge-soft"><i class="bi bi-tag"></i> <%= tag %></span>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      </section>

      <% if (dashboard.latestAnnouncement) { %>
        <section class="announcement-banner mb-4">
          <div class="announcement-banner__icon"><i class="bi bi-megaphone-fill"></i></div>
          <div class="announcement-banner__body">
            <p class="announcement-banner__eyebrow">
              ประกาศล่าสุดสำหรับผู้ขาย · <%= dashboard.latestAnnouncement.category %> · <%= dashboard.latestAnnouncement.createdAt %>
            </p>
            <h3 class="announcement-banner__title"><%= dashboard.latestAnnouncement.title %></h3>
            <p class="announcement-banner__content"><%= dashboard.latestAnnouncement.content %></p>
          </div>
        </section>
      <% } %>

      <section class="mb-4">
        <article class="info-card">
          <div class="info-card__head">
            <h2>การดำเนินการด่วน</h2>
          </div>

          <div class="quick-action-grid">
            <a href="/select-zone" class="quick-action-card">
              <i class="bi bi-map"></i>
              <span>เลือกโซน</span>
            </a>
            <a href="/booking-status" class="quick-action-card">
              <i class="bi bi-journal-check"></i>
              <span>สถานะการจอง</span>
            </a>
            <a href="/repair" class="quick-action-card">
              <i class="bi bi-wrench-adjustable-circle"></i>
              <span>แจ้งซ่อม</span>
            </a>
          </div>

          <div class="quick-action-footer">
            <a href="/logout" class="logout-link-subtle" onclick="return confirm('ยืนยันออกจากระบบใช่หรือไม่?');">
              <i class="bi bi-box-arrow-right"></i>
              <span>ออกจากระบบ</span>
            </a>
          </div>
        </article>
      </section>

      <section class="row g-3 g-md-4 mb-4">
        <div class="col-6 col-xl-4">
          <article class="stat-card">
            <div class="stat-icon stat-icon--primary"><i class="bi bi-shop"></i></div>
            <h3 class="stat-value"><%= dashboard.activeBookingCount %></h3>
            <p class="stat-label">การจองที่กำลังดำเนินการ</p>
          </article>
        </div>
        <div class="col-6 col-xl-4">
          <article class="stat-card">
            <div class="stat-icon stat-icon--success"><i class="bi bi-cash-coin"></i></div>
            <h3 class="stat-value stat-value--text">
              <%= dashboard.latestBooking ? Number(dashboard.latestBooking.grandTotal || 0).toLocaleString('th-TH') + ' บาท' : '-' %>
            </h3>
            <p class="stat-label">ยอดชำระการจองล่าสุด</p>
          </article>
        </div>
        <div class="col-12 col-xl-4">
          <article class="stat-card">
            <div class="stat-icon <%= dashboard.isVerified ? 'stat-icon--success' : 'stat-icon--warning' %>">
              <i class="bi <%= dashboard.isVerified ? 'bi-patch-check-fill' : 'bi-hourglass-split' %>"></i>
            </div>
            <h3 class="stat-value stat-value--text"><%= dashboard.isVerified ? 'ยืนยันแล้ว' : 'รอตรวจสอบ' %></h3>
            <p class="stat-label">สถานะยืนยันตัวตนร้านค้า</p>
          </article>
        </div>
      </section>

      <section class="row g-4">
        <div class="col-lg-7">
          <article class="info-card h-100">
            <div class="info-card__head">
              <h2>ข้อมูลร้านค้าที่เชื่อมกับบัญชีปัจจุบัน</h2>
              <span class="status-pill <%= dashboard.isVerified ? 'status-pill--success' : 'status-pill--neutral' %>">
                <i class="bi <%= dashboard.isVerified ? 'bi-patch-check-fill' : 'bi-hourglass-split' %>"></i>
                <%= dashboard.isVerified ? 'ยืนยันแล้ว' : 'รอตรวจสอบ' %>
              </span>
            </div>

            <dl class="info-list">
              <div class="info-list__row">
                <dt>ชื่อร้าน</dt>
                <dd><%= dashboard.shopName %></dd>
              </div>
              <div class="info-list__row">
                <dt>รายละเอียดร้าน</dt>
                <dd><%= dashboard.shopDescription %></dd>
              </div>
              <div class="info-list__row">
                <dt>ประเภทสินค้า</dt>
                <dd><%= dashboard.productType %></dd>
              </div>
              <div class="info-list__row">
                <dt>โซนร้าน</dt>
                <dd><%= dashboard.zoneLabel %></dd>
              </div>
              <div class="info-list__row">
                <dt>แท็กของร้าน</dt>
                <dd>
                  <div class="tag-group">
                    <% if (dashboard.tags.length === 0) { %>
                      <span class="badge-soft">ยังไม่มีแท็ก</span>
                    <% } %>
                    <% dashboard.tags.forEach(function(tag) { %>
                      <span class="badge-soft"><i class="bi bi-tag"></i> <%= tag %></span>
                    <% }) %>
                  </div>
                </dd>
              </div>
            </dl>
          </article>
        </div>

        <div class="col-lg-5">
          <article class="info-card">
            <div class="info-card__head">
              <h2>ข้อมูลบัญชีผู้ขาย</h2>
            </div>

            <dl class="info-list info-list--compact">
              <div class="info-list__row">
                <dt>ชื่อผู้ใช้งาน</dt>
                <dd><%= user.username %></dd>
              </div>
              <div class="info-list__row">
                <dt>ชื่อผู้ขาย</dt>
                <dd><%= user.name %></dd>
              </div>
              <div class="info-list__row">
                <dt>อีเมล</dt>
                <dd><%= dashboard.email %></dd>
              </div>
              <div class="info-list__row">
                <dt>สมัครเมื่อ</dt>
                <dd><%= dashboard.memberSince ? new Date(dashboard.memberSince).toLocaleDateString('th-TH') : '-' %></dd>
              </div>
            </dl>
          </article>
        </div>
      </section>

      <section class="row g-4 mt-1">
        <div class="col-lg-8">
          <article class="booking-card">
            <div class="info-card__head">
              <h2>การจองล่าสุด</h2>
              <% if (dashboard.latestBooking) { %>
                <span class="status-pill <%= dashboard.latestBooking.statusClass %>">
                  <i class="bi bi-record-circle-fill"></i> <%= dashboard.latestBooking.statusText %>
                </span>
              <% } %>
            </div>

            <% if (dashboard.latestBooking && dashboard.latestBooking.slot) { %>
              <div class="booking-card__content">
                <div>
                  <p class="booking-card__eyebrow">แผงล่าสุด</p>
                  <h3 class="booking-card__title"><%= dashboard.latestBooking.slot.slotNumber %></h3>
                  <p class="booking-card__sub">จองเมื่อ <%= dashboard.latestBooking.createdAt %></p>
                </div>
                <div class="booking-card__meta">
                  <div>
                    <span class="booking-card__label">โซน</span>
                    <strong><%= dashboard.latestBooking.selectedZoneLabel || dashboard.latestBooking.slot.zone %></strong>
                  </div>
                  <div>
                    <span class="booking-card__label">จำนวนแผง</span>
                    <strong><%= dashboard.latestBooking.stallCount %> แผง</strong>
                  </div>
                  <% if (dashboard.latestBooking.rentalStartDate) { %>
                    <div>
                      <span class="booking-card__label">ระยะเวลาเช่า</span>
                      <strong><%= dashboard.latestBooking.rentalStartDate %> - <%= dashboard.latestBooking.rentalEndDate %></strong>
                    </div>
                  <% } %>
                  <div>
                    <span class="booking-card__label">ไฟฟ้า/เครื่องใช้ไฟฟ้า</span>
                    <strong>
                      <%= dashboard.latestBooking.lightEnabled ? 'มีไฟส่องสว่าง' : 'ไม่มีไฟส่องสว่าง' %>
                      <% if ((dashboard.latestBooking.smallApplianceCount || 0) + (dashboard.latestBooking.largeApplianceCount || 0) > 0) { %>
                        · เครื่องใช้ไฟฟ้า <%= (dashboard.latestBooking.smallApplianceCount || 0) + (dashboard.latestBooking.largeApplianceCount || 0) %> ชิ้น
                      <% } %>
                    </strong>
                  </div>
                  <div>
                    <span class="booking-card__label">ยอดชำระรวม</span>
                    <strong><%= Number(dashboard.latestBooking.grandTotal || dashboard.latestBooking.slot.price || 0).toLocaleString('th-TH') %> บาท</strong>
                  </div>
                </div>
              </div>
            <% } else { %>
              <p class="empty-state">
                <i class="bi bi-inbox"></i>
                ยังไม่มีประวัติการจองแผงในระบบ
                <a href="/select-zone" class="empty-state__cta">เริ่มจองแผงเลย</a>
              </p>
            <% } %>
          </article>
        </div>

        <div class="col-lg-4">
          <article class="repair-card h-100">
            <div class="info-card__head">
              <h2>แจ้งซ่อมล่าสุด</h2>
              <% if (dashboard.latestRepairReport) { %>
                <span class="status-pill <%= dashboard.latestRepairReport.statusClass %>">
                  <i class="bi bi-record-circle-fill"></i> <%= dashboard.latestRepairReport.statusText %>
                </span>
              <% } %>
            </div>

            <% if (dashboard.latestRepairReport) { %>
              <p class="repair-card__category"><i class="bi bi-tools"></i> <%= dashboard.latestRepairReport.category %></p>
              <p class="repair-card__desc"><%= dashboard.latestRepairReport.description %></p>
              <div class="repair-card__meta">
                <span><i class="bi bi-geo-alt"></i> <%= dashboard.latestRepairReport.location %></span>
                <span><i class="bi bi-calendar3"></i> <%= dashboard.latestRepairReport.createdAt %></span>
              </div>
              <a href="/repair" class="repair-card__link">ดูรายการแจ้งซ่อมทั้งหมด <i class="bi bi-arrow-right"></i></a>
            <% } else { %>
              <p class="empty-state">
                <i class="bi bi-check2-circle"></i>
                ยังไม่มีการแจ้งซ่อม
                <a href="/repair" class="empty-state__cta">แจ้งซ่อมตอนนี้</a>
              </p>
            <% } %>
          </article>
        </div>
      </section>
    </div>
  </main>
</body>
</html>