<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Market Seller Center — แดชบอร์ดผู้ขาย</title>
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260826-7">
  <link rel="stylesheet" href="/stylesheets/seller/sellerindex.css?v=20260823-2">
</head>
<body>
<script src="/js/common/tabSession.js"></script>
  <%- include('../partials/navbarSeller') %>

  <%
    // เลือกโทนสี/ข้อความ/ปุ่ม CTA ของแถบสถานะบนสุดตามสถานะการจองล่าสุด
    // (จุดที่สำคัญที่สุดของแดชบอร์ด — ผู้ขายต้องรู้ทันทีว่าต้องทำอะไรต่อ)
    let statusTone = 'neutral';
    let statusIcon = 'bi-info-circle-fill';
    let statusTitle = 'ยังไม่มีการจองแผงในระบบ';
    let statusDesc = 'เลือกโซนและแผงที่ต้องการ เพื่อเริ่มขายในตลาดกังสดาลไนท์';
    let statusCtaHref = '/select-zone';
    let statusCtaLabel = 'เลือกโซน';

    if (dashboard.latestBooking) {
      const lb = dashboard.latestBooking;
      if (lb.status === 'PENDING') {
        statusTone = 'neutral'; statusIcon = 'bi-hourglass-split';
        statusTitle = 'รอการตรวจสอบร้านค้า';
        statusDesc = 'แอดมินกำลังตรวจสอบคำขอจองของคุณ ระบบจะแจ้งผลเมื่อดำเนินการเสร็จ';
        statusCtaHref = '/booking-status'; statusCtaLabel = 'ดูสถานะการจอง';
      } else if (lb.status === 'APPROVED') {
        statusTone = 'neutral'; statusIcon = 'bi-check-circle';
        statusTitle = 'ร้านผ่านการตรวจสอบแล้ว';
        statusDesc = 'รอแอดมินจัดสรรล็อกให้ ระบบจะแจ้งเตือนเมื่อได้รับล็อก';
        statusCtaHref = '/booking-status'; statusCtaLabel = 'ดูสถานะการจอง';
      } else if (lb.status === 'IN_PROGRESS') {
        statusTone = 'warning'; statusIcon = 'bi-exclamation-triangle-fill';
        statusTitle = 'ได้รับล็อกแล้ว กรุณาชำระเงิน';
        statusDesc = 'อัปโหลดสลิปโอนเงินเพื่อยืนยันการจอง มิฉะนั้นล็อกอาจถูกปล่อยให้ผู้ขายรายอื่น';
        statusCtaHref = '/booking-status'; statusCtaLabel = 'ชำระเงินตอนนี้';
      } else if (lb.status === 'SUCCESS') {
        statusTone = 'success'; statusIcon = 'bi-patch-check-fill';
        statusTitle = lb.slot ? `ชำระเงินสำเร็จ · ล็อก ${lb.slot.slotNumber} เป็นของร้านคุณ` : 'ชำระเงินสำเร็จ เสร็จสิ้นการจอง';
        statusDesc = 'ยืนยันเรียบร้อยแล้ว พร้อมขายได้ตามวันที่จองไว้';
        statusCtaHref = '/booking-status'; statusCtaLabel = 'ดูรายละเอียดการจอง';
      } else if (lb.status === 'REJECTED') {
        statusTone = 'danger'; statusIcon = 'bi-x-circle-fill';
        statusTitle = 'คำขอจองไม่ผ่านการตรวจสอบ';
        statusDesc = 'ติดต่อแอดมินเพื่อสอบถามรายละเอียด หรือส่งคำขอจองใหม่อีกครั้ง';
        statusCtaHref = '/select-zone'; statusCtaLabel = 'ส่งคำขอใหม่';
      }
    }
  %>

  <main class="seller-dashboard-page">
    <div class="seller-dashboard-shell container-xxl">
      <header class="seller-dashboard-header">
        <div>
          <p class="seller-dashboard-header__eyebrow">Seller Center</p>
          <h1 class="seller-dashboard-header__title">แดชบอร์ดผู้ขาย</h1>
        </div>
        <div class="seller-dashboard-header__actions">
          <a href="/shop-profile" class="btn btn-outline-primary"><i class="bi bi-person-lines-fill me-2"></i>แก้ไขโปรไฟล์</a>
        </div>
      </header>

      <section class="status-alert status-alert--<%= statusTone %> mb-3">
        <div class="status-alert__icon"><i class="bi <%= statusIcon %>"></i></div>
        <div class="status-alert__body">
          <h3><%= statusTitle %></h3>
          <p><%= statusDesc %></p>
        </div>
        <a href="<%= statusCtaHref %>" class="status-alert__cta"><%= statusCtaLabel %> <i class="bi bi-arrow-right"></i></a>
      </section>

      <% if (typeof bookingRound !== 'undefined' && bookingRound) { %>
        <section class="round-strip mb-4">
          <i class="bi bi-calendar-range"></i>
          <span>รอบที่ <%= bookingRound.roundNumber %> · <%= bookingRound.cycleStart %> - <%= bookingRound.cycleEnd %> · <b><%= bookingRound.status %></b></span>
          <span class="round-strip__sep"></span>
          <span>รอบถัดไป: รอบที่ <%= bookingRound.nextRoundNumber %> เปิดจอง <%= bookingRound.nextOpenAt %></span>
        </section>
      <% } %>

      <section class="identity-bar mb-4">
        <div class="identity-bar__logo">
          <span class="identity-bar__fallback"><%= dashboard.displayLetter %></span>
          <% if (dashboard.productImage) { %>
            <img src="<%= dashboard.productImage %>" alt="<%= dashboard.shopName %>" onerror="this.remove()">
          <% } %>
        </div>
        <div class="identity-bar__body">
          <h2>
            <%= dashboard.shopName %>
            <% if (dashboard.isVerified) { %>
              <i class="bi bi-patch-check-fill verify-tick" title="ร้านค้ายืนยันตัวตนแล้ว"></i>
            <% } %>
          </h2>
          <div class="identity-bar__tags">
            <span class="tier-badge tier-badge--info"><i class="bi bi-grid-1x2-fill"></i> <%= dashboard.productType %></span>
            <span class="tier-badge tier-badge--primary"><i class="bi bi-geo-alt-fill"></i> <%= dashboard.zoneLabel %></span>
            <span class="status-pill <%= dashboard.isVerified ? 'status-pill--success' : 'status-pill--neutral' %>">
              <i class="bi <%= dashboard.isVerified ? 'bi-patch-check-fill' : 'bi-hourglass-split' %>"></i>
              <%= dashboard.isVerified ? 'ยืนยันตัวตนแล้ว' : 'รอตรวจสอบตัวตน' %>
            </span>
          </div>
        </div>
        <div class="identity-bar__stat">
          <strong><%= dashboard.activeBookingCount %></strong>
          <span>การจองที่กำลังดำเนินการ</span>
        </div>
      </section>

      <section class="mb-4">
        <article class="info-card">
          <div class="info-card__head">
            <h2>การดำเนินการด่วน</h2>
          </div>

          <div class="quick-action-grid">
            <a href="/select-zone" class="quick-action-card">
              <i class="bi bi-map"></i>
              <span>เลือกโซน</span>
            </a>
            <a href="/booking-status" class="quick-action-card">
              <i class="bi bi-journal-check"></i>
              <span>สถานะการจอง</span>
            </a>
            <a href="/booking-history" class="quick-action-card">
              <i class="bi bi-clock-history"></i>
              <span>ประวัติการจอง</span>
            </a>
            <a href="/repair" class="quick-action-card">
              <i class="bi bi-wrench-adjustable-circle"></i>
              <span>แจ้งซ่อม</span>
            </a>
          </div>

          <div class="quick-action-footer">
            <a href="/logout" class="logout-link-subtle" data-confirm-logout>
              <i class="bi bi-box-arrow-right"></i>
              <span>ออกจากระบบ</span>
            </a>
          </div>
        </article>
      </section>

      <section class="row g-4">
        <div class="col-lg-8">
          <article class="booking-card">
            <div class="info-card__head">
              <h2>รายละเอียดการจองล่าสุด</h2>
              <% if (dashboard.latestBooking) { %>
                <span class="status-pill <%= dashboard.latestBooking.statusClass %>">
                  <i class="bi bi-record-circle-fill"></i> <%= dashboard.latestBooking.statusText %>
                </span>
              <% } %>
            </div>

            <% if (dashboard.latestBooking) { %>
              <% const lb = dashboard.latestBooking; %>
              <div class="booking-card__content">
                <div>
                  <p class="booking-card__eyebrow"><%= lb.slot ? 'แผงของคุณ' : 'โซนที่จอง' %></p>
                  <h3 class="booking-card__title"><%= lb.slot ? lb.slot.slotNumber : (lb.selectedZoneLabel || (lb.zoneCode ? `โซน ${lb.zoneCode}` : '-')) %></h3>
                  <p class="booking-card__sub">จองเมื่อ <%= lb.createdAt %></p>
                </div>
                <div class="booking-card__meta">
                  <div>
                    <span class="booking-card__label">โซน</span>
                    <strong><%= lb.selectedZoneLabel || (lb.zoneCode ? `โซน ${lb.zoneCode}` : '-') %></strong>
                  </div>
                  <div>
                    <span class="booking-card__label">จำนวนแผง</span>
                    <strong><%= lb.stallCount %> แผง</strong>
                  </div>
                  <% if (lb.rentalStartDate) { %>
                    <div>
                      <span class="booking-card__label">ระยะเวลาเช่า</span>
                      <strong><%= lb.rentalStartDate %> - <%= lb.rentalEndDate %></strong>
                    </div>
                  <% } %>
                  <div>
                    <span class="booking-card__label">ไฟฟ้า/เครื่องใช้ไฟฟ้า</span>
                    <strong>
                      <%= lb.lightEnabled ? 'มีไฟส่องสว่าง' : 'ไม่มีไฟส่องสว่าง' %>
                      <% if ((lb.smallApplianceCount || 0) + (lb.largeApplianceCount || 0) > 0) { %>
                        · เครื่องใช้ไฟฟ้า <%= (lb.smallApplianceCount || 0) + (lb.largeApplianceCount || 0) %> ชิ้น
                      <% } %>
                    </strong>
                  </div>
                  <div>
                    <span class="booking-card__label">ยอดชำระรวม</span>
                    <strong><%= Number(lb.grandTotal || 0).toLocaleString('th-TH') %> บาท</strong>
                  </div>
                </div>
              </div>
            <% } else { %>
              <p class="empty-state">
                <i class="bi bi-inbox"></i>
                ยังไม่มีประวัติการจองแผงในระบบ
                <a href="/select-zone" class="empty-state__cta">เริ่มจองแผงเลย</a>
              </p>
            <% } %>
          </article>
        </div>

        <div class="col-lg-4 d-flex flex-column gap-4">
          <% if (dashboard.latestAnnouncement) { %>
            <article class="announcement-banner">
              <div class="announcement-banner__icon"><i class="bi bi-megaphone-fill"></i></div>
              <div class="announcement-banner__body">
                <p class="announcement-banner__eyebrow">
                  ประกาศล่าสุด · <%= dashboard.latestAnnouncement.category %> · <%= dashboard.latestAnnouncement.createdAt %>
                </p>
                <h3 class="announcement-banner__title"><%= dashboard.latestAnnouncement.title %></h3>
                <p class="announcement-banner__content"><%= dashboard.latestAnnouncement.content %></p>
              </div>
            </article>
          <% } %>

          <article class="repair-card flex-fill">
            <div class="info-card__head">
              <h2>แจ้งซ่อมล่าสุด</h2>
              <% if (dashboard.latestRepairReport) { %>
                <span class="status-pill <%= dashboard.latestRepairReport.statusClass %>">
                  <i class="bi bi-record-circle-fill"></i> <%= dashboard.latestRepairReport.statusText %>
                </span>
              <% } %>
            </div>

            <% if (dashboard.latestRepairReport) { %>
              <p class="repair-card__category"><i class="bi bi-tools"></i> <%= dashboard.latestRepairReport.category %></p>
              <p class="repair-card__desc"><%= dashboard.latestRepairReport.description %></p>
              <div class="repair-card__meta">
                <span><i class="bi bi-geo-alt"></i> <%= dashboard.latestRepairReport.location %></span>
                <span><i class="bi bi-calendar3"></i> <%= dashboard.latestRepairReport.createdAt %></span>
              </div>
              <a href="/repair" class="repair-card__link">ดูรายการแจ้งซ่อมทั้งหมด <i class="bi bi-arrow-right"></i></a>
            <% } else { %>
              <p class="empty-state">
                <i class="bi bi-check2-circle"></i>
                ยังไม่มีการแจ้งซ่อม
                <a href="/repair" class="empty-state__cta">แจ้งซ่อมตอนนี้</a>
              </p>
            <% } %>
          </article>
        </div>
      </section>
    </div>
  </main>
  <script src="/js/common/dialogs.js"></script>
  <script>
    document.querySelectorAll('[data-confirm-logout]').forEach(function (link) {
      link.addEventListener('click', function (event) {
        event.preventDefault();
        window.showConfirmDialog({
          title: 'ยืนยันออกจากระบบ',
          message: 'ต้องการออกจากระบบใช่หรือไม่?',
          tone: 'danger',
          confirmText: 'ออกจากระบบ',
          onConfirm: function () { window.location.href = link.href; }
        });
      });
    });
  </script>
</body>
</html>
