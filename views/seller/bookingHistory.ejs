<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ประวัติการจอง — Seller Center</title>
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260724-6">
  <link rel="stylesheet" href="/stylesheets/seller/sellerindex.css">
  <link rel="stylesheet" href="/stylesheets/seller/bookingHistory.css">
</head>
<body>
<script src="/js/common/tabSession.js"></script>
  <%- include('../partials/navbarSeller') %>

  <main class="seller-dashboard-page">
    <div class="seller-dashboard-shell container-xxl">
      <header class="seller-dashboard-header">
        <div>
          <p class="seller-dashboard-header__eyebrow">Seller Center</p>
          <h1 class="seller-dashboard-header__title">ประวัติการจอง</h1>
          <p class="seller-dashboard-header__subtitle">รายการจองแผงทั้งหมดของร้านค้าคุณ ทุกรอบ ตั้งแต่เริ่มใช้งานระบบ</p>
        </div>
        <div class="seller-dashboard-header__actions">
          <a href="/seller" class="btn btn-outline-primary"><i class="bi bi-arrow-left me-2"></i>กลับหน้าหลัก</a>
        </div>
      </header>

      <article class="info-card">
        <div class="info-card__head">
          <h2>รายการจองทั้งหมด</h2>
          <span class="status-pill status-pill--neutral"><i class="bi bi-list-ol"></i> <%= bookings.length %> รายการ</span>
        </div>

        <% if (bookings.length === 0) { %>
          <p class="empty-state">
            <i class="bi bi-inbox"></i>
            ยังไม่มีประวัติการจองแผงในระบบ
            <a href="/select-zone" class="empty-state__cta">เริ่มจองแผงเลย</a>
          </p>
        <% } else { %>
          <div class="history-table-wrap">
            <table class="history-table">
              <thead>
                <tr>
                  <th>รอบที่</th>
                  <th>โซน / แผง</th>
                  <th>ระยะเวลาเช่า</th>
                  <th>จำนวนแผง</th>
                  <th>ยอดชำระรวม</th>
                  <th>สถานะ</th>
                  <th>วันที่ทำรายการ</th>
                </tr>
              </thead>
              <tbody>
                <% bookings.forEach(function(b) { %>
                  <tr>
                    <td><%= b.roundNumber ? ('รอบที่ ' + b.roundNumber) : '-' %></td>
                    <td>
                      <%= b.zoneLabel %>
                      <% if (b.slotLabel) { %><br><small class="text-muted"><%= b.slotLabel %></small><% } %>
                    </td>
                    <td><%= b.rentalStartDate %> - <%= b.rentalEndDate %></td>
                    <td><%= b.stallCount %> แผง</td>
                    <td><%= b.grandTotal.toLocaleString('th-TH') %> บาท</td>
                    <td>
                      <span class="status-pill <%= b.statusClass %>">
                        <i class="bi bi-record-circle-fill"></i> <%= b.statusText %>
                      </span>
                    </td>
                    <td><%= b.createdAt %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </article>
    </div>
  </main>
</body>
</html>
