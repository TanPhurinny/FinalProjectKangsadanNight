<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>แจ้งซ่อม - กังสดาลไนท์</title>

        <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&family=Noto+Sans+Thai:wght@300;400;500;600;700&family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/partials/navbar.css">
  <link rel="stylesheet" href="/stylesheets/seller/repair.css">
    </head>

    <body>
  <%- include('../partials/navbar2') %>

        <header class="site-header">
            <button class="btn-back" onclick="history.back()" title="ย้อนกลับ">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>
            <h1 class="header-title">แจ้งซ่อม</h1>
            <div class="header-spacer"></div>
        </header>

        <div class="container">
            <div class="form-card">
                <%
                const errorParam = (typeof error !== 'undefined' && error) ?
                error : null;
                const successParam = (typeof success !== 'undefined' && success)
                ? success : null;
                const successMsg = successParam ? 'แจ้งซ่อมสำเร็จแล้ว!' : null;
                const errorMsg = {
                'missing_fields': 'กรุณากรอกข้อมูลให้ครบถ้วน',
                'upload_failed': 'อัปโหลดรูปภาพล้มเหลว กรุณาลองใหม่',
                'db_error': 'เกิดข้อผิดพลาดในการบันทึกข้อมูล กรุณาลองใหม่'
                }[errorParam] || null;
                %>

                <% if (successMsg) { %>
                <div
                    style="background-color: #d4edda; border: 1px solid #c3e6cb; color: #155724; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                    <i class="fa-solid fa-check-circle"
                        style="font-size: 18px;"></i>
                    <span><%= successMsg %></span>
                </div>
                <% } %>

                <% if (errorMsg) { %>
                <div
                    style="background-color: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                    <i class="fa-solid fa-exclamation-circle"
                        style="font-size: 18px;"></i>
                    <span><%= errorMsg %></span>
                </div>
                <% } %>

                <form action="/repair" method="POST"
                    enctype="multipart/form-data">

                    <div class="form-grid">
                        <div class="form-group">
                            <label>ชื่อ - นามสกุล</label>
                            <input type="text" name="name" class="input-blue"
                                value="<%= user ? user.name : '' %>" readonly>
                        </div>

                        <div class="form-group">
                            <label>เบอร์โทรศัพท์</label>
                            <input type="tel" name="phone" class="input-blue"
                                value="<%= user ? user.phoneNumber : '' %>"
                                readonly>
                        </div>

                        <div class="form-group">
                            <label>แผงที่ต้องการซ่อม</label>
                            <input type="text" name="location"
                                class="input-white"
                                placeholder="เช่น A105, โซน F" required>
                        </div>

                        <div class="form-group">
                            <label>ประเภทปัญหา</label>
                            <select name="category" class="input-white"
                                required>
                                <option value disabled
                                    selected>เลือกประเภท...</option>
                                <option value="ไฟฟ้า">ไฟฟ้า (หลอดไฟขาด,
                                    ปลั๊กพัง)</option>
                                <option value="โครงสร้าง">โครงสร้าง (หลังคารั่ว,
                                    พื้นทรุด)</option>
                                <option value="อื่นๆ">อื่นๆ</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label>รายละเอียด</label>
                        <textarea name="description" class="input-white"
                            placeholder="เพิ่มรายละเอียด..."
                            required></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label>แนบรูปภาพเพิ่มเติม</label>
                        <div class="upload-wrapper">
                            <label for="imageUpload" class="upload-box"
                                id="uploadLabel">
                                <img id="imagePreview" src alt="Preview">
                            </label>
                            <input type="file" name="image" id="imageUpload"
                                class="upload-input" accept="image/*">
                        </div>
                    </div>

                    <button type="submit"
                        class="submit-btn"
                        id="submitBtn">ยืนยันการแจ้งซ่อม</button>

                </form>

                <% if (successMsg) { %>
                <script>
                    // รีเซ็ตฟอร์มเมื่อสำเร็จ
                    document.querySelector('form').reset();
                    document.getElementById('imagePreview').style.display = 'none';
                </script>
                <% } %>
            </div>

            <div class="history-section">
                <h3 class="history-title">ประวัติการแจ้งซ่อมของคุณ</h3>

                <% const statusLabel = {
                    PENDING: 'รอดำเนินการ',
                    IN_PROGRESS: 'กำลังดำเนินการ',
                    APPROVED: 'อนุมัติแล้ว',
                    SUCCESS: 'ซ่อมเสร็จแล้ว',
                    REJECTED: 'ถูกปฏิเสธ'
                }; %>

                <% if (typeof reports !== 'undefined' && reports.length > 0) { %>
                <div class="history-list">
                    <% reports.forEach(function(report) { %>
                    <div class="history-item" onclick="openDetailModal(this)"
                        data-image="<%= report.image || '' %>"
                        data-location="<%= report.location %>"
                        data-category="<%= report.category %>"
                        data-description="<%= report.description %>"
                        data-status="<%= report.status %>"
                        data-status-label="<%= statusLabel[report.status] || report.status %>"
                        data-date="<%= new Date(report.createdAt).toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %>">
                        <% if (report.image) { %>
                        <img class="history-thumb" src="<%= report.image %>"
                            alt="รูปแจ้งซ่อม"
                            onclick="event.stopPropagation(); openLightbox('<%= report.image %>')">
                        <% } else { %>
                        <div class="history-thumb-empty"><i
                                class="fa-solid fa-image"></i></div>
                        <% } %>
                        <div class="history-info">
                            <div class="location"><%= report.location %> —
                                <%= report.category %>
                            </div>
                            <div class="meta desc"><%= report.description %></div>
                            <div class="meta"><%= new
                                Date(report.createdAt).toLocaleDateString('th-TH',
                                { year: 'numeric', month: 'short', day:
                                'numeric' }) %></div>
                            <span
                                class="status-badge status-<%= report.status %>"><%=
                                statusLabel[report.status] || report.status %></span>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <% } else { %>
                <p class="empty-history">คุณยังไม่เคยแจ้งซ่อม</p>
                <% } %>
            </div>
        </div>

        <div class="lightbox-overlay" id="lightboxOverlay"
            onclick="closeLightbox()">
            <button class="lightbox-close" onclick="closeLightbox(event)">&times;</button>
            <img id="lightboxImage" src alt="รูปแจ้งซ่อมขนาดเต็ม">
        </div>

        <div class="detail-overlay" id="detailOverlay"
            onclick="closeDetailModal(event)">
            <div class="detail-card" onclick="event.stopPropagation()">
                <button class="detail-close"
                    onclick="closeDetailModal(event)">&times;</button>

                <img id="detailImage" class="detail-image" src
                    alt="รูปแจ้งซ่อม" style="display: none;"
                    onclick="openLightbox(this.src)">
                <div id="detailImageEmpty" class="detail-image-empty"
                    style="display: none;"><i
                        class="fa-solid fa-image"></i></div>

                <div class="detail-row">
                    <div class="detail-label">แผงที่แจ้งซ่อม</div>
                    <div class="detail-value" id="detailLocation"></div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">ประเภทปัญหา</div>
                    <div class="detail-value" id="detailCategory"></div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">รายละเอียด</div>
                    <div class="detail-value" id="detailDescription"></div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">วันที่แจ้ง</div>
                    <div class="detail-value" id="detailDate"></div>
                </div>
                <div class="detail-row" style="margin-bottom: 0;">
                    <div class="detail-label">สถานะ</div>
                    <span class="status-badge" id="detailStatus"></span>
                </div>
            </div>
        </div>

        <script src="/js/seller/repair.js"></script>
    </body>
</html>