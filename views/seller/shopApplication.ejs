<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>สมัครเปิดร้านค้า - กังสดาลไนท์</title>
        <link rel="icon" type="image/png" href="/img/favicon.png">

        <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20261023-ios">
  <link rel="stylesheet" href="/stylesheets/seller/repair.css">
  <link rel="stylesheet" href="/stylesheets/seller/shopApplication.css?v=20261023-logo">
    </head>

    <body>
        <script src="/js/common/tabSession.js"></script>
  <% if (user && user.role === 'SELLER' && !viewAsCustomer) { %>
  <%- include('../partials/navbarSeller') %>
  <% } else { %>
  <%- include('../partials/navbarCustomer') %>
  <% } %>

        <header class="site-header">
            <button class="btn-back" onclick="history.back()" title="ย้อนกลับ">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>
            <h1 class="header-title">สมัครเปิดร้านค้า</h1>
            <div class="header-spacer"></div>
        </header>

        <div class="container">
            <div class="form-card">
                <%
                const errorParam = (typeof error !== 'undefined' && error) ? error : null;
                const successParam = (typeof success !== 'undefined' && success) ? success : null;
                const fd = (typeof formData !== 'undefined' && formData) ? formData : {};
                const termsAlreadyAccepted = fd.termsAccepted === 'true';
                const successMsg = successParam === 'application_submitted' ? 'ส่งใบสมัครเปิดร้านค้าสำเร็จ กรุณารอแอดมินตรวจสอบ' : null;
                // ผู้ขายที่มีร้านแล้วสมัครเปิดร้านเพิ่ม (/shop-application?new=1) — 1 ผู้ใช้มีได้หลายร้าน
                const isNewShopMode = typeof newShopMode !== 'undefined' && newShopMode;
                const errorMsg = {
                    'not_customer': 'บัญชีนี้สมัครเปิดร้านค้าไม่ได้',
                    'missing_fields': 'กรุณากรอกข้อมูลให้ครบถ้วน',
                    'upload_failed': 'อัปโหลดรูปภาพล้มเหลว กรุณาลองใหม่',
                    'already_pending': 'คุณมีใบสมัครที่รอตรวจสอบอยู่แล้ว',
                    'db_error': 'เกิดข้อผิดพลาดในการบันทึกข้อมูล กรุณาลองใหม่',
                    'not_applied': 'กรุณาสมัครเปิดร้านค้าให้เสร็จก่อน ถึงจะเลือกโซน/ล็อกได้',
                    'sellers_only': 'หน้านั้นสำหรับผู้ขายเท่านั้น กรุณาสมัครเปิดร้านค้าก่อน'
                }[errorParam] || null;
                %>

                <% if (successMsg) { %>
                <div class="form-alert form-alert--success">
                    <i class="fa-solid fa-check-circle"></i>
                    <span><%= successMsg %></span>
                </div>
                <% } %>

                <% if (errorMsg) { %>
                <div class="form-alert form-alert--danger">
                    <i class="fa-solid fa-exclamation-circle"></i>
                    <span><%= errorMsg %></span>
                </div>
                <% } %>

                <%
                // แถบสถานะใบสมัคร: ส่งแล้ว → แอดมินตรวจ → อนุมัติ → จองล็อก
                // role ถูกดึงจาก DB ทุก request (middlewares/jwtAuth.js refreshUserRole) อนุมัติแล้วใช้เมนูร้านค้าได้ทันที ไม่ต้องล็อกอินใหม่
                const isSellerAccount = user.role === 'SELLER' && !isNewShopMode;
                const appStatus = latestApplication ? latestApplication.status : null;
                const showStatusTrack = isSellerAccount || ((user.role === 'CUSTOMER' || isNewShopMode) && (appStatus === 'PENDING' || appStatus === 'APPROVED'));
                const fmtThaiDate = (value) => value ? new Date(value).toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Bangkok' }) : '';
                const approvedDone = isSellerAccount || appStatus === 'APPROVED';
                const statusSteps = [
                    { label: 'ส่งใบสมัคร', note: latestApplication ? fmtThaiDate(latestApplication.createdAt) : '', state: 'done' },
                    { label: 'แอดมินตรวจสอบ', note: approvedDone ? (latestApplication && latestApplication.reviewedAt ? fmtThaiDate(latestApplication.reviewedAt) : '') : 'กำลังตรวจ', state: approvedDone ? 'done' : 'current' },
                    { label: 'อนุมัติเป็นผู้ขาย', note: approvedDone ? 'เรียบร้อย' : 'รอผล', state: approvedDone ? 'done' : 'todo' },
                    { label: 'เลือกโซน/จองล็อก', note: approvedDone ? 'ทำต่อได้เลย' : 'จองระหว่างรอได้', state: approvedDone ? 'current' : 'todo' }
                ];
                %>
                <% if (showStatusTrack) { %>
                <div class="status-panel">
                    <p class="status-panel__title">
                        <% if (approvedDone) { %>
                        <i class="fa-solid fa-circle-check me-2"></i>ร้าน "<%= (latestApplication && latestApplication.shopName) || 'ของคุณ' %>" เปิดเป็นผู้ขายแล้ว
                        <% } else { %>
                        <i class="fa-solid fa-clock me-2"></i>ใบสมัครร้าน "<%= latestApplication.shopName %>" อยู่ระหว่างตรวจสอบ
                        <% } %>
                    </p>
                    <ol class="status-track">
                        <% statusSteps.forEach((step, index) => { %>
                        <li class="status-step status-step--<%= step.state %>">
                            <span class="status-step__dot"><% if (step.state === 'done') { %><i class="fa-solid fa-check"></i><% } else { %><%= index + 1 %><% } %></span>
                            <span class="status-step__label"><%= step.label %></span>
                            <% if (step.note) { %><span class="status-step__note"><%= step.note %></span><% } %>
                        </li>
                        <% }) %>
                    </ol>
                    <p class="status-panel__hint">
                        <% if (approvedDone) { %>
                        ใช้เมนูร้านค้าได้ทันที ไม่ต้องออกจากระบบ — ต่อไปเลือกโซนจองล็อก หรือเติมรูปและเมนูให้ร้านน่าสนใจ
                        <% } else { %>
                        ผลการตรวจจะแจ้งทางอีเมล — ระหว่างรอเลือกโซนและจองล็อกไว้ก่อนได้
                        <% } %>
                    </p>
                    <div class="status-panel__actions">
                        <a href="/select-zone" class="status-btn status-btn--primary"><i class="fa-solid fa-map-location-dot me-2"></i>เลือกโซน/จองล็อก</a>
                        <% if (isSellerAccount) { %>
                        <a href="/shop-profile" class="status-btn"><i class="fa-solid fa-store me-2"></i>ร้านค้าของฉัน</a>
                        <a href="/shop-application?new=1" class="status-btn"><i class="fa-solid fa-plus me-2"></i>สมัครเปิดร้านเพิ่ม</a>
                        <% } %>
                    </div>
                </div>
                <% } else if (user.role !== 'CUSTOMER' && !isNewShopMode) { %>
                <p class="text-muted">บัญชีนี้ไม่ใช่บัญชีลูกค้าทั่วไป จึงไม่ต้องสมัครเปิดร้านค้า</p>
                <% } else { %>

                <% if (latestApplication && latestApplication.status === 'REJECTED') { %>
                <div class="form-alert form-alert--danger">
                    <i class="fa-solid fa-circle-xmark"></i>
                    <span>
                        ใบสมัครร้าน "<%= latestApplication.shopName %>" ครั้งก่อนไม่ผ่านการอนุมัติ
                        <% if (latestApplication.rejectReason) { %><strong class="reject-reason">เหตุผล: <%= latestApplication.rejectReason %></strong><% } %>
                        <% if (typeof prefilledFromRejected !== 'undefined' && prefilledFromRejected) { %>
                        เติมข้อมูลเดิมไว้ให้แล้ว แก้เฉพาะจุดที่ต้องปรับแล้วส่งใหม่ได้เลย
                        <% } else { %>
                        แก้ไขข้อมูลแล้วสมัครใหม่ได้ด้านล่าง
                        <% } %>
                    </span>
                </div>
                <% } %>

                <div class="draft-banner" id="draftBanner" hidden>
                    <i class="fa-solid fa-floppy-disk"></i>
                    <span class="draft-banner__text">มีข้อมูลที่กรอกค้างไว้ <span id="draftBannerTime"></span> — ใช้ต่อไหม?</span>
                    <span class="draft-banner__actions">
                        <button type="button" class="status-btn status-btn--primary" id="draftRestoreBtn">ใช้ต่อ</button>
                        <button type="button" class="status-btn" id="draftDiscardBtn">เริ่มใหม่</button>
                    </span>
                </div>

                <div class="apply-intro">
                    <p class="apply-intro__lead">กรอก 3 ขั้นตอนหลักให้ครบ ใช้เวลาประมาณ 5 นาที — ช่องที่มี <span class="req-mark">*</span> ต้องกรอก</p>
                    <button type="button" class="rules-reopen-link" id="reopenRulesBtn">
                        <i class="fa-solid fa-file-lines me-1"></i>อ่านกฎระเบียบร้านค้าอีกครั้ง
                    </button>
                </div>

                <% if (isNewShopMode) { %>
                <div class="form-alert form-alert--info">
                    <i class="fa-solid fa-store"></i>
                    <span>สมัครเปิด<strong>ร้านใหม่</strong>เพิ่มจากร้านที่มีอยู่ — อนุมัติแล้วจะเป็นอีกร้านแยกกัน มีหน้าร้าน การจองแผง ใบกำกับภาษี และสัญญาเช่าของตัวเอง ร้านเดิมไม่เปลี่ยน</span>
                </div>
                <% } %>

                <form action="/shop-application<%= isNewShopMode ? '?new=1' : '' %>" method="POST"
                    enctype="multipart/form-data" id="shopApplicationForm"
                    data-draft-key="shopApplicationDraft:<%= user.id %><%= isNewShopMode ? ':new' : '' %>"
                    data-skip-draft="<%= errorMsg ? '1' : '' %>">
                    <input type="hidden" name="termsAccepted" id="termsAcceptedInput" value="<%= termsAlreadyAccepted ? 'true' : '' %>">

                    <%
                    const productTypeOptions = [
                        { value: 'FOOD', label: 'อาหาร/เครื่องดื่ม', icon: 'fa-bowl-food' },
                        { value: 'FASHION', label: 'เสื้อผ้า/แฟชั่น', icon: 'fa-shirt' },
                        { value: 'อื่นๆ', label: 'อื่นๆ', icon: 'fa-box-open' }
                    ];
                    %>
                    <section class="form-section" data-step="1">
                        <div class="form-section-head">
                            <span class="form-section-num">1</span>
                            <span class="form-section-title">ข้อมูลร้าน</span>
                            <span class="form-section-hint">แสดงบนผังตลาดหลังอนุมัติ</span>
                            <span class="form-section-done" hidden><i class="fa-solid fa-check"></i> ครบแล้ว</span>
                        </div>

                        <div class="form-group full-width">
                            <label for="shopNameInput">ชื่อร้านค้า <span class="req-mark">*</span></label>
                            <input type="text" name="shopName" id="shopNameInput" class="input-white"
                                value="<%= fd.shopName || '' %>" maxlength="200"
                                placeholder="เช่น ร้านส้มตำป้าแดง" autocomplete="organization" required>
                            <p class="field-hint field-hint--warn" id="shopNameTakenHint" hidden>
                                <i class="fa-solid fa-triangle-exclamation me-1"></i>มีร้านชื่อนี้อยู่แล้ว แนะนำเติมคำให้ต่างกัน เช่น ชื่อเจ้าของหรือเมนูเด่น ลูกค้าจะได้ไม่สับสน
                            </p>
                            <p class="field-hint">ขึ้นบนผังตลาดและป้ายหน้าร้าน — อนุมัติแล้วต้องให้แอดมินแก้ให้</p>
                        </div>

                        <div class="form-group full-width">
                            <label id="productTypeLabel">ขายสินค้าประเภทไหน <span class="req-mark">*</span></label>
                            <div class="type-cards" role="radiogroup" aria-labelledby="productTypeLabel">
                                <% productTypeOptions.forEach((opt) => { %>
                                <label class="type-card">
                                    <input type="radio" name="productType" value="<%= opt.value %>"
                                        <%= fd.productType === opt.value ? 'checked' : '' %> required>
                                    <span class="type-card__icon"><i class="fa-solid <%= opt.icon %>"></i></span>
                                    <span class="type-card__label"><%= opt.label %></span>
                                </label>
                                <% }) %>
                            </div>
                            <p class="field-hint">ประเภทสินค้ากำหนดโซนที่จองล็อกได้ และแก้เองไม่ได้หลังอนุมัติ</p>
                        </div>

                        <div class="form-group full-width" id="productSubtypeSection">
                            <div class="subtype-section__head">
                                <label>ขายอะไรบ้าง <span class="label-optional">เลือกได้หลายรายการ</span> <span class="subtype-count" id="subtypeCount" hidden>0</span></label>
                                <p class="field-hint mt-0">ใช้จัดล็อกไม่ให้ร้านที่ขายของซ้ำกันอยู่ติดกัน</p>
                            </div>
                            <div class="subtype-selected" id="subtypeSelected" hidden>
                                <span class="subtype-selected__label">เลือกแล้ว</span>
                                <span class="subtype-selected__chips" id="subtypeSelectedChips"></span>
                            </div>
                            <div class="subtype-search" id="subtypeSearchWrap" hidden>
                                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                                <input type="search" id="subtypeSearch" class="input-white" autocomplete="off" enterkeyhint="search"
                                    placeholder="ค้นหา เช่น ส้มตำ, โรตี, เสื้อผ้ามือสอง" aria-label="ค้นหาสินค้าที่ขาย">
                            </div>
                            <p class="subtype-noresult" id="subtypeNoResult" hidden>
                                ไม่เจอ "<span id="subtypeNoResultText"></span>" ในรายการ
                                <button type="button" class="field-action" id="subtypeUseOtherBtn">
                                    <i class="fa-solid fa-plus me-1"></i>เพิ่มเป็น "อื่นๆ (ระบุเอง)"
                                </button>
                            </p>
                            <%
                            const selectedSubtypes = (fd.productSubtype || '').split(',').map((s) => s.trim()).filter(Boolean);
                            const subtypeGroupsByType = (typeof productSubtypeGroups !== 'undefined' && productSubtypeGroups) ? productSubtypeGroups : {};
                            %>
                            <% Object.keys(subtypeGroupsByType).forEach((typeKey) => { %>
                            <div class="subtype-panel" data-product-type="<%= typeKey %>" hidden>
                                <% subtypeGroupsByType[typeKey].forEach((groupEntry) => {
                                    const groupCheckedCount = groupEntry.items.filter((item) => selectedSubtypes.includes(item)).length;
                                %>
                                <details class="subtype-group" <%= groupCheckedCount > 0 ? 'open' : '' %>>
                                    <summary class="subtype-group__title">
                                        <%= groupEntry.group %>
                                        <span class="subtype-group__count" <%= groupCheckedCount > 0 ? '' : 'hidden' %>><%= groupCheckedCount %></span>
                                    </summary>
                                    <div class="subtype-group__items">
                                        <% groupEntry.items.forEach((item) => { %>
                                        <label class="subtype-checkbox">
                                            <input type="checkbox" name="productSubtype" value="<%= item %>"
                                                <%= selectedSubtypes.includes(item) ? 'checked' : '' %>>
                                            <span><%= item %></span>
                                        </label>
                                        <% }) %>
                                    </div>
                                </details>
                                <% }) %>
                            </div>
                            <% }) %>
                            <details class="subtype-group subtype-group--other" <%= (fd.productSubtypeOther || '') ? 'open' : '' %>>
                                <summary class="subtype-group__title">อื่นๆ (ระบุเอง)</summary>
                                <div class="subtype-group__items">
                                    <label class="subtype-checkbox subtype-checkbox--other">
                                        <input type="checkbox" id="subtypeOtherToggle" <%= (fd.productSubtypeOther || '') ? 'checked' : '' %>>
                                        <span>มีสินค้าอื่นนอกลิสต์ด้านบน</span>
                                    </label>
                                    <input type="text" name="productSubtypeOther" id="subtypeOtherInput" class="input-white"
                                        value="<%= fd.productSubtypeOther || '' %>"
                                        placeholder="เช่น หมูสะเต๊ะ" maxlength="200"
                                        <%= (fd.productSubtypeOther || '') ? '' : 'hidden' %>>
                                </div>
                            </details>
                            <p class="subtype-empty" id="productSubtypeHint"><i class="fa-solid fa-arrow-up me-1"></i>เลือกประเภทสินค้าด้านบนก่อน รายการจะขึ้นตรงนี้</p>
                        </div>

                        <div class="form-group full-width">
                            <label for="productDetailInput">รายละเอียดสินค้า <span class="req-mark">*</span></label>
                            <textarea name="productDetail" id="productDetailInput" class="input-white" maxlength="2000" data-counter
                                placeholder="สินค้าที่จะขาย ราคาโดยประมาณ วัตถุดิบหลัก..." required><%= fd.productDetail || '' %></textarea>
                            <div class="field-foot">
                                <p class="field-hint">แอดมินใช้พิจารณาใบสมัคร และขึ้นในหน้าร้านให้ลูกค้ารู้ว่าขายอะไร</p>
                                <span class="char-count"></span>
                            </div>
                        </div>
                    </section>

                    <section class="form-section" data-step="2">
                        <div class="form-section-head">
                            <span class="form-section-num">2</span>
                            <span class="form-section-title">ผู้ขายและการติดต่อ</span>
                            <span class="form-section-hint">เจ้าหน้าที่ใช้ติดต่อ</span>
                            <span class="form-section-done" hidden><i class="fa-solid fa-check"></i> ครบแล้ว</span>
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label for="sellerNameInput">ชื่อผู้ขาย</label>
                                <input type="text" name="sellerName" id="sellerNameInput" class="input-white input-readonly"
                                    value="<%= user && user.name ? user.name : '' %>" readonly required>
                                <p class="field-hint">ดึงจากบัญชีผู้ใช้ แก้ได้ที่หน้าโปรไฟล์</p>
                            </div>

                            <div class="form-group">
                                <label for="phoneNumberInput">เบอร์โทรศัพท์ <span class="req-mark">*</span></label>
                                <input type="tel" name="phoneNumber" id="phoneNumberInput" class="input-white" data-digits-only
                                    value="<%= fd.phoneNumber || (typeof userPhoneNumber !== 'undefined' ? userPhoneNumber : '') %>"
                                    inputmode="numeric" maxlength="10" pattern="0[0-9]{8,9}" autocomplete="tel"
                                    placeholder="เช่น 0812345678" required>
                                <p class="field-hint">ตัวเลข 9–10 หลัก ขึ้นต้นด้วย 0</p>
                            </div>
                        </div>
                    </section>

                    <section class="form-section" data-step="3">
                        <div class="form-section-head">
                            <span class="form-section-num">3</span>
                            <span class="form-section-title">บัญชีธนาคาร</span>
                            <span class="form-section-hint">ไม่แสดงบนผังตลาด</span>
                            <span class="form-section-done" hidden><i class="fa-solid fa-check"></i> ครบแล้ว</span>
                        </div>

                        <div class="form-grid">
                            <div class="form-group full-width">
                                <label for="bankNameSelect">ธนาคาร <span class="req-mark">*</span></label>
                                <select name="bankName" id="bankNameSelect" class="input-white" required>
                                    <option value="" <%= !fd.bankName ? 'selected' : '' %> disabled>เลือกธนาคาร...</option>
                                    <% (typeof bankNames !== 'undefined' ? bankNames : []).forEach((bank) => { %>
                                    <option value="<%= bank %>" <%= fd.bankName === bank ? 'selected' : '' %>><%= bank %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="bankAccountNumberInput">เลขบัญชี <span class="req-mark">*</span></label>
                                <input type="text" name="bankAccountNumber" id="bankAccountNumberInput" class="input-white" data-digits-only
                                    value="<%= fd.bankAccountNumber || '' %>"
                                    inputmode="numeric" minlength="4" maxlength="30" autocomplete="off"
                                    placeholder="เช่น 1234567890" required>
                                <p class="field-hint">พิมพ์เฉพาะตัวเลข ไม่ต้องใส่ขีด</p>
                            </div>

                            <div class="form-group">
                                <label for="bankAccountNameInput">ชื่อบัญชี <span class="req-mark">*</span></label>
                                <input type="text" name="bankAccountName" id="bankAccountNameInput" class="input-white"
                                    value="<%= fd.bankAccountName || '' %>" maxlength="200"
                                    placeholder="เช่น นายสมชาย ใจดี" required>
                                <button type="button" class="field-action" id="useSellerNameBtn">
                                    <i class="fa-solid fa-user-check me-1"></i>ใช้ชื่อเดียวกับผู้ขาย
                                </button>
                            </div>
                        </div>
                    </section>

                    <section class="form-section form-section--optional">
                        <div class="form-section-head">
                            <span class="form-section-num form-section-num--optional">+</span>
                            <span class="form-section-title">ทำให้ร้านน่าสนใจ</span>
                            <span class="form-section-hint">ไม่บังคับ · เพิ่มทีหลังได้ที่หน้าร้านค้าของฉัน</span>
                        </div>

                        <div class="form-group full-width">
                            <label for="shopSummaryInput">แนะนำร้านสั้น ๆ</label>
                            <textarea name="shopSummary" id="shopSummaryInput" class="input-white input-short" maxlength="500" data-counter
                                placeholder="เช่น ส้มตำปูปลาร้าสูตรอีสานแท้ ตำสดทุกครก"><%= fd.shopSummary || '' %></textarea>
                            <div class="field-foot">
                                <p class="field-hint">ขึ้นในการ์ดร้านบนผังตลาดและหน้าคอมมูนิตี้</p>
                                <span class="char-count"></span>
                            </div>
                        </div>

                        <div class="form-group full-width">
                            <label for="shopTagsField">เมนูเด่น (คำค้นหา)</label>
                            <div class="tag-input-box" id="shopTagsBox">
                                <input type="text" id="shopTagsField" class="tag-input-field" enterkeyhint="done"
                                    placeholder="พิมพ์ชื่อเมนู แล้วกด Enter เช่น หมูปิ้งนมสด">
                            </div>
                            <input type="hidden" name="shopTags" id="shopTagsHidden" value="<%= fd.shopTags || '' %>">
                            <div class="tag-suggest" id="tagSuggest" hidden>
                                <span class="tag-suggest__label">แตะเพื่อเพิ่มจากที่ติ๊กไว้:</span>
                                <span class="tag-suggest__chips" id="tagSuggestChips"></span>
                            </div>
                            <p class="field-hint">ลูกค้าค้นชื่อเมนูบนผังตลาดแล้วเจอร้านคุณ — ใส่แบบเจาะจง เช่น "หมูปิ้งนมสด" แทน "หมูปิ้ง"</p>
                        </div>

                        <div class="form-group full-width">
                            <label>โลโก้ร้าน <span class="label-optional">ถ้ามี</span></label>
                            <div class="upload-wrapper">
                                <label for="logoImageUpload" class="upload-box upload-box--cover upload-box--logo"
                                    id="logoUploadLabel">
                                    <img id="logoImagePreview" src alt="Preview" hidden>
                                    <span class="upload-box__placeholder" id="logoUploadPlaceholder">
                                        <span class="upload-box__icon" aria-hidden="true"><i class="fa-solid fa-store"></i></span>
                                        <span class="upload-box__text">แตะเพื่อเลือกโลโก้</span>
                                    </span>
                                </label>
                                <input type="file" name="logoImage" id="logoImageUpload"
                                    class="upload-input" accept="image/*">
                            </div>
                            <p class="field-hint">ใช้เป็นรูปย่อของร้านบนผังตลาด — แยกจากรูปสินค้า ลูกค้าที่กดดูเมนูจะไม่เห็นโลโก้ปนกับรูปอาหาร</p>
                        </div>

                        <div class="upload-grid">
                            <div class="form-group">
                                <label>รูปสินค้า <span class="label-optional">สูงสุด <%= maxProductImagesCount %> รูป</span></label>
                                <div class="upload-wrapper gallery-wrapper" id="productImagesWrapper">
                                    <label for="productImagesUpload" class="upload-box" id="productImagesUploadLabel"></label>
                                </div>
                                <input type="file" name="productImages" id="productImagesUpload"
                                    class="upload-input" accept="image/*" multiple data-max="<%= maxProductImagesCount %>">
                                <p class="field-hint">รูปอาหาร/สินค้าจริงของร้าน (ไม่ต้องใส่โลโก้ในช่องนี้)</p>
                            </div>

                            <div class="form-group">
                                <label>รูปเมนูร้าน <span class="label-optional">สูงสุด <%= maxMenuImagesCount %> รูป</span></label>
                                <div class="upload-wrapper gallery-wrapper" id="menuImagesWrapper">
                                    <label for="menuImagesUpload" class="upload-box" id="menuImagesUploadLabel"></label>
                                </div>
                                <input type="file" name="menuImages" id="menuImagesUpload"
                                    class="upload-input" accept="image/*" multiple data-max="<%= maxMenuImagesCount %>">
                                <p class="field-hint">ถ่ายป้ายเมนู/ใบราคาให้อ่านชื่อและราคาได้ชัด</p>
                            </div>
                        </div>

                        <div class="form-group full-width">
                            <label>รูปหน้าปกร้าน</label>
                            <div class="upload-wrapper" id="coverUploadWrapper">
                                <label for="imageUpload" class="upload-box upload-box--cover"
                                    id="uploadLabel">
                                    <img id="imagePreview" src alt="Preview" hidden>
                                    <span class="upload-box__placeholder" id="uploadPlaceholder">
                                        <span class="upload-box__icon" aria-hidden="true"><i class="fa-solid fa-image"></i></span>
                                        <span class="upload-box__text">แตะเพื่อเลือกรูป</span>
                                    </span>
                                </label>
                                <input type="file" name="shopCoverImage" id="imageUpload"
                                    class="upload-input" accept="image/*">
                            </div>
                            <p class="field-hint">ถ้าไม่มีโลโก้และรูปสินค้า จะใช้รูปนี้เป็นรูปย่อบนผังตลาดแทน · ทุกช่องย่อรูปให้อัตโนมัติก่อนส่ง อัปโหลดเร็วขึ้นบนเน็ตมือถือ</p>
                        </div>

                        <% const prevImages = (typeof previousImages !== 'undefined' && previousImages) ? previousImages : null; %>
                        <% if (prevImages) {
                            const prevThumbs = [prevImages.logo, prevImages.cover, ...prevImages.products, ...prevImages.menus].filter(Boolean);
                        %>
                        <label class="reuse-images" id="reuseImagesBox"
                            data-cover="<%= prevImages.cover || '' %>" data-logo="<%= prevImages.logo || '' %>" data-first-product="<%= prevImages.products[0] || '' %>">
                            <input type="checkbox" name="reusePreviousImages" value="1" id="reuseImagesToggle" checked>
                            <span class="reuse-images__body">
                                <span class="reuse-images__title">ใช้รูปจากใบสมัครครั้งก่อน (<%= prevThumbs.length %> รูป)</span>
                                <span class="field-hint mt-0">ช่องไหนเลือกรูปใหม่ จะใช้รูปใหม่แทนเฉพาะช่องนั้น</span>
                                <span class="reuse-images__thumbs">
                                    <% prevThumbs.slice(0, 6).forEach((url) => { %><img src="<%= url %>" alt="" loading="lazy"><% }) %>
                                </span>
                            </span>
                        </label>
                        <% } %>

                        <div class="shop-preview" aria-live="polite">
                            <span class="shop-preview__caption">ตัวอย่างการ์ดร้านบนผังตลาด</span>
                            <div class="shop-preview__card">
                                <div class="shop-preview__thumb" id="previewThumb"><i class="fa-solid fa-store"></i></div>
                                <div class="shop-preview__info">
                                    <span class="shop-preview__type" id="previewType">ประเภทสินค้า</span>
                                    <strong class="shop-preview__name" id="previewName">ชื่อร้านของคุณ</strong>
                                    <span class="shop-preview__summary" id="previewSummary">แนะนำร้านสั้น ๆ จะขึ้นตรงนี้</span>
                                    <span class="shop-preview__tags" id="previewTags"></span>
                                </div>
                            </div>
                        </div>
                        <% if (errorMsg) { %>
                        <p class="field-hint field-hint--warn"><i class="fa-solid fa-triangle-exclamation me-1"></i>ส่งไม่สำเร็จครั้งก่อน — ต้องแนบรูปทุกช่องใหม่อีกครั้ง (เบราว์เซอร์ไม่เก็บไฟล์ค้างไว้ให้)</p>
                        <% } %>
                    </section>

                    <div class="submit-bar">
                        <div class="submit-progress" aria-live="polite">
                            <div class="submit-progress__track"><div class="submit-progress__fill" id="progressFill"></div></div>
                            <span class="submit-progress__text" id="progressText"></span>
                        </div>
                        <button type="submit"
                            class="submit-btn"
                            id="submitBtn" <%= termsAlreadyAccepted ? '' : 'disabled' %>><%= termsAlreadyAccepted ? 'ส่งใบสมัคร' : 'ส่งใบสมัคร (กรุณายอมรับกฎระเบียบก่อน)' %></button>
                    </div>

                </form>
                <% } %>
            </div>
        </div>

        <% if ((user.role === 'CUSTOMER' || isNewShopMode) && !(latestApplication && (latestApplication.status === 'PENDING' || latestApplication.status === 'APPROVED'))) { %>
        <div class="rules-overlay" id="rulesOverlay" <%= termsAlreadyAccepted ? 'hidden' : '' %>>
            <div class="rules-modal">
                <div class="rules-modal__header">
                    <h2><i class="fa-solid fa-scroll me-2"></i>กฎระเบียบร้านค้า</h2>
                    <p>กรุณาอ่านให้ครบก่อนสมัครเปิดร้านค้า</p>
                </div>
                <div class="rules-modal__body">
                    <h3>ทั่วไป</h3>
                    <ul>
                        <li><strong>ห้าม</strong>ปล่อยเช่าช่วงต่อในเชิงธุรกิจ หรือปล่อยเช่าเกินราคาเช่าเด็ดขาด</li>
                        <li>ตลาดเปิดให้บริการตั้งแต่เวลา 16:00 น. จนถึง 00:00 น.</li>
                        <li>ร้านค้าสามารถเข้าพื้นที่ตั้งแผงได้ตั้งแต่เวลา 10.00 - 18.00 น. นอกเวลานี้ต้องติดต่อเจ้าหน้าที่เป็นกรณีพิเศษ</li>
                        <li>เปิดกระแสไฟฟ้าให้ใช้ตั้งแต่เวลา 16.00 - 00.30 น. หรือตามความเหมาะสม</li>
                        <li><strong>ห้าม</strong>รถเข้าพื้นที่ขายตั้งแต่เวลา 16.30 - 23.00 น.</li>
                        <li>เมื่อสิ้นสุดการเช่าหรือย้ายแผง ต้องจัดเก็บแผงและคืนพื้นที่ให้เรียบร้อยภายในเวลา 00.30 น. ของคืนนั้น มิฉะนั้นถือเป็นการบุกรุกพื้นที่โดยไม่ได้รับอนุญาต ทางตลาดสงวนสิทธิ์เคลื่อนย้ายสิ่งของโดยผู้เช่ารับผิดชอบค่าใช้จ่ายเอง และปรับครั้งที่ 1 = 50% ของค่าล็อค ครั้งที่ 2 = 100% ครั้งที่ 3 = 200% หากมีครั้งที่ 4 ทางตลาดสงวนสิทธิ์ไม่ต่อสิทธิ์ร้านค้า</li>
                        <li>กรณีย้ายแผง สิทธิ์เช่าล็อคจะโอนไปยังล็อคใหม่ที่แจ้งไว้ ส่วนล็อคเดิมคืนให้ทางตลาด</li>
                        <li>ทรัพย์สินของร้านค้าเป็นความรับผิดชอบของร้านค้าเอง ทางตลาดมีเจ้าหน้าที่ตรวจตราแต่ไม่รับผิดชอบความเสียหาย/สูญหาย</li>
                        <li>โต๊ะ เก้าอี้ อุปกรณ์ และเฟอร์นิเจอร์ทั้งหมดเป็นทรัพย์สินของตลาด ห้ามนำไปใช้ส่วนตัวโดยไม่ได้รับอนุญาต</li>
                        <li>กรณีขอคืนเงินหลังชำระแล้ว ขึ้นอยู่กับดุลพินิจของเจ้าหน้าที่ตลาด</li>
                        <li>หากฝ่าฝืนกฎระเบียบ ค้างชำระค่าปรับ หรือส่งผลกระทบต่อส่วนรวม ทางตลาดสงวนสิทธิ์เพิกถอนสิทธิ์การเช่า ตัดสิทธิ์ หรือปฏิเสธการเช่า</li>
                    </ul>

                    <h3>ความสะอาดและการจัดการขยะ</h3>
                    <ul>
                        <li>ต้องจัดเก็บและทิ้งขยะในจุดที่กำหนดเท่านั้น ทางตลาดไม่มีนโยบายเข้าไปเก็บขยะในแผงร้านค้า</li>
                        <li><strong>ห้าม</strong>ทิ้งขยะหรือเศษอาหารลงท่อระบายน้ำหรือบริเวณโดยรอบ ต้องคัดแยกและทิ้งในจุดที่จัดเตรียมไว้เท่านั้น</li>
                        <li><strong>ห้าม</strong>นำภาชนะหรือสิ่งของไปล้างในห้องน้ำหรือบริเวณทิ้งเศษอาหารโดยเด็ดขาด ร้านค้าต้องรับผิดชอบภาชนะของตนเอง</li>
                        <li>หากพื้นที่เช่าถูกทิ้งไว้สกปรก ทางตลาดจะเรียกเก็บค่าปรับความสะอาดตามค่าใช้จ่ายจริง</li>
                        <li><strong>งด</strong>ใช้กล่องโฟม (พื้นที่ปลอดโฟม) และ<strong>งด</strong>ใช้ลูกแม็คสแตปเปิ้ล</li>
                    </ul>

                    <h3>การจัดวางร้านและทัศนียภาพ</h3>
                    <ul>
                        <li><strong>ห้าม</strong>ติดตั้งแผงกั้น/ผ้ากั้นด้านซ้าย-ขวาของร้านสูงเกิน 1.20 เมตรจากพื้นในช่วงเวลาขาย</li>
                        <li><strong>ห้าม</strong>ติดตั้งหรือวางส่วนใดของร้านสูงเกิน 3.75 เมตรจากพื้นดิน</li>
                        <li>ต้องใช้พื้นที่ตามขนาดที่ได้รับอนุญาตเท่านั้น ห้ามตั้งแผงเกินพื้นที่เช่าโดยไม่ได้รับอนุญาต</li>
                        <li>ร้านที่ไม่มาขายหรือปิดร้านก่อน 21.00 น. ต้องจัดเก็บ/ปิดร้านให้เรียบร้อย ไม่บดบังทัศนียภาพ (อยู่ในดุลพินิจของตลาด) เจ้าหน้าที่มีสิทธิ์จัดระเบียบพื้นที่ เปิดไฟ หรือติดตั้งฉากกั้นได้</li>
                        <li>ปลั๊กพ่วงที่นำมาใช้ต้องได้มาตรฐาน เพื่อป้องกันอุบัติเหตุ</li>
                        <li>ต้องติดป้ายราคาสินค้าและรายละเอียดสินค้าให้ชัดเจน เพื่อความโปร่งใส</li>
                        <li>ร้านอาหารต้องจำหน่ายอาหารที่สะอาด ปลอดภัย ถูกสุขลักษณะตามมาตรฐานอนามัย</li>
                        <li>หลีกเลี่ยงเสียงดังเกินควรหรือก่อความรำคาญต่อผู้อื่น</li>
                    </ul>

                    <h3>ค่าปรับพื้นที่เกิน</h3>
                    <ul>
                        <li>เกินเล็กน้อย (ไม่เกิน 1 ตร.ม.): ปรับ 25-500 บาท</li>
                        <li>เกินปานกลาง (1-3 ตร.ม.): ปรับ 50-1,000 บาท</li>
                        <li>เกินมาก (เกิน 3 ตร.ม.): ปรับ 2-10 เท่าของค่าเช่าพื้นที่ปกติ</li>
                        <li>อัตราค่าปรับเพิ่มตามจำนวนครั้งที่พบ และอาจมีค่าปรับเพิ่มเติมกรณีต้องจัดการความเสียหายที่เกิดขึ้น</li>
                    </ul>

                    <h3>เครื่องใช้ไฟฟ้าและไฟส่องสว่าง</h3>
                    <ul>
                        <li>แจ้งล่วงหน้าในระบบ: เครื่องเล็ก 20 บาท / เครื่องใหญ่ 40 บาท</li>
                        <li>เก็บหน้างาน (ไม่แจ้งล่วงหน้า): เครื่องเล็ก 40 บาท / เครื่องใหญ่ 60 บาท</li>
                        <li>เครื่องเล็ก = ไม่เกิน 1,200 วัตต์ และขนาดรวม (กว้าง×ยาว×สูง) ไม่เกิน 250,000 ลบ.ซม. นอกเหนือจากนี้นับเป็นเครื่องใหญ่</li>
                        <li>ต้องแจ้งรายการเครื่องใช้ไฟฟ้าที่นำมาล่วงหน้าก่อนการขาย ภายใน 16.30 น. ไม่ว่าจะใช้งานจริงหรือไม่ หากนำมาโดยไม่แจ้งจะถูกปรับ 2-10 เท่าของอัตราปกติ (ปรับเพิ่มตามจำนวนครั้งที่พบ)</li>
                        <li>ค่าปรับไฟส่องสว่างเกิน: คิดจากพลังงานที่เกิน 150 วัตต์ต่อล็อค อัตรา 20 บาทต่อ 100 วัตต์ (เศษเกิน 50 วัตต์ปัดขึ้น) ขั้นต่ำ 20 บาทต่อครั้ง</li>
                    </ul>

                    <h3>การชดเชยกรณีฝนตก</h3>
                    <ul>
                        <li>เข้าเงื่อนไขต้องครบทั้ง 2 ข้อ: (1) ฝนตกช่วงเวลา 17.00-20.00 น. (2) ฝนตกต่อเนื่องจนเป็นอุปสรรคจนไม่สามารถทำการค้าได้ (ฝนตกปรอยๆ แล้วหยุด ไม่เข้าเงื่อนไข)</li>
                        <li>หากเข้าเงื่อนไข จะได้รับส่วนลดชดเชย 50-100% จากค่าเช่าล็อควันนั้น ประกาศผลเวลา 21.30 น.</li>
                        <li>ทางตลาดสงวนสิทธิ์ใช้ดุลยพินิจตีความและตัดสินใจโดยเด็ดขาด ผลการพิจารณาถือเป็นที่สุด</li>
                    </ul>

                    <h3>การใช้งานส่วนลดชดเชย</h3>
                    <ul>
                        <li>ใช้เป็นส่วนลดสำหรับการจองล็อคครั้งถัดไปเท่านั้น ต้องใช้ไลน์เดียวกับรอบที่ได้รับชดเชย และแจ้งเจ้าหน้าที่ว่าต้องการใช้</li>
                        <li>มีระยะเวลาหมดอายุ 45 วัน นับจากวันที่ได้รับชดเชย</li>
                        <li>ต้องใช้ส่วนลดทั้งหมดที่มีในครั้งเดียว และไม่สามารถแลกคืนเป็นเงินสดได้</li>
                        <li>หากส่วนลดมากกว่าค่าเช่า ส่วนต่างจะไม่สะสมต่อ</li>
                        <li>ไม่ครอบคลุมลูกค้าวอล์คอินหรือเช่าช่วงต่อจากผู้อื่น และไม่สามารถโอน/ส่งต่อสิทธิ์ให้ผู้อื่นได้</li>
                        <li>เศษทศนิยมปัดขึ้นเพื่อประโยชน์ของร้านค้า สะสมได้สูงสุด 5 ครั้ง</li>
                        <li>เช็คส่วนลดที่มีได้โดยพิมพ์ "@ชดเชย" ตามด้วยไอดี เช่น @ชดเชย123456</li>
                    </ul>
                </div>
                <div class="rules-modal__footer">
                    <label class="rules-consent">
                        <input type="checkbox" id="rulesConsentCheckbox">
                        <span>ข้าพเจ้าได้อ่านและยอมรับกฎระเบียบร้านค้าข้างต้นทั้งหมด</span>
                    </label>
                    <button type="button" class="rules-accept-btn" id="rulesAcceptBtn" disabled>ยอมรับเงื่อนไข/กติกาตลาด</button>
                </div>
            </div>
        </div>
        <% } %>

        <% if ((user.role === 'CUSTOMER' || isNewShopMode) && !(latestApplication && (latestApplication.status === 'PENDING' || latestApplication.status === 'APPROVED'))) { %>
        <div class="rules-overlay" id="reviewOverlay" hidden>
            <div class="rules-modal" role="dialog" aria-modal="true" aria-labelledby="reviewTitle">
                <div class="rules-modal__header">
                    <h2 id="reviewTitle"><i class="fa-solid fa-list-check me-2"></i>ตรวจทานก่อนส่ง</h2>
                    <p>เช็คให้แน่ใจโดยเฉพาะเลขบัญชีและเบอร์โทร — ชื่อร้านและประเภทสินค้าแก้เองไม่ได้หลังอนุมัติ</p>
                </div>
                <div class="rules-modal__body" id="reviewBody"></div>
                <div class="rules-modal__footer review-footer">
                    <button type="button" class="status-btn" id="reviewEditBtn">กลับไปแก้ไข</button>
                    <button type="button" class="rules-accept-btn" id="reviewConfirmBtn">ยืนยันส่งใบสมัคร</button>
                </div>
            </div>
        </div>
        <% } %>

        <script src="/js/seller/shopApplication.js?v=20261023-logo"></script>
    </body>
</html>
