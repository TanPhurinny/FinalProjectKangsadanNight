<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>จองแผงค้า</title>
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260711-5">
  <link rel="stylesheet" href="/stylesheets/seller/bookingStall.css">
</head>
<body>
<script src="/js/common/tabSession.js"></script>
  <%- include('../partials/navbar2') %>

  <header class="site-header">
    <button class="btn-back" onclick="history.back()" title="ย้อนกลับ">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <h1 class="header-title">จองแผงค้า</h1>
    <div class="header-spacer"></div>
  </header>

  <main class="main-content">
    <form class="form-card" method="POST" action="/booking-stall" id="bookingForm">
      <% if (error) { %>
        <div class="alert-box"><%= error %></div>
      <% } %>

      <input type="hidden" name="zone" value="<%= zone || '' %>" />

      <div class="field-group">
        <label class="field-label">ชื่อ - นามสกุล</label>
        <input type="text" class="field-input" value="<%= user ? user.name : '' %>" readonly />
      </div>

      <div class="field-group">
        <label class="field-label">เบอร์โทรศัพท์</label>
        <input type="text" class="field-input" value="<%= user ? (user.phoneNumber || '-') : '' %>" readonly />
      </div>

      <div class="grid-two">
        <div class="field-group">
          <label class="field-label">วันที่เริ่มเช่า</label>
          <input type="date" class="field-input" id="dateStart" name="dateStart" required />
        </div>
        <div class="field-group">
          <label class="field-label">วันที่สิ้นสุดเช่า</label>
          <input type="date" class="field-input" id="dateEnd" name="dateEnd" required />
        </div>
      </div>

      <div class="field-group">
        <label class="field-label">โซนที่เลือก</label>
        <input type="text" class="field-input" value="<%= zone ? ('โซน ' + zone) : 'ไม่ระบุ' %>" readonly />
      </div>

      <div class="field-group">
        <label class="field-label">จำนวนล็อกแผง</label>
        <input type="number" class="field-input" id="stallCount" name="stallCount" min="1" value="1" required />
      </div>

      <div class="field-group">
        <label class="field-label">รายละเอียดร้านค้า</label>
        <textarea class="field-input" id="storeDetail" name="storeDetail" rows="4" placeholder="เพิ่มรายละเอียดร้านค้า"><%= defaultStoreDetail || '' %></textarea>
      </div>

      <div class="grid-two">
        <div class="field-group">
          <label class="field-label">เครื่องใช้ไฟฟ้าเล็ก (เครื่องละ <%= pricing.smallAppliancePrice %> บาท/วัน)</label>
          <input type="number" class="field-input" id="smallApplianceCount" name="smallApplianceCount" min="0" value="0" />
        </div>
        <div class="field-group">
          <label class="field-label">เครื่องใช้ไฟฟ้าใหญ่ (เครื่องละ <%= pricing.largeAppliancePrice %> บาท/วัน)</label>
          <input type="number" class="field-input" id="largeApplianceCount" name="largeApplianceCount" min="0" value="0" />
        </div>
      </div>

      <%
        var currentCornerValue = typeof cornerZoneValue !== 'undefined' ? Number(cornerZoneValue) : 0;
        var cornerOptionsList = typeof pricing.cornerZoneOptions !== 'undefined' ? pricing.cornerZoneOptions : [];
      %>
      <div class="field-group">
        <label class="field-label">สนใจแผงหัวมุม/แผงพิเศษไหม? <span class="field-label__note">(แจ้งความสนใจเฉยๆ ยังไม่คิดเงิน จะคิดเพิ่มก็ต่อเมื่อแอดมินจัดแผงพิเศษให้จริงเท่านั้น)</span></label>
        <div class="option-list">
          <label class="option-card">
            <input type="radio" name="cornerZone" value="0" <%= currentCornerValue === 0 ? 'checked' : '' %> />
            <span class="option-card__text">
              <strong>ไม่สนใจ</strong>
              <small>แผงมาตรฐาน</small>
            </span>
          </label>
          <% cornerOptionsList.forEach(function(opt) { %>
            <label class="option-card">
              <input type="radio" name="cornerZone" value="<%= opt.value %>" <%= currentCornerValue === opt.value ? 'checked' : '' %> />
              <span class="option-card__text">
                <strong><%= opt.label %> <span class="option-card__tag">+<%= opt.value %> บาท/ล็อก/วัน หากได้รับจัดให้</span></strong>
                <small><%= opt.desc %></small>
              </span>
            </label>
          <% }) %>
        </div>
      </div>

      <div class="summary-box">
        <div class="summary-line">ค่าเช่าแผงต่อวัน: <strong id="dailyPriceText"><%= Number(zonePrice || 0).toLocaleString('th-TH') %> บาท/ล็อก/วัน</strong></div>
        <div class="summary-line">จำนวนวันเช่า: <strong id="rentalDaysText">1 วัน</strong></div>
        <div class="summary-line">รวมค่าเช่าแผง: <strong id="rentTotalText">0 บาท</strong></div>
        <div class="summary-line">รวมค่าไฟสว่าง: <strong id="lightTotalText">0 บาท</strong></div>
        <div class="summary-line">รวมค่าเครื่องใช้ไฟฟ้า: <strong id="applianceTotalText">0 บาท</strong></div>
        <div class="summary-small">ระบบจะคำนวณอีกครั้งฝั่งเซิร์ฟเวอร์ก่อนบันทึกข้อมูล (ค่าแผงหัวมุม/แผงพิเศษยังไม่รวมในยอดนี้ จะคิดเพิ่มภายหลังเฉพาะกรณีแอดมินจัดแผงพิเศษให้)</div>
      </div>

      <div class="total-row">
        <span>รวมทั้งหมด</span>
        <span id="grandTotalText">0 บาท</span>
      </div>

      <div class="bottom-buttons">
        <button type="button" class="btn-cancel-main" onclick="history.back()">ยกเลิก</button>
        <button type="submit" class="btn-confirm">ยืนยันการจอง</button>
      </div>
    </form>
  </main>

  <script>
    window.PRICING_DATA = {
      zonePrice: <%= Number(zonePrice || 0) %>,
      lightUnitPrice: <%= Number(pricing.lightUnitPrice || 15) %>,
      smallAppliancePrice: <%= Number(pricing.smallAppliancePrice || 20) %>,
      largeAppliancePrice: <%= Number(pricing.largeAppliancePrice || 40) %>
    };
  </script>
  <script src="/js/seller/bookingStall.js"></script>
</body>
</html>