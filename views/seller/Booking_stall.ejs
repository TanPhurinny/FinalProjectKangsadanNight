<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>จองแผงค้า</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="book-stall.css" />
</head>
<body>

  <!-- HEADER -->
  <header class="site-header">
    <button class="btn-back" onclick="history.back()" title="ย้อนกลับ">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <h1 class="header-title">จองแถว A101-A119 โซน A</h1>
    <div class="header-spacer"></div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    <div class="form-card">

      <!-- NAME -->
      <div class="field-group">
        <label class="field-label">ชื่อ – นามสกุล</label>
        <input type="text" class="field-input" id="fullname" placeholder="กรอกชื่อ-นามสกุล" value="Melissa Peters" />
      </div>

      <!-- PHONE -->
      <div class="field-group">
        <label class="field-label">เบอร์โทรศัพท์</label>
        <input type="tel" class="field-input" id="phone" placeholder="กรอกเบอร์โทรศัพท์" value="043-551-8889" />
      </div>

      <!-- DATE -->
      <div class="field-group">
        <label class="field-label">วันที่ต้องการเช่า</label>
        <div class="date-row">
          <div class="date-item">
            <span class="date-label">เริ่ม :</span>
            <input type="date" class="field-input date-input" id="dateStart" value="2025-10-12" onchange="recalcTotal()" />
          </div>
          <div class="date-item">
            <span class="date-label">สิ้นสุด :</span>
            <input type="date" class="field-input date-input" id="dateEnd" value="2025-10-15" onchange="recalcTotal()" />
          </div>
        </div>
      </div>

      <!-- STORE DETAILS -->
      <div class="field-group">
        <label class="field-label">รายละเอียดร้านค้า</label>
        <textarea class="field-input field-textarea" id="storeDetail" placeholder="เพิ่มรายละเอียด...."></textarea>
      </div>

      <!-- PRODUCT IMAGE -->
      <div class="field-group">
        <label class="field-label">รูปภาพสินค้า</label>
        <div class="upload-box" id="productUploadBox" onclick="document.getElementById('productImageInput').click()">
          <input type="file" id="productImageInput" accept="image/*" style="display:none" onchange="previewImage(this,'productUploadBox')" />
          <div class="upload-placeholder" id="productUploadPlaceholder">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#bbb" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
          <img id="productUploadPreview" class="upload-preview" style="display:none" alt="preview" />
        </div>
      </div>

      <!-- LIGHT OPTION -->
      <div class="field-group">
        <label class="field-label">ไฟสว่าง</label>
        <div class="radio-group">
          <label class="radio-label">
            <input type="radio" name="light" value="yes" />
            <span class="radio-custom"></span>
            ใช้
          </label>
          <label class="radio-label">
            <input type="radio" name="light" value="no" checked />
            <span class="radio-custom"></span>
            ไม่ใช้
          </label>
        </div>
      </div>

      <!-- ELECTRICAL DEVICES TABLE -->
      <div class="field-group">
        <label class="field-label">เครื่องใช้ไฟฟ้า (หากมี)</label>
        <div class="table-wrapper">
          <table class="elec-table" id="elecTable">
            <thead>
              <tr>
                <th>เครื่องใช้ไฟฟ้า</th>
                <th>ประเภท</th>
                <th>จำนวน</th>
                <th>ราคา</th>
                <th>จัดการ</th>
              </tr>
            </thead>
            <tbody id="elecTableBody">
              <!-- demo rows -->
              <tr data-price="80" data-type="large" data-qty="2">
                <td>1.เตาไฟฟ้า</td>
                <td>ขนาดใหญ่</td>
                <td>2</td>
                <td>80</td>
                <td class="action-cell">
                  <button class="btn-edit" onclick="openEditModal(this)">แก้ไข</button>
                  <button class="btn-delete" onclick="deleteRow(this)">ลบ</button>
                </td>
              </tr>
              <tr data-price="20" data-type="small" data-qty="1">
                <td>2.เครื่องปั่น</td>
                <td>ขนาดเล็ก</td>
                <td>1</td>
                <td>20</td>
                <td class="action-cell">
                  <button class="btn-edit" onclick="openEditModal(this)">แก้ไข</button>
                  <button class="btn-delete" onclick="deleteRow(this)">ลบ</button>
                </td>
              </tr>
            </tbody>
            <tfoot>
              <tr>
                <td colspan="2" class="tfoot-label">รวม</td>
                <td colspan="2" class="tfoot-sum" id="elecSum">100 บาท</td>
                <td>
                  <button class="btn-add" onclick="openAddModal()">เพิ่มเครื่องใช้ไฟฟ้า</button>
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- PRICE SUMMARY BOX -->
      <div class="summary-box">
        <div class="summary-line">ค่าเช่าแผง : <strong>500 บาท/วัน</strong></div>
        <div class="summary-line">แผง : <strong>H 001</strong></div>
      </div>

      <!-- TOTAL -->
      <div class="total-row">
        <span class="total-label">รวมเงิน</span>
        <span class="total-amount" id="totalAmount">630 บาท</span>
      </div>
      <div class="total-note">ท่านจะสามารถชำระเงินได้หลังจากแอดมินอนุมัติ</div>

      <!-- BOTTOM BUTTONS -->
      <div class="bottom-buttons">
        <button class="btn-cancel-main" onclick="history.back()">ยกเลิก</button>
        <button class="btn-confirm" onclick="handleConfirm()">
ยืนยันการจอง
</button>
      </div>

    </div><!-- end form-card -->
  </main>

  <!-- ==================== MODAL ==================== -->
  <div class="modal-overlay" id="modalOverlay" onclick="closeModalOnOverlay(event)">
    <div class="modal-box" id="modalBox">
      <div class="modal-header">
        <span class="modal-title" id="modalTitle">เครื่องใช้ไฟฟ้า</span>
        <button class="modal-close" onclick="closeModal()">✕</button>
      </div>
      <div class="modal-body">

        <!-- Device type -->
        <div class="modal-section-title">ประเภทเครื่องใช้ไฟฟ้า</div>

        <label class="radio-card" id="radioCardSmall">
          <input type="radio" name="deviceType" value="small" id="radioSmall" onchange="onDeviceTypeChange()" />
          <span class="radio-custom"></span>
          <div class="radio-card-content">
            <div class="radio-card-main">เครื่องใช้ไฟฟ้าเล็ก &nbsp;<u>เครื่องละ</u> <span class="price-tag">20 บาท/วัน</span></div>
            <div class="radio-card-warn">หมายเหตุ เครื่องใช้ไฟฟ้าขนาดเล็กต้องต่ำกว่า 1200 วัตต์<br/>เช่น เครื่องปั่น เครื่องปิ้งขนมปัง กาน้ำร้อน</div>
          </div>
        </label>

        <label class="radio-card" id="radioCardLarge">
          <input type="radio" name="deviceType" value="large" id="radioLarge" onchange="onDeviceTypeChange()" checked />
          <span class="radio-custom"></span>
          <div class="radio-card-content">
            <div class="radio-card-main">เครื่องใช้ไฟฟ้าใหญ่ &nbsp;<u>เครื่องละ</u> <span class="price-tag">40 บาท/วัน</span></div>
            <div class="radio-card-sub">เช่น กระทะไฟฟ้า เตาไฟฟ้า เตาอบ หม้อทอด ตู้แช่ ฯลฯ</div>
          </div>
        </label>

        <div class="modal-device-title" id="modalDeviceTitle">เครื่องใช้ไฟฟ้าขนาดใหญ่</div>

        <!-- Device form -->
        <div class="modal-form-grid">
          <div class="modal-field">
            <label class="modal-field-label">ชื่อเครื่องใช้ไฟฟ้า <span class="required">*</span></label>
            <input type="text" class="modal-input" id="deviceName" placeholder="" />
          </div>
          <div class="modal-field">
            <label class="modal-field-label">รายละเอียดเครื่องใช้ไฟฟ้า</label>
            <input type="text" class="modal-input" id="deviceDetail" placeholder="" />
          </div>
        </div>

        <div class="modal-field" style="margin-top:14px">
          <label class="modal-field-label">จำนวน</label>
          <input type="number" class="modal-input qty-input" id="deviceQty" placeholder="1" min="1" value="1" />
        </div>

        <!-- Device image upload -->
        <div class="modal-field" style="margin-top:14px">
          <label class="modal-field-label">รูปภาพเครื่องใช้ไฟฟ้า</label>
          <div class="upload-box upload-box-sm" id="deviceUploadBox" onclick="document.getElementById('deviceImageInput').click()">
            <input type="file" id="deviceImageInput" accept="image/*" style="display:none" onchange="previewImage(this,'deviceUploadBox')" />
            <div class="upload-placeholder" id="deviceUploadPlaceholder">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#bbb" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </div>
            <img id="deviceUploadPreview" class="upload-preview" style="display:none" alt="preview" />
          </div>
        </div>

      </div><!-- end modal-body -->

      <div class="modal-footer">
        <button class="btn-modal-cancel" onclick="closeModal()">ยกเลิก</button>
        <button class="btn-modal-add" id="modalAddBtn" onclick="addDevice()">เพิ่มเครื่องใช้ไฟฟ้า</button>
      </div>
    </div>
  </div>
  <!-- END MODAL -->

  <script src="book-stall.js"></script>
</body>
</html>
<style>
    /* ==========================================
   book-stall.css
   Night Market Stall Booking UI
   ========================================== */

:root {
  --primary:    #3BB8D4;
  --primary-lt: #A0E3F3;
  --primary-dk: #2a9ab5;
  --accent-add: #27C840;
  --accent-edit:#FFCA08;
  --accent-del: #E51837;
  --gray-bg:    #f4f5f7;
  --gray-border:#d8dde3;
  --gray-btn:   #b0b8c1;
  --text-main:  #1a1d23;
  --text-sub:   #6b7280;
  --white:      #ffffff;
  --warn-red:   #E51837;
  --radius-sm:  6px;
  --radius-md:  10px;
  --radius-lg:  14px;
  --shadow-card:0 2px 12px rgba(0,0,0,0.07);
  --shadow-modal:0 8px 40px rgba(0,0,0,0.18);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { font-size: 15px; }

body {
  font-family: 'Sarabun', sans-serif;
  background: var(--gray-bg);
  color: var(--text-main);
  min-height: 100vh;
}

/* ==========================================
   HEADER
   ========================================== */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--white);
  border-bottom: 1.5px solid var(--gray-border);
  display: flex;
  align-items: center;
  padding: 0 24px;
  height: 58px;
  box-shadow: 0 1px 6px rgba(0,0,0,0.06);
}

.btn-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border: none;
  background: transparent;
  cursor: pointer;
  border-radius: var(--radius-sm);
  color: var(--text-main);
  transition: background 0.15s;
}
.btn-back:hover { background: var(--gray-bg); }

.header-title {
  flex: 1;
  text-align: center;
  font-size: 1.2rem;
  font-weight: 700;
  letter-spacing: 0.01em;
  color: var(--text-main);
}

.header-spacer { width: 38px; }

/* ==========================================
   MAIN LAYOUT
   ========================================== */
.main-content {
  max-width: 720px;
  margin: 32px auto 60px;
  padding: 0 16px;
}

.form-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 32px 36px 36px;
}

/* ==========================================
   FORM FIELDS
   ========================================== */
.field-group {
  margin-bottom: 22px;
}

.field-label {
  display: block;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8px;
}

.field-input {
  width: 100%;
  padding: 11px 14px;
  background: var(--primary-lt);
  border: 1.5px solid transparent;
  border-radius: var(--radius-sm);
  font-family: 'Sarabun', sans-serif;
  font-size: 0.97rem;
  color: var(--text-main);
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.field-input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(59,184,212,0.13);
}
.field-input::placeholder { color: #a0b0bb; }

.field-textarea {
  resize: vertical;
  min-height: 80px;
}

/* ==========================================
   DATE ROW
   ========================================== */
.date-row {
  display: flex;
  gap: 20px;
  align-items: center;
  flex-wrap: wrap;
}

.date-item {
  display: flex;
  align-items: center;
  gap: 8px;
}

.date-label {
  font-size: 0.93rem;
  font-weight: 500;
  white-space: nowrap;
  color: var(--text-main);
}

.date-input {
  width: 170px;
  padding: 9px 12px;
}

/* ==========================================
   UPLOAD BOX
   ========================================== */
.upload-box {
  width: 72px;
  height: 72px;
  background: #e8ecef;
  border-radius: var(--radius-sm);
  border: 1.5px dashed var(--gray-border);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  overflow: hidden;
  position: relative;
  transition: border-color 0.2s, background 0.2s;
}
.upload-box:hover { border-color: var(--primary); background: #e0f6fb; }

.upload-box-sm { width: 60px; height: 60px; }

.upload-placeholder { display: flex; align-items: center; justify-content: center; }

.upload-preview {
  width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0;
}

/* ==========================================
   RADIO BUTTONS
   ========================================== */
.radio-group { display: flex; flex-direction: column; gap: 8px; }

.radio-label {
  display: flex;
  align-items: center;
  gap: 9px;
  cursor: pointer;
  font-size: 0.97rem;
  font-weight: 500;
  color: var(--text-main);
  user-select: none;
}

.radio-label input[type="radio"] { display: none; }

.radio-custom {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 2px solid #b0c4cc;
  background: #fff;
  flex-shrink: 0;
  position: relative;
  transition: border-color 0.2s;
}

.radio-label input[type="radio"]:checked ~ .radio-custom {
  border-color: var(--primary);
  background: var(--primary);
  box-shadow: inset 0 0 0 3px #fff;
}

/* ==========================================
   ELECTRICAL DEVICES TABLE
   ========================================== */
.table-wrapper {
  overflow-x: auto;
  border-radius: var(--radius-md);
  border: 1.5px solid var(--gray-border);
}

.elec-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.92rem;
}

.elec-table thead tr {
  background: var(--primary);
}

.elec-table thead th {
  padding: 10px 12px;
  text-align: left;
  color: var(--white);
  font-weight: 600;
  font-size: 0.9rem;
  white-space: nowrap;
}

.elec-table tbody tr {
  border-bottom: 1px solid #edf0f3;
  transition: background 0.12s;
}
.elec-table tbody tr:hover { background: #f7fbfd; }
.elec-table tbody tr:last-child { border-bottom: none; }

.elec-table tbody td {
  padding: 9px 12px;
  color: var(--text-main);
  vertical-align: middle;
}

.elec-table tfoot tr {
  border-top: 1.5px solid var(--gray-border);
  background: #fafbfc;
}

.elec-table tfoot td {
  padding: 10px 12px;
  vertical-align: middle;
}

.tfoot-label { font-weight: 600; color: var(--text-sub); }

.tfoot-sum {
  font-weight: 700;
  color: var(--text-main);
  font-size: 0.97rem;
}

.action-cell { display: flex; gap: 5px; align-items: center; }

/* ==========================================
   TABLE ACTION BUTTONS
   ========================================== */
.btn-edit, .btn-delete, .btn-add {
  border: none;
  border-radius: 5px;
  padding: 5px 12px;
  font-family: 'Sarabun', sans-serif;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.15s, transform 0.1s;
  white-space: nowrap;
}
.btn-edit:hover, .btn-delete:hover, .btn-add:hover { opacity: 0.85; transform: translateY(-1px); }

.btn-edit   { background: var(--accent-edit); color: #111; }
.btn-delete { background: var(--accent-del);  color: #fff; }
.btn-add    { background: var(--accent-add);  color: #fff; font-size: 0.85rem; padding: 6px 12px; }

/* ==========================================
   SUMMARY BOX
   ========================================== */
.summary-box {
  background: var(--primary-lt);
  border-radius: var(--radius-sm);
  padding: 16px 20px;
  margin-bottom: 24px;
  border: 1.5px solid rgba(59,184,212,0.25);
}

.summary-line {
  font-size: 0.97rem;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 4px;
  line-height: 1.6;
}
.summary-line:last-child { margin-bottom: 0; }

/* ==========================================
   TOTAL
   ========================================== */
.total-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 4px;
}

.total-label {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--text-main);
}

.total-amount {
  font-size: 1.65rem;
  font-weight: 800;
  color: var(--text-main);
}

.total-note {
  text-align: right;
  font-size: 0.82rem;
  color: var(--text-sub);
  margin-bottom: 28px;
}

/* ==========================================
   BOTTOM BUTTONS
   ========================================== */
.bottom-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.btn-cancel-main, .btn-confirm {
  width: 100%;
  padding: 15px 0;
  border: none;
  border-radius: var(--radius-md);
  font-family: 'Sarabun', sans-serif;
  font-size: 1.05rem;
  font-weight: 700;
  cursor: pointer;
  transition: opacity 0.15s, transform 0.1s, box-shadow 0.15s;
  letter-spacing: 0.01em;
}
.btn-cancel-main:hover, .btn-confirm:hover { opacity: 0.88; transform: translateY(-1px); }
.btn-cancel-main { background: var(--gray-btn); color: #fff; }
.btn-confirm { background: var(--primary); color: #fff; box-shadow: 0 4px 16px rgba(59,184,212,0.3); }

/* ==========================================
   MODAL
   ========================================== */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.22s, visibility 0.22s;
  padding: 16px;
}

.modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

.modal-box {
  background: var(--white);
  border-radius: var(--radius-lg);
  width: 100%;
  max-width: 520px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: var(--shadow-modal);
  transform: translateY(20px) scale(0.97);
  transition: transform 0.22s;
}

.modal-overlay.active .modal-box {
  transform: translateY(0) scale(1);
}

.modal-header {
  background: var(--primary);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 16px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--white);
}

.modal-close {
  background: rgba(255,255,255,0.2);
  border: none;
  color: var(--white);
  width: 32px;
  height: 32px;
  border-radius: 50%;
  font-size: 1rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s;
}
.modal-close:hover { background: rgba(255,255,255,0.35); }

.modal-body {
  padding: 24px 24px 8px;
}

.modal-section-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 14px;
}

/* Radio cards in modal */
.radio-card {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  padding: 12px 14px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  margin-bottom: 10px;
  border: 1.5px solid transparent;
  transition: border-color 0.15s, background 0.15s;
  background: #fafbfc;
}
.radio-card:hover { border-color: var(--primary-lt); background: #f0fafd; }
.radio-card input[type="radio"] { display: none; }

.radio-card .radio-custom {
  margin-top: 2px;
  flex-shrink: 0;
}
.radio-card input[type="radio"]:checked ~ .radio-custom {
  border-color: var(--primary);
  background: var(--primary);
  box-shadow: inset 0 0 0 3px #fff;
}

.radio-card-content { flex: 1; }
.radio-card-main { font-size: 0.93rem; font-weight: 600; color: var(--text-main); line-height: 1.4; }
.radio-card-warn { font-size: 0.82rem; color: var(--warn-red); margin-top: 4px; line-height: 1.5; }
.radio-card-sub  { font-size: 0.82rem; color: var(--text-sub);  margin-top: 4px; line-height: 1.5; }
.price-tag { color: var(--primary-dk); font-weight: 700; }

/* Device form title */
.modal-device-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-main);
  margin: 16px 0 12px;
  padding-top: 12px;
  border-top: 1.5px solid #eee;
}

/* Modal form grid */
.modal-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.modal-field { display: flex; flex-direction: column; gap: 6px; }
.modal-field-label { font-size: 0.88rem; font-weight: 600; color: var(--text-main); }
.required { color: var(--accent-del); }

.modal-input {
  padding: 9px 12px;
  border: 1.5px solid var(--gray-border);
  border-radius: var(--radius-sm);
  font-family: 'Sarabun', sans-serif;
  font-size: 0.92rem;
  color: var(--text-main);
  outline: none;
  transition: border-color 0.18s, box-shadow 0.18s;
  background: #fff;
}
.modal-input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(59,184,212,0.12);
}

.qty-input { width: 100px; }

/* Modal footer */
.modal-footer {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  padding: 18px 24px 22px;
  border-top: 1.5px solid #eee;
}

.btn-modal-cancel, .btn-modal-add {
  padding: 12px 0;
  border: none;
  border-radius: var(--radius-sm);
  font-family: 'Sarabun', sans-serif;
  font-size: 0.97rem;
  font-weight: 700;
  cursor: pointer;
  transition: opacity 0.15s, transform 0.1s;
}
.btn-modal-cancel:hover, .btn-modal-add:hover { opacity: 0.85; transform: translateY(-1px); }
.btn-modal-cancel { background: var(--gray-btn); color: #fff; }
.btn-modal-add    { background: var(--primary);   color: #fff; }

/* ==========================================
   SCROLLBAR STYLE (modal)
   ========================================== */
.modal-box::-webkit-scrollbar { width: 5px; }
.modal-box::-webkit-scrollbar-thumb { background: #c8d6dc; border-radius: 3px; }

/* ==========================================
   RESPONSIVE
   ========================================== */
@media (max-width: 600px) {
  .form-card { padding: 22px 16px 26px; }
  .modal-form-grid { grid-template-columns: 1fr; }
  .date-row { flex-direction: column; gap: 12px; }
  .date-input { width: 100%; }
  .bottom-buttons { grid-template-columns: 1fr; }
  .header-title { font-size: 1rem; }
}
</style>
<script>
    /**
 * book-stall.js
 * Night Market Stall Booking — Vanilla JS
 */

'use strict';

// ==========================================
// CONSTANTS
// ==========================================
const STALL_RENT_PER_DAY = 500;
const PRICE_SMALL        = 20;
const PRICE_LARGE        = 40;

// ==========================================
// STATE
// ==========================================
let editingRow = null; // reference to TR being edited

// ==========================================
// DOM HELPERS
// ==========================================
const $  = id => document.getElementById(id);
const el = (tag, cls, txt) => {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (txt !== undefined) e.textContent = txt;
  return e;
};

// ==========================================
// MODAL OPEN / CLOSE
// ==========================================
function openAddModal() {
  editingRow = null;
  resetModal();
  $('modalTitle').textContent   = 'เครื่องใช้ไฟฟ้า';
  $('modalAddBtn').textContent  = 'เพิ่มเครื่องใช้ไฟฟ้า';
  $('modalOverlay').classList.add('active');
  document.body.style.overflow  = 'hidden';
}

function openEditModal(btn) {
  const row = btn.closest('tr');
  editingRow = row;

  const cells    = row.querySelectorAll('td');
  const name     = cells[0].textContent.replace(/^\d+\./, '').trim();
  const typeText = cells[1].textContent.trim();
  const qty      = cells[2].textContent.trim();

  resetModal();

  // set device type radio
  if (typeText === 'ขนาดเล็ก') {
    $('radioSmall').checked = true;
  } else {
    $('radioLarge').checked = true;
  }
  onDeviceTypeChange();

  $('deviceName').value  = name;
  $('deviceQty').value   = qty;

  $('modalTitle').textContent  = 'แก้ไขเครื่องใช้ไฟฟ้า';
  $('modalAddBtn').textContent = 'บันทึกการแก้ไข';
  $('modalOverlay').classList.add('active');
  document.body.style.overflow = 'hidden';
}

function closeModal() {
  $('modalOverlay').classList.remove('active');
  document.body.style.overflow = '';
  editingRow = null;
}

function closeModalOnOverlay(e) {
  if (e.target === $('modalOverlay')) closeModal();
}

function resetModal() {
  $('deviceName').value   = '';
  $('deviceDetail').value = '';
  $('deviceQty').value    = '1';
  $('radioLarge').checked = true;
  onDeviceTypeChange();
  // reset image upload
  $('deviceUploadPreview').style.display     = 'none';
  $('deviceUploadPlaceholder').style.display = 'flex';
}

// ==========================================
// DEVICE TYPE CHANGE
// ==========================================
function onDeviceTypeChange() {
  const isSmall = $('radioSmall').checked;
  $('modalDeviceTitle').textContent = isSmall
    ? 'เครื่องใช้ไฟฟ้าขนาดเล็ก'
    : 'เครื่องใช้ไฟฟ้าขนาดใหญ่';
}

// ==========================================
// ADD / EDIT DEVICE
// ==========================================
function addDevice() {
  const name   = $('deviceName').value.trim();
  const detail = $('deviceDetail').value.trim();
  const qty    = parseInt($('deviceQty').value) || 1;
  const isSmall= $('radioSmall').checked;

  if (!name) {
    $('deviceName').focus();
    $('deviceName').style.borderColor = '#E51837';
    setTimeout(() => $('deviceName').style.borderColor = '', 1800);
    return;
  }

  const typeText = isSmall ? 'ขนาดเล็ก' : 'ขนาดใหญ่';
  const unitPrice= isSmall ? PRICE_SMALL : PRICE_LARGE;
  const total    = unitPrice * qty;

  const tbody    = $('elecTableBody');
  const rowCount = tbody.querySelectorAll('tr').length;

  if (editingRow) {
    // Update existing row
    const cells = editingRow.querySelectorAll('td');
    const num   = cells[0].textContent.match(/^\d+/)?.[0] ?? '';
    cells[0].textContent = `${num}.${name}`;
    cells[1].textContent = typeText;
    cells[2].textContent = qty;
    cells[3].textContent = total;
    editingRow.dataset.price = total;
    editingRow.dataset.type  = isSmall ? 'small' : 'large';
    editingRow.dataset.qty   = qty;
  } else {
    // New row
    const newNum = rowCount + 1;
    const tr     = document.createElement('tr');
    tr.dataset.price = total;
    tr.dataset.type  = isSmall ? 'small' : 'large';
    tr.dataset.qty   = qty;

    tr.innerHTML = `
      <td>${newNum}.${name}</td>
      <td>${typeText}</td>
      <td>${qty}</td>
      <td>${total}</td>
      <td class="action-cell">
        <button class="btn-edit"   onclick="openEditModal(this)">แก้ไข</button>
        <button class="btn-delete" onclick="deleteRow(this)">ลบ</button>
      </td>
    `;
    tbody.appendChild(tr);
  }

  renumberRows();
  recalcTotal();
  closeModal();
}

// ==========================================
// DELETE ROW
// ==========================================
function deleteRow(btn) {
  const row = btn.closest('tr');
  row.remove();
  renumberRows();
  recalcTotal();
}

// ==========================================
// RENUMBER ROWS
// ==========================================
function renumberRows() {
  const rows = $('elecTableBody').querySelectorAll('tr');
  rows.forEach((row, i) => {
    const cell = row.querySelector('td:first-child');
    const name = cell.textContent.replace(/^\d+\./, '').trim();
    cell.textContent = `${i + 1}.${name}`;
  });
}

// ==========================================
// RECALCULATE TOTAL
// ==========================================
function recalcTotal() {
  // Sum devices
  const rows = $('elecTableBody').querySelectorAll('tr');
  let elecSum = 0;
  rows.forEach(r => { elecSum += parseInt(r.dataset.price || 0); });
  $('elecSum').textContent = elecSum + ' บาท';

  // Days
  const startVal = $('dateStart').value;
  const endVal   = $('dateEnd').value;
  let days = 1;
  if (startVal && endVal) {
    const start = new Date(startVal);
    const end   = new Date(endVal);
    const diff  = Math.round((end - start) / (1000 * 60 * 60 * 24));
    if (diff > 0) days = diff;
  }

  const rentTotal  = STALL_RENT_PER_DAY * days;
  const grandTotal = rentTotal + elecSum;

  $('totalAmount').textContent = grandTotal.toLocaleString('th-TH') + ' บาท';
}

// ==========================================
// IMAGE PREVIEW UPLOAD
// ==========================================
function previewImage(input, boxId) {
  const box = document.getElementById(boxId);
  if (!box) return;
  const file = input.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = e => {
    const preview = box.querySelector('.upload-preview');
    const placeholder = box.querySelector('.upload-placeholder');
    if (preview) { preview.src = e.target.result; preview.style.display = 'block'; }
    if (placeholder) placeholder.style.display = 'none';
  };
  reader.readAsDataURL(file);
}

// ==========================================
// CONFIRM BOOKING
// ==========================================
function handleConfirm() {

  const name  = $('fullname').value.trim();
  const phone = $('phone').value.trim();
  const start = $('dateStart').value;
  const end   = $('dateEnd').value;

  if (!name)  { 
    alert('กรุณากรอกชื่อ-นามสกุล'); 
    $('fullname').focus(); 
    return; 
  }

  if (!phone) { 
    alert('กรุณากรอกเบอร์โทรศัพท์'); 
    $('phone').focus(); 
    return; 
  }

  if (!start || !end) { 
    alert('กรุณาเลือกวันที่เช่า'); 
    return; 
  }

  alert("ส่งคำขอจองเรียบร้อย");

  // 👉 redirect ไปหน้าสถานะ
  window.location.href = "/booking-status";

}
// ==========================================
// INIT
// ==========================================
document.addEventListener('DOMContentLoaded', () => {
  recalcTotal();

  // Keyboard: Escape to close modal
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeModal();
  });
});
</script>