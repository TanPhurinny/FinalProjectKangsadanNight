<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ลาหยุด / ปล่อยเช่าช่วง — ตลาดกังสดาลไนท์</title>
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20261023-ios">
    <link rel="stylesheet" href="/stylesheets/partials/shopSwitch.css?v=20261027">
    <link rel="stylesheet" href="/stylesheets/eventBooth.css?v=20261026">
    <link rel="stylesheet" href="/stylesheets/seller/stallLeave.css?v=20261028-sublet">
</head>
<body class="eb-body">
    <script src="/js/common/tabSession.js"></script>
    <%- include('../partials/navbarSeller') %>

    <main class="eb-page">
        <header class="eb-head">
            <div>
                <p class="eb-kicker">จัดการร้าน · แผงของฉัน</p>
                <h1 class="eb-title">ลาหยุด / ปล่อยเช่าช่วง</h1>
                <p class="eb-lead">ไม่สะดวกมาขายบางวันในช่วงสัญญา แจ้งลาหยุด หรือให้ร้านอื่นที่เป็นสมาชิกตลาดมาขายแทนชั่วคราว
                    แอดมินพิจารณาก่อนทุกครั้ง ไม่มีการคืนค่าเช่าผ่านระบบ (เงินค่าเช่าช่วงตกลงกันเองระหว่างร้าน) แผงยังเป็นของร้านคุณตามสัญญาเดิม</p>
            </div>
            <a class="eb-zone-tag" href="/stall-leave"><i class="fa-solid fa-list"></i> คำขอของฉัน</a>
        </header>

        <%- include('../partials/shopSwitch', { shops: shops, selectedShopId: shop && shop.id, href: function (id) { return '/stall-leave/new?shop=' + id + (kind === 'LEAVE' ? '' : '&kind=sublet'); }, label: 'ร้าน' }) %>

        <% if (error) { %>
        <div class="eb-notice eb-notice--danger" role="alert"><%= error %></div>
        <% } %>

        <% if (!stalls.length) { %>
        <div class="eb-empty">ร้าน<%= shop && shop.shopName ? ` ${shop.shopName}` : '' %>ยังไม่มีแผงที่ชำระเงินแล้วและสัญญายังไม่หมด จึงยังแจ้งลาหยุดไม่ได้</div>
        <% } else { %>
        <form method="POST" action="/stall-leave" class="eb-form sl-form" id="stallLeaveForm">
            <input type="hidden" name="shopId" value="<%= shop.id %>">
            <section class="eb-section">
                <div class="eb-section-head">
                    <div>
                        <h2 class="eb-section-title">1. ต้องการทำอะไร</h2>
                    </div>
                </div>
                <div class="sl-kinds" role="radiogroup" aria-label="ประเภทคำขอ">
                    <label class="sl-stall">
                        <input type="radio" name="kind" value="LEAVE" <%= kind === 'LEAVE' ? 'checked' : '' %>>
                        <b>ลาหยุด</b>
                        <small>ไม่มาขาย แผงว่างในวันนั้น</small>
                    </label>
                    <label class="sl-stall">
                        <input type="radio" name="kind" value="SUBLET_MEMBER" <%= kind === 'SUBLET_MEMBER' ? 'checked' : '' %>>
                        <b>ให้ร้านสมาชิกเช่าช่วง</b>
                        <small>ร้านอื่นในตลาดมาขายแทนชั่วคราว</small>
                    </label>
                </div>
            </section>

            <section class="eb-section">
                <div class="eb-section-head">
                    <div>
                        <h2 class="eb-section-title">2. เลือกแผง</h2>
                        <p class="eb-section-hint">แผงของร้าน <b><%= shop.shopName || 'ร้านยังไม่ตั้งชื่อ' %></b> ที่ชำระเงินแล้ว</p>
                    </div>
                </div>
                <div class="sl-stalls" role="radiogroup" aria-label="แผง">
                    <% stalls.forEach(function (s, i) { const checked = values.stallCode ? values.stallCode === s.code : i === 0; %>
                    <label class="sl-stall">
                        <input type="radio" name="stallCode" value="<%= s.code %>" required <%= checked ? 'checked' : '' %>
                               data-min="<%= s.contractStartKey > earliestKey ? s.contractStartKey : earliestKey %>" data-max="<%= s.contractEndKey %>">
                        <b><%= s.code %></b>
                        <small>สัญญา <%= s.contractText %></small>
                    </label>
                    <% }) %>
                </div>
            </section>

            <section class="eb-section" id="subtenantSection" <%= kind === 'SUBLET_MEMBER' ? '' : 'hidden' %>>
                <div class="eb-section-head">
                    <div>
                        <h2 class="eb-section-title">3. ร้านที่จะมาขายแทน</h2>
                        <p class="eb-section-hint">ค้นจากชื่อร้าน หรือเบอร์โทรเต็ม 10 หลักของเจ้าของร้าน · ร้านนั้นต้องกดตอบรับก่อน คำขอถึงจะส่งให้แอดมิน</p>
                    </div>
                </div>
                <input type="hidden" name="subShopId" id="subShopId" value="<%= subShop ? subShop.id : '' %>">
                <div class="sl-picked" id="subPicked" <%= subShop ? '' : 'hidden' %>>
                    <span id="subPickedText"><% if (subShop) { %><b><%= subShop.shopName %></b> · <%= subShop.productType || '-' %><%= subShop.productSubtype ? ` (${subShop.productSubtype})` : '' %><% } %></span>
                    <button type="button" class="eb-btn eb-btn--ghost eb-btn--sm" id="subClear">เปลี่ยนร้าน</button>
                </div>
                <div class="sl-search" id="subSearchBox" <%= subShop ? 'hidden' : '' %>>
                    <input class="eb-input" id="subSearch" type="search" maxlength="60" autocomplete="off" placeholder="ชื่อร้าน หรือ 08xxxxxxxx" aria-label="ค้นหาร้านสมาชิก">
                    <ul class="sl-results" id="subResults" aria-live="polite"></ul>
                </div>
            </section>

            <section class="eb-section">
                <div class="eb-section-head">
                    <div>
                        <h2 class="eb-section-title"><span data-step-num><%= kind === 'SUBLET_MEMBER' ? '4' : '3' %></span>. วันที่ และเหตุผล</h2>
                        <p class="eb-section-hint">แจ้งวันนี้ได้ถึง <%= cutoffHour %>:00 น. · ครั้งละไม่เกิน <%= maxDays %> วัน · ลาวันเดียวเลือกวันเริ่มกับวันสิ้นสุดเป็นวันเดียวกัน</p>
                    </div>
                </div>
                <div class="eb-fields">
                    <div class="eb-field">
                        <label for="startDate">วันเริ่ม <span class="eb-must">*</span></label>
                        <input class="eb-input" id="startDate" name="startDate" type="date" required min="<%= earliestKey %>" value="<%= values.startDate || '' %>">
                    </div>
                    <div class="eb-field">
                        <label for="endDate">วันสิ้นสุด <span class="eb-must">*</span></label>
                        <input class="eb-input" id="endDate" name="endDate" type="date" required min="<%= earliestKey %>" value="<%= values.endDate || '' %>">
                    </div>
                    <div class="eb-field eb-field--full">
                        <label for="reason">เหตุผล <span class="eb-must">*</span></label>
                        <textarea class="eb-input" id="reason" name="reason" maxlength="1000" required placeholder="เช่น ป่วย, ติดธุระต่างจังหวัด, ซ่อมอุปกรณ์ร้าน"><%= values.reason || '' %></textarea>
                    </div>
                </div>
            </section>

            <div class="eb-actions">
                <button type="submit" class="eb-btn" id="submitBtn"><i class="fa-solid fa-paper-plane"></i> <span><%= kind === 'SUBLET_MEMBER' ? 'ส่งคำขอเช่าช่วง' : 'ส่งคำขอลาหยุด' %></span></button>
                <span class="eb-actions-note">แอดมินจะพิจารณาและแจ้งผลในหน้าแจ้งเตือน</span>
            </div>
        </form>
        <% } %>
    </main>

    <script>
        // ช่วงวันที่เลือกได้ตามสัญญาของแผงที่เลือก (ตรวจซ้ำฝั่ง server เสมอ — utils/stallLeave.js)
        (function () {
            const form = document.getElementById('stallLeaveForm');
            if (!form) return;
            const start = document.getElementById('startDate');
            const end = document.getElementById('endDate');
            function sync() {
                const picked = form.querySelector('input[name="stallCode"]:checked');
                if (!picked) return;
                [start, end].forEach((input) => { input.min = picked.dataset.min; input.max = picked.dataset.max; });
                if (start.value) end.min = start.value > picked.dataset.min ? start.value : picked.dataset.min;
                if (start.value && !end.value) end.value = start.value;
            }
            form.addEventListener('change', sync);
            sync();

            // ประเภทคำขอ: เช่าช่วงต้องเลือกร้านผู้รับ
            const subSection = document.getElementById('subtenantSection');
            const stepNum = form.querySelector('[data-step-num]');
            const submitText = document.querySelector('#submitBtn span');
            const subId = document.getElementById('subShopId');
            function syncKind() {
                const sublet = form.querySelector('input[name="kind"]:checked').value === 'SUBLET_MEMBER';
                subSection.hidden = !sublet;
                stepNum.textContent = sublet ? '4' : '3';
                submitText.textContent = sublet ? 'ส่งคำขอเช่าช่วง' : 'ส่งคำขอลาหยุด';
            }
            form.querySelectorAll('input[name="kind"]').forEach((input) => input.addEventListener('change', syncKind));
            form.addEventListener('submit', (e) => {
                const sublet = form.querySelector('input[name="kind"]:checked').value === 'SUBLET_MEMBER';
                if (sublet && !subId.value) {
                    e.preventDefault();
                    document.getElementById('subSearch').focus();
                    window.showAlertDialog({ title: 'ยังไม่ได้เลือกร้าน', message: 'ค้นหาและเลือกร้านที่จะมาขายแทนก่อนส่งคำขอ', tone: 'warning' });
                }
            });

            // ค้นร้านสมาชิก (GET /api/market-members/search) — รอพิมพ์เสร็จ 350ms ค่อยค้น
            const search = document.getElementById('subSearch');
            const results = document.getElementById('subResults');
            const picked = document.getElementById('subPicked');
            const pickedText = document.getElementById('subPickedText');
            const searchBox = document.getElementById('subSearchBox');
            const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            let timer = null;
            let seq = 0;
            search.addEventListener('input', () => {
                clearTimeout(timer);
                timer = setTimeout(run, 350);
            });
            async function run() {
                const q = search.value.trim();
                if (q.length < 2) { results.innerHTML = ''; return; }
                const mine = ++seq;
                try {
                    const response = await fetch('/api/market-members/search?q=' + encodeURIComponent(q), { headers: { Accept: 'application/json' } });
                    const payload = await response.json();
                    if (mine !== seq) return;
                    if (!response.ok || !payload.success) throw new Error(payload.message || 'ค้นหาไม่สำเร็จ');
                    results.innerHTML = payload.shops.length
                        ? payload.shops.map((shop) => `
                            <li><button type="button" class="sl-result" data-id="${shop.id}" data-label="${esc(`${shop.shopName} · ${shop.productType || '-'}${shop.productSubtype ? ` (${shop.productSubtype})` : ''}`)}">
                                ${shop.image ? `<img src="${esc(shop.image)}" alt="">` : '<span class="sl-result__ph"><i class="fa-solid fa-store"></i></span>'}
                                <span><b>${esc(shop.shopName)}</b><small>${esc(shop.productType || '-')}${shop.productSubtype ? ` · ${esc(shop.productSubtype)}` : ''}${shop.phoneMasked ? ` · ${esc(shop.phoneMasked)}` : ''}</small></span>
                            </button></li>`).join('')
                        : '<li class="sl-results__empty">ไม่พบร้าน (ชื่อร้าน หรือเบอร์โทรต้องครบ 10 หลัก)</li>';
                } catch (error) {
                    results.innerHTML = `<li class="sl-results__empty">${esc(error.message)}</li>`;
                }
            }
            results.addEventListener('click', (e) => {
                const btn = e.target.closest('.sl-result');
                if (!btn) return;
                subId.value = btn.dataset.id;
                pickedText.innerHTML = `<b>${esc(btn.dataset.label)}</b>`;
                picked.hidden = false;
                searchBox.hidden = true;
                results.innerHTML = '';
            });
            document.getElementById('subClear').addEventListener('click', () => {
                subId.value = '';
                picked.hidden = true;
                searchBox.hidden = false;
                search.value = '';
                search.focus();
            });
        })();
    </script>
    <script src="/js/common/dialogs.js?v=20261023-input"></script>
</body>
</html>
