<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ลาหยุด / ปล่อยเช่าช่วง — ตลาดกังสดาลไนท์</title>
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20261023-ios">
    <link rel="stylesheet" href="/stylesheets/partials/shopSwitch.css?v=20261028">
    <link rel="stylesheet" href="/stylesheets/seller/stallLeave.css?v=20261028-edit2">
</head>
<body class="sl-body">
    <script src="/js/common/tabSession.js"></script>
    <%- include('../partials/navbarSeller') %>
    <%
        const isEdit = typeof editing !== 'undefined' && editing;
        const SUBMIT_TEXT = isEdit
            ? { LEAVE: 'บันทึกการแก้ไข', SUBLET_MEMBER: 'บันทึกการแก้ไข', SUBLET_GUEST: 'บันทึกการแก้ไข' }
            : { LEAVE: 'ส่งคำขอลาหยุด', SUBLET_MEMBER: 'ส่งคำขอเช่าช่วง', SUBLET_GUEST: 'สร้างลิงก์ให้คนนอกกรอกข้อมูล' };
        // หลังแก้ คำขอต้องผ่านขั้นตอนใหม่ (utils/stallLeave.js updateRequest)
        const EDIT_NOTE = {
            LEAVE: 'บันทึกแล้วคำขอกลับไปรอแอดมินพิจารณาใหม่',
            SUBLET_MEMBER: 'ถ้าเปลี่ยนวันหรือเปลี่ยนร้าน ร้านผู้รับต้องกดตอบรับใหม่ แล้วจึงส่งต่อให้แอดมิน · แก้แค่เหตุผล คำขอกลับไปรอแอดมิน',
            SUBLET_GUEST: 'ถ้าคนนอกกรอกข้อมูลแล้ว คำขอกลับไปรอแอดมินพิจารณาใหม่ · ยังไม่กรอก ลิงก์เดิมใช้ต่อได้'
        };
    %>

    <main class="sl-page">
        <header class="sl-head">
            <div>
                <p class="sl-kicker">จัดการร้าน · แผงของฉัน</p>
                <h1 class="sl-title"><%= isEdit ? `แก้ไขคำขอ #${editing.id}` : 'ลาหยุด / ปล่อยเช่าช่วง' %></h1>
                <% if (isEdit) { %>
                <p class="sl-lead">สถานะตอนนี้: <b><%= editing.statusLabel %></b> · แก้ได้ถึง <%= changeCutoffHour %>:00 น. ของวันเริ่ม (เวลาตลาดเปิด) · <%= EDIT_NOTE[kind] %> · เปลี่ยนประเภทคำขอหรือแผงไม่ได้ ให้ยกเลิกแล้วขอใหม่</p>
                <% } else { %>
                <p class="sl-lead">แผงยังเป็นของร้านคุณตามสัญญาเดิม ไม่มีการคืนค่าเช่าผ่านระบบ ค่าเช่าช่วงตกลงกันเองระหว่างร้าน แอดมินพิจารณาทุกคำขอก่อนมีผล</p>
                <% } %>
            </div>
            <div class="sl-head__actions">
                <a class="sl-btn sl-btn--line" href="/stall-leave"><i class="fa-solid fa-list" aria-hidden="true"></i> คำขอของฉัน</a>
            </div>
        </header>

        <% if (!isEdit) { %>
        <%- include('../partials/shopSwitch', { shops: shops, selectedShopId: shop && shop.id, href: function (id) { return '/stall-leave/new?shop=' + id + ({ SUBLET_MEMBER: '&kind=sublet', SUBLET_GUEST: '&kind=guest' }[kind] || ''); }, label: 'ร้าน' }) %>
        <% } %>

        <% if (error) { %>
        <div class="sl-notice sl-notice--bad" role="alert"><%= error %></div>
        <% } %>

        <% if (!stalls.length) { %>
        <div class="sl-empty" style="margin-top:24px"><b>ร้าน<%= shop && shop.shopName ? ` ${shop.shopName}` : '' %>ยังไม่มีแผงที่ใช้ได้</b>ต้องมีแผงที่ชำระเงินแล้วและสัญญายังไม่หมด ถึงจะแจ้งลาหยุดหรือปล่อยเช่าช่วงได้ · <a href="/select-zone<%= shop ? `?shop=${shop.id}` : '' %>">จองแผง</a></div>
        <% } else { %>
        <form method="POST" action="<%= isEdit ? `/stall-leave/${editing.id}/edit` : '/stall-leave' %>" class="sl-form" id="stallLeaveForm">
            <input type="hidden" name="shopId" value="<%= shop.id %>">

            <section class="sl-step" aria-labelledby="stepKind">
                <span class="sl-step__num">1</span>
                <div>
                    <h2 class="sl-step__title" id="stepKind">ต้องการทำอะไร</h2>
                    <p class="sl-step__hint"><%= isEdit ? 'ประเภทคำขอแก้ไม่ได้ ถ้าต้องการเปลี่ยนให้ยกเลิกคำขอนี้แล้วขอใหม่' : 'วันที่ได้รับอนุมัติ ผังตลาดจะแสดงสถานะของแผงให้ลูกค้าและเจ้าหน้าที่เห็น' %></p>
                    <div class="sl-choices" role="radiogroup" aria-labelledby="stepKind">
                        <label class="sl-choice">
                            <input type="radio" name="kind" value="LEAVE" <%= kind === 'LEAVE' ? 'checked' : '' %> <%= isEdit && kind !== 'LEAVE' ? 'disabled' : '' %>>
                            <i class="fa-solid fa-calendar-minus" aria-hidden="true"></i>
                            <b>ลาหยุด</b>
                            <small>ไม่มาขาย ผังขึ้นว่าร้านลาหยุด และไม่ต้องตรวจตลาดวันนั้น</small>
                        </label>
                        <label class="sl-choice">
                            <input type="radio" name="kind" value="SUBLET_MEMBER" <%= kind === 'SUBLET_MEMBER' ? 'checked' : '' %> <%= isEdit && kind !== 'SUBLET_MEMBER' ? 'disabled' : '' %>>
                            <i class="fa-solid fa-handshake" aria-hidden="true"></i>
                            <b>ให้ร้านสมาชิกเช่าช่วง</b>
                            <small>ร้านอื่นในตลาดมาขายแทน ร้านนั้นต้องกดตอบรับก่อน</small>
                        </label>
                        <label class="sl-choice">
                            <input type="radio" name="kind" value="SUBLET_GUEST" <%= kind === 'SUBLET_GUEST' ? 'checked' : '' %> <%= isEdit && kind !== 'SUBLET_GUEST' ? 'disabled' : '' %>>
                            <i class="fa-solid fa-link" aria-hidden="true"></i>
                            <b>ให้คนนอกตลาดเช่าช่วง</b>
                            <small>ได้ลิงก์ส่งให้เขากรอกข้อมูลและรูปสินค้าเอง</small>
                        </label>
                    </div>
                </div>
            </section>

            <section class="sl-step" aria-labelledby="stepStall">
                <span class="sl-step__num">2</span>
                <div>
                    <h2 class="sl-step__title" id="stepStall">เลือกแผง</h2>
                    <p class="sl-step__hint">แผงของร้าน <b><%= shop.shopName || 'ร้านยังไม่ตั้งชื่อ' %></b> ที่ชำระเงินแล้ว เลือกวันได้เฉพาะในช่วงสัญญา</p>
                    <div class="sl-choices sl-choices--stalls" role="radiogroup" aria-labelledby="stepStall">
                        <% stalls.forEach(function (s, i) { const checked = values.stallCode ? values.stallCode === s.code : i === 0; %>
                        <label class="sl-choice">
                            <input type="radio" name="stallCode" value="<%= s.code %>" required <%= checked ? 'checked' : '' %>
                                   data-min="<%= s.contractStartKey > earliestKey ? s.contractStartKey : earliestKey %>" data-max="<%= s.contractEndKey %>">
                            <b class="sl-choice__code"><%= s.code %></b>
                            <small>สัญญา <%= s.contractText %></small>
                        </label>
                        <% }) %>
                    </div>
                </div>
            </section>

            <section class="sl-step" id="subtenantSection" aria-labelledby="stepSub" <%= kind === 'SUBLET_MEMBER' ? '' : 'hidden' %>>
                <span class="sl-step__num">3</span>
                <div>
                    <h2 class="sl-step__title" id="stepSub">ร้านที่จะมาขายแทน</h2>
                    <p class="sl-step__hint">ค้นจากชื่อร้าน หรือเบอร์โทรเต็ม 10 หลักของเจ้าของร้าน</p>
                    <input type="hidden" name="subShopId" id="subShopId" value="<%= subShop ? subShop.id : '' %>">
                    <div class="sl-picked" id="subPicked" <%= subShop ? '' : 'hidden' %>>
                        <span id="subPickedText"><% if (subShop) { %><b><%= subShop.shopName %> · <%= subShop.productType || '-' %><%= subShop.productSubtype ? ` (${subShop.productSubtype})` : '' %></b><% } %></span>
                        <button type="button" class="sl-btn sl-btn--line sl-btn--sm" id="subClear">เปลี่ยนร้าน</button>
                    </div>
                    <div class="sl-search" id="subSearchBox" <%= subShop ? 'hidden' : '' %>>
                        <input class="sl-input" id="subSearch" type="search" maxlength="60" autocomplete="off" placeholder="ชื่อร้าน หรือ 08xxxxxxxx" aria-label="ค้นหาร้านสมาชิก">
                        <ul class="sl-results" id="subResults" aria-live="polite"></ul>
                    </div>
                </div>
            </section>

            <section class="sl-step" aria-labelledby="stepDate">
                <span class="sl-step__num" data-step-num><%= kind === 'SUBLET_MEMBER' ? '4' : '3' %></span>
                <div>
                    <h2 class="sl-step__title" id="stepDate">วันที่ และเหตุผล</h2>
                    <p class="sl-step__hint">แจ้งวันนี้ได้ถึง <%= cutoffHour %>:00 น. · ยกเลิก/แก้ไขได้ถึง <%= changeCutoffHour %>:00 น. ของวันเริ่ม · ครั้งละไม่เกิน <%= maxDays %> วัน · วันเดียวให้เลือกวันเริ่มกับวันสิ้นสุดเป็นวันเดียวกัน</p>
                    <div class="sl-fields">
                        <div class="sl-field">
                            <label for="startDate">วันเริ่ม <em>*</em></label>
                            <input class="sl-input" id="startDate" name="startDate" type="date" required min="<%= earliestKey %>" value="<%= values.startDate || '' %>">
                        </div>
                        <div class="sl-field">
                            <label for="endDate">วันสิ้นสุด <em>*</em></label>
                            <input class="sl-input" id="endDate" name="endDate" type="date" required min="<%= earliestKey %>" value="<%= values.endDate || '' %>">
                        </div>
                        <div class="sl-field sl-field--full">
                            <label for="reason">เหตุผล <em>*</em> <span>แอดมินใช้ประกอบการพิจารณา</span></label>
                            <textarea class="sl-input" id="reason" name="reason" maxlength="1000" required placeholder="เช่น ป่วย ติดธุระต่างจังหวัด ซ่อมอุปกรณ์ร้าน"><%= values.reason || '' %></textarea>
                        </div>
                    </div>
                </div>
            </section>

            <div class="sl-submit">
                <button type="submit" class="sl-btn" id="submitBtn"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> <span><%= SUBMIT_TEXT[kind] %></span></button>
                <% if (isEdit) { %><a class="sl-btn sl-btn--line" href="/stall-leave#leave-<%= editing.id %>">ยกเลิกการแก้ไข</a><% } %>
                <small><%= isEdit ? EDIT_NOTE[kind] : 'ผลการพิจารณาจะแจ้งในหน้าแจ้งเตือน' %></small>
            </div>
        </form>
        <% } %>
    </main>

    <script src="/js/common/dialogs.js?v=20261023-input"></script>
    <script>
        // ช่วงวันที่เลือกได้ตามสัญญาของแผงที่เลือก (ตรวจซ้ำฝั่ง server เสมอ — utils/stallLeave.js)
        (function () {
            const form = document.getElementById('stallLeaveForm');
            if (!form) return;
            const start = document.getElementById('startDate');
            const end = document.getElementById('endDate');
            function sync() {
                const picked = form.querySelector('input[name="stallCode"]:checked');
                if (!picked) return;
                [start, end].forEach((input) => { input.min = picked.dataset.min; input.max = picked.dataset.max; });
                if (start.value) end.min = start.value > picked.dataset.min ? start.value : picked.dataset.min;
                if (start.value && !end.value) end.value = start.value;
            }
            form.addEventListener('change', sync);
            sync();

            // ประเภทคำขอ: เช่าช่วงให้สมาชิกต้องเลือกร้านผู้รับ (ขั้นที่ 3)
            const subSection = document.getElementById('subtenantSection');
            const stepNum = form.querySelector('[data-step-num]');
            const submitText = document.querySelector('#submitBtn span');
            const subId = document.getElementById('subShopId');
            const SUBMIT_TEXT = <%- JSON.stringify(SUBMIT_TEXT) %>;
            function syncKind() {
                const kind = form.querySelector('input[name="kind"]:checked').value;
                const sublet = kind === 'SUBLET_MEMBER';
                subSection.hidden = !sublet;
                stepNum.textContent = sublet ? '4' : '3';
                submitText.textContent = SUBMIT_TEXT[kind];
            }
            form.querySelectorAll('input[name="kind"]').forEach((input) => input.addEventListener('change', syncKind));
            form.addEventListener('submit', (e) => {
                const sublet = form.querySelector('input[name="kind"]:checked').value === 'SUBLET_MEMBER';
                if (sublet && !subId.value) {
                    e.preventDefault();
                    document.getElementById('subSearch').focus();
                    window.showAlertDialog({ title: 'ยังไม่ได้เลือกร้าน', message: 'ค้นหาและเลือกร้านที่จะมาขายแทนก่อนส่งคำขอ', tone: 'warning' });
                }
            });

            // ค้นร้านสมาชิก (GET /api/market-members/search) — รอพิมพ์เสร็จ 350ms ค่อยค้น
            const search = document.getElementById('subSearch');
            const results = document.getElementById('subResults');
            const picked = document.getElementById('subPicked');
            const pickedText = document.getElementById('subPickedText');
            const searchBox = document.getElementById('subSearchBox');
            const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            let timer = null;
            let seq = 0;
            search.addEventListener('input', () => {
                clearTimeout(timer);
                timer = setTimeout(run, 350);
            });
            async function run() {
                const q = search.value.trim();
                if (q.length < 2) { results.innerHTML = ''; return; }
                const mine = ++seq;
                try {
                    const response = await fetch('/api/market-members/search?q=' + encodeURIComponent(q), { headers: { Accept: 'application/json' } });
                    const payload = await response.json();
                    if (mine !== seq) return;
                    if (!response.ok || !payload.success) throw new Error(payload.message || 'ค้นหาไม่สำเร็จ');
                    results.innerHTML = payload.shops.length
                        ? payload.shops.map((shop) => `
                            <li><button type="button" class="sl-result" data-id="${shop.id}" data-label="${esc(`${shop.shopName} · ${shop.productType || '-'}${shop.productSubtype ? ` (${shop.productSubtype})` : ''}`)}">
                                ${shop.image ? `<img src="${esc(shop.image)}" alt="">` : '<span class="sl-result__ph"><i class="fa-solid fa-store" aria-hidden="true"></i></span>'}
                                <span><b>${esc(shop.shopName)}</b><small>${esc(shop.productType || '-')}${shop.productSubtype ? ` · ${esc(shop.productSubtype)}` : ''}${shop.phoneMasked ? ` · ${esc(shop.phoneMasked)}` : ''}</small></span>
                            </button></li>`).join('')
                        : '<li class="sl-results__empty">ไม่พบร้าน (ชื่อร้าน หรือเบอร์โทรต้องครบ 10 หลัก)</li>';
                } catch (error) {
                    results.innerHTML = `<li class="sl-results__empty">${esc(error.message)}</li>`;
                }
            }
            results.addEventListener('click', (e) => {
                const btn = e.target.closest('.sl-result');
                if (!btn) return;
                subId.value = btn.dataset.id;
                pickedText.innerHTML = `<b>${esc(btn.dataset.label)}</b>`;
                picked.hidden = false;
                searchBox.hidden = true;
                results.innerHTML = '';
            });
            document.getElementById('subClear').addEventListener('click', () => {
                subId.value = '';
                picked.hidden = true;
                searchBox.hidden = false;
                search.value = '';
                search.focus();
            });
        })();
    </script>
</body>
</html>
