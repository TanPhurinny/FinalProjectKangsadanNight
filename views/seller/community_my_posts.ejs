<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>โพสต์ของฉัน - คอมมูนิตี้</title>
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20261023-ios" />
  <!-- ใช้ token/ปุ่ม/ป้ายชุดเดียวกับหน้าฟีด แล้วเสริมเฉพาะเลย์เอาต์ของหน้านี้ -->
  <link rel="stylesheet" href="/stylesheets/seller/comunity.css?v=20261024-4" />
  <link rel="stylesheet" href="/stylesheets/seller/community-my-posts.css?v=20261024-1" />
</head>
<%
  const safeJson = (value) => JSON.stringify(value).replace(/</g, '\\u003c');
  const catColor = (category) => (categoryColors && categoryColors[category]) || defaultCategoryColor;
%>
<body class="community-body">
<script src="/js/common/tabSession.js"></script>
<% if (user && user.role === 'SELLER' && !viewAsCustomer) { %>
<%- include('../partials/navbarSeller') %>
<% } else { %>
<%- include('../partials/navbarCustomer') %>
<% } %>

<script type="application/json" id="myPostsData"><%- safeJson({
  posts: posts || [],
  categoryIcons: categoryIcons || {},
  defaultCategoryIcon: defaultCategoryIcon,
  categoryColors: categoryColors || {},
  defaultCategoryColor: defaultCategoryColor
}) %></script>

<div class="cm-page mp-page">
  <header class="cm-head">
    <div class="cm-head__text">
      <p class="cm-eyebrow"><a href="/community" class="mp-crumb">คอมมูนิตี้</a> / โพสต์ของฉัน</p>
      <h1 class="cm-head__title">โพสต์ของฉัน</h1>
      <p class="cm-head__lede">ดูว่าโพสต์ไหนคนสนใจ แก้ไขหรือลบโพสต์ของร้านคุณได้ในที่เดียว</p>
    </div>
    <div class="cm-head__actions mp-head-actions">
      <a href="/community" class="cm-btn cm-btn--ghost"><i class="bi bi-arrow-left"></i>กลับฟีด</a>
      <a href="/community?compose=1" class="cm-btn cm-btn--primary"><i class="bi bi-pencil-square"></i>เขียนโพสต์</a>
    </div>
  </header>

  <section class="mp-stats" aria-label="สรุปโพสต์ของคุณ">
    <div class="mp-stat"><span class="mp-stat__label">โพสต์ทั้งหมด</span><span class="mp-stat__value" id="statPosts">0</span></div>
    <div class="mp-stat"><span class="mp-stat__label">ถูกใจรวม</span><span class="mp-stat__value" id="statLikes">0</span></div>
    <div class="mp-stat"><span class="mp-stat__label">คอมเมนต์รวม</span><span class="mp-stat__value" id="statComments">0</span></div>
    <div class="mp-stat mp-stat--wide">
      <span class="mp-stat__label"><i class="bi bi-fire"></i>โพสต์ที่คนสนใจที่สุด</span>
      <a class="mp-stat__top" id="statTop" href="/community">—</a>
    </div>
  </section>

  <div class="mp-toolbar">
    <label class="cm-search" for="searchInput">
      <i class="bi bi-search"></i>
      <span class="visually-hidden">ค้นหาโพสต์ของฉัน</span>
      <input type="search" id="searchInput" placeholder="ค้นหาจากเนื้อหาโพสต์" autocomplete="off">
    </label>
    <label class="mp-select">
      <span class="visually-hidden">กรองตามช่อง</span>
      <select id="categoryFilter">
        <option value="">ทุกช่อง</option>
        <% categories.forEach(function(category) { %>
          <option value="<%= category %>"><%= category %></option>
        <% }) %>
      </select>
    </label>
    <label class="mp-select">
      <span class="visually-hidden">เรียงตาม</span>
      <select id="sortSelect">
        <option value="latest">ล่าสุด</option>
        <option value="likes">ถูกใจมากสุด</option>
        <option value="comments">คอมเมนต์มากสุด</option>
      </select>
    </label>
  </div>

  <div class="mp-list" role="list" id="myPostsList" aria-live="polite"></div>
</div>

<div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-3 cm-toast-wrap">
  <div id="actionToast" class="toast cm-toast" role="status" aria-live="polite">
    <div class="d-flex">
      <div class="toast-body" id="toastMessage"></div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="ปิด"></button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/common/dialogs.js" defer></script>
<script src="/js/seller/community-my-posts.js?v=20261024-1" defer></script>
</body>
</html>
