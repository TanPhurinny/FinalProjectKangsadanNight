<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>ผังตลาด — กังสดาลไนท์</title>
        <link rel="icon" type="image/png" href="/img/favicon.png">

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link
            href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
            rel="stylesheet" />
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
            rel="stylesheet" />
        <link rel="stylesheet" href="/stylesheets/partials/navbar.css?v=20260826-7">
        <link rel="stylesheet" href="/stylesheets/marketMap.css?v=20261002-all">
        <link rel="stylesheet" href="/stylesheets/common/searchSuggest.css?v=20261002">
    </head>
    <body>
        <script src="/js/common/tabSession.js"></script>
        <% if (user && user.role === 'SELLER' && !viewAsCustomer) { %>
        <%- include('partials/navbarSeller') %>
        <% } else { %>
        <%- include('partials/navbarCustomer') %>
        <% } %>

        <%
        const zonesList = locals.zonesData || [];
        const zoneByCode = zonesList.reduce((acc, zone) => {
            acc[zone.code] = zone;
            return acc;
        }, {});
        const otherZones = zonesList.filter((zone) => !['A', 'B', 'C', 'D', 'E', 'F', 'X'].includes(zone.code));
        %>

        <div id="stallTooltip" class="stall-tooltip">
            <img id="tt-image" class="tt-image" alt="รูปร้านค้า" hidden>
            <div class="tt-header">แผง <span id="tt-stall-id"></span></div>
            <div class="tt-body">
                <div class="tt-group"><span class="tt-label">ร้านค้า</span><span class="tt-value tt-strong" id="tt-shop"></span></div>
                <div class="tt-group"><span class="tt-label">ประเภทสินค้า</span><span class="tt-value" id="tt-product"></span></div>
                <div class="tt-group"><span class="tt-label">ขายอะไรบ้าง</span><span class="tt-value" id="tt-detail"></span></div>
                <div class="tt-group" id="tt-tags-group"><span class="tt-label">เมนูเด่น</span><span class="tt-tags" id="tt-tags"></span></div>
                <div class="tt-group"><span class="tt-label">หมดสัญญา</span><span class="tt-value" id="tt-expiry"></span></div>
                <div class="tt-hint" id="tt-hint"></div>
            </div>
        </div>

        <div class="market-map-page">

            <!-- TOP BAR -->
            <div class="top-bar">
                <div class="bar-title"><i class="fa-solid fa-map fa-sm me-1"
                        style="color:var(--primary)"></i> ผังตลาด</div>
                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" id="searchInput"
                        placeholder="ค้นหาร้านค้า เช่น หมูปิ้ง, เสื้อผ้า, ก๋วยเตี๋ยว..." />
                    <button id="clearBtn" onclick="clearSearch()">✕</button>
                    <ul id="searchSuggest" class="search-suggest" hidden></ul>
                </div>
                <span id="resultBadge"></span>
            </div>

            <% if (canSeeVacancy) { %>
            <!-- ชั้นข้อมูล: สลับว่าสีบนผังบอกเรื่องอะไร (เฉพาะแอดมิน/staff) — ปุ่มสร้างใน marketMap.js -->
            <div class="layer-bar" id="layerBar">
                <span class="tag-lbl">ชั้นข้อมูล:</span>
                <div class="layer-tabs" id="layerTabs" role="tablist"></div>
                <div class="layer-summary" id="layerSummary" hidden></div>
            </div>
            <% } %>

            <!-- QUICK TAGS -->
            <div class="tag-bar">
                <span class="tag-lbl">ค้นหาด่วน:</span>
                <% if (canSeeVacancy) { %>
                <button class="qtag qtag-empty"
                    onclick="quickStatusFilter(this,'EMPTY')"><i
                        class="fa-solid fa-circle-check fa-xs"></i> แผงว่าง</button>
                <% } %>
                <button class="qtag qtag-booked"
                    onclick="quickStatusFilter(this,'BOOKED')"><i
                        class="fa-solid fa-store fa-xs"></i> มีร้านค้าแล้ว</button>
                <button class="qtag qtag-menu" onclick="quickStatusFilter(this,'HAS_MENU')"><i
                        class="fa-solid fa-book-open fa-xs"></i> มีรูปเมนู <small data-qcount="HAS_MENU"></small></button>
                <button class="qtag qtag-new" onclick="quickStatusFilter(this,'NEW')"><i
                        class="fa-solid fa-seedling fa-xs"></i> ร้านใหม่ <small data-qcount="NEW"></small></button>
                <button class="qtag qtag-fav" onclick="quickStatusFilter(this,'FAV')"><i
                        class="fa-solid fa-star fa-xs"></i> ร้านโปรด <small data-qcount="FAV"></small></button>
            </div>

            <!-- หมวดสินค้า (สี + กรอง) และปุ่มลัด -->
            <div class="cat-bar">
                <span class="tag-lbl">หมวดสินค้า:</span>
                <div class="cat-chips" id="catChips"></div>
                <div class="cat-actions">
                    <button type="button" class="act-btn d-none" id="btnMyStall"><i class="fa-solid fa-location-crosshairs fa-xs"></i> ไปที่ล็อกของฉัน</button>
                    <button type="button" class="act-btn act-random" id="btnRandomFood"><i class="fa-solid fa-dice fa-xs"></i> สุ่มร้านกินอะไรดี</button>
                </div>
            </div>

            <!-- PAGE BODY -->
            <div class="page-body">
                <div class="map-shell">
                    <div class="road-top">
                        <span class="road-top-label">ถนน</span>
                        <div class="sign-charoen"><div class="sign-dot"></div>
                            U Seoul Grill</div>
                    </div>
                    <div class="map-mid">
                        <div class="road-left">
                            <div class="stripe-v"></div>
                            <span class="road-left-text">ทางเข้าตลาด 62
                                บล็อค</span>
                            <span class="road-arrow"><i
                                    class="fa-solid fa-arrow-down"></i></span>
                        </div>

                        <div class="zone-canvas">
                            <div class="zone-block" id="zone-E"
                                onclick="openZone('E')">
                                <div class="zone-label"><div class="z-title">โซน
                                        E</div><div
                                        class="z-sub"><%= zoneByCode.E ? zoneByCode.E.description : '-' %></div></div>
                            </div>
                            <div class="zone-block" id="zone-D"
                                onclick="openZone('D')">
                                <div class="zone-label"><div class="z-title">โซน
                                        D</div><div
                                        class="z-sub"><%= zoneByCode.D ? zoneByCode.D.description : '-' %></div></div>
                            </div>
                            <% if (zoneByCode.X) { %>
                            <div class="zone-block" id="zone-X"
                                onclick="openZone('X')">
                                <div class="zone-label"><div class="z-title">โซน
                                        X</div><div
                                        class="z-sub"><%= zoneByCode.X.description %></div></div>
                            </div>
                            <% } %>
                            <div class="zone-block" id="zone-A"
                                onclick="openZone('A')">
                                <div class="zone-label"><div class="z-title">โซน
                                        A</div><div
                                        class="z-sub"><%= zoneByCode.A ? zoneByCode.A.description : '-' %></div></div>
                            </div>
                            <div class="zone-block" id="zone-F"
                                onclick="openZone('F')">
                                <div class="zone-label"><div class="z-title">โซน
                                        F</div><div
                                        class="z-sub"><%= zoneByCode.F ? zoneByCode.F.description : '-' %></div></div>
                            </div>
                            <div class="zone-block" id="zone-B"
                                onclick="openZone('B')">
                                <div class="zone-label"><div class="z-title">โซน
                                        B</div><div
                                        class="z-sub"><%= zoneByCode.B ? zoneByCode.B.description : '-' %></div></div>
                            </div>
                            <div class="zone-block" id="zone-C"
                                onclick="openZone('C')">
                                <div class="zone-label"><div class="z-title">โซน
                                        C</div><div
                                        class="z-sub"><%= zoneByCode.C ? zoneByCode.C.description : '-' %></div></div>
                            </div>
                            <div class="facility-btns">
                                <button class="btn-facility btn-facility-trash"><i
                                        class="fa-solid fa-dumpster fa-xs"></i>
                                    จุดทิ้งขยะ</button>
                                <button class="btn-facility btn-facility-restroom"><i
                                        class="fa-solid fa-restroom fa-xs"></i>
                                    ห้องน้ำ</button>
                                <button class="btn-facility btn-facility-office"><i
                                        class="fa-solid fa-user-tie fa-xs"></i>
                                    ออฟฟิศ</button>
                            </div>
                        </div>

                        <div class="road-right">
                            <span class="road-right-text">ลานจอดรถ
                                กังสดาลไนท์</span>
                        </div>
                    </div>
                    <div class="road-bottom">
                        <div class="stripe-h"></div>
                        <span class="sign-inout">เข้า-ออก</span>
                    </div>
                </div>

                <% if (otherZones.length) { %>
                <div class="other-zones-bar">
                    <span class="tag-lbl">โซนอื่นๆ:</span>
                    <% otherZones.forEach((zone) => { %>
                    <button type="button" class="zone-chip"
                        onclick="openZone('<%= zone.code %>')">โซน <%= zone.code
                        %> <small>(<%= zone.description %>)</small></button>
                    <% }) %>
                </div>
                <% } %>
            </div>

            <!-- BACKDROP -->
            <div class="backdrop" id="backdrop" onclick="closeZone()"></div>

            <!-- BOTTOM DRAWER -->
            <div class="drawer" id="drawer">

                <div class="drawer-handle-wrap">
                    <div class="drawer-handle"></div>
                </div>

                <div class="drawer-head">
                    <div>
                        <div class="zone-pill" id="zonePill">
                            <div class="zone-dot" id="zoneDot"></div>
                            <span id="drawerTitle">—</span>
                        </div>
                        <div class="head-sub" id="drawerSub"></div>
                    </div>
                    <div class="head-right">
                        <div class="drawer-stats" id="drawerStats"></div>
                        <button class="btn-close-drawer"
                            onclick="closeZone()">✕</button>
                    </div>
                </div>

                <div class="drawer-legend">
                    <% if (canSeeVacancy) { %>
                    <div class="leg"><div class="leg-box"
                            style="background:#fff;"></div>ว่าง</div>
                    <% } %>
                    <div class="leg" id="legBooked"><div class="leg-box"
                            style="background:#8a9aa0;border-color:#000;"></div>มีร้านค้าแล้ว</div>
                    <div class="layer-legend" id="layerLegend"></div>
                    <div class="leg"><div class="leg-box"
                            style="background:#c98a2e;border-color:#000;"></div>ซ่อมบำรุง</div>
                    <div class="leg"><div class="leg-box"
                            style="background:#fff;outline:3px solid #22c55e;outline-offset:1px;"></div>ผลค้นหา</div>
                </div>

                <div class="info-card-backdrop" id="infoCardBackdrop" onclick="hideInfo()"></div>
                <div class="info-card" id="infoCard">
                    <button type="button" class="ic-close" onclick="hideInfo()" aria-label="ปิด">✕</button>
                    <div class="ic-title"><i
                            class="fa-solid fa-store fa-xs"></i><span
                            id="ic-head"></span><span class="ic-new-badge d-none" id="icNewBadge">ร้านใหม่</span></div>
                    <div class="ic-tools d-none" id="icTools">
                        <button type="button" class="ic-tool" id="icFavBtn" aria-pressed="false"></button>
                        <button type="button" class="ic-tool" id="icShareBtn"><i class="fa-solid fa-share-nodes"></i> แชร์ร้าน</button>
                    </div>
                    <img id="ic-image" class="ic-image d-none" alt="รูปร้านค้า" />
                    <div class="ic-grid">
                        <div class="ig"><label>ชื่อร้านค้า</label><span
                                id="ic-shop"></span></div>
                        <div class="ig"><label>ประเภทสินค้า</label><span
                                id="ic-product"></span></div>
                        <div class="ig ic-span2"><label>ขายอะไรบ้าง</label><span
                                id="ic-detail"></span></div>
                        <div class="ig ic-span2 d-none" id="icSummaryWrap"><label>แนะนำร้าน</label><span
                                id="ic-summary"></span></div>
                    </div>
                    <div class="ic-tags-wrap d-none" id="icTagsWrap">
                        <label>เมนูเด่น <small>กดป้ายเพื่อหาร้านอื่นที่ขายคล้ายกัน</small></label>
                        <div class="ic-tags" id="icTags"></div>
                    </div>
                    <button type="button" class="ic-menu-btn d-none" id="icMenuBtn">
                        <i class="fa-solid fa-book-open"></i> ดูเมนูร้าน <span class="ic-menu-count" id="icMenuCount"></span>
                    </button>
                    <div class="ic-role-note d-none" id="icRoleNote"></div>
                    <div class="ic-role-actions d-none" id="icRoleActions"></div>
                    <div class="ic-quick-inspect" id="icQuickInspect"></div>
                </div>

                <div class="drawer-body">
                    <nav class="zone-cards" id="zoneCards" aria-label="สลับโซน"></nav>
                    <div class="drawer-grid">
                        <div class="stall-flex" id="stallGrid"></div>
                    </div>
                </div>

            </div>

        </div>

        <!-- หน้าต่างดูเมนูร้าน: รูปเมนู / รายการเมนู / รูปสินค้า (เนื้อหาเติมใน marketMap.js) -->
        <div class="menu-viewer" id="menuViewer" hidden>
            <div class="mv-backdrop" data-mv-close></div>
            <div class="mv-panel" role="dialog" aria-modal="true" aria-labelledby="mvTitle">
                <div class="mv-head">
                    <div>
                        <div class="mv-kicker">เมนูร้าน · แผง <span id="mvStall"></span></div>
                        <div class="mv-title" id="mvTitle"></div>
                    </div>
                    <button type="button" class="mv-close" data-mv-close aria-label="ปิด">✕</button>
                </div>
                <div class="mv-tabs" id="mvTabs" role="tablist"></div>
                <div class="mv-body">
                    <div class="mv-stage" id="mvStage">
                        <button type="button" class="mv-nav mv-prev" id="mvPrev" aria-label="รูปก่อนหน้า"><i class="fa-solid fa-chevron-left"></i></button>
                        <a class="mv-image-link" id="mvImageLink" target="_blank" rel="noopener" title="เปิดรูปขนาดเต็ม">
                            <img id="mvImage" alt="">
                        </a>
                        <button type="button" class="mv-nav mv-next" id="mvNext" aria-label="รูปถัดไป"><i class="fa-solid fa-chevron-right"></i></button>
                        <span class="mv-counter" id="mvCounter"></span>
                    </div>
                    <div class="mv-thumbs" id="mvThumbs"></div>
                    <ol class="mv-list" id="mvList"></ol>
                </div>
            </div>
        </div>

        <script type="application/json" id="zonesDataJson"><%- JSON.stringify(zoneByCode).replace(/</g, '\\u003c') %></script>
        <script type="application/json" id="bookingByStallJson"><%- JSON.stringify(locals.bookingByStallCode || {}).replace(/</g, '\\u003c') %></script>
        <script type="application/json" id="viewerJson"><%- JSON.stringify(locals.viewer || { role: 'CUSTOMER', allowedZones: [], myStalls: [] }).replace(/</g, '\\u003c') %></script>
        <script type="application/json" id="inspectionLayerJson"><%- JSON.stringify(locals.inspectionLayer || null).replace(/</g, '\\u003c') %></script>
        <script src="/js/common/searchSuggest.js?v=20261002"></script>
        <script src="/js/marketMap.js?v=20261002-all"></script>
    </body>
</html>
