<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Kangsadan Night Market | Portal</title>
        <link rel="icon" type="image/png" href="/img/favicon.png">
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css"
            rel="stylesheet">
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
            rel="stylesheet">
        <link
            href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
            rel="stylesheet">
        <link rel="stylesheet" href="/stylesheets/login/auth.css">
        <link rel="stylesheet" href="/stylesheets/responsive.css">
    </head>
    <body
        data-active-tab="<%= typeof activeTab !== 'undefined' ? activeTab : 'login' %>">
        <script src="/js/common/tabSession.js"></script>
        <div class="auth-shell">
            <aside class="auth-visual">
                <div class="auth-visual-content">
                    <img src="/img/favicon.png" alt="Kangsadan Night Market"
                        class="auth-visual-logo">
                    <div class="logo-sub">NIGHT MARKET SYSTEM</div>
                    <p class="auth-visual-tagline">ระบบจัดการตลาดนัดกลางคืนครบวงจร
                        สำหรับผู้ดูแลตลาดและผู้ค้าในตลาด</p>
                </div>
                <ul class="auth-visual-facts">
                    <li><span>เปิดให้บริการ</span><span>17:00–00:00</span></li>
                    <li><span>ที่ตั้ง</span><span>กังสดาล มข.</span></li>
                    <li><span>ร้านค้าในระบบ</span><span>500+</span></li>
                </ul>
            </aside>

            <main class="auth-main">
                <div class="auth-container">
                    <div class="form-card">
                        <div id="authMessage" class="mb-3"></div>

                        <div class="auth-tabswitch">
                            <button type="button"
                                onclick="showLogin()">เข้าสู่ระบบ</button>
                            <button type="button"
                                onclick="showRegister()">สมัครสมาชิก</button>
                        </div>

                        <div id="loginPage" class="auth-page">
                            <h3 class="text-center mb-1 fw-bold">เข้าสู่ระบบ</h3>
                            <p class="auth-step-hint text-center mb-4">ยินดีต้อนรับกลับ</p>

                            <% if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-danger small text-center"><%=
                                error %></div>
                            <% } %>

                            <% if (typeof success !== 'undefined' && success) { %>
                            <div
                                class="alert alert-success small text-center fw-bold">
                                <i class="fas fa-check-circle me-1"></i> <%= success
                                %>
                            </div>
                            <% } %>

                            <form method="POST" action="/login">
                                <div class="field-group mb-3">
                                    <label class="field-label" for="loginUsername">Username
                                        หรืออีเมล</label>
                                    <div class="input-wrap">
                                        <i class="fas fa-user input-icon"></i>
                                        <input type="text" id="loginUsername"
                                            name="username" class="form-control"
                                            placeholder="กรอก Username หรืออีเมล"
                                            required>
                                    </div>
                                </div>
                                <div class="field-group mb-4">
                                    <label class="field-label"
                                        for="loginPassword">Password</label>
                                    <div class="input-wrap password-input-group">
                                        <i class="fas fa-lock input-icon"></i>
                                        <input type="password" id="loginPassword"
                                            name="password"
                                            class="form-control password-field"
                                            placeholder="กรอกรหัสผ่าน" required>
                                        <button class="password-toggle"
                                            type="button" tabindex="-1"
                                            aria-label="แสดง/ซ่อนรหัสผ่าน">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>
                                <div
                                    class="d-flex justify-content-between align-items-center mb-3 small">
                                    <label
                                        class="form-check-label d-flex align-items-center gap-2">
                                        <input class="form-check-input m-0"
                                            type="checkbox" name="rememberMe"
                                            value="1">
                                        จดจำการเข้าสู่ระบบ
                                    </label>
                                    <a href="#"
                                        onclick="showForgotPassword(); return false;"
                                        class="fw-semibold">ลืมรหัสผ่าน?</a>
                                </div>
                                <button type="submit"
                                    class="btn btn-primary w-100 py-2 mb-3 shadow-sm">เข้าสู่ระบบ</button>
                            </form>
                            <div class="text-center small">
                                ยังไม่มีบัญชี? <a href="#" onclick="showRegister()"
                                    class="fw-bold">สมัครสมาชิกใหม่</a>
                            </div>
                        </div>

                        <div id="forgotPage" class="auth-page d-none">
                            <h3 class="text-center mb-1 fw-bold">ลืมรหัสผ่าน</h3>
                            <p class="text-center small text-muted mb-3">กรอก
                                Username และอีเมลที่ผูกกับบัญชี เราจะส่งลิงก์สำหรับตั้งรหัสผ่านใหม่ไปให้ทางอีเมล</p>

                            <% if (typeof forgotError !== 'undefined' &&
                            forgotError) { %>
                            <div class="alert alert-danger small text-center"><%=
                                forgotError %></div>
                            <% } %>

                            <% if (typeof forgotSuccess !== 'undefined' &&
                            forgotSuccess) { %>
                            <div
                                class="alert alert-success small text-center fw-bold"><%=
                                forgotSuccess %></div>
                            <% } %>

                            <form method="POST" action="/forgot-password">
                                <div class="field-group mb-3">
                                    <label class="field-label"
                                        for="forgotUsername">Username</label>
                                    <div class="input-wrap">
                                        <i class="fas fa-id-badge input-icon"></i>
                                        <input type="text" id="forgotUsername"
                                            name="username" class="form-control"
                                            placeholder="กรอก Username" required>
                                    </div>
                                </div>
                                <div class="field-group mb-4">
                                    <label class="field-label"
                                        for="forgotEmail">อีเมล</label>
                                    <div class="input-wrap">
                                        <i class="fas fa-envelope input-icon"></i>
                                        <input type="email" id="forgotEmail"
                                            name="email" class="form-control"
                                            placeholder="example@mail.com"
                                            required>
                                    </div>
                                </div>
                                <button type="submit"
                                    class="btn btn-primary w-100 py-2 mb-3">ส่งลิงก์รีเซ็ตรหัสผ่าน</button>
                            </form>
                            <div class="text-center">
                                <a href="#" onclick="showLogin(); return false;"
                                    class="text-muted small"><i
                                        class="fas fa-chevron-left"></i>
                                    กลับไปหน้าเข้าสู่ระบบ</a>
                            </div>
                        </div>

                        <div id="registerPage" class="auth-page d-none">
                        <form method="POST" action="/register" id="registerForm">
                            <div id="regStep1" class="reg-step">
                                <h3 class="text-center mb-1 fw-bold">สมัครสมาชิก</h3>

                                <% if (typeof registerError !== 'undefined' &&
                                registerError) { %>
                                <div class="alert alert-danger small text-center"><%=
                                    registerError %></div>
                                <% } %>

                                <div class="field-group mb-3">
                                    <label class="field-label"
                                        for="regName">ชื่อ-นามสกุลจริง</label>
                                    <div class="input-wrap">
                                        <i class="fas fa-user-circle input-icon"></i>
                                        <input type="text" id="regName" name="name"
                                            class="form-control"
                                            placeholder="ชื่อ-นามสกุลจริง" required>
                                    </div>
                                </div>

                                <div class="field-group mb-3">
                                    <label class="field-label"
                                        for="regEmail">อีเมล</label>
                                    <div class="input-wrap">
                                        <i class="fas fa-envelope input-icon"></i>
                                        <input type="email" id="regEmail"
                                            name="email" class="form-control"
                                            placeholder="example@mail.com"
                                            required>
                                    </div>
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-7">
                                        <div class="field-group">
                                            <label class="field-label"
                                                for="regPhone">เบอร์โทรศัพท์</label>
                                            <div class="input-wrap">
                                                <i
                                                    class="fas fa-phone input-icon"></i>
                                                <input type="tel" id="regPhone"
                                                    name="phoneNumber"
                                                    class="form-control"
                                                    placeholder="0xx-xxx-xxxx"
                                                    required>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-5">
                                        <div class="field-group">
                                            <label class="field-label"
                                                for="regBirthDate">วันเกิด</label>
                                            <div class="input-wrap">
                                                <i
                                                    class="fas fa-calendar-alt input-icon"></i>
                                                <input type="date"
                                                    id="regBirthDate"
                                                    name="birthDate"
                                                    class="form-control" required>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="field-group mb-3">
                                    <label class="field-label"
                                        for="regUsername">Username</label>
                                    <div class="input-wrap">
                                        <i class="fas fa-id-badge input-icon"></i>
                                        <input type="text" id="regUsername"
                                            name="username" class="form-control"
                                            placeholder="กรอก Username" required>
                                    </div>
                                </div>
                                <div class="field-group mb-4">
                                    <label class="field-label"
                                        for="regPassword">Password</label>
                                    <div class="input-wrap password-input-group">
                                        <i class="fas fa-key input-icon"></i>
                                        <input type="password" id="regPassword"
                                            name="password"
                                            class="form-control password-field"
                                            placeholder="กรอกรหัสผ่าน" required>
                                        <button class="password-toggle"
                                            type="button" tabindex="-1"
                                            aria-label="แสดง/ซ่อนรหัสผ่าน">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>

                                <button type="submit"
                                    class="btn btn-primary w-100 py-2 mb-3">สร้างบัญชี</button>
                            </div>
                        </form>
                            <div class="text-center">
                                <a href="#" onclick="showLogin()"
                                    class="text-muted small"><i
                                        class="fas fa-chevron-left"></i>
                                    กลับไปหน้าเข้าสู่ระบบ</a>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>

        <script src="/js/login/auth.js"></script>
    </body>

</html>
