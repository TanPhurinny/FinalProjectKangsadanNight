<%# ฟอร์มขอใบกำกับภาษี + รายการคำขอของฉัน — ใช้ในหน้า /documents/tax-invoice (เดิมอยู่ในหน้าร้านค้าของฉัน) %>
            <div class="form-card">
                <%
                const errorParam = (typeof error !== 'undefined' && error) ? error : null;
                const successParam = (typeof success !== 'undefined' && success) ? success : null;
                const eligibleQuotationList = (typeof eligibleQuotations !== 'undefined' && Array.isArray(eligibleQuotations)) ? eligibleQuotations : [];
                const taxInvoiceProfileList = (typeof taxInvoiceProfiles !== 'undefined' && Array.isArray(taxInvoiceProfiles)) ? taxInvoiceProfiles : [];
                const taxInvoiceRequestList = (typeof taxInvoiceRequests !== 'undefined' && Array.isArray(taxInvoiceRequests)) ? taxInvoiceRequests : [];
                const taxSuccessMsg = successParam === 'tax_invoice_requested' ? 'ส่งคำขอใบกำกับภาษีเรียบร้อยแล้ว รอแอดมินดำเนินการ' : null;
                const taxErrorMsg = {
                    'missing_booking_requests': 'กรุณาเลือกใบเสนอราคาอย่างน้อย 1 ใบ',
                    'booking_request_not_eligible': 'ใบเสนอราคาที่เลือกไม่สามารถขอใบกำกับภาษีได้ (อาจถูกผูกกับคำขออื่นไปแล้ว)',
                    'missing_profile_data': 'กรุณาเลือกโปรไฟล์ผู้เสียภาษี หรือกรอกข้อมูลนามใหม่ให้ครบ',
                    'profile_not_found': 'ไม่พบโปรไฟล์ผู้เสียภาษีที่เลือก',
                    'invalid_tax_id': 'เลขประจำตัวผู้เสียภาษีต้องเป็นตัวเลข 13 หลัก',
                    'invalid_taxpayer_name': 'ชื่อที่จะขึ้นในใบกำกับภาษีต้องไม่ว่าง และยาวไม่เกิน 120 ตัวอักษร',
                    'invalid_address': 'ที่อยู่ต้องยาว 10–300 ตัวอักษร',
                    'invalid_phone': 'เบอร์โทรต้องเป็นตัวเลข 9–10 หลัก ขึ้นต้นด้วย 0',
                    'invalid_branch': 'สาขาต้องเป็น "สำนักงานใหญ่" หรือ "สาขาที่" ตามด้วยเลข 5 หลัก',
                    'tax_invoice_not_found': 'ไม่พบใบกำกับภาษีที่ต้องการ'
                }[errorParam] || null;
                %>

                <div class="section-title">ขอใบกำกับภาษี</div>

                <% if (taxSuccessMsg) { %>
                <div class="form-alert form-alert--success"><i class="fa-solid fa-check-circle"></i><span><%= taxSuccessMsg %></span></div>
                <% } %>
                <% if (taxErrorMsg) { %>
                <div class="form-alert form-alert--danger"><i class="fa-solid fa-exclamation-circle"></i><span><%= taxErrorMsg %></span></div>
                <% } %>

                <form action="/tax-invoice-requests" method="POST" id="taxInvoiceForm" novalidate>
                    <p class="text-muted small mb-2">1. เลือกใบเสนอราคาที่ต้องการออกใบกำกับภาษี</p>
                    <div class="quotation-pick-list">
                        <% if (!eligibleQuotationList.length) { %>
                        <div class="quotation-pick-empty">ไม่มีใบเสนอราคาที่ขอใบกำกับภาษีได้ในขณะนี้</div>
                        <% } %>
                        <% if (eligibleQuotationList.length > 1) { %>
                        <label class="quotation-pick-row quotation-pick-all">
                            <input type="checkbox" id="pickAllQuotations">
                            <span class="qn">เลือกทั้งหมด (<%= eligibleQuotationList.length %> ใบ)</span>
                        </label>
                        <% } %>
                        <% eligibleQuotationList.forEach(function(q) { %>
                        <label class="quotation-pick-row">
                            <input type="checkbox" name="bookingRequestIds" value="<%= q.id %>" data-amount="<%= Number(q.netTotal) || 0 %>">
                            <span class="qn">เลขที่ <%= q.quotationNumber %></span>
                            <span class="qa"><%= q.issuedDateLabel %> — <%= Number(q.netTotal).toLocaleString('th-TH', { minimumFractionDigits: 2 }) %> บาท</span>
                        </label>
                        <% }) %>
                    </div>
                    <div class="tax-pick-summary" id="quotationSummary" aria-live="polite">เลือกแล้ว 0 ใบ</div>
                    <div class="tax-field-msg is-error" id="quotationError" hidden>กรุณาเลือกใบเสนอราคาอย่างน้อย 1 ใบ</div>

                    <p class="text-muted small mb-2">2. ข้อมูลผู้เสียภาษี</p>
                    <div class="profile-toggle">
                        <button type="button" id="btnUseExisting">ใช้โปรไฟล์เดิม</button>
                        <button type="button" id="btnUseNew">ขอในนามใหม่</button>
                    </div>

                    <div id="existingProfileBlock" class="form-group full-width">
                        <label for="taxInvoiceProfileId">เลือกโปรไฟล์ผู้เสียภาษี</label>
                        <select name="taxInvoiceProfileId" class="input-white" id="taxInvoiceProfileId">
                            <option value="">-- เลือก --</option>
                            <% taxInvoiceProfileList.forEach(function(p) { %>
                            <option value="<%= p.id %>"
                                data-type="<%= p.taxpayerType %>"
                                data-name="<%= p.taxpayerName %>"
                                data-taxid="<%= p.taxId %>"
                                data-branch="<%= p.branch || '' %>"
                                data-address="<%= p.address %>"
                                data-phone="<%= p.phoneNumber || '' %>"><%= p.taxpayerName %> (<%= p.taxId %>)</option>
                            <% }) %>
                        </select>
                        <div class="tax-profile-preview" id="profilePreview" hidden></div>
                        <div class="tax-field-msg is-error" id="profileError" hidden>กรุณาเลือกโปรไฟล์ผู้เสียภาษี</div>
                        <% if (!taxInvoiceProfileList.length) { %>
                        <small style="color: var(--ink-soft); margin-top: 6px;">ยังไม่มีโปรไฟล์เดิม — กรุณาเลือก "ขอในนามใหม่"</small>
                        <% } %>
                    </div>

                    <div id="newProfileBlock" class="form-grid" style="display:none;">
                        <div class="form-group full-width tax-prefill-row">
                            <span class="tax-draft-note" id="draftNote" hidden><i class="fa-solid fa-floppy-disk"></i> บันทึกฉบับร่างในเครื่องนี้ให้อัตโนมัติ · <button type="button" id="btnClearDraft">ล้างฟอร์ม</button></span>
                        </div>
                        <div class="form-group">
                            <label for="taxpayerTypeInput">ประเภทผู้เสียภาษี</label>
                            <select name="taxpayerType" class="input-white" id="taxpayerTypeInput">
                                <option value="COMPANY">นิติบุคคล (บริษัท/ห้างหุ้นส่วน)</option>
                                <option value="INDIVIDUAL">บุคคลธรรมดา</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="taxIdInput" id="taxIdLabel">เลขประจำตัวผู้เสียภาษี (13 หลัก)</label>
                            <input type="text" name="taxId" id="taxIdInput" class="input-white tax-mono" placeholder="0-0000-00000-00-0"
                                inputmode="numeric" maxlength="17" autocomplete="off" aria-describedby="taxIdHint">
                            <div class="tax-field-msg" id="taxIdHint"></div>
                        </div>
                        <div class="form-group full-width">
                            <label for="taxpayerNameInput">ชื่อที่จะขึ้นในใบกำกับภาษี</label>
                            <input type="text" name="taxpayerName" id="taxpayerNameInput" class="input-white" placeholder="เช่น บริษัท ตัวอย่าง จำกัด"
                                maxlength="120" autocomplete="organization">
                            <div class="tax-field-msg"><span class="tax-counter" id="nameCounter">0/120</span><span id="nameHint"></span></div>
                        </div>
                        <div class="form-group" id="branchGroup">
                            <label for="branchKind">สาขา</label>
                            <div class="tax-branch-row">
                                <select id="branchKind" class="input-white">
                                    <option value="HQ">สำนักงานใหญ่</option>
                                    <option value="BRANCH">สาขาเลขที่</option>
                                </select>
                                <input type="text" id="branchNo" class="input-white tax-mono" placeholder="00001" inputmode="numeric" maxlength="5" autocomplete="off" hidden aria-label="เลขที่สาขา 5 หลัก">
                            </div>
                            <input type="hidden" name="branch" id="branchValue" value="สำนักงานใหญ่">
                            <div class="tax-field-msg" id="branchHint"></div>
                        </div>
                        <div class="form-group">
                            <label for="phoneInput">เบอร์โทร <span class="tax-optional">(ไม่บังคับ)</span></label>
                            <input type="tel" name="phoneNumber" id="phoneInput" class="input-white tax-mono" placeholder="081-234-5678"
                                inputmode="tel" maxlength="12" autocomplete="tel">
                            <div class="tax-field-msg" id="phoneHint"></div>
                        </div>
                        <div class="form-group full-width">
                            <label for="addressInput">ที่อยู่สำหรับออกใบกำกับภาษี</label>
                            <textarea name="address" id="addressInput" class="input-white" rows="3" maxlength="300"
                                placeholder="เลขที่ ถนน ตำบล/แขวง อำเภอ/เขต จังหวัด รหัสไปรษณีย์" autocomplete="street-address"></textarea>
                            <div class="tax-field-msg"><span class="tax-counter" id="addressCounter">0/300</span><span id="addressHint"></span></div>
                        </div>
                        <small style="color: var(--ink-soft); grid-column: 1 / -1;">แอดมินจะตรวจสอบและยืนยัน/แก้ไขข้อมูลนี้อีกครั้งก่อนออกใบกำกับภาษีจริง</small>
                    </div>

                    <div class="tax-form-error" id="formError" role="alert" hidden></div>
                    <button type="submit" class="btn-submit" id="taxSubmitBtn" style="margin-top: 18px;">ส่งคำขอใบกำกับภาษี</button>
                </form>

                <% if (taxInvoiceRequestList.length) { %>
                <p class="text-muted small mt-4 mb-2">คำขอใบกำกับภาษีของฉัน</p>
                <div class="request-list">
                    <% taxInvoiceRequestList.forEach(function(r) { %>
                    <div class="request-row">
                        <div class="request-row-main">
                            <span class="request-row-title"><%= r.taxpayerName %> <% if (r.documentNumber) { %>(เลขที่ <%= r.documentNumber %>)<% } %></span>
                            <span class="request-row-meta"><%= r.quotationCount %> ใบเสนอราคา — <%= Number(r.netTotal).toLocaleString('th-TH', { minimumFractionDigits: 2 }) %> บาท</span>
                        </div>
                        <span class="badge <%= r.status.toLowerCase() %>"><%= r.statusLabel %></span>
                        <% if (r.status === 'ISSUED') { %>
                        <a href="/tax-invoices/<%= r.id %>" class="link-view">ดูเอกสาร</a>
                        <% } %>
                    </div>
                    <% }) %>
                </div>
                <% } %>
            </div>
