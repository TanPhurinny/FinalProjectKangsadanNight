<%
// ตารางรายการเช่า/ชำระเงิน (1 แถว = 1 คำขอที่จัดล็อกแล้ว) — ใช้ร่วมกันทั้งหน้าร้านค้าและหน้าแอดมิน
// rows: จาก utils/rentalStatement.js · docPrefix: '' (ร้านค้า) หรือ '/admin' (ลิงก์ใบเสร็จ/ใบกำกับภาษีฝั่งแอดมิน)
// showTenant: แสดงคอลัมน์ผู้เช่า (หน้าต่อล็อก) · stallMode: ยอดเป็นส่วนของล็อกนี้ (หน้าต่อล็อก)
const prefix = typeof docPrefix === 'string' ? docPrefix : '';
const withTenant = typeof showTenant !== 'undefined' && showTenant;
const perStall = typeof stallMode !== 'undefined' && stallMode;
const baht = (n) => Number(n || 0).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const footPaid = rows.filter((r) => r.status === 'PAID');
%>
<% if (!rows.length) { %>
<div class="rs-empty">ไม่มีรายการเช่าในช่วงนี้</div>
<% } else { %>
<div class="rs-table-wrap">
    <table class="rs-table">
        <thead>
            <tr>
                <th>รอบ</th>
                <% if (withTenant) { %><th>ผู้เช่า</th><% } %>
                <th>ล็อก</th>
                <th>ช่วงเช่า</th>
                <th class="rs-num">วันคิดเงิน</th>
                <% if (perStall) { %>
                <th class="rs-num">ยอดทั้งคำขอ</th>
                <th class="rs-num">ส่วนของล็อกนี้</th>
                <% } else { %>
                <th class="rs-num">ค่าเช่าแผง</th>
                <th class="rs-num">ค่าไฟ</th>
                <th class="rs-num">เครื่องใช้ไฟฟ้า</th>
                <th class="rs-num">ยอดรวม</th>
                <% } %>
                <th>สถานะ</th>
                <th>วันที่ชำระ</th>
                <th>เอกสาร</th>
            </tr>
        </thead>
        <tbody>
            <% rows.forEach((r) => { %>
            <tr>
                <td><%= r.roundNumber ? r.roundNumber : '-' %><% if (r.isExtension) { %><div class="rs-muted">ต่อล็อก</div><% } %></td>
                <% if (withTenant) { %>
                <td>
                    <% if (r.userId && prefix === '/admin') { %><a href="/admin/rental-statements/user/<%= r.userId %>"><%= r.tenantName %></a><% } else { %><%= r.tenantName %><% } %>
                    <div class="rs-muted"><%= r.shopName %></div>
                </td>
                <% } %>
                <td class="rs-code">
                    <% r.stallCodes.forEach((code, i) => { %><% if (prefix === '/admin') { %><a href="/admin/rental-statements/stall/<%= code %>"><%= code %></a><% } else { %><%= code %><% } %><%= i < r.stallCodes.length - 1 ? ', ' : '' %><% }) %>
                    <div class="rs-muted">โซน <%= r.zone %></div>
                </td>
                <td><%= r.rentalStartText %> – <%= r.rentalEndText %></td>
                <td class="rs-num"><%= r.billableDays %></td>
                <% if (perStall) { %>
                <td class="rs-num"><%= baht(r.grandTotal) %><% if (r.stallCount > 1) { %><div class="rs-muted"><%= r.stallCount %> ล็อก</div><% } %></td>
                <td class="rs-num"><strong><%= baht(r.stallShare) %></strong></td>
                <% } else { %>
                <td class="rs-num"><%= baht(r.rentTotal) %></td>
                <td class="rs-num"><%= baht(r.lightTotal) %></td>
                <td class="rs-num"><%= baht(r.applianceTotal) %></td>
                <td class="rs-num"><strong><%= baht(r.grandTotal) %></strong></td>
                <% } %>
                <td><span class="rs-pill <%= r.status === 'PAID' ? 'rs-pill--paid' : 'rs-pill--due' %>"><%= r.statusLabel %></span></td>
                <td><%= r.paidAtText %><% if (r.status === 'PAID' && prefix === '/admin') { %><div class="rs-muted">โดย <%= r.confirmedByName %></div><% } %></td>
                <td>
                    <% if (r.receiptNumber) { %><a href="<%= prefix %>/quotations/<%= r.requestId %>" target="_blank" rel="noopener"><%= r.receiptNumber %></a><% } else { %><span class="rs-muted">-</span><% } %>
                    <% if (r.taxInvoiceId) { %><div><a href="<%= prefix %>/tax-invoices/<%= r.taxInvoiceId %>" target="_blank" rel="noopener">ใบกำกับ <%= r.taxInvoiceNumber %></a></div><% } %>
                </td>
            </tr>
            <% }) %>
        </tbody>
        <tfoot>
            <tr>
                <td colspan="<%= withTenant ? 5 : 4 %>">รวมที่ชำระแล้ว (<%= footPaid.length %> รายการ)</td>
                <% if (perStall) { %>
                <td class="rs-num"></td>
                <td class="rs-num"><%= baht(footPaid.reduce((s, r) => s + r.stallShare, 0)) %></td>
                <% } else { %>
                <td class="rs-num"><%= baht(footPaid.reduce((s, r) => s + r.rentTotal, 0)) %></td>
                <td class="rs-num"><%= baht(footPaid.reduce((s, r) => s + r.lightTotal, 0)) %></td>
                <td class="rs-num"><%= baht(footPaid.reduce((s, r) => s + r.applianceTotal, 0)) %></td>
                <td class="rs-num"><%= baht(footPaid.reduce((s, r) => s + r.grandTotal, 0)) %></td>
                <% } %>
                <td colspan="3"></td>
            </tr>
        </tfoot>
    </table>
</div>
<% } %>
