<%
// ตรวจสอบหน้าปัจจุบันจาก URL path
const currentPath = locals.path || '';
const isStaff = user && user.role === 'STAFF';
%>

<nav class="management-nav admin-nav">
    <div class="nav-container">
        <a href="/admin/dashboard" class="nav-brand">
            <img src="/img/favicon.png" alt="Kang Night Logo" class="nav-logo">
        </a>

        <button class="nav-toggle" id="navToggle">
            <i class="fas fa-bars"></i>
        </button>

        <div class="nav-links" id="navMenu">
            <a href="/admin/dashboard"
                class="nav-item <%= currentPath.includes('dashboard') ? 'active' : '' %>">
                <i class="fas fa-th-large"></i> แดชบอร์ด
            </a>
            <a href="/admin/slots"
                class="nav-item <%= currentPath.includes('slots') ? 'active' : '' %>">
                <i class="fas fa-map-marked-alt"></i> ผังตลาด
            </a>
            <a href="/admin/requests"
                class="nav-item <%= currentPath.includes('requests') ? 'active' : '' %>">
                <i class="fas fa-tools"></i> การแจ้งคำร้อง
            </a>
            <% if (isStaff) { %>
            <a href="/staff/marketinspection"
                class="nav-item <%= currentPath.includes('/staff/marketinspection') ? 'active' : '' %>">
                <i class="fas fa-clipboard-check"></i> งานตรวจตลาด
            </a>
            <a href="/staff/seller-scores"
                class="nav-item <%= currentPath.includes('/staff/seller-scores') ? 'active' : '' %>">
                <i class="fas fa-star"></i> คะแนนร้านค้า
            </a>
            <% } else { %>
            <a href="/admin/approvals"
                class="nav-item <%= currentPath.includes('approvals') ? 'active' : '' %>">
                <i class="fas fa-check-circle"></i> รายการอนุมัติ
            </a>
            <a href="/community"
                class="nav-item <%= currentPath.includes('/community') || currentPath.includes('/comunity') ? 'active' : '' %>">
                <i class="fas fa-comments"></i> คอมมูนิตี้
            </a>
            <a href="/admin/users"
                class="nav-item <%= currentPath.includes('users') ? 'active' : '' %>">
                <i class="fas fa-users"></i> จัดการผู้ใช้
            </a>
            <%
                const moreLinks = [
                    { href: '/admin/tax-invoice-requests', icon: 'fa-file-invoice', label: 'คำขอใบกำกับภาษี', match: 'tax-invoice-requests' },
                    { href: '/admin/announcements', icon: 'fa-bullhorn', label: 'จัดการประกาศ', match: 'announcements' },
                    { href: '/admin/community-banners', icon: 'fa-images', label: 'แบนเนอร์คอมมูนิตี้', match: '/community-banners' },
                    { href: '/admin/sellers/scores', icon: 'fa-star', label: 'คะแนนร้านค้า', match: '/sellers/scores' }
                ];
                const isMoreActive = moreLinks.some(function(link) { return currentPath.includes(link.match); });
            %>
            <details class="nav-dropdown">
                <summary class="nav-item <%= isMoreActive ? 'active' : '' %>">
                    <i class="fas fa-ellipsis-h"></i> เพิ่มเติม
                </summary>
                <div class="nav-dropdown__panel">
                    <% moreLinks.forEach(function(link) { %>
                    <a href="<%= link.href %>" class="<%= currentPath.includes(link.match) ? 'active' : '' %>">
                        <i class="fas <%= link.icon %>"></i> <%= link.label %>
                    </a>
                    <% }) %>
                </div>
            </details>
            <% } %>

            <div class="nav-actions d-flex align-items-center">
                <a href="/profile"
                    class="user-badge user-badge-link shadow-sm <%= currentPath.includes('/profile') ? 'active' : '' %>">
                    <i class="fas fa-user-circle"></i>
                    <%= user.name %>
                </a>
                <a href="/logout" class="logout-link">
                    <i class="fas fa-sign-out-alt me-1"></i>ออกจากระบบ
                </a>
            </div>
        </div>
    </div>
</nav>

<script src="/js/partials/navbar.js"></script>