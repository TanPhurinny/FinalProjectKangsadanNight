<%
// ตรวจสอบหน้าปัจจุบันจาก URL path
const currentPath = locals.path || '';
const isStaff = user && user.role === 'STAFF';
const count = function (value) { return Number(value) || 0; };
const badgeText = function (n) { return n > 99 ? '99+' : n; };

const approvalCount = typeof approvalTodo !== 'undefined' && approvalTodo ? count(approvalTodo.total) : 0;
const approvalUrgent = typeof approvalTodo !== 'undefined' && approvalTodo ? count(approvalTodo.urgent) : 0;
const boothCount = typeof eventBoothTodo !== 'undefined' && eventBoothTodo ? count(eventBoothTodo.total) : 0;
const boothSlips = typeof eventBoothTodo !== 'undefined' && eventBoothTodo ? count(eventBoothTodo.slips) : 0;
const reviewCount = typeof reportedReviews !== 'undefined' ? count(reportedReviews) : 0;
const leaseCount = typeof leaseContractTodo !== 'undefined' ? count(leaseContractTodo) : 0;
const taxCount = typeof taxInvoiceTodo !== 'undefined' ? count(taxInvoiceTodo) : 0;
const documentCount = leaseCount + taxCount;
// badge แยกประเภท ให้รู้ว่าคำขอที่เข้ามาเป็นใบกำกับภาษีหรือสัญญาเช่า (แสดงเฉพาะที่มีค้าง)
const documentBadges = [
    { label: 'ภาษี', n: taxCount, title: `คำขอใบกำกับภาษีรอดำเนินการ ${taxCount}` },
    { label: 'สัญญา', n: leaseCount, title: `คำขอสัญญาเช่ารออนุมัติ ${leaseCount}` }
].filter(function (b) { return b.n > 0; });

// เมนูหลักอยู่บนแถบเสมอ ส่วน moreLinks รวมใน "เพิ่มเติม" (จอกว้าง) — บนมือถือทุกเมนูเรียงต่อกันในเมนู hamburger
// badge = ตัวเลขงานค้าง, urgent = มีงานด่วน (สีแดง)
const primaryLinks = isStaff ? [
    { href: '/admin/dashboard', icon: 'fa-th-large', label: 'แดชบอร์ด', match: 'dashboard' },
    { href: '/admin/slots', icon: 'fa-map-marked-alt', label: 'ผังตลาด', match: 'slots' },
    { href: '/admin/requests', icon: 'fa-tools', label: 'การแจ้งคำร้อง', match: '/admin/requests' },
    { href: '/staff/marketinspection', icon: 'fa-clipboard-check', label: 'งานตรวจตลาด', match: '/staff/marketinspection' },
    { href: '/staff/seller-scores', icon: 'fa-calendar-check', label: 'การมาขายร้านค้า', match: '/staff/seller-scores' },
    { href: '/admin/shop-reviews', icon: 'fa-star-half-stroke', label: 'รีวิวร้านค้า', match: '/shop-reviews', badge: reviewCount, title: `รีวิวที่ร้านรายงานรอตรวจ ${reviewCount}` }
] : [
    { href: '/admin/dashboard', icon: 'fa-th-large', label: 'แดชบอร์ด', match: 'dashboard' },
    { href: '/admin/approvals', icon: 'fa-check-circle', label: 'รายการอนุมัติ', match: 'approvals', badge: approvalCount, urgent: approvalUrgent > 0,
      title: `ต้องจัดการ ${approvalCount} รายการ${approvalUrgent ? ` (ด่วน ${approvalUrgent})` : ''}` },
    { href: '/admin/slots', icon: 'fa-map-marked-alt', label: 'ผังตลาด', match: 'slots' },
    { href: '/admin/event-booths', icon: 'fa-people-group', label: 'บูธกิจกรรม', match: '/admin/event-booths', badge: boothCount, urgent: boothSlips > 0,
      title: typeof eventBoothTodo !== 'undefined' && eventBoothTodo ? `คำขอใหม่ ${count(eventBoothTodo.pending)} · สลิปรอยืนยัน ${boothSlips}` : '' },
    { href: '/admin/requests', icon: 'fa-tools', label: 'การแจ้งคำร้อง', match: '/admin/requests' },
    { href: '/admin/users', icon: 'fa-users', label: 'จัดการผู้ใช้', match: 'users' }
];
const moreLinks = isStaff ? [] : [
    { href: '/community', icon: 'fa-comments', label: 'คอมมูนิตี้', match: '/community' },
    { href: '/admin/rental-statements', icon: 'fa-file-invoice-dollar', label: 'รายงานการชำระค่าเช่า', match: '/rental-statements' },
    // ใบกำกับภาษี + สัญญาเช่า รวมเป็นเมนูเดียว เข้าแล้วเลือกได้ว่าจะจัดการอะไร (/admin/documents)
    { href: '/admin/documents', icon: 'fa-folder-open', label: 'คำขอเอกสาร (ใบกำกับภาษี / สัญญาเช่า)', match: ['/admin/documents', 'tax-invoice', '/lease-contracts'], badge: documentCount, badges: documentBadges },
    { href: '/admin/announcements', icon: 'fa-bullhorn', label: 'จัดการประกาศ', match: 'announcements' },
    { href: '/admin/shop-reviews', icon: 'fa-star-half-stroke', label: 'รีวิวร้านค้า', match: '/shop-reviews', badge: reviewCount, title: `รีวิวที่ร้านรายงานรอตรวจ ${reviewCount}` },
    { href: '/admin/community-banners', icon: 'fa-images', label: 'แบนเนอร์คอมมูนิตี้', match: '/community-banners' },
    { href: '/admin/sellers/scores', icon: 'fa-calendar-check', label: 'การมาขายร้านค้า', match: '/sellers/scores' },
    { href: '/admin/booking-holidays', icon: 'fa-calendar-xmark', label: 'วันหยุดรอบจอง', match: '/booking-holidays' },
    { href: '/admin/rain-compensation', icon: 'fa-cloud-rain', label: 'ชดเชยฝนตก', match: '/rain-compensation' },
    { href: '/admin/product-subtypes', icon: 'fa-tags', label: 'รายการสินค้าที่ขาย', match: '/product-subtypes' }
];
const isLinkActive = function (link) {
    // "/community" ต้องไม่ติดไฮไลต์ตอนอยู่หน้า /admin/community-banners
    if (link.match === '/community') return (currentPath.startsWith('/community') || currentPath.startsWith('/comunity'));
    return [].concat(link.match).some(function (m) { return currentPath.includes(m); });
};
const isMoreActive = moreLinks.some(isLinkActive);
const moreBadge = moreLinks.reduce(function (sum, link) { return sum + count(link.badge); }, 0);

// ตัวเลขรวมบนปุ่มเมนูมือถือ — ให้รู้ว่ามีงานค้างโดยไม่ต้องเปิดเมนู
const todoTotal = isStaff ? reviewCount : approvalCount + boothCount + reviewCount + documentCount;
const todoUrgent = !isStaff && (approvalUrgent > 0 || boothSlips > 0);
%>
<link rel="stylesheet" href="/stylesheets/partials/navMenu.css?v=20261027">

<nav class="management-nav admin-nav nav-v2">
    <div class="nav-container">
        <a href="/admin/dashboard" class="nav-brand">
            <img src="/img/favicon.png" alt="Kang Night Logo" class="nav-logo">
        </a>

        <div class="nav-v2__mobile-bar">
            <div class="nav-v2__toggle-wrap">
                <button class="nav-toggle" id="navToggle" type="button" aria-label="เปิดเมนู<%= todoTotal ? ` (งานค้าง ${todoTotal})` : '' %>">
                    <i class="fas fa-bars"></i>
                </button>
                <% if (todoTotal) { %>
                <span class="nav-notification-badge <%= todoUrgent ? '' : 'nav-notification-badge--warn' %>"><%= badgeText(todoTotal) %></span>
                <% } %>
            </div>
        </div>

        <div class="nav-links" id="navMenu">
            <div class="nav-links__primary">
                <% primaryLinks.forEach(function (link) { %>
                <a href="<%= link.href %>" class="nav-item <%= isLinkActive(link) ? 'active' : '' %>">
                    <i class="fas <%= link.icon %>"></i> <%= link.label %>
                    <% if (link.badge) { %>
                    <span class="nav-badge<%= link.urgent ? ' nav-badge--urgent' : '' %>" title="<%= link.title %>"><%= badgeText(link.badge) %></span>
                    <% } %>
                </a>
                <% }) %>

                <% if (moreLinks.length) { %>
                <%# จอกว้าง: เมนูรองอยู่ใน dropdown %>
                <details class="nav-dropdown nav-v2__more">
                    <summary class="nav-item <%= isMoreActive ? 'active' : '' %>">
                        <i class="fas fa-ellipsis-h"></i> เพิ่มเติม
                        <% if (moreBadge) { %><span class="nav-badge" title="รอดำเนินการ <%= moreBadge %> รายการ<%= taxCount ? ` · ใบกำกับภาษี ${taxCount}` : '' %><%= leaseCount ? ` · สัญญาเช่า ${leaseCount}` : '' %><%= reviewCount ? ` · รีวิวที่ถูกรายงาน ${reviewCount}` : '' %>"><%= badgeText(moreBadge) %></span><% } %>
                    </summary>
                    <div class="nav-dropdown__panel">
                        <% moreLinks.forEach(function (link) { %>
                        <a href="<%= link.href %>" class="<%= isLinkActive(link) ? 'active' : '' %>">
                            <i class="fas <%= link.icon %>"></i> <%= link.label %>
                            <% if (link.badges) { link.badges.forEach(function (b) { %><span class="nav-badge nav-badge--labeled" title="<%= b.title %>"><%= b.label %> <%= badgeText(b.n) %></span><% }) } else if (link.badge) { %><span class="nav-badge"><%= badgeText(link.badge) %></span><% } %>
                        </a>
                        <% }) %>
                    </div>
                </details>

                <%# มือถือ: เมนูรองเรียงต่อกันในเมนู hamburger ไม่ต้องกางอีกชั้น %>
                <% moreLinks.forEach(function (link) { %>
                <a href="<%= link.href %>" class="nav-item nav-v2__mobile-only <%= isLinkActive(link) ? 'active' : '' %>">
                    <i class="fas <%= link.icon %>"></i> <%= link.label %>
                    <% if (link.badges) { link.badges.forEach(function (b) { %><span class="nav-badge nav-badge--labeled" title="<%= b.title %>"><%= b.label %> <%= badgeText(b.n) %></span><% }) } else if (link.badge) { %><span class="nav-badge"><%= badgeText(link.badge) %></span><% } %>
                </a>
                <% }) %>
                <% } %>
            </div>

            <%- include('navAccount', { navUser: user, navPath: currentPath, navSwitch: null }) %>
        </div>
    </div>
</nav>

<script src="/js/partials/navbar.js"></script>
