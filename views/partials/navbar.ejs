                <a href="/admin/dashboard" class="nav-item">แดชบอร์ด</a>
                <a href="/slots" class="nav-item">ผังตลาด</a>
                <a href="/admin/requests" class="nav-item">การแจ้งคำร้อง</a>
                <a href="/admin/approvals" class="nav-item">รายการอนุมัติ</a>
                <% if (user.role === 'ADMIN') { %>
                    <a href="/admin/users" class="nav-item">สิทธิ์การใช้งาน</a>
                <% } %>
            <% } %>

            <% if (user.role === 'SELLER') { %>
