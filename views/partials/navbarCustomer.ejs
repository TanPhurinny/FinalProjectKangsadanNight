<%
    // ตรวจสอบหน้าปัจจุบันจาก URL path เพื่อไฮไลต์เมนูที่ใช้งานอยู่
    // หน้าแรกของลูกค้าทั่วไปคือฟีดคอมมูนิตี้ (ตั้งแต่ล็อกอินเข้ามาจะมาที่นี่เลย)
    const currentPath = locals.path || '';
    const navUser = (typeof user !== 'undefined' && user) ? user : null;
    const isStaffOrAdmin = navUser && (navUser.role === 'ADMIN' || navUser.role === 'STAFF');
    // ยังไม่ล็อกอิน: หน้าแรกคือหน้าต้อนรับ / (ฟีดคอมมูนิตี้ต้องล็อกอิน)
    const homePath = isStaffOrAdmin ? '/admin/dashboard' : (navUser ? '/community' : '/');
    const isCommunityPath = currentPath.includes('community') || currentPath.includes('comunity');
    const notificationList = (typeof notifications !== 'undefined' && Array.isArray(notifications)) ? notifications : [];
    // กติกาเดียวกับ isReal ในหน้าแจ้งเตือน (public/js/seller/notifications.js) และ navbarSeller.ejs
    const unreadNotifications = notificationList.filter(function(item) {
        return !item.isRead && !item.upcoming && (!item.step || item.action || item.step === 3);
    }).length;
    const notificationsActive = currentPath.includes('notifications');

    // ยังไม่ล็อกอิน: เหลือเฉพาะเมนูที่ไม่ต้องใช้บัญชี
    const links = [
        { href: navUser ? '/community' : '/', icon: 'fa-home', label: 'หน้าหลัก', active: navUser ? isCommunityPath : currentPath === '/' },
        { href: '/market-map', icon: 'fa-map', label: 'ผังตลาด', active: currentPath.includes('market-map') },
        { href: '/announcements', icon: 'fa-bullhorn', label: 'ประกาศ', active: currentPath.includes('announcements') },
        { href: '/shop-application', icon: 'fa-store', label: 'สมัครเปิดร้านค้า', active: currentPath.includes('shop-application'), needsLogin: true },
        { href: '/booking-status', icon: 'fa-clipboard-list', label: 'สถานะการจอง', active: currentPath.includes('booking-status'), needsLogin: true }
    ].filter(function (link) { return navUser || !link.needsLogin; });
%>
<link rel="stylesheet" href="/stylesheets/partials/navMenu.css?v=20261027">

<nav class="management-nav nav-v2">
    <div class="nav-container">
        <a href="<%= homePath %>" class="nav-brand <%= isCommunityPath ? 'active' : '' %>">
            <img src="/img/favicon.png" alt="Kang Night Logo" class="nav-logo">
        </a>

        <%# มือถือ: กระดิ่งอยู่ข้างปุ่มเมนู กดได้ทันทีไม่ต้องเปิดเมนู %>
        <div class="nav-v2__mobile-bar">
            <% if (navUser) { %>
            <a href="/notifications" class="nav-v2__bell <%= notificationsActive ? 'active' : '' %>" title="แจ้งเตือน" aria-label="แจ้งเตือน<%= unreadNotifications > 0 ? ` (${unreadNotifications} ยังไม่อ่าน)` : '' %>">
                <i class="fas fa-bell"></i>
                <% if (unreadNotifications > 0) { %>
                    <span class="nav-notification-badge"><%= unreadNotifications > 99 ? '99+' : unreadNotifications %></span>
                <% } %>
            </a>
            <% } %>
            <button class="nav-toggle" id="navToggle" type="button" aria-label="เปิดเมนู">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <div class="nav-links" id="navMenu">
            <div class="nav-links__primary">
                <% links.forEach(function (link) { %>
                <a href="<%= link.href %>" class="nav-item <%= link.active ? 'active' : '' %>">
                    <i class="fas <%= link.icon %>"></i> <%= link.label %>
                </a>
                <% }) %>

                <% if (navUser) { %>
                <a href="/notifications" class="nav-item nav-notification nav-notification--icon-only nav-v2__desktop-only <%= notificationsActive ? 'active' : '' %>" title="แจ้งเตือน" aria-label="แจ้งเตือน">
                    <i class="fas fa-bell"></i>
                    <% if (unreadNotifications > 0) { %>
                        <span class="nav-notification-badge"><%= unreadNotifications > 99 ? '99+' : unreadNotifications %></span>
                    <% } %>
                </a>
                <% } %>
            </div>

            <%- include('navAccount', {
                navUser: navUser,
                navPath: currentPath,
                navSwitch: locals.viewAsCustomer ? { href: '/switch-view/seller', label: 'สลับเป็นมุมมองผู้ขาย' } : null
            }) %>
        </div>
    </div>
</nav>

<script src="/js/partials/navbar.js"></script>
