<%
    // ตรวจสอบหน้าปัจจุบันจาก URL path เพื่อไฮไลต์เมนูที่ใช้งานอยู่
    const currentPath = locals.path || '';
    const notificationList = (typeof notifications !== 'undefined' && Array.isArray(notifications)) ? notifications : [];
    const unreadNotifications = notificationList.filter(function(item) {
        return !item.isRead && !item.upcoming && (!item.step || item.action || item.step === 3);
    }).length;
%>

<nav class="management-nav seller-nav">
    <div class="nav-container">
        <a href="/seller" class="nav-brand <%= currentPath === '/seller' ? 'active' : '' %>">
            <img src="/img/favicon.png" alt="Kang Night Logo" class="nav-logo">
        </a>

        <button class="nav-toggle" id="navToggle">
            <i class="fas fa-bars"></i>
        </button>

        <div class="nav-links" id="navMenu">
            <div class="nav-links__primary">
            <a href="/seller" class="nav-item <%= currentPath === '/seller' ? 'active' : '' %>">
                <i class="fas fa-home"></i> หน้าหลัก
            </a>
            <a href="/select-zone" class="nav-item <%= currentPath.includes('select-zone') ? 'active' : '' %>">
                <i class="fas fa-store"></i> จองแผง
            </a>
            <a href="/booking-status" class="nav-item <%= currentPath.includes('booking-status') ? 'active' : '' %>">
                <i class="fas fa-clipboard-list"></i> สถานะการจอง
            </a>
            <a href="/market-map" class="nav-item <%= currentPath.includes('market-map') ? 'active' : '' %>">
                <i class="fas fa-map"></i> ผังตลาด
            </a>
            <a href="/community" class="nav-item <%= (currentPath.includes('community') || currentPath.includes('comunity')) ? 'active' : '' %>">
                <i class="fas fa-users"></i> คอมมูนิตี้
            </a>
            <a href="/shop-profile" class="nav-item <%= currentPath.includes('shop-profile') ? 'active' : '' %>">
                <i class="fas fa-store"></i> ร้านค้าของฉัน
            </a>
            <%
                // เมนูที่ใช้ไม่บ่อยรวมไว้ใน "เพิ่มเติม" แบบเดียวกับ navbar แอดมิน (views/partials/navbar.ejs) กันแถบเมนูล้นจอ
                const moreLinks = [
                    { href: '/booking-history', icon: 'fa-clock-rotate-left', label: 'ประวัติการจอง', match: ['booking-history'] },
                    { href: '/rental-statement', icon: 'fa-file-invoice-dollar', label: 'รายงานการเช่าและชำระเงิน', match: ['rental-statement'] },
                    { href: '/documents', icon: 'fa-folder-open', label: 'ขอเอกสาร (ใบกำกับภาษี / สัญญาเช่า)', match: ['/documents', '/lease-contracts', '/tax-invoices'] },
                    { href: '/repair', icon: 'fa-tools', label: 'แจ้งซ่อม', match: ['repair'] },
                    { href: '/announcements', icon: 'fa-bullhorn', label: 'ประกาศ', match: ['announcements'] }
                ];
                const linkActive = function(link) { return link.match.some(function(m) { return currentPath.includes(m); }); };
                const isMoreActive = moreLinks.some(linkActive);
            %>
            <details class="nav-dropdown">
                <summary class="nav-item <%= isMoreActive ? 'active' : '' %>">
                    <i class="fas fa-ellipsis-h"></i> เพิ่มเติม
                </summary>
                <div class="nav-dropdown__panel">
                    <% moreLinks.forEach(function(link) { %>
                    <a href="<%= link.href %>" class="<%= linkActive(link) ? 'active' : '' %>">
                        <i class="fas <%= link.icon %>"></i> <%= link.label %>
                    </a>
                    <% }) %>
                </div>
            </details>

            <a href="/notifications" class="nav-item nav-notification nav-notification--icon-only <%= currentPath.includes('notifications') ? 'active' : '' %>" title="แจ้งเตือน" aria-label="แจ้งเตือน">
                <i class="fas fa-bell"></i>
                <% if (unreadNotifications > 0) { %>
                    <span class="nav-notification-badge"><%= unreadNotifications %></span>
                <% } %>
            </a>
            </div>

            <div class="nav-actions d-flex align-items-center">
                <a href="/profile"
                    class="user-badge user-badge-link shadow-sm <%= currentPath.includes('/profile') ? 'active' : '' %>">
                    <i class="fas fa-user-circle"></i>
                    <%= user ? user.name : 'ผู้ใช้งาน' %>
                </a>
                <a href="/switch-view/customer" class="switch-view-btn" title="ดูมุมมองลูกค้าทั่วไป">
                    <i class="fas fa-right-left"></i> สลับเป็นลูกค้า
                </a>
                <a href="/logout" class="logout-link" style="white-space:nowrap">
                    <i class="fas fa-sign-out-alt me-1"></i>ออกจากระบบ
                </a>
            </div>
        </div>
    </div>
</nav>

<script src="/js/partials/navbar.js"></script>
