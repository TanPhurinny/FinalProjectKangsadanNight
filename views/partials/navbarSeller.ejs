<%
    // ตรวจสอบหน้าปัจจุบันจาก URL path เพื่อไฮไลต์เมนูที่ใช้งานอยู่
    const currentPath = locals.path || '';
    const notificationList = (typeof notifications !== 'undefined' && Array.isArray(notifications)) ? notifications : [];
    const unreadNotifications = notificationList.filter(function(item) {
        return !item.isRead && !item.upcoming && (!item.step || item.action || item.step === 3);
    }).length;

    // เมนูหลักโชว์บนแถบเสมอ ส่วนเมนูรองรวมใน "เพิ่มเติม" (จอกว้าง) — บนมือถือแสดงทุกเมนูเรียงกันในเมนู hamburger
    const isActive = function (match) { return match.some(function (m) { return currentPath.includes(m); }); };
    const primaryLinks = [
        { href: '/seller', icon: 'fa-home', label: 'หน้าหลัก', active: currentPath === '/seller' },
        { href: '/select-zone', icon: 'fa-store', label: 'จองแผง', active: isActive(['select-zone', 'booking-stall']) },
        { href: '/booking-status', icon: 'fa-clipboard-list', label: 'สถานะการจอง', active: isActive(['booking-status']) },
        { href: '/market-map', icon: 'fa-map', label: 'ผังตลาด', active: isActive(['market-map']) },
        { href: '/shop-profile', icon: 'fa-shop', label: 'ร้านค้าของฉัน', active: isActive(['shop-profile']) },
        { href: '/community', icon: 'fa-users', label: 'คอมมูนิตี้', active: isActive(['community', 'comunity']) }
    ];
    const moreLinks = [
        { href: '/booking-history', icon: 'fa-clock-rotate-left', label: 'ประวัติการจอง', active: isActive(['booking-history']) },
        { href: '/rental-statement', icon: 'fa-file-invoice-dollar', label: 'รายงานการเช่าและชำระเงิน', active: isActive(['rental-statement']) },
        { href: '/documents', icon: 'fa-folder-open', label: 'ขอเอกสาร (ใบกำกับภาษี / สัญญาเช่า)', active: isActive(['/documents', '/lease-contracts', '/tax-invoices', 'tax-invoice-requests']) },
        { href: '/stall-leave', icon: 'fa-calendar-minus', label: 'ลาหยุด / เช่าช่วงแผง', active: isActive(['/stall-leave']) },
        { href: '/repair', icon: 'fa-tools', label: 'แจ้งซ่อม', active: isActive(['repair']) },
        { href: '/announcements', icon: 'fa-bullhorn', label: 'ประกาศ', active: isActive(['announcements']) }
    ];
    const moreActive = moreLinks.some(function (link) { return link.active; });
    const notificationsActive = currentPath.includes('notifications');
%>
<link rel="stylesheet" href="/stylesheets/partials/navMenu.css?v=20261027">

<nav class="management-nav seller-nav nav-v2">
    <div class="nav-container">
        <a href="/seller" class="nav-brand <%= currentPath === '/seller' ? 'active' : '' %>">
            <img src="/img/favicon.png" alt="Kang Night Logo" class="nav-logo">
        </a>

        <%# มือถือ: กระดิ่งอยู่ข้างปุ่มเมนู กดได้ทันทีไม่ต้องเปิดเมนู %>
        <div class="nav-v2__mobile-bar">
            <a href="/notifications" class="nav-v2__bell <%= notificationsActive ? 'active' : '' %>" title="แจ้งเตือน" aria-label="แจ้งเตือน<%= unreadNotifications > 0 ? ` (${unreadNotifications} ยังไม่อ่าน)` : '' %>">
                <i class="fas fa-bell"></i>
                <% if (unreadNotifications > 0) { %>
                    <span class="nav-notification-badge"><%= unreadNotifications > 99 ? '99+' : unreadNotifications %></span>
                <% } %>
            </a>
            <button class="nav-toggle" id="navToggle" type="button" aria-label="เปิดเมนู">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <div class="nav-links" id="navMenu">
            <div class="nav-links__primary">
                <% primaryLinks.forEach(function (link) { %>
                <a href="<%= link.href %>" class="nav-item <%= link.active ? 'active' : '' %>">
                    <i class="fas <%= link.icon %>"></i> <%= link.label %>
                </a>
                <% }) %>

                <%# จอกว้าง: เมนูรองอยู่ใน dropdown %>
                <details class="nav-dropdown nav-v2__more">
                    <summary class="nav-item <%= moreActive ? 'active' : '' %>">
                        <i class="fas fa-ellipsis"></i> เพิ่มเติม
                    </summary>
                    <div class="nav-dropdown__panel">
                        <% moreLinks.forEach(function (link) { %>
                        <a href="<%= link.href %>" class="<%= link.active ? 'active' : '' %>"><i class="fas <%= link.icon %>"></i><%= link.label %></a>
                        <% }) %>
                    </div>
                </details>

                <%# มือถือ: เมนูรองเรียงต่อกันในเมนู hamburger ไม่ต้องกางอีกชั้น %>
                <% moreLinks.forEach(function (link) { %>
                <a href="<%= link.href %>" class="nav-item nav-v2__mobile-only <%= link.active ? 'active' : '' %>">
                    <i class="fas <%= link.icon %>"></i> <%= link.label %>
                </a>
                <% }) %>

                <a href="/notifications" class="nav-item nav-notification nav-notification--icon-only nav-v2__desktop-only <%= notificationsActive ? 'active' : '' %>" title="แจ้งเตือน" aria-label="แจ้งเตือน">
                    <i class="fas fa-bell"></i>
                    <% if (unreadNotifications > 0) { %>
                        <span class="nav-notification-badge"><%= unreadNotifications > 99 ? '99+' : unreadNotifications %></span>
                    <% } %>
                </a>
            </div>

            <%- include('navAccount', { navUser: user, navPath: currentPath, navSwitch: { href: '/switch-view/customer', label: 'สลับเป็นมุมมองลูกค้า' } }) %>
        </div>
    </div>
</nav>

<script src="/js/partials/navbar.js"></script>
